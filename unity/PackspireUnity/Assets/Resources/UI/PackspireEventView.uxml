<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="event-background" class="ps-event-background-layer" picking-mode="Ignore" />
    <ui:VisualElement class="ps-misprint-mark ps-misprint-mark--event" picking-mode="Ignore" />
    <ui:VisualElement class="ps-misprint-register" picking-mode="Ignore" />
    <ui:VisualElement class="ps-misprint-decor ps-misprint-decor--binder" picking-mode="Ignore" />
    <ui:VisualElement name="event-mist" class="ps-event-mist">
        <ui:VisualElement name="event-dialog" class="ps-event-panel">
            <ui:VisualElement name="event-header">
                <ui:VisualElement class="ps-misprint-header-copy">
                    <ui:Label name="event-header-eyebrow" class="ps-misprint-header-eyebrow" picking-mode="Ignore" />
                    <ui:Label name="event-header-title" class="ps-misprint-header-title" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="event-body">
                <ui:Label name="event-body-copy" class="ps-event-body-copy" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="event-choices" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
