.ps-battle-card.ps-docket-card {
    width: 168px;
    height: 252px;
    min-width: 168px;
    min-height: 252px;
    max-width: 168px;
    max-height: 252px;
    padding: 0;
    overflow: visible;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    transition-property: translate, scale, opacity;
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}

.ps-battle-card.ps-docket-card:hover {
    translate: 0 -18px;
    scale: 1.035 1.035 1;
}

.ps-docket {
    position: absolute;
    left: 0;
    top: 0;
    width: 168px;
    height: 252px;
    overflow: hidden;
    background-image: resource("Art/UI/CardDocket/docket-layered-c1-v1");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgb(24, 24, 23);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    color: rgb(239, 223, 188);
}

.ps-docket__art {
    height: 128px;
    margin: 9px 13px 0 8px;
    overflow: hidden;
    background-color: rgb(10, 10, 10);
    -unity-background-scale-mode: scale-and-crop;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(177, 139, 72, 0.58);
    border-right-color: rgba(177, 139, 72, 0.58);
    border-top-color: rgba(177, 139, 72, 0.58);
    border-bottom-color: rgba(177, 139, 72, 0.58);
}

.ps-docket__art-shade {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(5, 5, 5, 0.08);
}

.ps-docket__frame {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.ps-docket__cancellation-stamp {
    position: absolute;
    right: 6px;
    top: 108px;
    width: 54px;
    height: 54px;
    background-image: resource("Art/UI/CardDocket/docket-cancellation-stamp-c1-v1");
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0.78;
}

.ps-docket__main {
    height: 105px;
    margin: 0 13px 0 8px;
    padding: 5px 5px 3px 5px;
    background-color: rgba(0, 0, 0, 0);
}

.ps-docket__title-row {
    height: 24px;
    align-items: center;
    justify-content: flex-start;
}

.ps-docket__main-name {
    width: 108px;
    height: 23px;
    color: rgb(244, 226, 187);
    font-size: 15px;
    -unity-font-definition: resource("Fonts/KleeOne-SemiBold");
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
}

.ps-docket__rule {
    width: 100%;
    height: 1px;
    margin: 0 0 3px 0;
    background-color: rgba(177, 139, 72, 0.62);
}

.ps-docket__main-text {
    height: 53px;
    padding: 4px 1px 0 1px;
    flex-direction: column;
    overflow: hidden;
}

.ps-docket__result {
    display: none;
}

.ps-docket__effect-row {
    min-height: 13px;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
}

.ps-docket__effect-run {
    position: relative;
    min-height: 12px;
    flex-direction: row;
    flex-shrink: 1;
}

.ps-docket__effect-run--value {
    flex-shrink: 0;
}

.ps-docket__effect-backing {
    display: none;
}

.ps-docket__effect-copy,
.ps-docket__effect-value {
    min-height: 12px;
    margin: 0;
    padding: 0;
    color: rgb(218, 207, 180);
    font-size: 8px;
    -unity-font-definition: resource("Fonts/KleeOne-Regular");
    -unity-text-align: middle-left;
    white-space: normal;
}

.ps-docket__effect-copy {
    flex-shrink: 1;
}

.ps-docket__effect-value {
    flex-shrink: 0;
    color: rgb(232, 91, 71);
    -unity-font-definition: resource("Fonts/KleeOne-SemiBold");
    -unity-font-style: bold;
}

.ps-docket__cost {
    position: absolute;
    left: 5px;
    bottom: 3px;
    width: 53px;
    height: 19px;
    padding: 0 4px;
    color: rgb(232, 91, 71);
    font-size: 11px;
    -unity-font-definition: resource("Fonts/KleeOne-SemiBold");
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(187, 58, 44);
    border-right-color: rgb(187, 58, 44);
    border-top-color: rgb(187, 58, 44);
    border-bottom-color: rgb(187, 58, 44);
}

.ps-docket__seal-glyph {
    width: 16px;
    min-width: 16px;
    height: 16px;
    margin-right: 4px;
    color: rgb(205, 66, 50);
    font-size: 8px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(187, 58, 44, 0.72);
    border-right-color: rgba(187, 58, 44, 0.72);
    border-top-color: rgba(187, 58, 44, 0.72);
    border-bottom-color: rgba(187, 58, 44, 0.72);
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
}

.ps-docket__kind,
.ps-docket__code {
    height: 16px;
    color: rgb(207, 185, 142);
    font-size: 6px;
    letter-spacing: 0;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.ps-docket__kind {
    width: 40px;
    margin-left: auto;
}

.ps-docket__code {
    width: 50px;
}

.ps-docket__source,
.ps-docket__status {
    display: none;
}

.ps-docket__lock {
    position: absolute;
    right: 13px;
    top: 111px;
    height: 18px;
    padding: 0 5px;
    color: rgb(250, 232, 193);
    font-size: 7px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: rgba(117, 30, 24, 0.94);
}

.ps-docket-card.ps-docket-authorized .ps-docket__lock { display: none; }
.ps-docket-card.ps-docket-held .ps-docket__lock { display: flex; }
.ps-docket-card.ps-battle-card-disabled { opacity: 0.46; }

.ps-docket-card.ps-docket-defense .ps-docket__effect-value,
.ps-docket-card.ps-docket-defense .ps-docket__cost {
    color: rgb(91, 211, 211);
}

.ps-docket-card.ps-docket-technique .ps-docket__effect-value,
.ps-docket-card.ps-docket-technique .ps-docket__cost {
    color: rgb(197, 160, 222);
}

.ps-equipment-card-preview.ps-docket-card,
.ps-gboard-card-view-card.ps-docket-card,
.ps-gboard-side-preview.ps-docket-card,
.ps-vault-v9-card.ps-docket-card {
    height: 252px;
    min-height: 252px;
    overflow: visible;
}
