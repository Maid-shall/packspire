.ps-roster-screen {
    color: rgb(229, 209, 176);
    -unity-font-definition: resource("Fonts/KleeOne-SemiBold");
}

.ps-roster-screen .ps-layer-content {
    padding: 10px 18px 14px 18px;
}

.ps-roster-screen .ps-mgmt-header {
    height: 64px;
    min-height: 64px;
    padding: 2px 16px 6px 168px;
    align-items: center;
}

.ps-roster-screen .ps-misprint-header-copy {
    flex-grow: 0;
    width: 420px;
    padding-left: 0;
}

.ps-roster-screen .ps-misprint-header-title {
    font-size: 30px;
    -unity-font-definition: resource("Fonts/KaiseiDecol-Regular");
}

.ps-character-header-note {
    margin-top: -2px;
    color: rgba(211, 183, 137, 0.72);
    font-size: 9px;
}

.ps-roster-screen .ps-roster-body {
    padding: 4px 0 0 0;
}

.ps-roster-screen .ps-roster-col-reel {
    width: 340px;
    min-width: 340px;
    max-width: 340px;
    margin-right: 14px;
    padding: 8px 10px 6px 6px;
    border-right-width: 1px;
    border-right-color: rgba(160, 125, 70, 0.42);
}

.ps-character-list-heading {
    height: 52px;
    min-height: 52px;
    flex-direction: row;
    align-items: center;
    padding: 7px 12px;
    background-image: resource("Art/UI/ObsidianMisprintCharacter/roster-ticket-standard-v1");
    -unity-background-scale-mode: stretch-to-fill;
}

.ps-roster-screen .ps-roster-reel-heading {
    flex-grow: 1;
    height: auto;
    margin: 0;
    padding: 0;
    color: rgb(235, 213, 177);
    font-size: 21px;
    background-image: none;
    -unity-font-definition: resource("Fonts/KaiseiDecol-Regular");
}

.ps-character-list-eyebrow {
    color: rgb(74, 171, 178);
    font-size: 9px;
}

.ps-roster-screen .ps-roster-reel-scroll {
    padding: 5px 0;
}

.ps-character-roster-row {
    position: relative;
    height: 108px;
    min-height: 108px;
    margin: 0 0 5px 0;
    padding: 8px 14px 8px 8px;
    flex-direction: row;
    align-items: center;
    background-image: resource("Art/UI/ObsidianMisprintCharacter/roster-ticket-standard-v1");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.ps-character-roster-row:hover {
    -unity-background-image-tint-color: rgb(224, 211, 184);
}

.ps-character-roster-row.ps-selected {
    background-image: resource("Art/UI/ObsidianMisprintCharacter/roster-ticket-selected-v1");
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.ps-character-roster-portrait {
    width: 92px;
    min-width: 92px;
    height: 92px;
    margin-right: 12px;
    -unity-background-scale-mode: scale-and-crop;
}

.ps-character-roster-copy {
    flex-grow: 1;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
}

.ps-character-roster-name {
    color: rgb(232, 213, 180);
    font-size: 23px;
    white-space: nowrap;
    -unity-font-definition: resource("Fonts/KaiseiDecol-Regular");
}

.ps-character-roster-title {
    margin-top: 4px;
    color: rgba(199, 174, 132, 0.84);
    font-size: 11px;
    white-space: normal;
}

.ps-character-roster-row.ps-selected .ps-character-roster-name,
.ps-character-roster-row.ps-selected .ps-character-roster-title {
    color: rgb(31, 18, 13);
}

.ps-character-roster-register {
    width: 20px;
    min-width: 20px;
    color: rgb(55, 184, 190);
    font-size: 18px;
    -unity-text-align: middle-center;
}

.ps-character-list-note {
    min-height: 26px;
    padding: 5px 8px 0 8px;
    color: rgba(189, 164, 124, 0.62);
    font-size: 9px;
    border-top-width: 1px;
    border-top-color: rgba(160, 125, 70, 0.38);
}

.ps-roster-screen .ps-roster-col-art {
    position: relative;
    width: auto;
    min-width: 400px;
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 16px;
    overflow: hidden;
}

.ps-character-study {
    position: absolute;
    top: 90px;
    width: 150px;
    height: 390px;
    opacity: 0.28;
    -unity-background-scale-mode: scale-to-fit;
}

.ps-character-study-front {
    left: 0;
    background-image: resource("Art/UI/ObsidianMisprint/hub-courier-study-front-v1");
}

.ps-character-study-back {
    right: 0;
    background-image: resource("Art/UI/ObsidianMisprint/hub-courier-study-back-v1");
}

.ps-roster-screen .ps-roster-art-host {
    position: absolute;
    left: 34px;
    right: 34px;
    top: 0;
    bottom: 54px;
    align-items: center;
    justify-content: flex-end;
    background-color: rgba(0, 0, 0, 0);
    border-bottom-width: 1px;
    border-bottom-color: rgba(45, 183, 190, 0.62);
}

.ps-roster-screen .ps-roster-art-image {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
    scale: 1.10 1.10 1;
    transform-origin: center bottom;
}

.ps-character-art-caption {
    position: absolute;
    left: 42px;
    bottom: 8px;
    width: 250px;
    height: 48px;
    padding: 6px 10px 5px 12px;
    background-color: rgba(2, 3, 3, 0.88);
    border-left-width: 2px;
    border-left-color: rgb(176, 43, 32);
}

.ps-character-art-caption-name {
    color: rgb(231, 211, 177);
    font-size: 18px;
    -unity-font-definition: resource("Fonts/KaiseiDecol-Regular");
}

.ps-character-art-caption-title {
    color: rgb(50, 174, 182);
    font-size: 9px;
}

.ps-roster-screen .ps-roster-col-detail {
    width: 388px;
    min-width: 388px;
    max-width: 388px;
    flex-grow: 0;
    flex-shrink: 0;
    padding: 20px 24px 18px 24px;
    background-image: resource("Art/UI/ObsidianMisprintCharacter/personnel-dossier-tall-v1");
    -unity-background-scale-mode: stretch-to-fill;
    border-left-width: 0;
}

.ps-character-dossier-heading {
    position: relative;
    height: 126px;
    min-height: 126px;
    padding: 8px 12px;
    flex-direction: column;
}

.ps-character-dossier-eyebrow {
    color: rgb(48, 170, 178);
    font-size: 9px;
}

.ps-character-dossier-title {
    color: rgb(231, 210, 175);
    font-size: 22px;
    -unity-font-definition: resource("Fonts/KaiseiDecol-Regular");
}

.ps-character-dossier-portrait-host {
    position: absolute;
    right: 4px;
    top: 12px;
    width: 112px;
    height: 102px;
    overflow: hidden;
}

.ps-character-dossier-portrait-image {
    width: 112px;
    height: 102px;
    -unity-background-scale-mode: scale-and-crop;
}

.ps-roster-screen .ps-roster-detail-scroll {
    padding: 4px 0 0 0;
    margin-bottom: 6px;
}

.ps-roster-screen .ps-roster-detail-body > .ps-title {
    color: rgb(236, 216, 180);
    font-size: 29px;
    margin: 4px 12px 0 12px;
    -unity-font-definition: resource("Fonts/KaiseiDecol-Regular");
}

.ps-roster-screen .ps-roster-detail-body > .ps-body {
    color: rgb(183, 55, 40);
    font-size: 12px;
    margin: 0 12px 6px 12px;
}

.ps-roster-screen .ps-mgmt-section {
    min-height: 72px;
    margin: 0;
    padding: 11px 14px 10px 14px;
    background-image: none;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.ps-roster-screen .ps-mgmt-section-title {
    color: rgb(50, 170, 178);
    font-size: 11px;
}

.ps-roster-screen .ps-mgmt-section-body {
    margin-top: 4px;
    color: rgb(220, 200, 168);
    font-size: 12px;
}

.ps-roster-screen .ps-roster-footer {
    min-height: 84px;
    padding: 0;
}

.ps-roster-screen .ps-roster-confirm {
    height: 82px;
    min-height: 82px;
    padding: 8px 18px 8px 76px;
    flex-direction: row;
    align-items: center;
    background-image: resource("Art/UI/ObsidianMisprintCharacter/selection-order-ticket-v1");
    -unity-background-scale-mode: stretch-to-fill;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    white-space: nowrap;
}

.ps-roster-screen .ps-roster-confirm:hover {
    -unity-background-image-tint-color: rgb(255, 238, 204);
}

.ps-roster-confirm-copy {
    flex-grow: 1;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
}

.ps-roster-confirm-eyebrow {
    color: rgba(132, 52, 40, 0.72);
    font-size: 8px;
}

.ps-roster-confirm-label {
    color: rgb(76, 37, 29);
    font-size: 19px;
    white-space: nowrap;
    -unity-font-definition: resource("Fonts/KaiseiDecol-Regular");
}

.ps-roster-confirm-arrow {
    width: 22px;
    min-width: 22px;
    color: rgb(151, 55, 42);
    font-size: 28px;
    -unity-text-align: middle-center;
}

.ps-nav-visible .ps-nav-back {
    left: 18px;
    top: 14px;
    min-width: 104px;
    min-height: 40px;
    background-image: resource("Art/UI/ObsidianMisprintShared/misprint-surface-order-ticket-v1");
    -unity-background-scale-mode: stretch-to-fill;
    color: rgb(48, 34, 25);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.ps-nav-visible .ps-nav-menu-btn {
    left: 126px;
    top: 14px;
    bottom: auto;
    width: 42px;
    min-width: 42px;
    height: 40px;
    min-height: 40px;
    padding: 0;
    color: rgb(213, 182, 132);
    background-color: rgba(2, 3, 3, 0.88);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(177, 139, 78, 0.7);
    border-right-color: rgba(177, 139, 78, 0.7);
    border-top-color: rgba(177, 139, 78, 0.7);
    border-bottom-color: rgba(177, 139, 78, 0.7);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
}
