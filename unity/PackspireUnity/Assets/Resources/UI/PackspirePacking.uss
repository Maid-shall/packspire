/* Packing: one canonical layout, 1280 x 720 logical coordinates.
   Inventory uses the same shared list surfaces as the vault. */
.ps-rite { position: absolute; left: 0; top: 0; width: 1280px; height: 720px; overflow: hidden; color: rgb(231,209,173); -unity-font-definition: resource("Fonts/KleeOne-SemiBold"); }
.ps-rite .ps-button { min-height: 32px; padding: 5px 8px; color: rgb(231,209,173); -unity-text-align: middle-center; }
.ps-rite .ps-button:hover { color: rgb(255,237,202); background-color: rgb(35,51,49); }
.ps-rite-scene-bg, .ps-rite-scene-shade { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.ps-rite-scene-bg { background-image: resource("Art/UI/ObsidianMisprint/hub-misprint-background-v1"); -unity-background-scale-mode: scale-and-crop; }
.ps-rite-scene-shade { background-color: rgba(3,5,6,.78); }
.ps-packing-mark, .ps-packing-register, .ps-packing-proof-slash { display: none; }
.ps-rite-top { position: absolute; left: 145px; right: 26px; top: 12px; height: 70px; flex-direction: row; justify-content: space-between; align-items: center; border-bottom-width: 1px; border-bottom-color: rgba(186,146,82,.55); }
.ps-rite-brand { flex-direction: row; }
.ps-rite-brand-mark { width: 54px; height: 54px; margin-right: 12px; background-image: resource("Art/UI/ObsidianMisprint/hub-icon-vault-v1"); -unity-background-scale-mode: scale-to-fit; }
.ps-rite-top-title { justify-content: center; }
.ps-rite-top-eyebrow { font-size: 10px; color: rgb(61,178,184); }
.ps-rite-top-name { font-size: 28px; -unity-font-definition: resource("Fonts/NotoSerifJP-VF"); }
.ps-rite-top-sub { font-size: 11px; color: rgb(171,158,136); }
.ps-rite-top-actions { display: none; }
.ps-rite-body { position: absolute; left: 20px; right: 20px; top: 98px; bottom: 20px; flex-direction: row; }
.ps-rite-left { width: 316px; min-width: 316px; flex-shrink: 0; padding-right: 12px; border-right-width: 1px; border-right-color: rgba(177,142,86,.35); overflow: hidden; }
.ps-rite-left-header { flex-shrink: 0; }
.ps-rite-panel-head { min-height: 34px; flex-direction: row; align-items: center; margin-bottom: 8px; border-bottom-width: 1px; border-bottom-color: rgba(177,142,86,.35); }
.ps-rite-panel-index { font-size: 10px; color: rgb(61,178,184); margin-right: 7px; }
.ps-rite-panel-title { font-size: 17px; color: rgb(231,209,173); }
.ps-rite-panel-rule { flex-grow: 1; }
.ps-rite-filters { flex-direction: row; height: 36px; margin-bottom: 8px; }
.ps-rite .ps-rite-filter { height: 32px; min-height: 32px; color: rgb(225,206,173); background-color: rgb(17,29,30); flex-grow: 1; min-width: 0; margin: 0 2px 0 0; padding: 4px; font-size: 11px; }
.ps-rite .ps-rite-filter.ps-selected { background-color: rgb(35,68,66); color: rgb(248,229,192); }
.ps-rite-filter-icon { display: none; }
.ps-rite-equip-scroll { flex-grow: 1; flex-shrink: 1; min-height: 0; overflow: hidden; }
.ps-rite-equip-scroll > .unity-scroll-view__content-viewport { overflow: hidden; }
.ps-rite-equip-grid { flex-direction: row; flex-wrap: wrap; align-content: flex-start; }
.ps-rite-equip-tile { position: relative; width: 128px; height: 106px; min-width: 128px; min-height: 106px; flex-shrink: 0; margin: 0 8px 8px 0; padding: 0; align-items: center; background-image: resource("Art/UI/ObsidianMisprintShared/misprint-surface-list-v1"); -unity-background-scale-mode: stretch-to-fill; background-color: transparent; border-width: 0; }
.ps-rite-equip-tile.ps-selected { background-image: resource("Art/UI/ObsidianMisprintShared/misprint-surface-selected-row-v1"); }
.ps-rite-equip-tile:hover { -unity-background-image-tint-color: rgb(215,239,234); }
.ps-rite-equip-art { position: absolute; left: 12px; top: 7px; width: 104px; height: 66px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; }
.ps-rite-equip-name { position: absolute; left: 8px; right: 8px; bottom: 16px; height: 18px; color: rgb(242,218,185); font-size: 10px; white-space: normal; -unity-text-align: middle-center; }
.ps-rite-equip-badge { position: absolute; top: 2px; left: 3px; padding: 1px 4px; font-size: 9px; color: rgb(11,31,31); background-color: rgb(97,183,173); }
.ps-rite-center { width: 520px; min-width: 520px; flex-shrink: 0; padding: 0 16px; }
.ps-rite-board-heading { height: 38px; flex-shrink: 0; flex-direction: row; align-items: center; justify-content: space-between; border-bottom-width: 1px; border-bottom-color: rgba(177,142,86,.35); }
.ps-rite-board-heading-title { font-size: 21px; }
.ps-rite-board-heading-size { font-size: 12px; color: rgb(61,178,184); }
.ps-rite-kiln-row { flex-grow: 1; min-height: 0; }
.ps-rite-kiln { flex-grow: 1; position: relative; min-height: 0; }
.ps-rite-circle { position: absolute; left: 0; right: 0; top: 18px; bottom: 86px; justify-content: center; align-items: center; }
.ps-rite-grid { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; align-content: flex-start; }
.ps-rite-cell { position: relative; flex-shrink: 0; min-width: 0; min-height: 0; margin: 0; padding: 0; border-width: 1px; border-color: rgba(189,151,91,.7); background-color: rgb(16,22,23); overflow: hidden; }
.ps-rite-cell:hover { background-color: rgb(29,48,47); }
.ps-rite-cell.ps-selected { border-color: rgb(76,219,213); background-color: rgb(30,55,54); }
.ps-rite-cell-art { position: absolute; left: 10%; top: 10%; width: 80%; height: 80%; -unity-background-scale-mode: scale-to-fit; }
.ps-rite-orb-wrap { position: absolute; left: 5px; top: 5px; width: 14px; height: 14px; }
.ps-rite .ps-rite-orb { background-color: transparent; width: 14px; height: 14px; }
.ps-rite-orb-halo { display: none; }
.ps-rite-orb-wrap-open { left: 35%; top: 35%; width: 30%; height: 30%; opacity: .7; }
.ps-rite-orb-wrap-open .ps-rite-orb { width: 100%; height: 100%; }
.ps-rite-orb-fallback { border-radius: 50%; }
.ps-rite-kiln-rail { height: 70px; flex-shrink: 0; flex-direction: row; align-items: center; border-top-width: 1px; border-top-color: rgba(177,142,86,.35); }
.ps-rite-seal-bar { flex-direction: row; flex-wrap: wrap; max-width: 310px; flex-shrink: 1; }
.ps-rite-seal-chip { flex-direction: row; align-items: center; margin: 3px; padding: 4px; }
.ps-rite-seal-orb { width: 16px; height: 16px; margin-right: 5px; }
.ps-rite-seal-value { font-size: 11px; }
.ps-rite-rail-spacer { flex-grow: 1; }
.ps-rite .ps-rite-tool { width: 142px; min-width: 142px; height: 38px; min-height: 38px; flex-shrink: 0; padding: 5px; color: rgb(232,209,173); font-size: 12px; white-space: nowrap; }
.ps-rite-tool-icon, .ps-rite-select-icon { display: none; }
.ps-rite-select-dock { position: absolute; left: 45px; right: 45px; bottom: 18px; height: 46px; flex-direction: row; justify-content: center; }
.ps-rite-select-caption { display: none; }
.ps-rite-select-btn { min-width: 100px; height: 42px; margin: 0 5px; font-size: 12px; }
.ps-rite-right-shell { width: 404px; min-width: 404px; flex-shrink: 0; padding-left: 16px; border-left-width: 1px; border-left-color: rgba(177,142,86,.35); overflow: hidden; }
.ps-packing-tabs { height: 38px; flex-shrink: 0; flex-direction: row; }
.ps-rite .ps-packing-tab { height: 38px; min-height: 38px; color: rgb(229,210,175); -unity-text-align: middle-center; border-width: 1px; border-color: rgb(93,83,63); background-color: rgb(15,26,27); flex-grow: 1; margin: 0 2px 0 0; font-size: 12px; }
.packing--effects #packing-effects-tab, .packing--formulas #packing-formulas-tab { border-bottom-color: rgb(71,200,198); background-color: rgb(25,52,51); }
.ps-packing-courier { height: 118px; flex-shrink: 0; flex-direction: row; margin-top: 12px; border-bottom-width: 1px; border-bottom-color: rgba(177,142,86,.35); }
.ps-packing-courier-art { width: 95px; height: 116px; overflow: hidden; }
.ps-packing-courier-image { width: 95px; height: 180px; -unity-background-scale-mode: scale-to-fit; }
.ps-packing-courier-copy { flex-grow: 1; justify-content: center; padding-left: 14px; }
.ps-packing-courier-name { font-size: 24px; }
.packing--formulas .ps-packing-courier { display: none; }
.ps-rite-right { flex-grow: 1; flex-shrink: 1; min-height: 0; margin-top: 12px; margin-bottom: 10px; overflow: hidden; }
.ps-rite-right > .unity-scroll-view__content-viewport { overflow: hidden; }
.ps-rite-right .unity-scroll-view__content-container { padding-right: 8px; }
.ps-rite .ps-rite-save { background-image: resource("Art/UI/ObsidianMisprintShared/misprint-surface-confirm-v1"); -unity-background-scale-mode: stretch-to-fill; background-color: transparent; color: rgb(235,215,181); -unity-text-align: middle-center; height: 42px; flex-shrink: 0; font-size: 14px; }
.ps-rite-detail-card { padding: 8px 0 12px; }
.ps-rite-detail-art { width: 115px; height: 115px; align-self: center; }
.ps-rite-detail-name { font-size: 22px; margin-bottom: 6px; }
.ps-rite-detail-desc, .ps-rite-meta, .ps-rite-empty, .ps-rite-status { font-size: 12px; white-space: normal; margin-bottom: 8px; color: rgb(192,179,154); }
.ps-rite-effect { padding: 10px 8px; margin-bottom: 7px; border-left-width: 2px; border-left-color: rgb(100,92,73); background-color: rgba(10,16,17,.8); }
.ps-rite-effect-active { border-left-color: rgb(66,188,183); }
.ps-rite-effect-top { flex-direction: row; justify-content: space-between; }
.ps-rite-effect-title { font-size: 14px; flex-shrink: 1; white-space: normal; }
.ps-rite-effect-badge { font-size: 10px; color: rgb(97,199,191); }
.ps-rite-effect-detail { font-size: 12px; white-space: normal; margin-top: 6px; color: rgb(192,179,154); }
.ps-rite-template-head, .ps-rite-template-actions { flex-direction: row; align-items: center; justify-content: space-between; }
.ps-rite-template-head { min-height: 48px; flex-shrink: 0; }
.ps-rite-template-head .ps-rite-panel-head { flex-grow: 1; min-width: 0; }
.ps-rite-template-head .ps-rite-panel-title { font-size: 15px; white-space: nowrap; }
.ps-rite-template-head .ps-rite-chip { min-width: 76px; }
.ps-rite-template-list-card, .ps-rite-template { padding: 12px; margin-bottom: 10px; border-bottom-width: 1px; border-bottom-color: rgba(177,142,86,.45); }
.ps-rite-template-list-card.ps-selected { background-color: rgb(26,45,44); }
.ps-rite-template-list-name { font-size: 19px; margin-bottom: 6px; }
.ps-rite-template-list-sub { font-size: 12px; white-space: normal; color: rgb(179,167,145); }
.ps-rite-template-actions { margin-top: 8px; justify-content: flex-end; }
.ps-rite-template-edit, .ps-rite-template-decide, .ps-rite-chip { height: 32px; min-width: 65px; margin-left: 5px; font-size: 12px; }
.ps-rite-shape { align-self: flex-start; margin: 4px 0 10px; }
.ps-rite-shape-row { flex-direction: row; }
.ps-rite-shape-cell { width: 22px; height: 22px; flex-shrink: 0; border-width: 1px; border-color: rgba(238,212,171,.7); }
.ps-rite-shape-empty { opacity: 0; }
.ps-rite-shape-filled.ps-element-fire { background-color: rgb(165,69,48); }
.ps-rite-shape-filled.ps-element-water { background-color: rgb(44,119,164); }
.ps-rite-shape-filled.ps-element-wind { background-color: rgb(68,142,105); }
.ps-rite-shape-filled.ps-element-earth { background-color: rgb(165,136,58); }
.ps-rite-drag-ghost { position: absolute; opacity: .8; }
.ps-rite-drag-ghost .ps-rite-shape { margin: 0; }
.ps-rite-drag-ghost .ps-rite-shape-cell { border-width: 2px; border-color: rgb(242,222,175); }
.ps-rite-popup-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(0,0,0,.8); align-items: center; justify-content: center; }
.ps-rite-popup { width: 1000px; height: 600px; padding: 20px; background-color: rgb(14,20,21); border-width: 1px; border-color: rgb(161,127,73); }
.ps-rite-popup-header { height: 64px; flex-shrink: 0; flex-direction: row; align-items: center; justify-content: space-between; }
.ps-rite-formula-name { height: 42px; flex-direction: row; align-items: center; }
.ps-rite-formula-name-label { width: 90px; }
.ps-rite-formula-name-field { flex-grow: 1; }
.ps-rite-formula-body, .ps-rite-deck-split { flex-direction: row; flex-grow: 1; min-height: 0; }
.ps-rite-formula-rail { width: 58%; padding-right: 16px; }
.ps-rite-formula-stage { flex-grow: 1; padding: 20px; border-left-width: 1px; border-left-color: rgba(177,142,86,.35); }
.ps-rite-formula-acc { margin-bottom: 8px; }
.ps-rite-formula-acc-head { height: 36px; flex-direction: row; align-items: center; }
.ps-rite-formula-acc-mark { width: 20px; }
.ps-rite-formula-acc-kind { width: 92px; }
.ps-rite-formula-acc-chosen { flex-grow: 1; }
.ps-rite-formula-acc-body { padding: 8px; }
.ps-rite-formula-acc-desc { white-space: normal; font-size: 12px; }
.ps-rite-formula-acc-option { min-height: 34px; white-space: normal; font-size: 12px; margin: 3px 0; }
.ps-rite-deck-col { width: 50%; padding: 10px; min-height: 0; }
.ps-rite-deck-col-title { font-size: 20px; height: 34px; }
.ps-rite-deck-col-scroll { flex-grow: 1; min-height: 0; overflow: hidden; }
.ps-rite-cards { flex-direction: row; flex-wrap: wrap; }
.ps-rite-card { width: 46%; min-height: 100px; padding: 8px; margin: 4px; background-color: rgb(23,34,35); }
.ps-rite-tick { display: none; }
