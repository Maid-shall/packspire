.ps-battle-screen {
    flex-grow: 1;
    position: relative;
    overflow: hidden;
    color: rgb(237, 222, 188);
    background-color: rgb(16, 14, 13);
    -unity-font-definition: resource("Fonts/KleeOne-Regular");
}

.ps-battle-background-layer,
.ps-battle-dungeon-backdrop,
.ps-battle-bg-dim,
.ps-battle-bg-vignette-left,
.ps-battle-bg-vignette-right,
.ps-battle-bg-ground-veil {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.ps-battle-dungeon-backdrop {
    -unity-background-scale-mode: scale-and-crop;
}

.ps-battle.is-dungeon-old-spire .ps-battle-dungeon-backdrop {
    background-image: resource("Art/Battle/Backgrounds/battle-bg-old-spire-v3");
}

.ps-battle.is-dungeon-ash-forge .ps-battle-dungeon-backdrop {
    background-image: resource("Art/Battle/Backgrounds/battle-bg-ash-forge-v1");
}

.ps-battle.is-dungeon-hollow-archive .ps-battle-dungeon-backdrop {
    background-image: resource("Art/Battle/Backgrounds/battle-bg-hollow-archive-v1");
}

.ps-battle-bg-dim {
    background-color: rgba(4, 6, 7, 0.14);
}

.ps-battle-bg-vignette-left,
.ps-battle-bg-vignette-right {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 190px;
    background-color: rgba(3, 5, 6, 0.22);
}

.ps-battle-bg-vignette-left {
    left: 0;
}

.ps-battle-bg-vignette-right {
    right: 0;
}

.ps-battle-bg-ground-veil {
    top: 68%;
    background-color: rgba(3, 4, 5, 0.14);
}

.ps-battle-stage {
    position: absolute;
    left: 40px;
    right: 40px;
    top: 52px;
    bottom: 198px;
    flex-direction: row;
    align-items: flex-end;
    overflow: visible;
}

.ps-battle-foreground-shade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 154px;
    background-color: rgba(3, 4, 5, 0.44);
}

.ps-battle-brand {
    position: absolute;
    left: 24px;
    top: 18px;
    width: 232px;
    height: 44px;
    flex-direction: row;
    align-items: center;
    padding: 0 12px;
    background-color: rgba(6, 8, 8, 0.86);
    border-left-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(174, 48, 36, 0.82);
    border-top-color: rgba(180, 141, 78, 0.48);
    border-bottom-color: rgba(180, 141, 78, 0.7);
}

.ps-battle-brand__copy {
    justify-content: center;
}

.ps-battle-circle {
    margin-right: 10px;
    color: rgb(204, 62, 45);
    font-size: 24px;
    -unity-font-definition: resource("Fonts/KleeOne-SemiBold");
}

.ps-battle-record-title {
    color: rgb(245, 227, 190);
    font-size: 17px;
    -unity-font-definition: resource("Fonts/KleeOne-SemiBold");
}

.ps-battle-brand__eyebrow {
    margin-top: -2px;
    color: rgb(57, 176, 182);
    font-size: 7px;
}

.ps-battle-round-badge {
    position: absolute;
    right: 24px;
    top: 18px;
    width: 124px;
    height: 38px;
    align-items: center;
    justify-content: center;
    background-image: resource("Art/Battle/Chrome/btn-plate-hex");
    -unity-background-scale-mode: stretch-to-fill;
}

.ps-battle-round {
    width: 100%;
    margin: 0;
    color: rgb(232, 213, 176);
    font-size: 14px;
    -unity-font-definition: resource("Fonts/KleeOne-SemiBold");
    -unity-text-align: middle-center;
}

.ps-battle-lane {
    height: 100%;
    align-items: center;
    justify-content: flex-end;
}

.ps-battle-lane-player {
    width: 42%;
}

.ps-battle-lane-enemy {
    flex-grow: 1;
}

.ps-battle-enemy-line {
    width: 100%;
    height: 100%;
    flex-direction: row;
    align-items: flex-end;
    justify-content: center;
}

.ps-battle-combatant {
    height: 100%;
    align-items: center;
    justify-content: flex-end;
    overflow: visible;
}

.ps-battle-combatant-player {
    width: 232px;
}

.ps-battle-combatant-enemy {
    width: 360px;
    margin-left: 58px;
}

.ps-battle-actor {
    position: relative;
    align-items: center;
    justify-content: flex-end;
    flex-shrink: 0;
    transition-property: translate, scale, opacity;
    transition-duration: 0.18s;
}

.ps-battle-actor-player {
    width: 196px;
    height: 350px;
}

.ps-battle-actor-enemy {
    width: 342px;
    height: 390px;
}

/*
 * Battle composition presets adjust both sides as one camera-like formation.
 * The actor images remain ScaleToFit; only their aspect-safe viewports change.
 */
.ps-battle.is-formation-normal .ps-battle-lane-player {
    width: 42%;
}

.ps-battle.is-formation-normal .ps-battle-combatant-enemy {
    width: 360px;
    margin-left: 58px;
}

.ps-battle.is-formation-small .ps-battle-lane-player {
    width: 44%;
}

.ps-battle.is-formation-small .ps-battle-combatant-player {
    width: 240px;
}

.ps-battle.is-formation-small .ps-battle-actor-player {
    width: 202px;
    height: 360px;
}

.ps-battle.is-formation-small .ps-battle-combatant-enemy {
    width: 238px;
    margin-left: 20px;
}

.ps-battle.is-formation-small .ps-battle-actor-enemy {
    width: 208px;
    height: 250px;
}

.ps-battle.is-formation-large .ps-battle-lane-player {
    width: 38%;
}

.ps-battle.is-formation-large .ps-battle-combatant-player {
    width: 208px;
}

.ps-battle.is-formation-large .ps-battle-actor-player {
    width: 176px;
    height: 315px;
}

.ps-battle.is-formation-large .ps-battle-combatant-enemy {
    width: 426px;
    margin-left: 88px;
}

.ps-battle.is-formation-large .ps-battle-actor-enemy {
    width: 394px;
    height: 420px;
}

.ps-battle.is-formation-boss .ps-battle-lane-player {
    width: 34%;
}

.ps-battle.is-formation-boss .ps-battle-combatant-player {
    width: 184px;
}

.ps-battle.is-formation-boss .ps-battle-actor-player {
    width: 156px;
    height: 280px;
}

.ps-battle.is-formation-boss .ps-battle-combatant-enemy {
    width: 500px;
    margin-left: 108px;
}

.ps-battle.is-formation-boss .ps-battle-actor-enemy {
    width: 458px;
    height: 440px;
}

.ps-battle.is-formation-multiple .ps-battle-lane-player {
    width: 30%;
}

.ps-battle.is-formation-multiple .ps-battle-combatant-player {
    width: 188px;
}

.ps-battle.is-formation-multiple .ps-battle-actor-player {
    width: 160px;
    height: 286px;
}

.ps-battle.is-formation-multiple .ps-battle-enemy-line {
    justify-content: space-around;
}

.ps-battle.is-formation-multiple .ps-battle-combatant-enemy {
    width: 194px;
    margin-left: 0;
}

.ps-battle.is-formation-multiple .ps-battle-actor-enemy {
    width: 172px;
    height: 238px;
}

.ps-battle.is-formation-multiple .ps-battle-hud,
.ps-battle.is-formation-multiple .ps-battle-vitals-frame {
    width: 168px;
}

.ps-battle.is-formation-multiple .ps-battle-vitals-track {
    left: 23px;
    width: 121px;
}

.ps-battle.is-formation-multiple .ps-battle-intent-list {
    width: 166px;
}

.ps-battle-combatant-preview .ps-battle-status-row {
    visibility: hidden;
}

.ps-battle-actor-sigil {
    position: absolute;
    left: -8%;
    right: -8%;
    bottom: 2px;
    height: 46px;
    opacity: 0.2;
    background-image: resource("Art/Battle/UI/battle-ground-sigil-v1");
    -unity-background-scale-mode: stretch-to-fill;
}

.ps-battle-actor-enemy .ps-battle-actor-sigil {
    left: -8%;
    right: -8%;
    height: 58px;
    opacity: 0.24;
}

.ps-battle-actor-shadow {
    position: absolute;
    left: 6%;
    right: 6%;
    bottom: 8px;
    height: 13px;
    background-color: rgba(0, 0, 0, 0.56);
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
}

.ps-battle-actor-enemy .ps-battle-actor-shadow {
    left: 3%;
    right: 3%;
    bottom: 7px;
    height: 20px;
}

.ps-battle-actor-image {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.ps-battle-actor-player .ps-battle-actor-image { scale: 1 1 1; }

.ps-battle-actor-hit {
    translate: -8px 0;
    opacity: 0.72;
}

.ps-battle-actor-guard {
    scale: 1.025 1.025 1;
}

.ps-battle-actor-heal {
    scale: 1.035 1.035 1;
}

.ps-battle-hud {
    position: relative;
    width: 204px;
    height: 58px;
    min-height: 58px;
    margin-bottom: 4px;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.ps-battle-hud-player,
.ps-battle-hud-enemy { align-items: center; }

.ps-battle-vitals-frame {
    position: relative;
    width: 200px;
    height: 46px;
    min-height: 46px;
    overflow: visible;
    background-color: rgba(0, 0, 0, 0);
}

.ps-battle-vitals-art {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: resource("Art/Battle/UI/battle-vitals-frame-v2");
    -unity-background-scale-mode: stretch-to-fill;
}

.ps-battle-vitals-value {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: auto;
    height: auto;
    min-height: 0;
    margin: 0;
    padding: 0;
    color: rgb(245, 229, 195);
    font-size: 11px;
    -unity-font-definition: resource("Fonts/KleeOne-SemiBold");
    -unity-text-align: middle-center;
    translate: 0 -3px;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 1);
}

.ps-battle-vitals-track {
    position: absolute;
    left: 27px;
    top: 19px;
    width: 150px;
    height: 14px;
    min-height: 14px;
    padding: 0;
    overflow: hidden;
    align-items: center;
    justify-content: center;
    background-color: rgb(22, 17, 15);
    background-image: none;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.ps-battle-vitals-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    height: auto;
    min-width: 0;
    opacity: 1;
    background-color: rgb(174, 40, 32);
    border-top-width: 1px;
    border-bottom-width: 2px;
    border-top-color: rgb(238, 111, 76);
    border-bottom-color: rgb(92, 20, 19);
}

.ps-battle-block-overlay {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(45, 164, 205, 0.2);
    background-image: none;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
    border-left-color: rgba(117, 223, 242, 0.88);
    border-right-color: rgba(117, 223, 242, 0.88);
    border-top-color: rgba(184, 248, 247, 0.74);
    border-bottom-color: rgba(38, 126, 164, 0.92);
}

.ps-battle-block-badge {
    display: none;
    position: absolute;
    right: -21px;
    top: -5px;
    width: 54px;
    height: 54px;
    background-image: resource("Art/Battle/UI/battle-vitals-shield-v1");
    -unity-background-scale-mode: scale-to-fit;
}

.ps-battle-block-value {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: auto;
    height: auto;
    min-height: 0;
    margin: 0;
    padding: 0;
    color: rgb(224, 252, 255);
    font-size: 14px;
    -unity-font-definition: resource("Fonts/KleeOne-SemiBold");
    -unity-text-align: middle-center;
    translate: -6px 0;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 1);
}

.ps-battle-hud.has-block .ps-battle-block-overlay,
.ps-battle-hud.has-block .ps-battle-block-badge {
    display: flex;
}

.ps-battle-status-row {
    width: 170px;
    height: 20px;
    min-height: 20px;
    margin-left: 0;
    margin-top: -2px;
    padding: 0;
    flex-direction: row;
    align-items: center;
    flex-wrap: nowrap;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
}

.ps-battle-status-chip {
    width: 27px;
    height: 20px;
    margin: 0 4px 0 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    color: rgb(237, 222, 188);
    background-color: rgba(6, 8, 9, 0.76);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 2px;
    border-left-color: rgb(60, 174, 184);
    border-right-color: rgb(60, 174, 184);
    border-top-color: rgb(60, 174, 184);
    border-bottom-color: rgb(60, 174, 184);
}

.ps-battle-status-debuff {
    border-bottom-color: rgb(205, 68, 48);
}

.ps-battle-status-count {
    margin-left: 2px;
    color: rgb(246, 226, 187);
    font-size: 10px;
    -unity-font-definition: resource("Fonts/KleeOne-SemiBold");
}

.ps-battle-utility-stack {
    position: relative;
    width: 280px;
    height: auto;
    margin: 0;
    padding: 0;
    flex-direction: column;
    align-items: flex-start;
    flex-shrink: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.ps-battle-skill-dock {
    position: relative;
    width: 188px;
    height: 76px;
    min-height: 76px;
    margin: 0 0 6px 0;
    padding: 12px 12px 10px 66px;
    flex-direction: column;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
    background-image: resource("Art/Battle/UI/battle-skill-command");
    -unity-background-scale-mode: stretch-to-fill;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    transition-property: -unity-background-image-tint-color, scale;
    transition-duration: 0.15s;
}

.ps-battle-skill-dock__eyebrow {
    position: relative;
    width: 100%;
    height: 14px;
    margin: 0;
    padding: 0;
    color: rgb(84, 186, 197);
    font-size: 9px;
    letter-spacing: 1px;
    -unity-font-definition: resource("Fonts/KleeOne-SemiBold");
    -unity-text-align: middle-left;
}

.ps-battle-skill-dock:hover {
    -unity-background-image-tint-color: rgb(255, 240, 230);
}

.ps-battle-skill-dock:disabled {
    -unity-background-image-tint-color: rgb(100, 100, 100);
}

.ps-battle-skill-dock:disabled .ps-battle-skill-dock__eyebrow {
    color: rgb(92, 88, 82);
}

.ps-battle-intent-list {
    position: relative;
    width: 190px;
    height: 34px;
    min-height: 34px;
    max-height: 34px;
    flex-direction: row;
    justify-content: center;
    margin-top: -2px;
    margin-bottom: 2px;
    flex-shrink: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
}

.ps-battle-intent-entry {
    min-width: 46px;
    height: 32px;
    margin: 0 2px;
    padding: 1px 5px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(7, 9, 10, 0.9);
    background-image: none;
    border-left-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(203, 63, 46, 0.5);
}

.ps-battle-intent-entry.is-guard {
    border-left-color: rgb(63, 181, 195);
    border-bottom-color: rgba(63, 181, 195, 0.5);
}

.ps-battle-intent-entry.is-heal {
    border-left-color: rgb(99, 181, 112);
    border-bottom-color: rgba(99, 181, 112, 0.5);
}

.ps-battle-intent-entry.is-status,
.ps-battle-intent-entry.is-special {
    border-left-color: rgb(174, 115, 181);
    border-bottom-color: rgba(174, 115, 181, 0.5);
}

.ps-battle-intent-entry__icon {
    width: 22px;
    min-width: 22px;
    height: 22px;
    margin-right: 3px;
}

.ps-battle-intent-entry__value {
    color: rgb(242, 225, 190);
    font-size: 14px;
    -unity-font-definition: resource("Fonts/KleeOne-SemiBold");
    -unity-text-align: middle-center;
}

.ps-battle-pile-dock {
    position: relative;
    width: 270px;
    height: 76px;
    min-height: 76px;
    margin: 0 0 6px 0;
    padding: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.ps-battle-pile-button {
    position: relative;
    height: 76px;
    margin: 0;
    padding: 10px 8px 8px 62px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: rgb(212, 201, 184);
    font-size: 10px;
    -unity-font-definition: resource("Fonts/KleeOne-SemiBold");
    -unity-text-align: middle-center;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: stretch-to-fill;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    transition-property: color, background-color;
    transition-duration: 0.15s;
}

.ps-battle-pile-button--draw {
    width: 122px;
    background-image: resource("Art/Battle/UI/battle-pile-draw");
}

.ps-battle-pile-button--discard {
    width: 149px;
    margin-left: -11px;
    padding-left: 66px;
    background-image: resource("Art/Battle/UI/battle-pile-discard");
}

.ps-battle-pile-button__label,
.ps-battle-pile-button__value {
    margin: 0;
    padding: 0;
    color: rgb(212, 201, 184);
    width: 100%;
    font-size: 10px;
    -unity-font-definition: resource("Fonts/KleeOne-SemiBold");
    -unity-text-align: middle-center;
}

.ps-battle-pile-button__value {
    min-width: 0;
    color: rgb(232, 219, 196);
    font-size: 14px;
    -unity-text-align: middle-center;
}

.ps-battle-pile-button:hover {
    -unity-background-image-tint-color: rgb(255, 240, 230);
}

.ps-battle-pile-button:hover .ps-battle-pile-button__label {
    color: rgb(255, 248, 237);
}

.ps-battle-pile-button:hover .ps-battle-pile-button__value {
    color: rgb(88, 201, 210);
}

.ps-battle-pile-button:active {
    translate: 1px 1px;
}

.ps-battle-energy-dial {
    position: relative;
    width: 279px;
    height: 69px;
    min-height: 69px;
    margin: 0;
    padding: 0 18px 0 54px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    background-color: rgba(0, 0, 0, 0);
    background-image: resource("Art/Battle/UI/battle-energy-ledger");
    -unity-background-scale-mode: stretch-to-fill;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.ps-battle-energy-dial__caption {
    width: 38px;
    margin: 0;
    padding: 0;
    color: rgb(232, 219, 196);
    font-size: 11px;
    -unity-font-definition: resource("Fonts/KleeOne-SemiBold");
    -unity-text-align: middle-center;
}

.ps-battle-energy-dial__value {
    flex-grow: 1;
    height: 40px;
    margin: 0;
    padding: 0;
    color: rgb(245, 239, 230);
    font-size: 20px;
    -unity-font-definition: resource("Fonts/KleeOne-SemiBold");
    -unity-text-align: middle-center;
    -unity-text-outline-color: rgba(11, 13, 14, 0.85);
    -unity-text-outline-width: 1px;
}

.ps-battle-lower-dock {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 0;
    height: 330px;
    flex-direction: row;
    align-items: flex-end;
    overflow: visible;
}

.ps-battle-hand {
    position: relative;
    flex-grow: 1;
    margin-left: 10px;
    margin-right: 48px;
    height: 224px;
    overflow: visible;
}

.ps-battle-card {
    margin: 0;
}

.ps-battle-screen .ps-battle-card.ps-docket-card {
    width: 156px;
    height: 218px;
    min-width: 156px;
    min-height: 218px;
    max-width: 156px;
    max-height: 218px;
    scale: 0.88 0.88 1;
}

.ps-battle-screen .ps-battle-card.ps-battle-card-large.ps-docket-card {
    scale: 0.92 0.92 1;
}

.ps-battle-screen .ps-battle-card.ps-battle-card-standard.ps-docket-card {
    scale: 0.88 0.88 1;
}

.ps-battle-screen .ps-battle-card.ps-battle-card-compact.ps-docket-card {
    scale: 0.82 0.82 1;
}

.ps-battle-screen .ps-battle-card.ps-battle-card-dense.ps-docket-card {
    scale: 0.76 0.76 1;
}

.ps-battle-screen .ps-battle-card.ps-docket-card:hover {
    translate: 0 -14px;
    scale: 0.92 0.92 1;
}

.ps-battle-screen .ps-battle-card.ps-battle-card-large.ps-docket-card:hover {
    scale: 0.96 0.96 1;
}

.ps-battle-screen .ps-battle-card.ps-battle-card-compact.ps-docket-card:hover {
    scale: 0.86 0.86 1;
}

.ps-battle-screen .ps-battle-card.ps-battle-card-dense.ps-docket-card:hover {
    scale: 0.8 0.8 1;
}

.ps-battle-screen .ps-battle-card .ps-docket {
    width: 156px;
    height: 218px;
    background-image: none;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(55, 42, 30);
}

.ps-battle-screen .ps-battle-card .ps-docket__frame {
    display: flex;
    position: absolute;
    left: -1px;
    top: -1px;
    width: 158px;
    height: 220px;
    background-image: resource("Art/Battle/UI/battle-card-frame-support-aged-v1");
    -unity-background-scale-mode: stretch-to-fill;
}

.ps-battle-screen .ps-battle-card.ps-docket-attack .ps-docket__frame {
    background-image: resource("Art/Battle/UI/battle-card-frame-attack-aged-v1");
}

.ps-battle-screen .ps-battle-card.ps-docket-defense .ps-docket__frame {
    background-image: resource("Art/Battle/UI/battle-card-frame-defense-aged-v1");
}

.ps-battle-screen .ps-battle-card.ps-docket-technique .ps-docket__frame {
    background-image: resource("Art/Battle/UI/battle-card-frame-support-aged-v1");
}

.ps-battle-screen .ps-battle-card.ps-docket-consumable .ps-docket__frame {
    background-image: resource("Art/Battle/UI/battle-card-frame-status-aged-v1");
}

.ps-battle-screen .ps-battle-card .ps-docket__art {
    height: 94px;
    margin: 8px 9px 0 9px;
    background-color: rgb(17, 17, 16);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.ps-battle-screen .ps-battle-card .ps-docket__art-shade {
    background-color: rgba(8, 8, 8, 0.02);
}

.ps-battle-screen .ps-battle-card .ps-docket__cancellation-stamp {
    display: none;
}

.ps-battle-screen .ps-battle-card .ps-docket__main {
    position: absolute;
    left: 9px;
    top: 102px;
    width: 138px;
    height: 116px;
    margin: 0;
    padding: 0;
}

.ps-battle-screen .ps-battle-card .ps-docket__main-name {
    width: 100%;
    height: 26px;
    color: rgb(49, 37, 27);
    font-size: 16px;
    -unity-font-definition: resource("Fonts/NotoSerifJP-VF");
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
}

.ps-battle-screen .ps-battle-card .ps-docket__title-row {
    position: absolute;
    left: 0;
    right: 0;
    top: 3px;
    width: 100%;
    height: 24px;
    justify-content: center;
}

.ps-battle-screen .ps-battle-card .ps-docket__rule {
    display: none;
}

.ps-battle-screen .ps-battle-card .ps-docket__main-text {
    position: absolute;
    left: 12px;
    right: 10px;
    top: 30px;
    bottom: auto;
    height: 72px;
    min-height: 72px;
    max-height: 72px;
    padding: 0 5px;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
}

.ps-battle-screen .ps-battle-card .ps-docket__effect-copy,
.ps-battle-screen .ps-battle-card .ps-docket__effect-value {
    color: rgb(31, 25, 21);
    font-size: 12px;
    -unity-font-definition: resource("Fonts/NotoSerifJP-VF");
    -unity-font-style: bold;
    min-height: 0;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
}

.ps-battle-screen .ps-battle-card .ps-docket__effect-run {
    min-height: 16px;
    overflow: visible;
}

.ps-battle-screen .ps-battle-card .ps-docket__effect-row {
    min-height: 16px;
    max-width: 100%;
    align-self: center;
    justify-content: center;
    margin-bottom: 0;
    padding: 0 2px;
    background-color: rgb(231, 218, 197);
}

.ps-battle-screen .ps-battle-card .ps-docket__effect-backing {
    display: flex;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    color: rgb(231, 218, 197);
    font-size: 12px;
    -unity-font-definition: resource("Fonts/NotoSerifJP-VF");
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-align: middle-center;
    -unity-text-outline-color: rgb(231, 218, 197);
    -unity-text-outline-width: 2px;
}

.ps-battle-screen .ps-battle-card .ps-docket__effect-value {
    color: rgb(153, 47, 36);
}

.ps-battle-screen .ps-battle-card.ps-docket-attack .ps-docket__effect-backing {
    color: rgb(232, 219, 199);
    -unity-text-outline-color: rgb(232, 219, 199);
}

.ps-battle-screen .ps-battle-card.ps-docket-defense .ps-docket__effect-value {
    color: rgb(37, 111, 118);
}

.ps-battle-screen .ps-battle-card.ps-docket-defense .ps-docket__effect-backing {
    color: rgb(232, 219, 199);
    -unity-text-outline-color: rgb(232, 219, 199);
}

.ps-battle-screen .ps-battle-card.ps-docket-attack .ps-docket__effect-row,
.ps-battle-screen .ps-battle-card.ps-docket-defense .ps-docket__effect-row {
    background-color: rgb(232, 219, 199);
}

.ps-battle-screen .ps-battle-card.ps-docket-technique .ps-docket__effect-value {
    color: rgb(42, 112, 88);
}

.ps-battle-screen .ps-battle-card.ps-docket-technique .ps-docket__effect-backing {
    color: rgb(231, 218, 197);
    -unity-text-outline-color: rgb(231, 218, 197);
}

.ps-battle-screen .ps-battle-card.ps-docket-consumable .ps-docket__effect-value {
    color: rgb(110, 73, 139);
}

.ps-battle-screen .ps-battle-card.ps-docket-consumable .ps-docket__effect-backing {
    color: rgb(231, 218, 198);
    -unity-text-outline-color: rgb(231, 218, 198);
}

.ps-battle-screen .ps-battle-card.ps-docket-consumable .ps-docket__effect-row {
    background-color: rgb(231, 218, 198);
}

.ps-battle-screen .ps-battle-card .ps-docket__cost {
    position: absolute;
    left: 2px;
    top: 19px;
    bottom: auto;
    width: 48px;
    min-width: 48px;
    height: 21px;
    margin: 0;
    padding: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    background-image: none;
    color: rgb(145, 48, 37);
    font-size: 18px;
    -unity-font-definition: resource("Fonts/NotoSerifJP-VF");
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.ps-battle-screen .ps-battle-card.ps-docket-defense .ps-docket__cost,
.ps-battle-screen .ps-battle-card.ps-docket-technique .ps-docket__cost {
    color: rgb(43, 111, 106);
}

.ps-battle-screen .ps-battle-card.ps-docket-consumable .ps-docket__cost {
    color: rgb(104, 71, 127);
}

.ps-battle-screen .ps-battle-card .ps-docket__seal-glyph {
    display: none;
}

.ps-battle-screen .ps-battle-card .ps-docket__kind {
    display: none;
    position: absolute;
    left: 14px;
    bottom: 3px;
    width: 48px;
    color: rgb(112, 70, 45);
    font-size: 6px;
    -unity-text-align: middle-left;
}

.ps-battle-screen .ps-battle-card .ps-docket__code {
    display: none;
    position: absolute;
    right: 13px;
    bottom: 3px;
    width: 58px;
    color: rgb(112, 70, 45);
    font-size: 6px;
    -unity-text-align: middle-right;
}

.ps-battle-screen .ps-battle-card .ps-docket__lock {
    right: 12px;
    top: 80px;
    color: rgb(246, 230, 198);
}

.ps-battle-card-disabled {
    opacity: 0.46;
}

.ps-battle-command-rail {
    position: relative;
    width: 166px;
    height: 58px;
    margin-bottom: 18px;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
}

.ps-battle-btn-end {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    width: auto;
    height: 58px;
    padding: 0 12px;
    color: rgb(239, 221, 184);
    font-size: 16px;
    -unity-font-definition: resource("Fonts/KleeOne-SemiBold");
    background-color: rgba(0, 0, 0, 0);
    background-image: resource("Art/Battle/Chrome/btn-plate-wide");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.ps-battle-btn-end:hover {
    translate: 0 -2px;
    color: rgb(255, 239, 203);
    -unity-background-image-tint-color: rgb(233, 93, 69);
}

.ps-battle-utility-button--skill {
    position: relative;
    width: 100%;
    height: 24px;
    margin: 0;
    padding: 0;
    color: rgb(230, 223, 211);
    font-size: 13px;
    -unity-font-definition: resource("Fonts/KleeOne-SemiBold");
    -unity-text-align: middle-left;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.ps-battle-utility-button--skill:hover {
    color: rgb(255, 255, 255);
}

.ps-battle-skill-dock:active {
    scale: 0.98 0.98 1;
}

.ps-battle-skill-dock:disabled .ps-battle-utility-button--skill {
    color: rgb(122, 114, 103);
}

.ps-battle-hover-detail {
    position: absolute;
    left: 222px;
    bottom: 150px;
    width: 284px;
    min-height: 116px;
    padding: 13px 15px;
    display: none;
    background-color: rgb(224, 208, 171);
    border-left-width: 3px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(190, 52, 40);
    border-right-color: rgb(92, 70, 46);
    border-top-color: rgb(92, 70, 46);
    border-bottom-color: rgb(92, 70, 46);
}

.ps-battle-hover-detail.is-visible {
    display: flex;
}

.ps-battle-hover-detail__eyebrow {
    color: rgb(158, 45, 37);
    font-size: 9px;
}

.ps-battle-hover-detail__title {
    margin-top: 3px;
    color: rgb(35, 30, 24);
    font-size: 18px;
    -unity-font-definition: resource("Fonts/KleeOne-SemiBold");
}

.ps-battle-hover-detail__body {
    margin-top: 6px;
    color: rgb(57, 49, 39);
    font-size: 11px;
    white-space: normal;
}

.ps-battle-deck-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
}

.ps-battle-deck-overlay.is-open {
    display: flex;
}

.ps-battle-deck-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(3, 5, 6, 0.88);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.ps-battle-deck-panel {
    position: absolute;
    left: 66px;
    right: 66px;
    top: 44px;
    bottom: 40px;
    padding: 20px 26px;
    background-color: rgb(19, 21, 20);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(193, 156, 87);
    border-right-color: rgb(193, 156, 87);
    border-top-color: rgb(193, 156, 87);
    border-bottom-color: rgb(193, 156, 87);
}

.ps-battle-deck-header {
    height: 60px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-bottom-width: 1px;
    border-bottom-color: rgba(196, 159, 91, 0.68);
}

.ps-battle-deck-eyebrow {
    color: rgb(62, 198, 199);
    font-size: 10px;
}

.ps-battle-deck-title {
    color: rgb(245, 228, 192);
    font-size: 28px;
    -unity-font-definition: resource("Fonts/KleeOne-SemiBold");
}

.ps-battle-deck-close {
    width: 118px;
    height: 38px;
    color: rgb(239, 221, 187);
    font-size: 13px;
    background-color: rgba(55, 31, 27, 0.95);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(190, 58, 44);
    border-right-color: rgb(190, 58, 44);
    border-top-color: rgb(190, 58, 44);
    border-bottom-color: rgb(190, 58, 44);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

.ps-battle-deck-summary {
    height: 34px;
    padding-top: 8px;
    color: rgb(202, 184, 151);
    font-size: 12px;
}

.ps-battle-deck-scroll {
    flex-grow: 1;
}

.ps-battle-deck-grid {
    padding: 8px 12px 28px 12px;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
}

.ps-battle-deck-card {
    position: relative;
    margin: 0 13px 18px 0;
}

.ps-battle-deck-card:hover {
    translate: 0 0;
    scale: 1 1 1;
}

.ps-battle-fx-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    overflow: visible;
}

.ps-battle-start-banner {
    position: absolute;
    left: 25%;
    right: 25%;
    top: 39%;
    height: 92px;
    align-items: center;
    justify-content: center;
    opacity: 0;
    translate: 0 12px;
    background-color: rgba(8, 10, 10, 0.92);
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(190, 54, 43);
    border-right-color: rgb(190, 54, 43);
    border-top-color: rgb(202, 165, 97);
    border-bottom-color: rgb(202, 165, 97);
    transition-property: opacity, translate, scale;
    transition-duration: 0.28s;
}

.ps-battle-start-banner-in { opacity: 1; translate: 0 0; }
.ps-battle-start-banner-out { opacity: 0; translate: 0 -18px; }

.ps-battle-start-title {
    color: rgb(240, 219, 176);
    font-size: 39px;
    -unity-font-definition: resource("Fonts/KleeOne-SemiBold");
}

.ps-battle-start-sub {
    margin-top: 2px;
    color: rgb(205, 63, 47);
    font-size: 16px;
}

.ps-battle-floater {
    position: absolute;
    padding: 6px 11px;
    flex-direction: row;
    align-items: center;
    opacity: 0;
    translate: 0 18px;
    background-color: rgba(7, 9, 9, 0.9);
    border-left-width: 2px;
    border-left-color: rgb(202, 61, 45);
    transition-property: opacity, translate, scale;
    transition-duration: 0.28s;
}

.ps-battle-floater-pop { opacity: 1; translate: 0 -8px; scale: 1.08 1.08 1; }
.ps-battle-floater-out { opacity: 0; translate: 0 -56px; scale: 0.92 0.92 1; }

.ps-battle-floater-icon-art {
    width: 32px;
    height: 32px;
    margin-right: 6px;
}

.ps-battle-floater-value {
    color: rgb(255, 239, 202);
    font-size: 28px;
    -unity-font-definition: resource("Fonts/KleeOne-SemiBold");
}

.ps-battle-floater-damage .ps-battle-floater-value { color: rgb(255, 129, 102); }
.ps-battle-floater-block .ps-battle-floater-value { color: rgb(109, 213, 226); }
.ps-battle-floater-heal .ps-battle-floater-value { color: rgb(129, 220, 143); }
.ps-battle-floater-energy .ps-battle-floater-value { color: rgb(242, 196, 88); }

.ps-battle-card-flight {
    position: absolute;
    width: 140px;
    height: 58px;
    align-items: center;
    justify-content: center;
    background-color: rgba(11, 14, 14, 0.96);
    border-left-width: 3px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(196, 58, 44);
    border-right-color: rgb(194, 158, 91);
    border-top-color: rgb(194, 158, 91);
    border-bottom-color: rgb(194, 158, 91);
    transition-property: left, top, opacity, scale;
    transition-duration: 0.24s;
}

.ps-battle-card-flight-support { border-left-color: rgb(65, 193, 199); }

.ps-battle-card-flight-name {
    color: rgb(243, 225, 190);
    font-size: 16px;
    -unity-font-definition: resource("Fonts/KleeOne-SemiBold");
}
