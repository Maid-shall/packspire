/* Management V3
   Shared pop-dark presentation for the vault, role ledger, packing forge and shop.
   The authored chrome marks hierarchy; ordinary information remains on open surfaces. */

.ps-management-v3,
.ps-shop-v3,
.ps-rite-v3 {
    -unity-font-definition: resource("Fonts/KaiseiDecol-Regular");
}

.ps-management-art {
    flex-shrink: 0;
}

.ps-management-brand {
    min-height: 92px;
    padding-left: 0;
    padding-bottom: 24px;
    margin-bottom: 0;
    overflow: visible;
}

.ps-management-brand > .ps-chrome-brand-stroke {
    display: none;
}

.ps-management-brand-crest {
    width: 86px;
    height: 86px;
    margin-right: 4px;
}

.ps-management-brand .ps-chrome-brand-copy {
    justify-content: center;
    min-height: 72px;
}

.ps-management-brand .ps-chrome-eyebrow {
    color: rgb(226, 176, 116);
    font-size: 11px;
    letter-spacing: 2px;
    margin-bottom: -2px;
}

.ps-management-brand .ps-chrome-title {
    color: rgb(255, 218, 144);
    font-size: 34px;
    letter-spacing: 3px;
    -unity-text-outline-color: rgba(55, 8, 50, 0.95);
    -unity-text-outline-width: 1px;
}

.ps-management-brand-flourish {
    position: absolute;
    left: 78px;
    bottom: -1px;
    width: 470px;
    height: 52px;
    opacity: 0.98;
}

.ps-management-page-crest {
    width: 100%;
    height: 100%;
}

.ps-management-filter-medallion {
    width: 38px;
    height: 38px;
    margin-right: 5px;
}

.ps-management-selection-corners {
    display: none;
    position: absolute;
    left: -4px;
    right: -4px;
    top: -4px;
    bottom: -4px;
    width: auto;
    height: auto;
    opacity: 0.98;
}

.ps-selected > .ps-management-selection-corners {
    display: flex;
}

.ps-management-detail-corner {
    position: absolute;
    left: -10px;
    bottom: -10px;
    width: 164px;
    height: 164px;
    opacity: 0.95;
}

/* ===== Management shell: vault and role ledger ===== */

.ps-management-v3 .ps-mgmt-shade {
    background-color: rgba(5, 4, 17, 0.56);
}

.ps-management-v3 .ps-layer-content {
    padding: 0;
}

.ps-management-v3 .ps-mgmt-header {
    min-height: 104px;
    height: 104px;
    margin-bottom: 0;
    padding-left: 28px;
    padding-right: 30px;
    padding-top: 10px;
}

.ps-management-v3 .ps-mgmt-body {
    padding-left: 30px;
    padding-right: 30px;
    padding-bottom: 22px;
}

.ps-management-v3 .ps-mgmt-column-boundary {
    opacity: 0.92;
}

.ps-management-v3 .ps-mgmt-list-header {
    flex-shrink: 0;
    margin-bottom: 8px;
}

.ps-management-v3 .ps-mgmt-filter-bar {
    min-height: 54px;
    align-items: center;
}

.ps-management-v3 .ps-mgmt-filter {
    min-height: 48px;
    min-width: 110px;
    margin-right: 8px;
    padding-left: 8px;
    padding-right: 15px;
    color: rgb(215, 201, 182);
    background-color: rgba(10, 7, 28, 0.26);
    border-bottom-width: 1px;
    border-bottom-color: rgba(190, 142, 92, 0.45);
}

.ps-management-v3 .ps-mgmt-filter.ps-selected {
    color: rgb(255, 223, 154);
    background-color: rgba(77, 13, 55, 0.62);
    border-bottom-width: 2px;
    border-bottom-color: rgb(83, 229, 255);
}

.ps-management-v3 .ps-management-detail-corner {
    left: -8px;
    bottom: -6px;
}

/* Vault: collection grid is the broad browsing field; the selected item owns the right. */

.ps-vault-v2.ps-management-v3 .ps-vault-inventory-column {
    flex-basis: 57%;
    width: 57%;
    max-width: 59%;
    min-width: 0;
    margin-right: 24px;
    padding-right: 22px;
}

.ps-vault-v2.ps-management-v3 .ps-vault-item-detail-column {
    flex-basis: 43%;
    width: 43%;
    max-width: 45%;
    min-width: 0;
}

.ps-vault-v2.ps-management-v3 .ps-vault-inventory-surface,
.ps-vault-v2.ps-management-v3 .ps-vault-item-detail-surface {
    background-color: rgba(6, 5, 21, 0.34);
}

.ps-vault-v2.ps-management-v3 .ps-vault-inventory-surface {
    padding: 12px 12px 10px 14px;
}

.ps-vault-v2.ps-management-v3 .ps-vault-item-detail-surface {
    padding: 12px 20px 16px 22px;
    border-left-width: 1px;
    border-left-color: rgba(81, 229, 255, 0.72);
}

.ps-vault-v2.ps-management-v3 .ps-vault-grid {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    padding-top: 8px;
}

.ps-vault-v2.ps-management-v3 .ps-vault-grid-card {
    position: relative;
    width: 22.8%;
    min-width: 112px;
    height: 148px;
    min-height: 148px;
    margin-right: 2.1%;
    margin-bottom: 14px;
    padding: 8px;
    background-color: rgba(8, 6, 25, 0.68);
    border-width: 1px;
    border-color: rgba(194, 149, 93, 0.48);
    overflow: visible;
}

.ps-vault-v2.ps-management-v3 .ps-vault-grid-card:hover {
    background-color: rgba(42, 17, 60, 0.88);
    border-color: rgba(236, 104, 175, 0.84);
}

.ps-vault-v2.ps-management-v3 .ps-vault-grid-card.ps-selected {
    background-color: rgba(62, 13, 54, 0.88);
    border-color: rgba(255, 105, 177, 0.95);
}

.ps-vault-v2.ps-management-v3 .ps-vault-grid-art {
    width: 100%;
    height: 106px;
    min-height: 106px;
    margin-bottom: 4px;
    background-color: rgba(3, 3, 15, 0.7);
}

.ps-vault-v2.ps-management-v3 .ps-vault-grid-image {
    width: 94%;
    height: 94%;
}

.ps-vault-v2.ps-management-v3 .ps-vault-grid-name {
    color: rgb(235, 219, 190);
    font-size: 13px;
    -unity-text-align: middle-center;
}

.ps-vault-v2.ps-management-v3 .ps-vault-item-header {
    min-height: 330px;
    height: 43%;
    max-height: 390px;
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
    background-color: rgba(3, 3, 16, 0.32);
}

.ps-vault-v2.ps-management-v3 .ps-mgmt-detail-art-host {
    width: 52%;
    height: 100%;
    min-height: 290px;
    margin-right: 18px;
}

.ps-vault-v2.ps-management-v3 .ps-mgmt-detail-art-frame {
    width: 100%;
    height: 100%;
}

.ps-vault-v2.ps-management-v3 .ps-mgmt-detail-art-image {
    width: 96%;
    height: 96%;
}

.ps-vault-v2.ps-management-v3 .ps-mgmt-detail-summary-host {
    width: 48%;
    justify-content: center;
    padding-right: 12px;
}

.ps-vault-v2.ps-management-v3 .ps-mgmt-detail-summary-host .ps-title {
    color: rgb(255, 218, 144);
    font-size: 27px;
}

.ps-vault-v2.ps-management-v3 .ps-vault-item-detail-scroll {
    border-top-width: 1px;
    border-top-color: rgba(214, 143, 85, 0.58);
    padding-top: 10px;
}

/* Status: portrait / learned roles / role identity. */

.ps-status-v2.ps-management-v3 .ps-status-character-column {
    flex-basis: 29%;
    width: 29%;
    max-width: 30%;
    margin-right: 18px;
    padding-right: 16px;
}

.ps-status-v2.ps-management-v3 .ps-status-roles-column {
    flex-basis: 31%;
    width: 31%;
    max-width: 32%;
    margin-right: 20px;
    padding-right: 18px;
}

.ps-status-v2.ps-management-v3 .ps-status-role-detail-column {
    flex-basis: 40%;
    width: 40%;
    max-width: 43%;
}

.ps-status-v2.ps-management-v3 .ps-status-character-surface,
.ps-status-v2.ps-management-v3 .ps-status-roles-surface,
.ps-status-v2.ps-management-v3 .ps-status-role-detail-surface {
    background-color: rgba(5, 4, 20, 0.31);
}

.ps-status-v2.ps-management-v3 .ps-status-character-surface {
    padding: 6px 12px 10px 8px;
}

.ps-status-v2.ps-management-v3 .ps-status-role-detail-surface {
    border-left-width: 1px;
    border-left-color: rgba(82, 230, 255, 0.74);
    padding: 4px 18px 12px 20px;
}

.ps-status-v2.ps-management-v3 .ps-status-character-art {
    height: 420px;
    min-height: 340px;
    max-height: 58%;
    background-color: rgba(6, 4, 22, 0.16);
}

.ps-status-v2.ps-management-v3 .ps-status-character-art-image {
    width: 106%;
    height: 106%;
}

.ps-status-v2.ps-management-v3 .ps-status-role-ticket {
    position: relative;
    min-height: 84px;
    margin-bottom: 10px;
    padding: 8px 12px 8px 12px;
    background-color: rgba(13, 9, 34, 0.67);
    border-left-width: 2px;
    border-left-color: rgba(213, 142, 89, 0.66);
    border-bottom-width: 1px;
    border-bottom-color: rgba(213, 142, 89, 0.33);
}

.ps-status-v2.ps-management-v3 .ps-status-role-ticket:hover {
    background-color: rgba(47, 20, 62, 0.84);
    border-left-color: rgb(235, 104, 174);
}

.ps-status-v2.ps-management-v3 .ps-status-role-ticket.ps-selected {
    background-color: rgba(78, 14, 56, 0.88);
    border-left-width: 4px;
    border-left-color: rgb(255, 90, 161);
    border-bottom-color: rgb(78, 229, 255);
}

.ps-status-v2.ps-management-v3 .ps-status-role-kind-icon {
    width: 58px;
    height: 58px;
    margin-right: 10px;
}

.ps-status-v2.ps-management-v3 .ps-status-role-ticket-name {
    color: rgb(246, 218, 170);
    font-size: 20px;
}

.ps-status-v2.ps-management-v3 .ps-status-role-ticket-lv {
    color: rgb(255, 124, 178);
    font-size: 16px;
}

.ps-status-v2.ps-management-v3 .ps-status-detail-header {
    min-height: 315px;
    height: 41%;
    max-height: 360px;
    margin-bottom: 10px;
    background-color: rgba(4, 4, 18, 0.28);
}

.ps-status-v2.ps-management-v3 .ps-status-role-image {
    width: 52%;
    height: 100%;
    min-height: 280px;
}

.ps-status-v2.ps-management-v3 .ps-status-role-identity {
    width: 48%;
    padding-left: 16px;
    justify-content: center;
}

.ps-status-v2.ps-management-v3 .ps-status-role-detail-name {
    color: rgb(255, 112, 176);
    font-size: 32px;
}

.ps-status-v2.ps-management-v3 .ps-status-role-detail-meta {
    color: rgb(239, 213, 161);
    font-size: 17px;
}

.ps-status-v2.ps-management-v3 .ps-status-role-detail-scroll {
    border-top-width: 1px;
    border-top-color: rgba(210, 142, 84, 0.5);
    padding-top: 9px;
}

/* ===== Packing forge ===== */

.ps-rite-v3 {
    -unity-font-definition: resource("Fonts/KaiseiDecol-Regular");
}

.ps-rite-v3 .ps-rite-scene-shade {
    background-color: rgba(6, 4, 18, 0.48);
}

.ps-rite-v3 .ps-rite-top {
    height: 88px;
    min-height: 88px;
    margin: 0;
    padding: 5px 22px 6px 20px;
    background-color: rgba(6, 4, 21, 0.72);
    border-bottom-width: 1px;
    border-bottom-color: rgba(225, 91, 159, 0.68);
}

.ps-rite-v3 .ps-rite-brand {
    min-height: 76px;
    align-items: center;
}

.ps-rite-v3 .ps-rite-brand-mark {
    width: 76px;
    height: 76px;
    margin-right: 4px;
    background-color: rgba(255, 255, 255, 0);
}

.ps-rite-v3 .ps-rite-top-title {
    min-width: 250px;
}

.ps-rite-v3 .ps-rite-top-eyebrow {
    color: rgb(228, 175, 117);
    font-size: 11px;
    letter-spacing: 2px;
}

.ps-rite-v3 .ps-rite-top-name {
    color: rgb(255, 185, 151);
    font-size: 30px;
    letter-spacing: 3px;
}

.ps-rite-v3 .ps-rite-top-sub {
    color: rgba(224, 201, 176, 0.78);
    font-size: 11px;
}

.ps-rite-v3 .ps-rite-body {
    padding: 12px 18px 16px 18px;
}

.ps-rite-v3 .ps-rite-left {
    width: 27%;
    min-width: 270px;
    max-width: 410px;
    padding: 10px 12px 10px 10px;
    margin-right: 12px;
    background-color: rgba(6, 5, 20, 0.48);
    border-left-width: 1px;
    border-left-color: rgba(82, 229, 255, 0.7);
}

.ps-rite-v3 .ps-rite-center {
    width: 45%;
    flex-grow: 1;
    min-width: 420px;
    margin-left: 0;
    margin-right: 12px;
    padding-left: 8px;
    padding-right: 8px;
}

.ps-rite-v3 .ps-rite-right-shell {
    width: 28%;
    min-width: 280px;
    max-width: 430px;
    background-color: rgba(9, 5, 25, 0.48);
    border-left-width: 1px;
    border-left-color: rgba(82, 229, 255, 0.72);
}

.ps-rite-v3 .ps-rite-right {
    padding: 12px 16px 16px 20px;
}

.ps-rite-v3 .ps-rite-filters {
    min-height: 54px;
    align-items: center;
    margin-bottom: 8px;
}

.ps-rite-v3 .ps-rite-filter {
    min-height: 48px;
    min-width: 54px;
    padding: 4px 6px;
    margin-right: 5px;
    background-color: rgba(10, 7, 28, 0.38);
    border-bottom-width: 1px;
    border-bottom-color: rgba(194, 143, 86, 0.42);
}

.ps-rite-v3 .ps-rite-filter.ps-selected {
    background-color: rgba(72, 13, 58, 0.76);
    border-bottom-width: 2px;
    border-bottom-color: rgb(78, 229, 255);
}

.ps-rite-v3 .ps-rite-equip-tile {
    min-height: 114px;
    margin-right: 1.4%;
    margin-bottom: 10px;
    padding: 5px;
    background-color: rgba(7, 5, 21, 0.72);
    border-color: rgba(203, 151, 91, 0.52);
}

.ps-rite-v3 .ps-rite-equip-tile:hover {
    background-color: rgba(43, 17, 60, 0.88);
    border-color: rgba(240, 92, 170, 0.88);
}

.ps-rite-v3 .ps-rite-kiln {
    background-color: rgba(8, 5, 22, 0.48);
    border-color: rgba(211, 145, 89, 0.48);
}

.ps-rite-v3 .ps-rite-kiln-rail {
    min-height: 70px;
    background-color: rgba(7, 5, 20, 0.72);
    border-top-width: 1px;
    border-top-color: rgba(220, 104, 165, 0.65);
}

.ps-rite-v3 .ps-rite-tool {
    min-height: 54px;
    min-width: 112px;
    color: rgb(241, 216, 176);
    background-color: rgba(21, 10, 39, 0.86);
    border-color: rgba(206, 145, 89, 0.66);
}

.ps-rite-v3 .ps-rite-tool-primary {
    background-color: rgba(98, 13, 54, 0.9);
    border-color: rgb(255, 94, 159);
}

.ps-rite-v3 .ps-rite-detail-card,
.ps-rite-v3 .ps-rite-template {
    background-color: rgba(7, 5, 22, 0.46);
    border-left-width: 2px;
    border-left-color: rgba(82, 229, 255, 0.72);
}

.ps-rite-v3 .ps-rite-save,
.ps-rite-v3 .ps-rite-template-decide {
    color: rgb(255, 222, 161);
    background-color: rgba(105, 15, 58, 0.92);
    border-color: rgb(255, 91, 159);
}

.ps-rite-v3 .ps-management-detail-corner {
    left: -8px;
    bottom: -8px;
}

/* ===== Demon shop ===== */

.ps-shop-v3 .ps-mgmt-shade {
    background-color: rgba(5, 4, 16, 0.58);
}

.ps-shop-v3 .ps-layer-content {
    padding: 0;
}

.ps-shop-v3 .ps-shop-header {
    height: 104px;
    min-height: 104px;
    padding-left: 26px;
    padding-right: 28px;
    padding-top: 9px;
    padding-bottom: 0;
}

.ps-shop-v3 .ps-shop-body {
    padding-left: 18px;
    padding-right: 20px;
    padding-bottom: 18px;
}

.ps-shop-v3 .ps-shop-col-merchant {
    width: 30%;
    min-width: 290px;
    flex-grow: 0;
    margin-right: 16px;
}

.ps-shop-v3 .ps-shop-col-list {
    width: 38%;
    min-width: 360px;
    flex-grow: 1;
    padding-right: 16px;
    margin-right: 14px;
    border-right-width: 1px;
    border-right-color: rgba(80, 228, 255, 0.72);
}

.ps-shop-v3 .ps-shop-col-detail {
    width: 32%;
    min-width: 330px;
    flex-grow: 0;
    padding-right: 0;
}

.ps-shop-v3 .ps-shop-merchant-scene {
    background-color: rgba(7, 4, 20, 0.28);
    border-right-width: 1px;
    border-right-color: rgba(213, 147, 88, 0.5);
}

.ps-shop-v3 .ps-shop-merchant-dialogue-layer {
    left: 5%;
    right: 5%;
    top: 9%;
    bottom: auto;
    min-height: 82px;
}

.ps-shop-v3 .ps-shop-merchant-dialogue {
    color: rgb(255, 224, 170);
    font-size: 18px;
    background-color: rgba(8, 5, 22, 0.85);
    border-color: rgba(231, 102, 165, 0.75);
}

.ps-shop-v3 .ps-shop-filter-host {
    min-height: 58px;
    align-items: center;
    justify-content: center;
    margin-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(210, 145, 88, 0.48);
}

.ps-shop-v3 .ps-shop-filter {
    min-width: 72px;
    min-height: 52px;
    margin-right: 7px;
    padding: 4px 9px;
    color: rgb(227, 207, 180);
    background-color: rgba(10, 7, 27, 0.3);
    border-bottom-width: 1px;
    border-bottom-color: rgba(181, 129, 80, 0.35);
}

.ps-shop-v3 .ps-shop-filter.ps-selected {
    color: rgb(255, 226, 163);
    background-color: rgba(76, 13, 57, 0.76);
    border-bottom-width: 2px;
    border-bottom-color: rgb(76, 229, 255);
}

.ps-shop-v3 .ps-shop-product-scroll {
    background-color: rgba(5, 4, 20, 0.34);
    padding: 10px;
}

.ps-shop-v3 .ps-shop-product-grid {
    justify-content: center;
}

.ps-shop-v3 .ps-shop-product-card {
    position: relative;
    width: 46%;
    height: 176px;
    min-height: 176px;
    margin-right: 3%;
    margin-bottom: 14px;
    padding: 9px;
    background-color: rgba(9, 6, 24, 0.78);
    border-width: 1px;
    border-color: rgba(205, 151, 91, 0.52);
    overflow: visible;
}

.ps-shop-v3 .ps-shop-product-card:hover {
    background-color: rgba(48, 17, 58, 0.9);
    border-color: rgba(244, 94, 169, 0.88);
}

.ps-shop-v3 .ps-shop-product-card.ps-selected {
    background-color: rgba(83, 14, 51, 0.9);
    border-color: rgb(255, 94, 161);
}

.ps-shop-v3 .ps-shop-product-art {
    width: 100%;
    height: 132px;
    margin-bottom: 5px;
    background-color: rgba(3, 3, 14, 0.68);
}

.ps-shop-v3 .ps-shop-product-image {
    width: 94%;
    height: 94%;
}

.ps-shop-v3 .ps-shop-product-price {
    color: rgb(255, 216, 136);
    font-size: 16px;
}

.ps-shop-v3 .ps-shop-detail-host {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    padding: 14px 16px 10px 20px;
    background-color: rgba(5, 4, 20, 0.52);
    border-left-width: 1px;
    border-left-color: rgba(80, 229, 255, 0.72);
}

.ps-shop-v3 .ps-shop-detail-art {
    height: 230px;
    min-height: 210px;
    margin-bottom: 10px;
    background-color: rgba(3, 3, 14, 0.38);
}

.ps-shop-v3 .ps-shop-detail-image {
    width: 90%;
    height: 90%;
}

.ps-shop-v3 .ps-shop-detail-scroll > .ps-title {
    color: rgb(255, 219, 146);
    font-size: 27px;
    margin-bottom: 12px;
}

.ps-shop-v3 .ps-shop-detail-block {
    margin-bottom: 8px;
    padding-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(205, 143, 85, 0.35);
}

.ps-shop-v3 .ps-shop-detail-label {
    color: rgb(255, 101, 170);
    font-size: 13px;
}

.ps-shop-v3 .ps-shop-detail-body {
    color: rgb(237, 219, 190);
    font-size: 14px;
}

.ps-shop-v3 .ps-shop-merchant-transaction-layer {
    position: relative;
    left: auto;
    right: auto;
    top: auto;
    bottom: auto;
    width: 100%;
    min-height: 174px;
    flex-shrink: 0;
    margin-top: 10px;
    padding: 12px 14px 10px 18px;
    background-color: rgba(8, 5, 22, 0.86);
    border-top-width: 1px;
    border-top-color: rgba(215, 147, 88, 0.64);
}

.ps-shop-v3 .ps-shop-tx-name {
    color: rgb(255, 220, 151);
    font-size: 18px;
}

.ps-shop-v3 .ps-shop-tx-gold,
.ps-shop-v3 .ps-shop-tx-total {
    color: rgb(234, 210, 178);
    font-size: 14px;
}

.ps-shop-v3 .ps-shop-tx-actions {
    margin-top: auto;
}

.ps-shop-v3 .ps-shop-buy-btn {
    min-height: 56px;
    color: rgb(255, 224, 166);
    font-size: 20px;
    background-color: rgba(115, 14, 55, 0.94);
    border-color: rgb(255, 92, 156);
}

.ps-shop-v3 .ps-shop-leave-btn {
    min-height: 44px;
}

.ps-shop-v3 .ps-management-detail-corner {
    left: -7px;
    bottom: -7px;
}

/* ===== Management V4 authored surfaces
   These rules replace generic panels and controls with page-specific art. ===== */

.ps-nav-visible .ps-nav-back {
    width: 126px;
    height: 54px;
    min-width: 126px;
    min-height: 54px;
    padding-left: 13px;
    padding-right: 20px;
