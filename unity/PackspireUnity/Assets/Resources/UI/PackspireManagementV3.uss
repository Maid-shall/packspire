    padding: 0;
    border-width: 0;
    border-radius: 29px;
    background-color: rgba(0, 0, 0, 0);
    background-image: resource("UI/Generated/VaultLockButton");
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0.72;
    scale: 0.94 0.94 1;
}

.ps-vault-v9.ps-management-v3 .ps-vault-v9-lock-action:hover {
    opacity: 0.94;
    scale: 1 1 1;
}

.ps-vault-v9.ps-management-v3 .ps-vault-v9-lock-action:active {
    opacity: 1;
    scale: 0.91 0.91 1;
}

.ps-vault-v9.ps-management-v3 .ps-vault-v9-lock-action.ps-locked {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    opacity: 1;
    scale: 1 1 1;
}

/* Vault V13: coherent category tabs. */
.ps-vault-v9.ps-management-v3 .ps-vault-v7-category-bar {
    height: 58px;
    min-height: 58px;
    max-height: 58px;
    padding: 3px 3px 4px 3px;
    background-color: rgba(2, 2, 13, 0.88);
    border-bottom-width: 1px;
    border-bottom-color: rgba(194, 132, 71, 0.72);
}

.ps-vault-v9.ps-management-v3 .ps-vault-v7-category {
    height: 50px;
    min-height: 50px;
    max-height: 50px;
    margin: 0 2px;
    padding: 2px 3px 3px 3px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-image: none;
    background-color: rgba(8, 6, 23, 0.94);
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(151, 98, 57, 0.56);
}

.ps-vault-v9.ps-management-v3 .ps-vault-v7-category:hover {
    background-color: rgba(35, 9, 39, 0.96);
    border-bottom-color: rgba(239, 87, 148, 0.92);
}

.ps-vault-v9.ps-management-v3 .ps-vault-v7-category.ps-selected {
    background-color: rgba(92, 10, 55, 0.96);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-left-color: rgba(249, 80, 151, 0.76);
    border-right-color: rgba(249, 80, 151, 0.76);
    border-top-color: rgba(249, 80, 151, 0.76);
    border-bottom-width: 3px;
    border-bottom-color: rgb(57, 226, 240);
}

.ps-vault-v9.ps-management-v3 .ps-vault-v7-category-icon,
.ps-vault-v9.ps-management-v3 .ps-vault-v7-category .ps-management-filter-medallion {
    width: 29px;
    min-width: 29px;
    max-width: 29px;
    height: 29px;
    min-height: 29px;
    max-height: 29px;
    margin: 0;
    flex-grow: 0;
    flex-shrink: 0;
}

.ps-vault-v9.ps-management-v3 .ps-vault-v7-category-label {
    height: 16px;
    min-height: 16px;
    margin: 0;
    color: rgb(223, 199, 165);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.ps-vault-v9.ps-management-v3 .ps-vault-v7-category.ps-selected .ps-vault-v7-category-label {
    color: rgb(255, 234, 191);
}

.ps-vault-v9.ps-management-v3 .ps-vault-v7-category-glow {
    position: absolute;
    left: 22%;
    right: 22%;
    bottom: -2px;
    height: 2px;
    background-color: rgba(0, 0, 0, 0);
}

.ps-vault-v9.ps-management-v3 .ps-vault-v7-category.ps-selected .ps-vault-v7-category-glow {
    background-color: rgb(66, 230, 242);
}

/* DropdownField opens its menu at panel root, so the popup must be styled globally. */
.unity-base-dropdown__container-outer,
.unity-generic-dropdown-menu__container-outer {
    padding: 4px;
    background-color: rgb(2, 2, 10);
    border-width: 1px;
    border-color: rgb(192, 128, 67);
}

.unity-base-dropdown__container-inner,
.unity-generic-dropdown-menu__container-inner {
    padding: 3px;
    background-color: rgb(3, 3, 14);
}

.unity-base-dropdown__item,
.unity-generic-dropdown-menu__item {
    height: 34px;
    min-height: 34px;
    padding: 5px 12px;
    color: rgb(246, 221, 182);
    font-size: 14px;
    background-color: rgb(5, 4, 17);
    border-bottom-width: 1px;
    border-bottom-color: rgba(121, 81, 52, 0.58);
}

.unity-base-dropdown__item:hover,
.unity-generic-dropdown-menu__item:hover {
    color: rgb(255, 241, 204);
    background-color: rgb(82, 10, 52);
    border-left-width: 2px;
    border-left-color: rgb(248, 74, 145);
}

.unity-base-dropdown__label,
.unity-generic-dropdown-menu__label {
    color: rgb(246, 221, 182);
    font-size: 14px;
    -unity-font-style: bold;
}

.unity-base-dropdown__checkmark,
.unity-generic-dropdown-menu__checkmark {
    color: rgb(65, 225, 239);
}
