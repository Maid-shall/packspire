/* ========================================================================
   Vault V7 — reference composition
   55% catalogue | 22% selected-item showcase | 23% product record.
   Scoped to Vault so the other management screens remain untouched.
   ======================================================================== */

.ps-vault-v7.ps-management-v3 .ps-mgmt-shade {
    background-color: rgba(2, 2, 15, 0.72);
}

.ps-vault-v7.ps-management-v3 .ps-mgmt-header {
    height: 88px;
    min-height: 88px;
    padding: 4px 30px 2px 30px;
    background-color: rgba(2, 2, 15, 0.82);
}

.ps-vault-v7.ps-management-v3 .ps-mgmt-body {
    position: absolute;
    left: 25px;
    right: 25px;
    top: 94px;
    bottom: 15px;
    min-height: 0;
    padding: 0;
    flex-direction: row;
    align-items: stretch;
}

.ps-vault-v7.ps-management-v3 .ps-vault-inventory-column {
    position: relative;
    width: 53%;
    min-width: 53%;
    max-width: 53%;
    flex-basis: 53%;
    margin: 0;
    padding: 0 20px 0 8px;
    border-right-width: 1px;
    border-right-color: rgba(194, 139, 76, 0.60);
    background-color: rgba(5, 4, 22, 0.70);
}

.ps-vault-v7.ps-management-v3 .ps-vault-inventory-column > .ps-mgmt-column-boundary {
    display: none;
}

.ps-vault-v7.ps-management-v3 .ps-vault-inventory-header {
