/* Vault V10: persistent protection badge, compact occupied-shape readout,
   and one dedicated protection action. Keep this at true EOF so legacy
   management selectors cannot restore the retired comparison layout. */
.ps-vault-v9.ps-management-v3 .ps-vault-grid-art {
    position: relative;
}

.ps-vault-v9.ps-management-v3 .ps-vault-grid-lock {
