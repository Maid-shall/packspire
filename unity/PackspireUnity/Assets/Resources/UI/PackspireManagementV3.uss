/* ==========================================================================
   Reference adoption V5
   The four approved mockups are now the layout authority. Large stretched
   "page frame" textures are intentionally removed; decoration belongs to
   individual tickets, products, actions, and the thin column dividers.
   ========================================================================== */

.ps-management-v3 .ps-mgmt-header,
.ps-shop-v3 .ps-shop-header {
    height: 108px;
    min-height: 108px;
    padding: 15px 38px 9px 42px;
    background-color: rgba(3, 3, 17, 0.72);
    border-bottom-width: 0;
}

.ps-management-v3 .ps-mgmt-body {
    padding: 8px 38px 23px 38px;
}

.ps-management-v3 .ps-mgmt-column-boundary,
.ps-shop-v3 .ps-shop-column-boundary,
.ps-rite-v3 .ps-rite-column-boundary {
    display: flex;
    position: absolute;
    top: 1%;
    right: -18px;
    bottom: 1%;
    width: 34px;
    height: 98%;
    opacity: 0.92;
    background-image: resource("Art/UI/PopDark/ManagementV5/detail-divider-cropped");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 12;
