    -unity-slice-right: 62;
    -unity-slice-top: 148;
    -unity-slice-bottom: 76;
}

.ps-vault-v2.ps-management-v3 .ps-vault-item-detail-surface,
.ps-rite-v3 .ps-rite-right-shell,
.ps-shop-v3 .ps-shop-detail-host {
    -unity-slice-left: 78;
    -unity-slice-right: 238;
    -unity-slice-top: 74;
    -unity-slice-bottom: 174;
}

.ps-status-v2.ps-management-v3 .ps-status-role-detail-surface {
    -unity-slice-left: 78;
    -unity-slice-right: 78;
    -unity-slice-top: 72;
    -unity-slice-bottom: 126;
}

.ps-shop-v3 .ps-shop-product-scroll,
.ps-shop-v3 .ps-shop-merchant-transaction-layer {
    -unity-slice-left: 78;
    -unity-slice-right: 78;
    -unity-slice-top: 80;
    -unity-slice-bottom: 132;
}

