    min-height: 124px;
    padding: 7px 8px 3px 8px;
    background-color: rgba(3, 3, 18, 0.42);
}

.ps-vault-v7.ps-management-v3 .ps-vault-inventory-header .ps-section-heading {
    min-height: 24px;
    margin-bottom: 2px;
}

.ps-vault-v7.ps-management-v3 .ps-vault-v7-category-bar {
    height: 65px;
    min-height: 65px;
    flex-direction: row;
    align-items: stretch;
    justify-content: space-between;
    margin-top: 1px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(194, 139, 76, 0.66);
}

.ps-vault-v7.ps-management-v3 .ps-vault-v7-category {
    position: relative;
    width: 19%;
    min-width: 19%;
    height: 62px;
    min-height: 62px;
    margin: 0;
    padding: 1px 2px 15px 2px;
    align-items: center;
    justify-content: center;
    color: rgb(226, 200, 160);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.ps-vault-v7.ps-management-v3 .ps-vault-v7-category:hover {
    background-color: rgba(51, 15, 55, 0.36);
}

.ps-vault-v7.ps-management-v3 .ps-vault-v7-category.ps-selected {
    color: rgb(255, 231, 177);
    background-color: rgba(87, 13, 57, 0.44);
}

.ps-vault-v7.ps-management-v3 .ps-vault-v7-category-icon {
    width: 39px;
    height: 39px;
    min-width: 39px;
    min-height: 39px;
    -unity-background-scale-mode: scale-to-fit;
}

.ps-vault-v7.ps-management-v3 .ps-vault-v7-category-label {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2px;
    height: 17px;
    color: rgb(232, 207, 169);
    font-size: 13px;
    -unity-text-align: middle-center;
}

.ps-vault-v7.ps-management-v3 .ps-vault-v7-category-glow {
    display: none;
    position: absolute;
    left: 12%;
    right: 12%;
    bottom: -1px;
    height: 3px;
    background-color: rgb(54, 226, 247);
}

.ps-vault-v7.ps-management-v3 .ps-vault-v7-category.ps-selected .ps-vault-v7-category-glow {
    display: flex;
}

.ps-vault-v7.ps-management-v3 .ps-vault-v7-context {
    height: 23px;
    min-height: 23px;
    margin: 1px 0 0 2px;
    color: rgba(231, 214, 191, 0.82);
    font-size: 13px;
}

.ps-vault-v7.ps-management-v3 .ps-vault-inventory-surface {
