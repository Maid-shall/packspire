}

.ps-vault-card-modal {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(3, 2, 13, 0.78);
}

.ps-vault-card-modal-stage {
    width: 360px;
    min-width: 360px;
    max-width: 360px;
    height: 570px;
    min-height: 570px;
    max-height: 570px;
    padding: 14px 22px 12px 22px;
    align-items: center;
    justify-content: center;
    background-color: rgba(9, 6, 29, 0.94);
    border-width: 1px;
    border-left-color: rgba(255, 74, 150, 0.78);
    border-right-color: rgba(65, 224, 239, 0.54);
    border-top-color: rgba(208, 151, 75, 0.62);
    border-bottom-color: rgba(208, 151, 75, 0.62);
    border-radius: 22px;
}

.ps-vault-card-modal-heading {
    height: 34px;
    min-height: 34px;
    color: rgb(255, 224, 166);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.ps-vault-card-modal-face {
    flex-grow: 0;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
}

.ps-vault-card-modal-face .ps-vault-v9-card {
    width: 294px;
    min-width: 294px;
    max-width: 294px;
    height: 430px;
    min-height: 430px;
    max-height: 430px;
    margin: 4px 0;
    translate: 0 0;
    scale: 1 1 1;
}

.ps-vault-card-modal-face .ps-vault-v9-card:hover,
.ps-vault-card-modal-face .ps-vault-v9-card.ps-demon-card:hover {
