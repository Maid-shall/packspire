    align-items: center;
    background-image: resource("Art/UI/ObsidianMisprintShared/misprint-decor-brush-underline-v1");
    -unity-background-scale-mode: stretch-to-fill;
}

.ps-vault-fixed__name {
    min-width: 0;
    margin: 0;
    padding: 0;
    color: rgb(251, 221, 169);
    font-size: 27px;
    -unity-font-definition: resource("Fonts/NotoSerifJP-VF");
