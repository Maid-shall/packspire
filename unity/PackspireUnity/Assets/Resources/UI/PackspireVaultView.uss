}

.ps-vault-fixed__shape-cell.ps-element-fire {
    -unity-background-image-tint-color: rgb(255, 103, 91);
}

.ps-vault-fixed__shape-cell.ps-element-water {
    -unity-background-image-tint-color: rgb(77, 218, 239);
}

.ps-vault-fixed__shape-cell.ps-element-wind {
    -unity-background-image-tint-color: rgb(89, 224, 157);
}

.ps-vault-fixed__shape-cell.ps-element-earth {
