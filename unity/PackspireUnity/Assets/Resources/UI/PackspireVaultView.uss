}

.ps-vault-fixed__actions .ps-vault-v9-lock-action:hover,
.ps-vault-fixed__actions .ps-vault-v9-lock-action:focus {
    opacity: 0.72;
}

.ps-vault-fixed__actions .ps-vault-v9-lock-action.ps-locked {
    opacity: 1;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.ps-vault-fixed__actions .ps-vault-v16-next-item {
    background-image: resource("Art/UI/PopDark/VaultCodexV3/round-next");
}

.ps-vault-fixed__empty-detail .ps-empty-state {
    width: 360px;
}
