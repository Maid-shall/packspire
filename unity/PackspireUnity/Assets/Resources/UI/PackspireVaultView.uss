    height: 112px;
    overflow: hidden;
}

.ps-vault-fixed__effect-slot--color {
    top: 322px;
}

.ps-vault-fixed__effect-slot--link {
    top: 438px;
}

.ps-vault-fixed__effect {
    width: 414px;
    height: 112px;
    min-height: 112px;
    max-height: 112px;
    margin: 0;
    padding: 15px 92px 10px 22px;
