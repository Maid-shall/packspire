    overflow: visible;
}

.ps-vault-fixed__card-host .ps-battle-card {
    position: relative;
    left: 0;
    top: 0;
    margin: 0;
    translate: 0 0;
    scale: 1 1;
}

.ps-vault-fixed__card-host .ps-battle-card:hover,
.ps-vault-fixed__card-host .ps-battle-card.ps-demon-card:hover {
    translate: 0 0;
    scale: 1 1;
}

.ps-vault-fixed__effect-slot {
