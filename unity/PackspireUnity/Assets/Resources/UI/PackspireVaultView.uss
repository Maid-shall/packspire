}

.ps-vault-fixed__actions .ps-vault-v9-lock-action,
.ps-vault-fixed__actions .ps-vault-v16-next-item {
    position: relative;
    left: auto;
    right: auto;
    top: auto;
    bottom: auto;
    width: 52px;
    min-width: 52px;
    max-width: 52px;
    height: 52px;
    min-height: 52px;
    max-height: 52px;
    margin: 0 0 0 8px;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
