/* Vault presentation isolated from the legacy management cascade.
 * All dimensions use the 1280 x 720 logical PanelSettings coordinate system.
 */

.ps-vault-fixed {
    position: absolute;
    left: 0;
    top: 0;
    width: 1280px;
    height: 720px;
    overflow: hidden;
    background-color: rgb(8, 9, 9);
    color: rgb(224, 199, 158);
    -unity-font-definition: resource("Fonts/KleeOne-SemiBold");
}

.ps-vault-fixed__layout {
    position: absolute;
    left: 0;
    top: 0;
    width: 1280px;
    height: 720px;
    overflow: hidden;
}

.ps-vault-fixed__background,
.ps-vault-fixed__shade {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.ps-vault-fixed__background {
    background-image: resource("Art/UI/ObsidianMisprintShared/misprint-background-archive-v1");
    -unity-background-scale-mode: scale-and-crop;
}

.ps-vault-fixed__shade {
    background-color: rgba(2, 4, 5, 0.22);
}

.ps-vault-fixed__ledger-spine,
.ps-vault-fixed__registration-mark,
.ps-vault-fixed__screen-seal {
    position: absolute;
    -unity-background-scale-mode: scale-to-fit;
}

.ps-vault-fixed__ledger-spine {
    left: 0;
    top: 88px;
    width: 48px;
    height: 520px;
    opacity: 0.18;
    background-image: resource("Art/UI/ObsidianMisprintShared/misprint-decor-ledger-spine-v1");
}

.ps-vault-fixed__registration-mark {
    left: -24px;
    bottom: -26px;
    width: 136px;
    height: 136px;
    opacity: 0.16;
    background-image: resource("Art/UI/ObsidianMisprintShared/misprint-decor-registration-corner-v1");
}

.ps-vault-fixed__screen-seal {
    right: 82px;
    top: 14px;
    width: 48px;
    height: 48px;
    opacity: 0.78;
    background-image: resource("Art/UI/ObsidianMisprint/hub-icon-vault-v1");
}

.ps-vault-fixed__header {
    position: absolute;
    left: 20px;
    top: 8px;
    width: 1240px;
    height: 70px;
    overflow: visible;
}

.ps-vault-fixed__header-flourish {
    position: absolute;
    left: 520px;
    top: 22px;
    width: 680px;
    height: 42px;
    background-image: resource("Art/UI/ObsidianMisprintShared/misprint-decor-long-rule-v1");
    -unity-background-scale-mode: stretch-to-fill;
    opacity: 0.68;
}

.ps-vault-fixed__back-host {
    position: absolute;
    left: 0;
    top: 8px;
    width: 118px;
    height: 44px;
}

.ps-vault-fixed__back {
    width: 118px;
    min-width: 118px;
    height: 42px;
    min-height: 42px;
    margin: 0;
    padding: 3px 12px 3px 8px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    background-color: rgba(0, 0, 0, 0);
    background-image: resource("Art/UI/ObsidianMisprintShared/misprint-surface-index-tab-v1");
    -unity-background-scale-mode: stretch-to-fill;
    border-width: 0;
}

.ps-vault-fixed__back:hover,
.ps-vault-fixed__back:focus {
    -unity-background-image-tint-color: rgb(255, 223, 181);
}

.ps-vault-fixed__back:disabled {
    opacity: 0.45;
}

.ps-vault-fixed__back-icon {
    width: 28px;
    min-width: 28px;
    height: 28px;
    min-height: 28px;
    margin-right: 5px;
}

.ps-vault-fixed__back-label {
    color: rgb(244, 220, 184);
    font-size: 13px;
    -unity-text-align: middle-left;
}

.ps-vault-fixed__brand-host {
    position: absolute;
    left: 132px;
    top: 0;
    width: 390px;
    height: 70px;
    flex-direction: row;
    align-items: center;
}

.ps-vault-fixed__brand-crest {
    width: 58px;
    min-width: 58px;
    height: 58px;
    margin-right: 10px;
    background-image: resource("Art/UI/ObsidianMisprint/hub-icon-vault-v1");
    -unity-background-scale-mode: scale-to-fit;
}

.ps-vault-fixed__brand-copy {
    min-width: 0;
    height: 64px;
    flex-grow: 1;
    justify-content: center;
}

.ps-vault-fixed__brand-eyebrow {
    height: 16px;
    color: rgb(198, 159, 98);
    font-size: 10px;
    white-space: nowrap;
}

.ps-vault-fixed__brand-title {
    height: 42px;
    color: rgb(235, 207, 164);
    font-size: 31px;
    -unity-font-definition: resource("Fonts/NotoSerifJP-VF");
    white-space: nowrap;
}

.ps-vault-fixed__inventory {
    position: absolute;
    left: 24px;
    top: 82px;
    width: 566px;
    height: 624px;
    overflow: hidden;
    background-color: rgba(1, 3, 3, 0.76);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(205, 168, 106, 0.42);
    border-right-color: rgba(205, 168, 106, 0.42);
    border-top-color: rgba(205, 168, 106, 0.56);
    border-bottom-color: rgba(55, 180, 186, 0.42);
}

.ps-vault-fixed__list-header {
    position: absolute;
    left: 0;
    top: 0;
    width: 554px;
    height: 112px;
    padding: 0 8px 2px 8px;
    overflow: hidden;
    background-color: rgba(1, 3, 3, 0.72);
    background-image: resource("Art/UI/ObsidianMisprintShared/misprint-surface-section-a-v1");
    -unity-background-scale-mode: stretch-to-fill;
    border-bottom-width: 1px;
    border-bottom-color: rgba(205, 168, 106, 0.34);
}

.ps-vault-fixed__list-header .ps-section-head,
.ps-vault-fixed__list-header .ps-selective-section-head {
    width: 100%;
    height: 48px;
    min-height: 48px;
    margin: 0;
    padding: 2px 0 0 0;
    align-items: center;
    justify-content: center;
}

.ps-vault-fixed__list-header .ps-section-head .ps-typo-eyebrow {
    display: none;
}

.ps-vault-fixed__list-header .ps-section-head .ps-typo-section {
    width: 100%;
    height: 42px;
    margin: 0;
    color: rgb(235, 207, 164);
    font-size: 19px;
    -unity-font-definition: resource("Fonts/NotoSerifJP-VF");
    -unity-text-align: middle-center;
}

.ps-vault-fixed__list-header .ps-vault-v7-category-bar {
    width: 100%;
    height: 60px;
    min-height: 60px;
    margin: 0;
    padding: 0;
    flex-direction: row;
    flex-wrap: nowrap;
}

.ps-vault-fixed__list-header .ps-vault-v7-category {
    width: 19.2%;
    min-width: 0;
    height: 58px;
    min-height: 58px;
    margin: 0 2px 0 0;
    padding: 5px 8px 3px 8px;
    flex-grow: 1;
    flex-shrink: 1;
    background-color: rgba(0, 0, 0, 0);
    background-image: resource("Art/UI/ObsidianMisprintShared/misprint-surface-index-tab-v1");
    -unity-background-scale-mode: stretch-to-fill;
    border-width: 0;
}

.ps-vault-fixed__list-header .ps-vault-v7-category.ps-selected {
    background-image: resource("Art/UI/ObsidianMisprintShared/misprint-surface-selection-v1");
}

.ps-vault-fixed__list-header .ps-vault-v7-category:hover,
.ps-vault-fixed__list-header .ps-vault-v7-category:focus {
    -unity-background-image-tint-color: rgb(255, 226, 195);
}

.ps-vault-fixed__list-header .ps-vault-v7-category-glow {
    display: none;
}

.ps-vault-fixed__list-header .ps-vault-v7-category-icon,
.ps-vault-fixed__list-header .ps-management-filter-medallion {
    display: none;
}

.ps-vault-fixed__list-header .ps-vault-v7-category-label,
.ps-vault-fixed__list-header .unity-button__text {
    color: rgb(224, 199, 158);
    width: 100%;
    font-size: 13px;
    white-space: nowrap;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

.ps-vault-fixed__list-header .ps-vault-v7-category.ps-selected .ps-vault-v7-category-label {
    color: rgb(31, 24, 19);
    -unity-font-style: normal;
}

.ps-vault-fixed__list-header .ps-vault-v7-context {
    display: none;
}

.ps-vault-fixed__list-surface {
    position: absolute;
    left: 0;
    top: 112px;
    width: 554px;
    height: 464px;
    overflow: hidden;
    background-color: rgba(1, 3, 3, 0.58);
}

.ps-vault-fixed__list-scroll {
    width: 100%;
    height: 100%;
    overflow: hidden;
}

.ps-vault-fixed__list-scroll > .unity-scroll-view__content-and-vertical-scroll-container,
.ps-vault-fixed__list-scroll > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroll-view__content-viewport {
    width: 100%;
    height: 100%;
    overflow: hidden;
}

.ps-vault-fixed__grid {
    width: 100%;
    min-height: 100%;
    padding: 6px 4px 10px 6px;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
}

.ps-vault-fixed__grid .ps-vault-grid-card,
.ps-vault-fixed__grid .ps-vault-grid-card:hover,
.ps-vault-fixed__grid .ps-vault-grid-card:active,
.ps-vault-fixed__grid .ps-vault-grid-card:focus,
.ps-vault-fixed__grid .ps-vault-grid-card.ps-selected {
    position: relative;
    width: 128px;
    min-width: 128px;
    max-width: 128px;
    height: 106px;
    min-height: 106px;
    max-height: 106px;
    margin: 0 8px 8px 0;
    padding: 0;
    flex-grow: 0;
    flex-shrink: 0;
    overflow: visible;
    background-color: rgba(0, 0, 0, 0);
    background-image: resource("Art/UI/ObsidianMisprintShared/misprint-surface-list-v1");
    -unity-background-scale-mode: stretch-to-fill;
    border-width: 0;
}

.ps-vault-fixed__grid .ps-vault-grid-card.ps-selected {
    background-image: resource("Art/UI/ObsidianMisprintShared/misprint-surface-selected-row-v1");
}

.ps-vault-fixed__grid .ps-vault-grid-art {
    position: absolute;
    left: 12px;
    top: 7px;
    width: 104px;
    height: 74px;
    overflow: hidden;
    background-color: rgba(0, 0, 0, 0);
}

.ps-vault-fixed__grid .ps-vault-grid-image {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.ps-vault-fixed__grid .ps-vault-grid-name {
    position: absolute;
    left: 8px;
    right: 8px;
    bottom: 10px;
    height: 18px;
    min-height: 18px;
    padding: 0;
    color: rgb(242, 218, 185);
    font-size: 10px;
    white-space: nowrap;
    -unity-text-align: middle-center;
}

.ps-vault-fixed__grid .ps-vault-grid-rarity {
    position: absolute;
    left: 58px;
    bottom: 2px;
    width: 12px;
    height: 10px;
    font-size: 6px;
    -unity-text-align: middle-center;
}

.ps-vault-fixed__grid .ps-vault-grid-badges {
    position: absolute;
    left: auto;
    right: 2px;
    top: 2px;
    width: auto;
    height: 18px;
    flex-direction: row;
}

.ps-vault-fixed__grid .ps-vault-grid-element {
    position: absolute;
    left: 2px;
    top: 2px;
    width: 20px;
    min-width: 20px;
    height: 20px;
    min-height: 20px;
    align-items: center;
    justify-content: center;
    background-image: resource("Art/UI/PopDark/VaultCodexV3/occupancy-cell-filled");
    -unity-background-scale-mode: scale-to-fit;
}

.ps-vault-fixed__grid .ps-vault-grid-element .unity-label {
    color: rgb(255, 240, 213);
    font-size: 9px;
    -unity-text-align: middle-center;
}

.ps-vault-fixed__grid .ps-vault-grid-element.ps-element-fire {
    -unity-background-image-tint-color: rgb(255, 87, 71);
}

.ps-vault-fixed__grid .ps-vault-grid-element.ps-element-water {
    -unity-background-image-tint-color: rgb(57, 189, 235);
}

.ps-vault-fixed__grid .ps-vault-grid-element.ps-element-wind {
    -unity-background-image-tint-color: rgb(74, 210, 124);
}

.ps-vault-fixed__grid .ps-vault-grid-element.ps-element-earth {
    -unity-background-image-tint-color: rgb(229, 174, 69);
}

.ps-vault-fixed__grid .ps-vault-grid-lock {
    position: absolute;
    display: none;
    right: 3px;
    top: auto;
    bottom: 3px;
    width: 30px;
    height: 30px;
    background-image: resource("Art/UI/PopDark/VaultCodexV3/lock-badge");
    -unity-background-scale-mode: scale-to-fit;
}

.ps-vault-fixed__grid .ps-vault-grid-card.ps-vault-protected .ps-vault-grid-lock {
    display: flex;
}

.ps-vault-fixed__grid .ps-vault-grid-lock-icon {
    display: none;
}

.ps-vault-fixed__grid .ps-vault-grid-badge {
    width: 18px;
    min-width: 18px;
    height: 18px;
    min-height: 18px;
    margin-right: 2px;
    align-items: center;
    justify-content: center;
    background-color: rgba(68, 14, 45, 0.94);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(255, 92, 157);
    border-right-color: rgb(255, 92, 157);
    border-top-color: rgb(255, 92, 157);
    border-bottom-color: rgb(255, 92, 157);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.ps-vault-fixed__grid .ps-vault-grid-badge .unity-label {
    color: rgb(255, 229, 185);
    font-size: 8px;
    -unity-text-align: middle-center;
}

.ps-vault-fixed__footer {
    position: absolute;
    left: 0;
    top: 576px;
    width: 554px;
    height: 48px;
    padding: 6px 8px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgba(1, 3, 3, 0.92);
    background-image: resource("Art/UI/ObsidianMisprintShared/misprint-surface-order-ticket-v1");
    -unity-background-scale-mode: stretch-to-fill;
    border-top-width: 1px;
    border-top-color: rgba(205, 168, 106, 0.42);
}

.ps-vault-fixed__footer .ps-vault-v7-rarity-filter {
    width: 292px;
    min-width: 292px;
    height: 34px;
    min-height: 34px;
    padding: 0 12px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    background-image: resource("Art/UI/ObsidianMisprintShared/misprint-surface-index-tab-v1");
    -unity-background-scale-mode: stretch-to-fill;
    border-width: 0;
}

.ps-vault-fixed__footer .ps-vault-v7-rarity-filter:hover,
.ps-vault-fixed__footer .ps-vault-v7-rarity-filter:focus {
    -unity-background-image-tint-color: rgb(255, 224, 183);
}

.ps-vault-fixed__footer .ps-vault-v8-sort-label {
    width: 62px;
    font-size: 11px;
}

.ps-vault-fixed__footer .ps-vault-v8-sort {
    min-width: 0;
    height: 28px;
    min-height: 28px;
    flex-grow: 1;
    color: rgb(244, 222, 191);
    font-size: 11px;
    -unity-text-align: middle-left;
}

.ps-vault-fixed__footer .ps-vault-v8-sort-arrow {
    width: 16px;
    min-width: 16px;
    color: rgb(214, 176, 118);
    font-size: 9px;
    -unity-text-align: middle-center;
}

.ps-vault-fixed__footer .ps-vault-v7-count {
    width: 86px;
    color: rgb(101, 213, 227);
    font-size: 11px;
    -unity-text-align: middle-right;
}

.ps-vault-fixed__sort-menu {
    display: none;
    position: absolute;
    left: 8px;
    top: 328px;
    width: 292px;
    height: 248px;
    padding: 8px;
    background-color: rgba(3, 4, 4, 0.98);
    background-image: resource("Art/UI/ObsidianMisprintShared/misprint-surface-dossier-v1");
    -unity-background-scale-mode: stretch-to-fill;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(132, 88, 62);
    border-right-color: rgb(132, 88, 62);
    border-top-color: rgb(214, 160, 101);
    border-bottom-color: rgb(132, 88, 62);
}

.ps-vault-fixed__sort-menu.ps-open {
    display: flex;
}

.ps-vault-fixed__sort-menu-title {
    height: 24px;
    min-height: 24px;
    padding-left: 8px;
    color: rgb(107, 215, 229);
    font-size: 10px;
    -unity-text-align: middle-left;
}

.ps-vault-fixed__sort-option {
    width: 274px;
    height: 27px;
    min-height: 27px;
    margin-bottom: 2px;
    padding: 0 10px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    background-image: resource("Art/UI/ObsidianMisprintShared/misprint-surface-list-v1");
    -unity-background-scale-mode: stretch-to-fill;
    border-width: 0;
}

.ps-vault-fixed__sort-option:hover,
.ps-vault-fixed__sort-option:focus {
    -unity-background-image-tint-color: rgb(255, 224, 183);
}

.ps-vault-fixed__sort-option.ps-selected {
    background-image: resource("Art/UI/ObsidianMisprintShared/misprint-surface-selected-row-v1");
}

.ps-vault-fixed__sort-option-mark {
    width: 18px;
    min-width: 18px;
    color: rgba(218, 177, 117, 0.42);
    font-size: 8px;
    -unity-text-align: middle-center;
}

.ps-vault-fixed__sort-option.ps-selected .ps-vault-fixed__sort-option-mark {
    color: rgb(93, 226, 238);
}

.ps-vault-fixed__sort-option-label {
    min-width: 0;
    flex-grow: 1;
    color: rgb(226, 207, 184);
    font-size: 11px;
    -unity-text-align: middle-left;
}

.ps-vault-fixed__sort-option.ps-selected .ps-vault-fixed__sort-option-label {
    color: rgb(255, 232, 194);
    -unity-font-style: bold;
}

.ps-vault-fixed__detail {
    position: absolute;
    left: 604px;
    top: 82px;
    width: 652px;
    height: 624px;
    overflow: hidden;
    background-color: rgba(1, 3, 3, 0.44);
    border-top-width: 1px;
    border-top-color: rgba(205, 168, 106, 0.44);
}

.ps-vault-fixed__standard-detail,
.ps-vault-fixed__empty-detail,
.ps-vault-fixed__heirloom-detail {
    position: absolute;
    left: 0;
    top: 0;
    width: 652px;
    height: 624px;
    overflow: hidden;
}

.ps-vault-fixed__empty-detail {
    display: none;
    align-items: center;
    justify-content: center;
}

.ps-vault-fixed__heirloom-detail {
    display: none;
}

.ps-vault-fixed__heirloom-detail > .unity-scroll-view__content-and-vertical-scroll-container,
.ps-vault-fixed__heirloom-detail > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroll-view__content-viewport,
.ps-vault-fixed__heirloom-detail .unity-scroll-view__content-container {
    width: 100%;
    height: 100%;
    overflow: hidden;
}

.ps-vault-fixed__heirloom-detail .ps-vault-v11-heirloom-page {
    position: relative;
    width: 652px;
    height: 624px;
    min-height: 624px;
    padding: 12px 16px;
    overflow: hidden;
}

.ps-vault-fixed__heirloom-detail .ps-vault-v11-heirloom-heading {
    width: 100%;
    height: 82px;
    min-height: 82px;
    padding: 2px 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(194, 132, 76, 0.55);
}

.ps-vault-fixed__heirloom-detail .ps-vault-v11-heirloom-eyebrow {
    height: 16px;
    min-height: 16px;
    color: rgb(89, 205, 221);
    font-size: 9px;
}

.ps-vault-fixed__heirloom-detail .ps-vault-v11-heirloom-title {
    height: 34px;
    min-height: 34px;
    margin: 0;
    color: rgb(251, 221, 169);
    font-size: 24px;
}

.ps-vault-fixed__heirloom-detail .ps-vault-v11-heirloom-subtitle {
    height: 22px;
    min-height: 22px;
    margin: 0;
    color: rgb(205, 193, 181);
    font-size: 10px;
}

.ps-vault-fixed__heirloom-detail .ps-vault-v11-heirloom-hero {
    width: 100%;
    height: 480px;
    min-height: 480px;
    padding: 12px 0 0 0;
    flex-direction: row;
    overflow: hidden;
}

.ps-vault-fixed__heirloom-detail .ps-vault-v11-heirloom-art {
    width: 270px;
    min-width: 270px;
    height: 440px;
    margin-right: 16px;
    padding: 30px;
    background-image: resource("Art/UI/PopDark/VaultCodexV3/magic-circle");
    -unity-background-scale-mode: scale-to-fit;
}

.ps-vault-fixed__heirloom-detail .ps-vault-v11-heirloom-art-image {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.ps-vault-fixed__heirloom-detail .ps-vault-v11-heirloom-records {
    min-width: 0;
    height: 440px;
    flex-grow: 1;
}

.ps-vault-fixed__heirloom-detail .ps-vault-v9-effect {
    width: 100%;
    min-height: 112px;
    margin: 0 0 8px 0;
    padding: 12px 18px;
    background-color: rgba(5, 4, 22, 0.82);
    border-left-width: 2px;
    border-left-color: rgb(59, 218, 232);
    border-bottom-width: 1px;
    border-bottom-color: rgba(61, 218, 232, 0.38);
}

.ps-vault-fixed__heirloom-detail .ps-vault-v11-page-arrow {
    position: absolute;
    right: 16px;
    bottom: 12px;
    width: 52px;
    height: 52px;
    padding: 0;
    background-image: resource("Art/UI/PopDark/VaultCodexV3/round-next");
    -unity-background-scale-mode: scale-to-fit;
    border-width: 0;
}

