}

.ps-vault-fixed__shape-row {
    width: 100%;
    height: 128px;
    min-height: 128px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.ps-vault-fixed__shape-grid {
    width: 126px;
    min-width: 126px;
    max-width: 126px;
    height: 126px;
    min-height: 126px;
    max-height: 126px;
    margin: 0;
    padding: 6px;
    flex-shrink: 0;
    background-image: resource("Art/UI/PopDark/VaultCodexV3/occupancy-grid");
