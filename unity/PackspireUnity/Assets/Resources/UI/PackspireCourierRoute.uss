.ps-route-link--gallows_square-to-drowned_archive { left: 860px; top: 410px; width: 234px; rotate: -39.8deg; }
.ps-route-link--gallows_square-to-silent_causeway { left: 860px; top: 410px; width: 228px; rotate: 37.9deg; }
.ps-route-link--drowned_archive-to-ash_hospital { left: 1040px; top: 260px; width: 211px; rotate: -31.4deg; }
.ps-route-link--drowned_archive-to-condemned_station { left: 1040px; top: 260px; width: 255px; rotate: 45deg; }
.ps-route-link--silent_causeway-to-condemned_station { left: 1040px; top: 550px; width: 211px; rotate: -31.4deg; }
.ps-route-link--ash_hospital-to-glass_aqueduct { left: 1220px; top: 150px; width: 211px; rotate: 31.4deg; }
.ps-route-link--condemned_station-to-glass_aqueduct { left: 1220px; top: 440px; width: 255px; rotate: -45deg; }
.ps-route-link--condemned_station-to-infernal_customs { left: 1220px; top: 440px; width: 228px; rotate: 37.9deg; }
.ps-route-link--glass_aqueduct-to-courier_catacomb { left: 1400px; top: 260px; width: 211px; rotate: -31.4deg; }
