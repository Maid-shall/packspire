.ps-route-node-detail__wax { position: absolute; right: 14px; top: 8px; width: 34px; height: 34px; opacity: 0.72; background-image: resource("Art/UI/ObsidianMisprintShared/misprint-decor-wax-smear-v1"); -unity-background-scale-mode: scale-to-fit; }
.ps-route-node-detail__content { width: 272px; height: 194px; }
.ps-route-detail-eyebrow { width: 198px; height: 14px; font-size: 8px; -unity-font-style: bold; color: rgb(129, 49, 37); }
.ps-route-dossier-title { width: 238px; height: 34px; font-size: 22px; -unity-font-style: bold; -unity-font-definition: resource("Fonts/NotoSerifJP-VF"); color: rgb(42, 31, 23); overflow: hidden; }
.ps-route-dossier-subtitle { width: 272px; height: 18px; font-size: 10px; -unity-font-style: bold; color: rgb(105, 66, 40); overflow: hidden; }
.ps-route-dossier-rule { height: 1px; margin-top: 2px; margin-bottom: 3px; background-color: rgba(119, 66, 42, 0.62); }
.ps-route-detail-row { height: 21px; flex-direction: row; align-items: center; border-bottom-width: 1px; border-bottom-color: rgba(119, 83, 55, 0.24); }
.ps-route-detail-key { width: 72px; font-size: 9px; -unity-font-style: bold; color: rgb(128, 63, 43); }
.ps-route-detail-value { width: 198px; font-size: 10px; -unity-font-style: bold; color: rgb(45, 35, 27); overflow: hidden; }
.ps-route-detail-section { height: 18px; margin-top: 3px; font-size: 9px; -unity-font-style: bold; color: rgb(132, 48, 37); }
.ps-route-detail-body { width: 272px; height: 42px; font-size: 10px; -unity-font-style: bold; white-space: normal; color: rgb(53, 40, 30); overflow: hidden; }
.ps-route-detail-confirm { position: absolute; right: 2px; bottom: -1px; height: 14px; font-size: 8px; -unity-font-style: bold; color: rgb(143, 48, 36); }

.ps-route-seal-drawer {
    position: absolute;
    right: 0;
    top: 98px;
    width: 218px;
    height: 548px;
    padding: 16px 18px 17px 30px;
    translate: 218px 0;
    overflow: visible;
    background-image: resource("Art/UI/ObsidianMisprintShared/misprint-surface-list-v1");
    -unity-background-scale-mode: stretch-to-fill;
    border-left-width: 1px;
    border-left-color: rgba(190, 145, 77, 0.72);
    transition-property: translate;
    transition-duration: 0.16s;
}
.ps-seal-drawer-open .ps-route-seal-drawer { translate: 0 0; }
.ps-route-seal-drawer__toggle { position: absolute; left: -36px; top: 104px; width: 36px; height: 154px; padding: 8px 4px; align-items: center; justify-content: center; background-image: resource("Art/UI/ObsidianMisprintShared/misprint-surface-list-v1"); -unity-background-scale-mode: stretch-to-fill; border-left-width: 1px; border-right-width: 0; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgba(211, 177, 113, 0.78); border-top-color: rgba(211, 177, 113, 0.78); border-bottom-color: rgba(211, 177, 113, 0.78); }
.ps-route-seal-drawer__toggle-mark { width: 24px; height: 24px; margin-bottom: 7px; background-image: resource("Art/UI/ObsidianMisprintShared/misprint-decor-wax-smear-v1"); -unity-background-scale-mode: scale-to-fit; }
.ps-route-seal-drawer__toggle-label { width: 20px; font-size: 11px; -unity-font-style: bold; white-space: normal; -unity-text-align: middle-center; color: rgb(238, 216, 174); }
.ps-route-seal-ledger__heading { width: 166px; height: 38px; padding-left: 7px; border-bottom-width: 1px; border-bottom-color: rgba(184, 142, 77, 0.55); }
.ps-route-seal-ledger__title { height: 22px; font-size: 15px; -unity-font-style: bold; color: rgb(235, 214, 174); }
.ps-route-seal-ledger__english { height: 11px; font-size: 7px; color: rgb(69, 198, 206); }
.ps-route-seal-arrow { width: 166px; min-width: 166px; height: 20px; padding: 0; font-size: 17px; color: rgb(210, 179, 123); border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; background-color: rgba(0, 0, 0, 0); }
.ps-route-seal-arrow:hover { color: rgb(79, 218, 224); }
.ps-route-seal-scroll { width: 166px; height: 336px; }
.ps-route-seal-host { width: 166px; align-items: center; padding-top: 2px; }
.ps-route-protocol { position: relative; width: 152px; min-width: 152px; height: 80px; min-height: 80px; margin-bottom: 3px; padding: 0; color: rgb(229, 207, 166); background-image: resource("Art/UI/ObsidianMisprintShared/misprint-surface-list-v1"); -unity-background-scale-mode: stretch-to-fill; background-color: rgba(0, 0, 0, 0); border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; }
.ps-route-protocol:hover { color: rgb(246, 224, 181); translate: -2px 0; }
.ps-route-protocol.ps-selected { translate: -3px 0; }
.ps-route-protocol.ps-spent { opacity: 0.42; }
.ps-route-protocol__mark { position: absolute; left: 7px; top: 7px; width: 64px; height: 64px; align-items: center; justify-content: center; background-image: resource("Art/UI/ObsidianMisprintShared/misprint-decor-wax-smear-v1"); -unity-background-scale-mode: scale-to-fit; }
.ps-route-protocol:hover .ps-route-protocol__mark,
.ps-route-protocol.ps-selected .ps-route-protocol__mark { scale: 1.07 1.07 1; }
.ps-route-protocol__icon { width: 31px; height: 31px; -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: rgb(236, 210, 166); }
.ps-route-protocol__icon--route { background-image: resource("Art/UI/ObsidianMisprintShared/misprint-icon-expedition-v1"); }
.ps-route-protocol__icon--delay { background-image: resource("Art/UI/ObsidianMisprintShared/misprint-icon-event-v1"); }
.ps-route-protocol__icon--seal { background-image: resource("Art/UI/ObsidianMisprintShared/misprint-icon-status-v1"); }
.ps-route-protocol__name { position: absolute; left: 72px; top: 17px; width: 72px; height: 22px; font-size: 11px; -unity-font-style: bold; overflow: hidden; }
.ps-route-protocol__charge { position: absolute; left: 72px; top: 43px; width: 72px; height: 17px; font-size: 9px; -unity-font-style: bold; color: rgb(68, 195, 202); }
.ps-route-protocol__selection { display: none; position: absolute; left: 2px; top: 2px; width: 74px; height: 74px; background-image: resource("Art/UI/ObsidianMisprintShared/misprint-decor-registration-corner-v1"); -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: rgb(211, 62, 42); }
.ps-route-protocol.ps-selected .ps-route-protocol__selection { display: flex; }
.ps-route-seal-detail { width: 166px; height: 91px; padding: 8px 9px 6px 9px; border-top-width: 1px; border-top-color: rgba(183, 141, 76, 0.52); }
.ps-route-seal-detail__name { height: 20px; font-size: 12px; -unity-font-style: bold; color: rgb(238, 216, 174); overflow: hidden; }
.ps-route-seal-detail__effect { height: 35px; font-size: 8px; white-space: normal; color: rgb(191, 174, 143); overflow: hidden; }
.ps-route-seal-apply { display: none; align-self: flex-end; width: 92px; height: 26px; padding: 0 8px; font-size: 9px; -unity-font-style: bold; color: rgb(239, 215, 171); background-image: resource("Art/UI/ObsidianMisprintShared/misprint-surface-confirm-v1"); -unity-background-scale-mode: stretch-to-fill; border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; }
.ps-route-seal-apply.ps-visible { display: flex; }
.ps-route-seal-apply:disabled { opacity: 0.36; }

.ps-route-status-strip { position: absolute; right: 96px; top: 16px; width: 430px; height: 64px; padding: 5px 10px; flex-direction: row; align-items: center; background-image: resource("Art/UI/ObsidianMisprintShared/misprint-surface-list-v1"); -unity-background-scale-mode: stretch-to-fill; border-bottom-width: 1px; border-bottom-color: rgba(214, 174, 104, 0.72); }
.ps-route-status-portrait { width: 52px; height: 52px; margin-right: 10px; padding: 4px; overflow: hidden; background-image: resource("Art/UI/CourierRoutePrototype/courier-route-node-stamp-v1"); -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: rgb(208, 170, 98); border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; }
.ps-route-status-portrait-image { width: 44px; height: 44px; -unity-background-scale-mode: scale-and-crop; }
.ps-route-status { height: 50px; padding: 3px 11px; border-right-width: 1px; border-right-color: rgba(162, 124, 67, 0.3); justify-content: center; }
.ps-route-status--hp { width: 126px; }
.ps-route-status--recovered { width: 78px; flex-direction: row; align-items: center; }
.ps-route-status--deadline { width: 150px; border-right-width: 0; }
.ps-route-status--recovered.ps-hidden { display: none; }
.ps-route-status-key { width: 29px; font-size: 8px; -unity-font-style: bold; color: rgb(200, 164, 102); }
.ps-route-status-value { height: 26px; font-size: 18px; -unity-font-style: bold; -unity-font-definition: resource("Fonts/NotoSerifJP-VF"); color: rgb(246, 226, 184); }
.ps-route-status-value--days { height: 25px; font-size: 18px; color: rgb(241, 220, 178); }
.ps-route-hp-bar { width: 106px; height: 5px; }
.ps-route-hp-bar .unity-progress-bar__background { background-color: rgb(24, 22, 20); border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgb(111, 89, 54); border-right-color: rgb(111, 89, 54); border-top-color: rgb(111, 89, 54); border-bottom-color: rgb(111, 89, 54); }
.ps-route-hp-bar .unity-progress-bar__progress { background-color: rgb(196, 48, 59); }
.ps-route-hp-bar .unity-progress-bar__title { display: none; }
.ps-route-deadline-meter { width: 130px; height: 8px; flex-direction: row; align-items: center; }
.ps-route-deadline-segment { width: 5px; height: 6px; margin-right: 2px; background-color: rgb(198, 184, 153); }
.ps-route-deadline-segment.ps-expired { background-color: rgb(57, 55, 50); }
.ps-route-deadline-segment.ps-warning { background-color: rgb(187, 56, 42); }

.ps-route-relay-pack { display: none; position: absolute; left: 36px; bottom: 72px; width: 158px; height: 36px; padding: 4px 10px; font-size: 10px; -unity-font-style: bold; white-space: normal; color: rgb(54, 42, 30); background-image: resource("Art/UI/ObsidianMisprintShared/misprint-surface-event-choice-v1"); -unity-background-scale-mode: stretch-to-fill; border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; -unity-text-align: middle-center; }
.ps-route-relay-pack.ps-visible { display: flex; }
.ps-route-finish { display: none; position: absolute; right: 42px; bottom: 28px; width: 210px; height: 56px; padding: 8px 28px; font-size: 14px; -unity-font-style: bold; -unity-font-definition: resource("Fonts/NotoSerifJP-VF"); color: rgb(238, 214, 172); background-image: resource("Art/UI/ObsidianMisprintShared/misprint-surface-confirm-v1"); -unity-background-scale-mode: stretch-to-fill; border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; -unity-text-align: middle-center; }
.ps-route-finish.ps-visible { display: flex; }
.ps-route-finish:hover { color: rgb(244, 226, 190); scale: 1.015 1.015 1; }
