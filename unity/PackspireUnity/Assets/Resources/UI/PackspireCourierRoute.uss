.ps-route-link--infernal_customs-to-black_bell_yard { left: 1400px; top: 580px; width: 234px; rotate: -39.8deg; }
.ps-route-link--courier_catacomb-to-final_relay { left: 1580px; top: 150px; width: 201px; rotate: 26.6deg; }
.ps-route-link--black_bell_yard-to-final_relay { left: 1580px; top: 430px; width: 262px; rotate: -46.5deg; }
.ps-route-link--black_bell_yard-to-pursuer_gate { left: 1580px; top: 430px; width: 222px; rotate: 35.8deg; }
.ps-route-link--final_relay-to-destination { left: 1760px; top: 240px; width: 193px; rotate: -21.3deg; }
.ps-route-link--pursuer_gate-to-destination { left: 1760px; top: 560px; width: 430px; rotate: -65.2deg; }

.ps-route-node {
    position: absolute;
    width: 100px;
    height: 100px;
    min-width: 100px;
    min-height: 100px;
    padding: 0;
    align-items: center;
    color: rgb(224, 205, 166);
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    opacity: 0.43;
}

.ps-route-node__phase { position: absolute; left: -4px; top: 2px; width: 31px; height: 20px; font-size: 11px; -unity-font-style: bold; -unity-text-align: middle-center; color: rgb(195, 153, 84); }
.ps-route-node__medallion { position: absolute; left: 10px; top: -4px; width: 80px; height: 80px; align-items: center; justify-content: center; background-image: resource("Art/UI/CourierRoutePrototype/courier-route-node-stamp-v1"); -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: rgb(166, 137, 89); }
.ps-route-node__stamp--start { background-image: resource("Art/UI/CourierRoutePrototype/courier-route-node-start-stamp-v1"); -unity-background-image-tint-color: rgb(205, 177, 121); }
.ps-route-node__stamp--relay { background-image: resource("Art/UI/CourierRoutePrototype/courier-route-node-relay-stamp-v1"); -unity-background-image-tint-color: rgb(68, 190, 194); }
.ps-route-node__stamp--pursuit { background-image: resource("Art/UI/CourierRoutePrototype/courier-route-node-pursuit-stamp-v1"); -unity-background-image-tint-color: rgb(199, 66, 49); }
.ps-route-node__stamp--cargo { background-image: resource("Art/UI/CourierRoutePrototype/courier-route-node-cargo-stamp-v1"); -unity-background-image-tint-color: rgb(204, 151, 64); }
.ps-route-node__stamp--event { background-image: resource("Art/UI/CourierRoutePrototype/courier-route-node-event-stamp-v1"); -unity-background-image-tint-color: rgb(151, 104, 174); }
.ps-route-node__stamp--destination { background-image: resource("Art/UI/CourierRoutePrototype/courier-route-node-destination-stamp-v1"); -unity-background-image-tint-color: rgb(229, 210, 167); }
.ps-route-node__unknown { width: 50px; height: 50px; font-size: 24px; -unity-font-style: bold; -unity-text-align: middle-center; color: rgb(175, 149, 104); }
.ps-route-node__title { display: none; position: absolute; left: -23px; top: 69px; width: 146px; height: 27px; padding-left: 7px; padding-right: 7px; font-size: 14px; -unity-font-style: bold; -unity-text-align: middle-center; color: rgb(246, 225, 184); background-image: resource("Art/UI/ObsidianMisprintShared/misprint-surface-list-v1"); -unity-background-scale-mode: stretch-to-fill; overflow: hidden; }
.ps-route-node__kind { display: none; position: absolute; left: -11px; top: 95px; width: 122px; height: 18px; font-size: 10px; -unity-font-style: bold; -unity-text-align: middle-center; color: rgb(74, 203, 211); }
.ps-route-node--unknown .ps-route-node__medallion { left: 17px; top: 2px; width: 66px; height: 66px; background-image: resource("Art/UI/CourierRoutePrototype/courier-route-node-stamp-v1"); -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: rgb(125, 105, 72); }
.ps-route-node.ps-resolved { opacity: 0.58; }
.ps-route-node.ps-available,
.ps-route-node.ps-current,
.ps-route-node.ps-selected { opacity: 1; }
.ps-route-node:disabled { opacity: 0.26; }
.ps-route-node.ps-resolved:disabled { opacity: 0.58; }
.ps-route-node.ps-current:disabled { opacity: 1; }
.ps-route-node.ps-available .ps-route-node__title,
.ps-route-node.ps-current .ps-route-node__title,
.ps-route-node.ps-selected .ps-route-node__title,
.ps-route-node.ps-available .ps-route-node__kind,
.ps-route-node.ps-current .ps-route-node__kind,
.ps-route-node.ps-selected .ps-route-node__kind { display: flex; }
.ps-route-node.ps-available .ps-route-node__medallion,
.ps-route-node.ps-current .ps-route-node__medallion { scale: 1.05 1.05 1; }
.ps-route-node.ps-available:hover .ps-route-node__medallion { scale: 1.12 1.12 1; }
.ps-route-node.ps-selected .ps-route-node__medallion { scale: 1.14 1.14 1; }
.ps-route-node.ps-selected .ps-route-node__kind { color: rgb(241, 92, 65); }
.ps-route-node.ps-travel-target .ps-route-node__medallion { scale: 1.12 1.12 1; }
.ps-route-node.ps-travel-target .ps-route-node__kind { color: rgb(72, 214, 219); }
.ps-route-node__current-marker { position: absolute; right: -7px; top: -8px; width: 37px; height: 37px; background-image: resource("Art/UI/ObsidianMisprintShared/misprint-icon-map-v1"); -unity-background-scale-mode: scale-to-fit; }

.ps-route-courier-position {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    width: 1px;
    height: 1px;
    overflow: visible;
}
.ps-route-courier-position.ps-visible { display: flex; }
.ps-route-traveling .ps-route-courier-position,
.ps-route-courier-position.ps-route-courier-position--traveling {
    display: flex;
    opacity: 1;
}
.ps-route-courier-marker {
    display: flex;
    position: absolute;
    left: -54px;
    top: -96px;
    width: 108px;
    height: 112px;
    transform-origin: center bottom;
}
.ps-route-courier-marker.ps-route-courier-marker--traveling {
    opacity: 1;
    scale: 1.12 1.12;
}
.ps-route-courier-marker--traveling .ps-route-courier-marker__sprite { display: flex; opacity: 1; }
.ps-route-courier-marker--traveling .ps-route-courier-marker__ground { opacity: 1; -unity-background-image-tint-color: rgb(85, 231, 233); }
.ps-route-courier-marker--traveling .ps-route-courier-marker__tag { display: flex; opacity: 1; }
.ps-route-courier-marker__ground {
    position: absolute;
    left: 24px;
    bottom: 2px;
    width: 60px;
    height: 24px;
    opacity: 0.82;
    background-image: resource("Art/UI/CourierRoutePrototype/courier-route-node-stamp-v1");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgb(62, 213, 218);
}
.ps-route-courier-marker__sprite {
    display: none;
    position: absolute;
    left: 9px;
    bottom: 7px;
    width: 90px;
    height: 104px;
}
.ps-route-courier-marker--animated .ps-route-courier-marker__sprite { display: flex; }
.ps-route-courier-marker__fallback {
    position: absolute;
    left: 17px;
    bottom: 7px;
    width: 74px;
    height: 101px;
    overflow: hidden;
}
.ps-route-courier-marker--animated .ps-route-courier-marker__fallback { display: none; }
.ps-route-courier-marker__fallback-image { width: 74px; height: 101px; -unity-background-scale-mode: scale-to-fit; }
.ps-route-courier-marker--left .ps-route-courier-marker__sprite,
.ps-route-courier-marker--left .ps-route-courier-marker__fallback { scale: -1 1 1; }
.ps-route-courier-marker__tag {
    position: absolute;
    left: 76px;
    top: 24px;
    min-width: 88px;
    height: 39px;
    padding: 5px 9px 4px 10px;
    background-image: resource("Art/UI/ObsidianMisprintShared/misprint-surface-list-v1");
    -unity-background-scale-mode: stretch-to-fill;
}
.ps-route-courier-marker__label { height: 17px; font-size: 10px; -unity-font-style: bold; color: rgb(244, 225, 184); white-space: nowrap; }
.ps-route-courier-marker__days { height: 8px; flex-direction: row; align-items: center; }
.ps-route-courier-marker__day { width: 8px; height: 3px; margin-right: 3px; background-color: rgb(222, 207, 170); }
.ps-route-courier-marker__day.ps-spent { background-color: rgb(60, 207, 214); }
.ps-route-traveling .ps-route-node-detail { display: none; }

