.ps-courier-route-shell,
.ps-courier-route {
    position: absolute;
    left: 0;
    top: 0;
    width: 1280px;
    height: 720px;
}

.ps-courier-route {
    overflow: hidden;
    color: rgb(229, 211, 173);
    -unity-font-definition: resource("Fonts/KleeOne-SemiBold");
    background-color: rgb(5, 6, 6);
}

.ps-route-ledger-background {
    position: absolute;
    left: 0;
    top: 0;
    width: 1280px;
    height: 720px;
    background-image: resource("Art/UI/ObsidianMisprintShared/misprint-background-route-v1");
    -unity-background-scale-mode: scale-and-crop;
}

.ps-route-title-block {
    position: absolute;
    left: 26px;
    top: 16px;
    width: 500px;
    height: 78px;
    padding-left: 18px;
    padding-right: 24px;
    flex-direction: row;
    align-items: center;
    background-image: resource("Art/UI/ObsidianMisprintShared/misprint-surface-list-v1");
    -unity-background-scale-mode: stretch-to-fill;
}

.ps-route-title-index {
    width: 62px;
    height: 52px;
    margin-right: 14px;
    font-size: 39px;
    -unity-font-definition: resource("Fonts/NotoSerifJP-VF");
    -unity-text-align: middle-center;
    color: rgb(193, 55, 40);
    border-right-width: 1px;
    border-right-color: rgba(193, 148, 81, 0.68);
}

.ps-route-title-copy {
    width: 455px;
    height: 56px;
    justify-content: center;
}

.ps-route-title-eyebrow {
    height: 13px;
    font-size: 8px;
    -unity-font-style: bold;
    color: rgb(75, 202, 208);
}

.ps-route-title {
    height: 31px;
    font-size: 25px;
    -unity-font-style: bold;
    -unity-font-definition: resource("Fonts/NotoSerifJP-VF");
    color: rgb(243, 222, 179);
}

.ps-route-destination {
    height: 16px;
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(190, 126, 71);
}

.ps-route-map-viewport {
    position: absolute;
    left: 0;
    top: 0;
    width: 1280px;
    height: 720px;
    overflow: hidden;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    background-color: rgb(13, 13, 11);
}

.ps-route-map-content,
.ps-route-map-ink,
.ps-route-links,
.ps-route-node-host {
    position: absolute;
    left: 0;
    top: 0;
    width: 2000px;
    height: 720px;
}

.ps-route-map-content { transform-origin: 0 0; }

.ps-route-map-ink {
    background-image: resource("Art/UI/ObsidianMisprintShared/misprint-background-route-v1");
    -unity-background-scale-mode: stretch-to-fill;
    opacity: 1;
    -unity-background-image-tint-color: rgb(180, 166, 137);
}

.ps-route-map-heading {
    position: absolute;
    left: 48px;
    top: 105px;
    width: 230px;
    height: 60px;
    padding-left: 14px;
    padding-right: 16px;
    justify-content: center;
    background-image: resource("Art/UI/ObsidianMisprintShared/misprint-surface-list-v1");
    -unity-background-scale-mode: stretch-to-fill;
}

.ps-route-map-heading__title {
    height: 26px;
    font-size: 21px;
    -unity-font-style: bold;
    -unity-font-definition: resource("Fonts/NotoSerifJP-VF");
    color: rgb(237, 215, 173);
}

.ps-route-map-heading__meta { height: 13px; font-size: 8px; color: rgb(68, 199, 207); }
.ps-route-map-heading__underline { position: absolute; left: -5px; bottom: 0; width: 128px; height: 10px; background-image: resource("Art/UI/ObsidianMisprintShared/misprint-decor-proof-slash-v1"); -unity-background-scale-mode: stretch-to-fill; }

.ps-route-map-watermark {
    position: absolute;
    left: 735px;
    top: 58px;
    width: 570px;
    height: 570px;
    opacity: 0.13;
    background-image: resource("Art/UI/ObsidianMisprintShared/misprint-decor-page-target-v1");
    -unity-background-scale-mode: scale-to-fit;
}

.ps-route-map-registration {
    position: absolute;
    width: 142px;
    height: 142px;
    opacity: 0.25;
    background-image: resource("Art/UI/ObsidianMisprintShared/misprint-decor-registration-corner-v1");
    -unity-background-scale-mode: scale-to-fit;
}

.ps-route-map-registration--a { left: 80px; top: 64px; }
.ps-route-map-registration--b { left: 1778px; top: 522px; rotate: 180deg; }

.ps-route-map-controls {
    position: absolute;
    left: 35px;
    bottom: 24px;
    width: 112px;
    height: 36px;
    padding: 3px 5px;
    flex-direction: row;
    align-items: center;
    background-image: resource("Art/UI/ObsidianMisprintShared/misprint-surface-list-v1");
    -unity-background-scale-mode: stretch-to-fill;
}

.ps-route-map-control {
    width: 30px;
    height: 30px;
    min-width: 30px;
    padding: 3px;
    margin-right: 2px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.ps-route-map-control:hover { background-color: rgba(55, 190, 196, 0.18); }
.ps-route-map-control__icon { width: 24px; height: 24px; -unity-background-scale-mode: scale-to-fit; }
.ps-route-map-control--focus .ps-route-map-control__icon { background-image: resource("Art/UI/ObsidianMisprintShared/misprint-icon-map-v1"); }
.ps-route-map-control--fit .ps-route-map-control__icon { background-image: resource("Art/UI/ObsidianMisprintShared/misprint-icon-expedition-v1"); }
.ps-route-map-zoom { width: 43px; height: 24px; font-size: 10px; color: rgb(83, 208, 215); -unity-text-align: middle-center; }

.ps-route-link {
    position: absolute;
    height: 5px;
    transform-origin: left center;
    background-color: rgba(0, 0, 0, 0);
    opacity: 0.68;
}

.ps-route-link__stroke {
    position: absolute;
    left: 0;
    top: -46px;
    width: 100%;
    height: 96px;
    background-image: resource("Art/UI/CourierRoutePrototype/courier-route-link-handdrawn-v1");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgb(216, 199, 160);
}

.ps-route-link--available { opacity: 0.94; }
.ps-route-link--available .ps-route-link__stroke { -unity-background-image-tint-color: rgb(55, 200, 209); scale: 1 1.08 1; }
.ps-route-link--selected { opacity: 1; }
.ps-route-link--selected .ps-route-link__stroke { -unity-background-image-tint-color: rgb(222, 55, 37); scale: 1 1.16 1; }
.ps-route-link--resolved { opacity: 0.68; }
.ps-route-link--resolved .ps-route-link__stroke { -unity-background-image-tint-color: rgb(188, 148, 79); }
.ps-route-link--traveling { opacity: 1; }
.ps-route-link--traveling .ps-route-link__stroke { -unity-background-image-tint-color: rgb(66, 216, 220); scale: 1 1.08 1; }

.ps-route-link__arrow {
    position: absolute;
    right: -6px;
    top: -5px;
    width: 13px;
    height: 13px;
    rotate: 45deg;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(134, 111, 72);
    border-right-color: rgb(134, 111, 72);
    border-top-color: rgb(134, 111, 72);
    border-bottom-color: rgb(134, 111, 72);
    background-color: rgb(10, 11, 11);
}

.ps-route-link--available .ps-route-link__arrow { border-left-color: rgb(77, 224, 230); border-right-color: rgb(77, 224, 230); border-top-color: rgb(77, 224, 230); border-bottom-color: rgb(77, 224, 230); }
.ps-route-link--selected .ps-route-link__arrow { border-left-color: rgb(239, 75, 52); border-right-color: rgb(239, 75, 52); border-top-color: rgb(239, 75, 52); border-bottom-color: rgb(239, 75, 52); background-color: rgb(77, 17, 12); }

