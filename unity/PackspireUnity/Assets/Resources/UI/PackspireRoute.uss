    border-bottom-color: rgb(73, 221, 255);
}
.ps-gboard-player-hud .ps-gboard-hp-track,
.ps-gboard-player-hud .ps-gboard-shield-track {
    position: absolute;
    top: 52px;
    bottom: 180px;
    height: auto;
    margin: 0;
    overflow: hidden;
    background-color: rgba(2, 2, 16, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}
.ps-gboard-player-hud .ps-gboard-hp-track {
    left: 84px;
    width: 14px;
}
.ps-gboard-player-hud .ps-gboard-shield-track {
    left: 132px;
    width: 12px;
}
.ps-gboard-player-hud .ps-gboard-hp-fill,
.ps-gboard-player-hud .ps-gboard-shield-fill {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    transition-property: height;
    transition-duration: 0.22s;
    transition-timing-function: ease-out;
}
.ps-gboard-player-hud .ps-gboard-hp-fill {
    background-color: rgb(237, 53, 112);
    border-top-width: 2px;
    border-top-color: rgb(255, 205, 151);
}
.ps-gboard-player-hud .ps-gboard-shield-fill {
    background-color: rgb(39, 178, 235);
    border-top-width: 2px;
    border-top-color: rgb(205, 250, 255);
}
.ps-gboard-player-hud .ps-gboard-en-rail,
.ps-gboard-idle .ps-gboard-player-hud .ps-gboard-en-rail,
.ps-gboard-planning .ps-gboard-player-hud .ps-gboard-en-rail,
.ps-gboard-in-combat .ps-gboard-player-hud .ps-gboard-en-rail {
    display: flex;
    position: absolute;
    left: 164px;
    right: auto;
    top: auto;
    bottom: 61px;
    width: 139px;
    min-height: 50px;
    height: 50px;
    padding: 0;
    align-items: center;
    justify-content: center;
    background-image: none;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}
.ps-gboard-player-hud .ps-gboard-en-label {
    margin: 0;
    font-size: 17px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(255, 229, 160);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.96);
}

.ps-gboard-map-stats {
    position: absolute;
    right: 16px;
    top: 14px;
    height: 42px;
    flex-direction: row;
    align-items: center;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
}
.ps-gboard-stat-chip {
    min-width: 116px;
    height: 36px;
    margin-left: 7px;
    padding: 6px 12px;
    font-size: 12px;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    background-color: rgba(6, 4, 28, 0.90);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 100, 180, 0.74);
    border-right-color: rgba(81, 229, 255, 0.74);
    border-top-color: rgba(255, 209, 130, 0.58);
    border-bottom-color: rgba(157, 93, 255, 0.70);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.94);
}
.ps-gboard-stat-turn {
    min-width: 132px;
    color: rgb(255, 222, 148);
    background-color: rgba(72, 12, 70, 0.92);
    border-left-width: 2px;
    border-left-color: rgb(255, 91, 174);
}
.ps-gboard-stat-area {
    color: rgb(130, 233, 255);
}
.ps-gboard-stat-curve {
    color: rgb(255, 167, 210);
}
.ps-gboard-map-stats .ps-gboard-top-finish.ps-gboard-action {
    position: relative;
    right: auto;
    bottom: auto;
    width: 54px;
    min-width: 54px;
    height: 30px;
    min-height: 30px;
    margin-left: 7px;
    padding: 0 5px;
    font-size: 9px;
    color: rgba(229, 213, 229, 0.78);
    background-color: rgba(12, 7, 28, 0.78);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 102, 179, 0.42);
    border-right-color: rgba(85, 228, 255, 0.42);
    border-top-color: rgba(255, 211, 132, 0.34);
    border-bottom-color: rgba(160, 94, 255, 0.42);
}
.ps-gboard-map-stats-combat .ps-gboard-stat-turn {
    min-width: 154px;
    color: rgb(255, 231, 166);
    background-color: rgba(91, 16, 53, 0.94);
}

.ps-gboard-mode-toast {
    position: absolute;
    left: 50%;
    top: 18px;
    width: 260px;
    min-height: 62px;
    margin-left: -130px;
    padding: 7px 20px;
    font-size: 18px;
    letter-spacing: 4px;
    white-space: normal;
    -unity-text-align: middle-center;
    color: rgb(255, 224, 151);
    opacity: 1;
    background-color: rgba(5, 3, 24, 0.70);
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 94, 184, 0.62);
    transition-property: opacity, translate;
    transition-duration: 0.36s;
}
.ps-gboard-mode-toast.ps-gboard-mode-toast-out {
    opacity: 0;
    translate: 0 -8px;
}

/* With the banner gone, the action lane starts near the true top. Enemy
   vitality belongs below the portrait, not in that upper reading lane. */
.ps-gboard-in-combat .ps-gboard-combat-vitals {
    top: 450px;
}
.ps-gboard-in-combat .ps-gboard-combat-action-view {
    top: 70px;
}
.ps-gboard-in-combat .ps-gboard-enemy-focus {
    top: 18px;
}

/* Exploration cell dossier: deliberately a light lower-right reading layer.
   It borrows the old dossier's neon language without rebuilding a full frame
   over the dungeon; only the left spine remains. */
.ps-gboard-cell-detail {
    position: absolute;
    right: 34px;
    bottom: 104px;
    width: 278px;
    min-height: 186px;
    padding: 18px 21px 16px;
    flex-direction: column;
    justify-content: flex-start;
    background-color: rgba(4, 3, 20, 0.84);
    border-left-width: 2px;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-color: rgb(83, 230, 255);
    opacity: 1;
}
.ps-gboard-cell-detail-eyebrow {
    margin: 0 0 6px;
    font-size: 10px;
    letter-spacing: 2px;
    color: rgb(112, 232, 255);
}
.ps-gboard-cell-detail-title {
    margin: 0;
    font-size: 27px;
    letter-spacing: 1px;
    color: rgb(255, 225, 159);
    -unity-font-style: bold;
}
.ps-gboard-cell-detail-rule {
    width: 100%;
    height: 1px;
    margin: 10px 0 12px;
    background-color: rgba(255, 95, 177, 0.72);
}
.ps-gboard-cell-detail-body {
    flex-grow: 1;
    margin: 0;
    font-size: 13px;
    white-space: normal;
    color: rgba(240, 229, 244, 0.92);
}
.ps-gboard-cell-detail-footer {
    margin: 12px 0 0;
    padding-top: 8px;
    font-size: 11px;
    letter-spacing: 0.7px;
    color: rgb(255, 174, 210);
    border-top-width: 1px;
    border-top-color: rgba(255, 211, 134, 0.34);
}
.ps-gboard-in-combat .ps-gboard-cell-detail {
    display: none;
}
