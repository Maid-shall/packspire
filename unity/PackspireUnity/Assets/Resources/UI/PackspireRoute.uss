/* ===== Seal grid board (left detail / right map; hero where axes were) ===== */
.ps-gboard {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(34, 28, 24);
}

.ps-gboard-top {
    position: absolute;
    left: 12px;
    right: 12px;
    top: 10px;
    height: 54px;
    min-height: 54px;
    flex-direction: row;
    align-items: center;
    padding: 0 14px;
    background-color: rgba(54, 38, 24, 0.96);
    border-left-width: 2px;
    border-left-color: rgb(212, 168, 72);
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-right-color: rgba(140, 115, 75, 0.32);
    border-top-color: rgba(140, 115, 75, 0.32);
    border-bottom-color: rgba(140, 115, 75, 0.32);
}

.ps-gboard-top-sub {
    font-size: 11px;
    color: rgba(170, 145, 95, 0.78);
    margin-top: 2px;
    letter-spacing: 1px;
}

.ps-gboard-phase {
    font-size: 13px;
    color: rgb(210, 180, 110);
    margin-left: 18px;
}

.ps-gboard-ink {
    font-size: 13px;
    color: rgb(160, 210, 220);
    margin-left: auto;
}

.ps-gboard-doom {
    min-width: 152px;
    margin-left: 14px;
    padding: 5px 8px;
    color: rgb(255, 178, 152);
    font-size: 11px;
    letter-spacing: 0.5px;
    background-color: rgba(52, 20, 30, 0.76);
    border-left-width: 2px;
    border-left-color: rgb(218, 112, 118);
}

.ps-gboard-dock {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 372px;
    padding: 76px 16px 10px 16px;
    flex-direction: column;
    background-color: rgb(72, 52, 34);
    border-right-width: 1px;
    border-right-color: rgba(170, 135, 70, 0.55);
}

.ps-gboard-panel {
    flex-grow: 1;
    flex-shrink: 1;
    width: 100%;
    min-height: 180px;
    padding: 18px 18px 12px 18px;
    flex-direction: column;
    background-color: rgba(54, 38, 24, 0.94);
    border-left-width: 2px;
    border-left-color: rgb(212, 168, 72);
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-right-color: rgba(140, 115, 75, 0.32);
    border-top-color: rgba(140, 115, 75, 0.32);
    border-bottom-color: rgba(140, 115, 75, 0.32);
}

.ps-gboard-panel-type {
    font-size: 12px;
    color: rgb(210, 175, 95);
    margin-bottom: 4px;
    -unity-font-definition: resource("Fonts/KleeOne-SemiBold");
}

.ps-gboard-panel-title {
    font-size: 26px;
    color: rgb(255, 238, 200);
    margin-bottom: 8px;
    -unity-font-definition: resource("Fonts/KleeOne-SemiBold");
}

.ps-gboard-panel-status {
    font-size: 13px;
    color: rgb(230, 205, 145);
    margin-bottom: 10px;
    white-space: normal;
}

.ps-gboard-panel-body {
    font-size: 14px;
    color: rgba(210, 195, 160, 0.95);
    white-space: normal;
    margin-bottom: 10px;
    flex-grow: 1;
}

.ps-gboard-panel-hint {
    font-size: 11px;
    color: rgba(145, 135, 112, 0.88);
    margin-bottom: 10px;
    white-space: normal;
}

.ps-gboard-hero {
    flex-shrink: 0;
    width: 100%;
    margin-top: 12px;
    padding: 12px 12px 10px 12px;
    flex-direction: column;
    background-color: rgba(16, 13, 18, 0.9);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(150, 120, 70, 0.35);
    border-right-color: rgba(150, 120, 70, 0.35);
    border-top-color: rgba(150, 120, 70, 0.35);
    border-bottom-color: rgba(150, 120, 70, 0.35);
}

.ps-gboard-hero-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
}

.ps-gboard-portrait {
    width: 88px;
    height: 88px;
    margin-right: 12px;
    flex-shrink: 0;
    overflow: hidden;
    background-color: rgba(28, 22, 18, 0.95);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(180, 145, 80, 0.45);
    border-right-color: rgba(180, 145, 80, 0.45);
    border-top-color: rgba(180, 145, 80, 0.45);
    border-bottom-color: rgba(180, 145, 80, 0.45);
}

.ps-gboard-portrait-image {
    width: 100%;
    height: 100%;
}

.ps-gboard-portrait-blank {
    width: 100%;
    height: 100%;
    background-color: rgba(40, 32, 28, 0.9);
}

.ps-gboard-hero-meta {
    flex-grow: 1;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
}

.ps-gboard-hero-name {
    font-size: 18px;
    color: rgb(255, 232, 186);
    margin-bottom: 6px;
    -unity-font-definition: resource("Fonts/KleeOne-SemiBold");
}

.ps-gboard-hp-label {
    font-size: 12px;
    color: rgb(220, 190, 140);
    margin-bottom: 6px;
}

.ps-gboard-hp-track {
    width: 100%;
    height: 10px;
    background-color: rgba(30, 22, 18, 0.95);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(120, 90, 55, 0.5);
    border-right-color: rgba(120, 90, 55, 0.5);
    border-top-color: rgba(120, 90, 55, 0.5);
    border-bottom-color: rgba(120, 90, 55, 0.5);
}

.ps-gboard-hp-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(180, 70, 70);
}

.ps-gboard-stage {
    position: absolute;
    left: 372px;
    right: 0;
    top: 0;
    bottom: 0;
    padding: 76px 0 0 0;
    flex-direction: column;
    background-color: rgb(92, 68, 44);
    border-left-width: 1px;
    border-left-color: rgba(198, 158, 78, 0.28);
    overflow: hidden;
}

.ps-gboard-viewport {
    position: relative;
    flex-grow: 1;
    width: 100%;
    height: 100%;
    min-height: 0;
    overflow: hidden;
    background-color: rgba(12, 10, 10, 0.55);
}

.ps-gboard-grid {
    position: absolute;
    flex-grow: 0;
    flex-shrink: 0;
    justify-content: flex-start;
    align-items: flex-start;
    padding: 8px;
    background-color: rgba(8, 7, 7, 0.35);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(160, 130, 70, 0.4);
    border-right-color: rgba(160, 130, 70, 0.4);
    border-top-color: rgba(160, 130, 70, 0.4);
    border-bottom-color: rgba(160, 130, 70, 0.4);
}

.ps-gboard-zoom {
    position: absolute;
    right: 14px;
    top: 84px;
    flex-direction: row;
    align-items: center;
    padding: 4px 6px;
    background-color: rgba(18, 14, 12, 0.88);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(170, 135, 70, 0.45);
    border-right-color: rgba(170, 135, 70, 0.45);
    border-top-color: rgba(170, 135, 70, 0.45);
    border-bottom-color: rgba(170, 135, 70, 0.45);
}

.ps-gboard-zoom > .ps-gboard-action {
    width: 34px;
    min-height: 28px;
    margin-bottom: 0;
    margin-right: 4px;
    padding: 0;
    font-size: 16px;
}

.ps-gboard-zoom-label {
    min-width: 48px;
    margin-right: 4px;
    font-size: 12px;
    color: rgb(210, 190, 140);
    -unity-text-align: middle-center;
}

.ps-gboard-top-finish {
    margin-left: 12px;
    min-height: 28px;
    font-size: 12px;
}

.ps-gboard-context {
    flex-direction: column;
    flex-shrink: 0;
    margin-top: 8px;
}

.ps-gboard-combat-stage {
    position: absolute;
    right: 18px;
    top: 94px;
    width: 310px;
    min-width: 310px;
    bottom: 152px;
    padding: 16px 14px 14px 14px;
    align-items: center;
    justify-content: center;
    background-color: rgba(28, 18, 22, 0.88);
    border-left-width: 2px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(218, 112, 118);
    border-right-color: rgba(218, 150, 118, 0.42);
    border-top-color: rgba(218, 150, 118, 0.42);
    border-bottom-color: rgba(218, 150, 118, 0.42);
}

.ps-gboard-combat-portrait {
    width: 224px;
    height: 224px;
    margin-bottom: 10px;
}

.ps-gboard-combat-title {
    font-size: 28px;
    color: rgb(255, 220, 180);
    margin-bottom: 8px;
    -unity-font-definition: resource("Fonts/KleeOne-SemiBold");
}

.ps-gboard-combat-hp {
    font-size: 16px;
    color: rgb(230, 170, 150);
    margin-bottom: 8px;
}

.ps-gboard-combat-intent {
    font-size: 15px;
    color: rgb(255, 200, 140);
    margin-bottom: 12px;
    -unity-font-definition: resource("Fonts/KleeOne-SemiBold");
}

/* The grid remains the expedition's visual anchor while a combat card is open. */
.ps-gboard-in-combat .ps-gboard-viewport {
    background-color: rgba(14, 8, 14, 0.72);
}

.ps-gboard-in-combat .ps-gboard-grid {
    opacity: 0.72;
}

.ps-gboard-fx-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.ps-gboard-consumables {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 10px;
}

.ps-gboard-consumable {
    min-width: 72px;
    margin-right: 6px;
    margin-bottom: 6px;
}

.ps-gboard-combat-leave {
    min-width: 140px;
}

.ps-gboard-en-rail {
    position: absolute;
    right: 10px;
    bottom: 6px;
    width: 460px;
    min-height: 40px;
    padding: 4px 8px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(12, 10, 14, 0.82);
    border-left-width: 2px;
    border-left-color: rgb(200, 160, 80);
}

/* Dice resolve tray: permanent combat location, later populated by real rolls. */
.ps-gboard-resolve {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    min-height: 60px;
    padding: 8px 12px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(28, 16, 38, 0.97);
    border-left-width: 3px;
    border-left-color: rgb(210, 146, 248);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgba(190, 132, 230, 0.5);
    border-right-color: rgba(190, 132, 230, 0.32);
    border-bottom-color: rgba(190, 132, 230, 0.32);
}

.ps-gboard-resolve-head {
    width: 146px;
    margin-right: 10px;
    flex-direction: column;
}

.ps-gboard-resolve-formula {
    color: rgb(228, 194, 255);
    font-size: 13px;
    letter-spacing: 1.4px;
}

.ps-gboard-resolve-result {
    color: rgb(255, 215, 162);
    font-size: 11px;
    margin-top: 3px;
}

.ps-gboard-resolve-dice {
    flex-direction: row;
    align-items: center;
}

.ps-gboard-die {
    width: 32px;
    height: 32px;
    margin-right: 6px;
    color: rgb(255, 238, 210);
    font-size: 18px;
    -unity-text-align: middle-center;
    background-color: rgb(64, 42, 76);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(220, 166, 250);
    border-right-color: rgb(220, 166, 250);
    border-top-color: rgb(220, 166, 250);
    border-bottom-color: rgb(220, 166, 250);
}

.ps-gboard-die-mod {
    margin-left: 4px;
    color: rgb(255, 204, 154);
    font-size: 16px;
}

.ps-gboard-en-label {
    font-size: 16px;
    color: rgb(255, 220, 140);
    letter-spacing: 1px;
    -unity-font-definition: resource("Fonts/KleeOne-SemiBold");
    margin-right: 12px;
}

.ps-gboard-combat-rail {
    flex-direction: row;
    align-items: center;
    margin-left: auto;
}

.ps-gboard-skill,
.ps-gboard-endturn {
    min-height: 34px;
    margin-bottom: 0;
    margin-left: 6px;
    font-size: 12px;
}

.ps-battle-hand.ps-gboard-hand-fan {
    position: absolute;
    left: auto;
    right: 10px;
    bottom: 52px;
    width: 460px;
    height: 56px;
    overflow: hidden;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    transition-property: height;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}

.ps-battle-hand.ps-gboard-hand-fan.ps-gboard-hand-open {
    height: 310px;
    overflow: visible;
    background-color: rgba(0, 0, 0, 0);
}

.ps-gboard-fan-peek:hover {
    translate: 0 0;
    scale: 1 1 1;
}

.ps-gboard-fan-selected {
    translate: 0 -18px;
    scale: 1.04 1.04 1;
}

.ps-gboard-selected {
    position: absolute;
    right: 28px;
    top: 96px;
    width: 252px;
    height: 354px;
    padding: 0;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.ps-battle-card.ps-gboard-selected-card {
    position: relative;
    width: 252px;
    height: 354px;
    min-width: 252px;
    min-height: 354px;
    max-width: 252px;
    max-height: 354px;
}

.ps-gboard-selected-card .ps-gboard-card-glyph {
    font-size: 56px;
}

.ps-gboard-selected-card .ps-battle-card-name {
    font-size: 20px;
}

.ps-gboard-selected-card .ps-battle-card-text {
    font-size: 14px;
}

.ps-gboard-card-glyph {
    font-size: 42px;
    color: rgb(255, 230, 170);
    -unity-text-align: middle-center;
    -unity-font-definition: resource("Fonts/KleeOne-SemiBold");
}

.ps-gboard-row {
    flex-direction: row;
    flex-grow: 0;
    flex-shrink: 0;
    justify-content: flex-start;
    align-items: flex-start;
}

.ps-gboard-cell {
    width: 56px;
    height: 56px;
    margin: 1px;
    padding: 0;
    flex-grow: 0;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    background-color: rgb(58, 48, 38);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(140, 120, 80, 0.55);
    border-right-color: rgba(140, 120, 80, 0.55);
    border-top-color: rgba(140, 120, 80, 0.55);
    border-bottom-color: rgba(140, 120, 80, 0.55);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

.ps-gboard-cell-mark {
    font-size: 14px;
    color: rgb(240, 225, 190);
    -unity-text-align: middle-center;
}

.ps-gboard-floor {
    background-color: rgb(58, 48, 38);
}

.ps-gboard-blocked {
    background-color: rgb(28, 24, 22);
    border-left-color: rgba(60, 50, 40, 0.8);
    border-right-color: rgba(60, 50, 40, 0.8);
    border-top-color: rgba(60, 50, 40, 0.8);
    border-bottom-color: rgba(60, 50, 40, 0.8);
}

.ps-gboard-start {
    background-color: rgb(48, 70, 88);
    border-left-color: rgb(120, 180, 210);
    border-right-color: rgb(120, 180, 210);
    border-top-color: rgb(120, 180, 210);
    border-bottom-color: rgb(120, 180, 210);
}

.ps-gboard-goal {
    background-color: rgb(78, 58, 36);
    border-left-color: rgb(230, 180, 80);
    border-right-color: rgb(230, 180, 80);
    border-top-color: rgb(230, 180, 80);
    border-bottom-color: rgb(230, 180, 80);
}

.ps-gboard-lamp {
    background-color: rgb(88, 62, 28);
}

.ps-gboard-fog {
    background-color: rgb(52, 64, 78);
}

.ps-gboard-seal {
    background-color: rgb(72, 36, 48);
}

.ps-gboard-enemy {
    background-color: rgb(68, 40, 78);
}

.ps-gboard-event {
    background-color: rgb(48, 58, 92);
}

.ps-gboard-next {
    background-color: rgb(40, 78, 68);
}

.ps-gboard-return {
    background-color: rgb(88, 68, 36);
}

.ps-gboard-gate {
    flex-direction: column;
    flex-shrink: 0;
    margin-top: 10px;
    padding-top: 8px;
    border-top-width: 1px;
    border-top-color: rgba(200, 160, 80, 0.45);
}

.ps-gboard-gate-title {
    font-size: 15px;
    color: rgb(255, 220, 160);
    margin-bottom: 8px;
    -unity-font-definition: resource("Fonts/KleeOne-SemiBold");
}

.ps-gboard-gate > .ps-gboard-action {
    margin-bottom: 6px;
}

.ps-gboard-path {
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(80, 210, 230);
    border-right-color: rgb(80, 210, 230);
    border-top-color: rgb(80, 210, 230);
    border-bottom-color: rgb(80, 210, 230);
}

.ps-gboard-piece {
    background-color: rgb(120, 92, 36);
}

.ps-gboard-actions {
    flex-direction: column;
    flex-shrink: 0;
}

.ps-gboard-dirs {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 8px;
}

.ps-gboard-dir {
    width: 52px;
    height: 40px;
    margin-right: 6px;
    margin-bottom: 6px;
    font-size: 18px;
    background-color: rgba(40, 34, 28, 0.95);
    color: rgb(230, 210, 160);
}

.ps-gboard-dir-hot {
    border-left-color: rgb(100, 210, 230);
    border-right-color: rgb(100, 210, 230);
    border-top-color: rgb(100, 210, 230);
    border-bottom-color: rgb(100, 210, 230);
    color: rgb(200, 245, 255);
}

.ps-gboard-preview {
    border-left-color: rgba(100, 200, 220, 0.45);
    border-right-color: rgba(100, 200, 220, 0.45);
    border-top-color: rgba(100, 200, 220, 0.45);
    border-bottom-color: rgba(100, 200, 220, 0.45);
    background-color: rgb(48, 58, 68);
}

.ps-gboard-action {
    margin-bottom: 5px;
    min-height: 30px;
    font-size: 12px;
}

.ps-gboard-hand {
    flex-shrink: 0;
    min-height: 118px;
    padding: 10px 12px;
    flex-direction: column;
    background-color: rgba(18, 14, 28, 0.94);
    border-left-width: 2px;
    border-left-color: rgb(80, 210, 220);
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-right-color: rgba(90, 160, 170, 0.4);
    border-top-color: rgba(90, 160, 170, 0.4);
    border-bottom-color: rgba(90, 160, 170, 0.4);
}

.ps-gboard-hand-title {
    font-size: 13px;
    color: rgb(180, 240, 245);
    margin-bottom: 8px;
    letter-spacing: 1px;
}

.ps-gboard-hand-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: stretch;
}

.ps-gboard-card {
    width: 148px;
    min-height: 72px;
    margin-right: 8px;
    margin-bottom: 4px;
    padding: 8px;
    font-size: 12px;
    white-space: normal;
    -unity-text-align: upper-left;
    background-color: rgba(28, 36, 48, 0.96);
    color: rgb(220, 235, 240);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(90, 180, 190, 0.55);
    border-right-color: rgba(90, 180, 190, 0.55);
    border-top-color: rgba(90, 180, 190, 0.55);
    border-bottom-color: rgba(90, 180, 190, 0.55);
}

.ps-gboard-card.ps-selected {
    background-color: rgba(24, 70, 78, 0.98);
    border-left-color: rgb(120, 240, 250);
    border-right-color: rgb(120, 240, 250);
    border-top-color: rgb(120, 240, 250);
    border-bottom-color: rgb(120, 240, 250);
}

.ps-gboard-hand-empty {
    font-size: 12px;
    color: rgba(170, 190, 200, 0.75);
    padding: 12px 4px;
}


.ps-xmap-rite {
    background-color: rgb(92, 68, 44);
}

.ps-xmap-view {
    position: absolute;
    left: 372px;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(92, 68, 44);
}

.ps-xmap-top-sub {
    font-size: 11px;
    color: rgba(170, 145, 95, 0.78);
    margin-top: 2px;
    letter-spacing: 1px;
}

.ps-xmap-sketch {
    position: absolute;
    right: 18px;
    bottom: 18px;
    width: 220px;
    height: 150px;
    padding: 8px 10px;
    background-color: rgba(12, 10, 14, 0.78);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(180, 145, 80, 0.35);
    border-right-color: rgba(180, 145, 80, 0.35);
    border-top-color: rgba(180, 145, 80, 0.35);
    border-bottom-color: rgba(180, 145, 80, 0.35);
}

.ps-xmap-sketch-title {
    font-size: 10px;
    color: rgba(190, 165, 110, 0.85);
    margin-bottom: 4px;
    letter-spacing: 1px;
}

.ps-xmap-sketch-canvas {
    position: relative;
    flex-grow: 1;
    width: 100%;
    height: 110px;
    background-color: rgba(20, 18, 24, 0.5);
}

.ps-xmap-sketch-link {
    position: absolute;
    height: 2px;
    margin-left: 0;
    margin-top: -1px;
    background-color: rgba(210, 175, 95, 0.55);
    transform-origin: 0% 50%;
}

.ps-xmap-sketch-link-hidden {
    background-color: rgba(150, 130, 210, 0.55);
}

.ps-xmap-sketch-link-breach {
    background-color: rgba(180, 90, 120, 0.65);
}

.ps-xmap-sketch-pip {
    position: absolute;
    width: 8px;
    height: 8px;
    margin-left: -4px;
    margin-top: -4px;
    background-color: rgba(230, 200, 140, 0.9);
    border-radius: 0;
}

.ps-xmap-sketch-pip-mark {
    width: 10px;
    height: 10px;
    margin-left: -5px;
    margin-top: -5px;
    background-color: rgba(200, 140, 230, 0.95);
}

.ps-xmap-sketch-pip-current {
    width: 12px;
    height: 12px;
    margin-left: -6px;
    margin-top: -6px;
    background-color: rgba(255, 210, 90, 1);
}

.ps-xmap-view-frame {
    position: absolute;
    left: 372px;
    right: 0;
    top: 0;
    bottom: 0;
    border-left-width: 1px;
    border-left-color: rgba(198, 158, 78, 0.28);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
}

.ps-xmap-dock {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 372px;
    padding: 76px 16px 10px 16px;
    flex-direction: column;
    background-color: rgb(72, 52, 34);
    border-right-width: 1px;
    border-right-color: rgba(170, 135, 70, 0.55);
}

.ps-xmap-maphand {
    position: absolute;
    left: 388px;
    right: 16px;
    bottom: 14px;
    min-height: 118px;
    padding: 10px 12px;
    flex-direction: column;
    background-color: rgba(18, 14, 28, 0.94);
    border-left-width: 2px;
    border-left-color: rgb(80, 210, 220);
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-right-color: rgba(90, 160, 170, 0.4);
    border-top-color: rgba(90, 160, 170, 0.4);
    border-bottom-color: rgba(90, 160, 170, 0.4);
}

.ps-xmap-maphand-head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
}

.ps-xmap-maphand-title {
    font-size: 13px;
    color: rgb(180, 240, 245);
    letter-spacing: 1px;
}

.ps-xmap-maphand-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: stretch;
}

.ps-xmap-mapcard {
    width: 148px;
    min-height: 72px;
    margin-right: 8px;
    margin-bottom: 4px;
    padding: 8px;
    font-size: 12px;
    white-space: normal;
    -unity-text-align: upper-left;
    background-color: rgba(28, 36, 48, 0.96);
    color: rgb(220, 235, 240);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(90, 180, 190, 0.55);
    border-right-color: rgba(90, 180, 190, 0.55);
    border-top-color: rgba(90, 180, 190, 0.55);
    border-bottom-color: rgba(90, 180, 190, 0.55);
}

.ps-xmap-mapcard.ps-selected {
    background-color: rgba(24, 70, 78, 0.98);
    border-left-color: rgb(120, 240, 250);
    border-right-color: rgb(120, 240, 250);
    border-top-color: rgb(120, 240, 250);
    border-bottom-color: rgb(120, 240, 250);
    color: rgb(230, 255, 255);
}

.ps-xmap-maphand-empty {
    font-size: 12px;
    color: rgba(170, 190, 200, 0.75);
    padding: 12px 4px;
}

.ps-xmap-top {
    position: absolute;
    left: 12px;
    right: 12px;
    top: 10px;
    height: 54px;
    min-height: 54px;
    flex-direction: row;
    align-items: center;
    padding: 0 14px;
    background-color: rgba(54, 38, 24, 0.96);
    border-left-width: 2px;
    border-left-color: rgb(212, 168, 72);
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-right-color: rgba(150, 125, 80, 0.35);
    border-top-color: rgba(150, 125, 80, 0.35);
    border-bottom-color: rgba(150, 125, 80, 0.35);
}

.ps-xmap-top-actions {
    margin-left: auto;
    flex-direction: row;
    align-items: center;
}

.ps-xmap-top-actions > .ps-rite-chip {
    margin-right: 0;
    margin-left: 6px;
    margin-bottom: 0;
    min-width: 96px;
}

.ps-xmap-panel {
    flex-grow: 1;
    flex-shrink: 1;
    width: 100%;
    min-height: 220px;
    padding: 18px 18px 16px 18px;
    flex-direction: column;
    background-color: rgba(54, 38, 24, 0.94);
    border-left-width: 2px;
    border-left-color: rgb(212, 168, 72);
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-right-color: rgba(140, 115, 75, 0.32);
    border-top-color: rgba(140, 115, 75, 0.32);
    border-bottom-color: rgba(140, 115, 75, 0.32);
}

.ps-xmap-panel-eye {
    font-size: 10px;
    letter-spacing: 3px;
    color: rgba(170, 150, 105, 0.72);
    margin-bottom: 8px;
}

.ps-xmap-panel-type {
    font-size: 12px;
    color: rgb(210, 175, 95);
    margin-bottom: 4px;
    -unity-font-definition: resource("Fonts/KleeOne-SemiBold");
}

.ps-xmap-panel-title {
    font-size: 26px;
    color: rgb(255, 238, 200);
    margin-bottom: 8px;
    -unity-font-definition: resource("Fonts/KleeOne-SemiBold");
}

.ps-xmap-panel-status {
    font-size: 13px;
    color: rgb(230, 205, 145);
    margin-bottom: 12px;
    white-space: normal;
}

.ps-xmap-panel-rule {
    height: 1px;
    margin-bottom: 12px;
    background-color: rgba(180, 145, 75, 0.35);
    flex-shrink: 0;
}

.ps-xmap-panel-body {
    font-size: 14px;
    color: rgba(210, 195, 160, 0.95);
    white-space: normal;
    margin-bottom: 14px;
    flex-grow: 1;
}

.ps-xmap-panel-hint {
    font-size: 11px;
    color: rgba(145, 135, 112, 0.88);
    margin-bottom: 0;
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: rgba(120, 100, 65, 0.28);
    white-space: normal;
}

.ps-xmap-compass {
    flex-shrink: 0;
    width: 100%;
    margin-top: 12px;
    padding: 12px 10px 6px 10px;
    flex-direction: column;
    align-items: center;
    background-color: rgba(16, 13, 18, 0.9);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(150, 120, 70, 0.35);
    border-right-color: rgba(150, 120, 70, 0.35);
    border-top-color: rgba(150, 120, 70, 0.35);
    border-bottom-color: rgba(150, 120, 70, 0.35);
}

.ps-xmap-compass-head {
    width: 100%;
    flex-direction: column;
    margin-bottom: 4px;
}

.ps-xmap-compass-title {
    font-size: 16px;
    color: rgb(255, 232, 186);
    margin-bottom: 2px;
    -unity-font-definition: resource("Fonts/KleeOne-SemiBold");
}

.ps-xmap-compass-sub {
    font-size: 10px;
    color: rgba(160, 145, 110, 0.8);
    margin-bottom: 2px;
}

.ps-xmap-axis-row {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    margin-top: 6px;
    margin-bottom: 2px;
}

.ps-xmap-axis-chip {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    margin-left: 3px;
    margin-right: 3px;
    padding: 6px 8px;
    background-color: rgba(8, 7, 10, 0.75);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(120, 100, 65, 0.35);
    border-right-color: rgba(120, 100, 65, 0.35);
    border-top-color: rgba(120, 100, 65, 0.35);
    border-bottom-color: rgba(120, 100, 65, 0.35);
}

.ps-xmap-axis-swatch {
    width: 8px;
    height: 8px;
    margin-right: 6px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    background-color: rgb(200, 180, 120);
}

.ps-xmap-axis-alert > .ps-xmap-axis-swatch {
    background-color: rgb(210, 68, 42);
}

.ps-xmap-axis-collapse > .ps-xmap-axis-swatch {
    background-color: rgb(210, 150, 55);
}

.ps-xmap-axis-corruption > .ps-xmap-axis-swatch {
    background-color: rgb(140, 78, 190);
}

.ps-xmap-axis-name {
    font-size: 10px;
    color: rgba(180, 165, 130, 0.9);
    margin-right: 4px;
}

.ps-xmap-axis-value {
    font-size: 13px;
    color: rgb(245, 220, 160);
    margin-left: auto;
    -unity-font-definition: resource("Fonts/KleeOne-SemiBold");
}

.ps-xmap-actions {
    flex-direction: row;
    align-items: center;
}

.ps-xmap-move {
    flex-grow: 1;
    margin-right: 8px;
    margin-bottom: 0;
    min-width: 140px;
}

.ps-xmap-mist {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(4, 3, 6, 0.62);
}

.ps-xmap-mist-veil {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(2, 2, 4, 0.35);
}

.ps-xmap-mist-cloud {
    position: absolute;
    background-color: rgba(0, 0, 0, 0.42);
    border-top-left-radius: 120px;
    border-top-right-radius: 120px;
    border-bottom-left-radius: 120px;
    border-bottom-right-radius: 120px;
}

.ps-xmap-mist-cloud-0 {
    left: -8%;
    top: 8%;
    width: 48%;
    height: 34%;
}

.ps-xmap-mist-cloud-1 {
    right: -6%;
    top: 4%;
    width: 46%;
    height: 36%;
}

.ps-xmap-mist-cloud-2 {
    left: -10%;
    bottom: 6%;
    width: 52%;
    height: 38%;
}

.ps-xmap-mist-cloud-3 {
    right: -8%;
    bottom: 8%;
    width: 48%;
    height: 34%;
}

.ps-xmap-mist-panel {
    width: 52%;
    max-width: 680px;
    margin: 0;
}

.ps-xmap-stats {
    margin-left: 14px;
    margin-right: 10px;
    font-size: 12px;
    color: rgb(220, 198, 150);
    -unity-font-definition: resource("Fonts/KleeOne-SemiBold");
    flex-shrink: 1;
    white-space: normal;
}

/* Shallow viewport: circle diameter ~300, center ~50px under the bottom edge */
.ps-xmap-gauge {
    width: 300px;
    height: 110px;
    align-self: center;
    background-color: rgba(0, 0, 0, 0);
    overflow: hidden;
}

.ps-xmap-gauge-dial {
    position: absolute;
    width: 300px;
    height: 300px;
    left: 0;
    bottom: -190px;
    background-color: rgba(34, 26, 16, 0.96);
    border-top-left-radius: 150px;
    border-top-right-radius: 150px;
    border-bottom-left-radius: 150px;
    border-bottom-right-radius: 150px;
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-color: rgb(212, 168, 72);
    border-right-color: rgb(212, 168, 72);
    border-top-color: rgb(212, 168, 72);
    border-bottom-color: rgb(212, 168, 72);
}

.ps-xmap-gauge-rim {
    position: absolute;
    width: 276px;
    height: 276px;
    left: 12px;
    bottom: -178px;
    background-color: rgba(0, 0, 0, 0);
    border-top-left-radius: 138px;
    border-top-right-radius: 138px;
    border-bottom-left-radius: 138px;
    border-bottom-right-radius: 138px;
    border-left-width: 8px;
    border-right-width: 8px;
    border-top-width: 8px;
    border-bottom-width: 8px;
    border-left-color: rgba(210, 170, 90, 0.28);
    border-right-color: rgba(210, 170, 90, 0.28);
    border-top-color: rgba(210, 170, 90, 0.28);
    border-bottom-color: rgba(210, 170, 90, 0.28);
}

.ps-xmap-gauge-tick {
    position: absolute;
    left: 50%;
    bottom: -40px;
    width: 2px;
    height: 130px;
    margin-left: -1px;
    background-color: rgba(190, 160, 95, 0.4);
    transform-origin: 50% 100%;
}

.ps-xmap-gauge-tick-major {
    width: 3px;
    height: 138px;
    margin-left: -1.5px;
    background-color: rgba(235, 200, 120, 0.95);
}

.ps-xmap-gauge-num {
    position: absolute;
    width: 36px;
    margin-left: -18px;
    margin-top: -10px;
    font-size: 12px;
    color: rgb(245, 220, 160);
    -unity-text-align: middle-center;
    -unity-font-definition: resource("Fonts/KleeOne-SemiBold");
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9);
}

.ps-xmap-needle {
    position: absolute;
    left: 50%;
    bottom: -40px;
    width: 3px;
    height: 132px;
    margin-left: -1.5px;
    transform-origin: 50% 100%;
}

.ps-xmap-needle-alert {
    background-color: rgb(210, 68, 42);
    height: 136px;
    width: 3px;
}

.ps-xmap-needle-collapse {
    background-color: rgb(210, 150, 55);
    height: 112px;
    width: 2px;
}

.ps-xmap-needle-corruption {
    background-color: rgb(140, 78, 190);
    height: 88px;
    width: 2px;
}

.ps-xmap-gauge-hub {
    position: absolute;
    left: 50%;
    bottom: -47px;
    width: 14px;
    height: 14px;
    margin-left: -7px;
    background-color: rgb(220, 190, 120);
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(90, 70, 40);
    border-right-color: rgb(90, 70, 40);
    border-top-color: rgb(90, 70, 40);
    border-bottom-color: rgb(90, 70, 40);
}

.ps-xmap-finish {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(4, 3, 6, 0.62);
}

.ps-xmap-finish-dialog {
    width: 48%;
    max-width: 560px;
    padding: 24px 26px;
    background-color: rgba(14, 12, 16, 0.97);
    border-left-width: 3px;
    border-left-color: rgb(212, 168, 72);
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-right-color: rgba(150, 125, 80, 0.35);
    border-top-color: rgba(150, 125, 80, 0.35);
    border-bottom-color: rgba(150, 125, 80, 0.35);
}

/* --- 2.5D route exploration (full-bleed stage, mini HUD) --- */
.ps-xmap-route {
    background-color: rgb(178, 184, 204);
}

.ps-xmap-route .ps-xmap-view {
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(178, 184, 204);
}

.ps-xmap-route .ps-xmap-view-frame {
    left: 0;
    display: none;
}

.ps-xmap-route .ps-xmap-top {
    display: none;
}

.ps-xmap-route .ps-xmap-dock {
    display: none;
}

.ps-xmap-hud {
    display: none;
}

.ps-xmap-mini {
    position: absolute;
    left: 14px;
    top: 12px;
    min-width: 120px;
    max-width: 220px;
    padding: 6px 8px;
    background-color: rgba(8, 9, 12, 0.52);
    border-left-width: 2px;
    border-left-color: rgba(212, 168, 72, 0.7);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgba(120, 100, 70, 0.25);
    border-right-color: rgba(120, 100, 70, 0.25);
    border-bottom-color: rgba(120, 100, 70, 0.25);
}

.ps-xmap-mini-name {
    font-size: 14px;
    color: rgb(245, 230, 190);
    margin-bottom: 2px;
}

.ps-xmap-mini-district {
    font-size: 11px;
    color: rgba(200, 185, 150, 0.85);
    margin-bottom: 4px;
    white-space: normal;
}

.ps-xmap-mini-row {
    flex-direction: row;
    align-items: center;
}

.ps-xmap-mini-bearing {
    font-size: 11px;
    color: rgba(180, 200, 210, 0.9);
    width: 22px;
    margin-right: 6px;
}

.ps-xmap-mini-info {
    width: 28px;
    height: 24px;
    min-width: 28px;
    font-size: 12px;
    padding: 0;
    background-color: rgba(30, 28, 24, 0.7);
    color: rgb(230, 210, 160);
}

.ps-xmap-detail {
    position: absolute;
    left: 14px;
    top: 86px;
    width: 240px;
    padding: 10px 12px;
    background-color: rgba(10, 10, 14, 0.88);
    border-left-width: 2px;
    border-left-color: rgba(212, 168, 72, 0.65);
}

.ps-xmap-detail-body {
    font-size: 12px;
    color: rgba(230, 215, 180, 0.92);
    white-space: normal;
}

.ps-xmap-axis-meter {
    position: absolute;
    right: 14px;
    bottom: 16px;
    width: 84px;
    height: 84px;
    background-color: rgba(8, 9, 12, 0.45);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(140, 120, 80, 0.35);
    border-right-color: rgba(140, 120, 80, 0.35);
    border-bottom-color: rgba(140, 120, 80, 0.35);
    border-left-color: rgba(140, 120, 80, 0.35);
    border-radius: 42px;
    align-items: center;
    justify-content: center;
}

.ps-xmap-axis-meter-dial {
    position: absolute;
    left: 10px;
    right: 10px;
    top: 10px;
    bottom: 10px;
    border-radius: 32px;
    background-color: rgba(20, 22, 28, 0.55);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(180, 150, 90, 0.35);
    border-right-color: rgba(180, 150, 90, 0.35);
    border-bottom-color: rgba(180, 150, 90, 0.35);
    border-left-color: rgba(180, 150, 90, 0.35);
}

.ps-xmap-axis-meter .ps-xmap-needle {
    bottom: 42px;
    height: 34px;
    width: 2px;
    margin-left: -1px;
}

.ps-xmap-axis-meter .ps-xmap-needle-alert {
    height: 36px;
}

.ps-xmap-axis-meter .ps-xmap-needle-collapse {
    height: 30px;
}

.ps-xmap-axis-meter .ps-xmap-needle-corruption {
    height: 24px;
}

.ps-xmap-axis-tip {
    position: absolute;
    right: 92px;
    bottom: 8px;
    min-width: 120px;
    padding: 8px 10px;
    background-color: rgba(10, 10, 14, 0.9);
    border-left-width: 2px;
    border-left-color: rgba(212, 168, 72, 0.7);
}

.ps-xmap-axis-tip-body {
    font-size: 11px;
    color: rgba(230, 215, 180, 0.95);
    white-space: normal;
}

.ps-xmap-confirm {
    position: absolute;
    width: 200px;
    padding: 12px 12px 10px 12px;
    background-color: rgba(12, 11, 16, 0.92);
    border-left-width: 2px;
    border-left-color: rgba(212, 168, 72, 0.8);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgba(140, 120, 80, 0.35);
    border-right-color: rgba(140, 120, 80, 0.35);
    border-bottom-color: rgba(140, 120, 80, 0.35);
}

.ps-xmap-confirm-title {
    font-size: 15px;
    color: rgb(245, 230, 190);
    margin-bottom: 4px;
}

.ps-xmap-confirm-kind {
    font-size: 12px;
    color: rgba(200, 170, 110, 0.95);
    margin-bottom: 6px;
}

.ps-xmap-confirm-body {
    font-size: 12px;
    color: rgba(220, 205, 170, 0.9);
    white-space: normal;
    margin-bottom: 4px;
}

.ps-xmap-confirm-delta {
    font-size: 11px;
    color: rgba(255, 180, 140, 0.95);
    white-space: normal;
    margin-bottom: 10px;
}

.ps-xmap-confirm-actions {
    flex-direction: row;
}

.ps-xmap-confirm-go {
    flex-grow: 1;
    margin-right: 6px;
    height: 32px;
    font-size: 13px;
}

.ps-xmap-confirm-back {
    flex-grow: 1;
    height: 32px;
    font-size: 13px;
    background-color: rgba(40, 38, 44, 0.9);
}

.ps-xmap-finish-chip {
    position: absolute;
    left: 14px;
    bottom: 16px;
    width: 96px;
    height: 30px;
    font-size: 12px;
    background-color: rgba(12, 12, 16, 0.55);
    color: rgba(220, 200, 160, 0.9);
}

.ps-dev-access-hint {
    left: auto;
    right: 16px;
    top: 14px;
    bottom: auto;
    width: 72px;
    height: 28px;
    font-size: 11px;
    background-color: rgba(18, 20, 24, 0.55);
    color: rgba(210, 190, 140, 0.72);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(160, 130, 70, 0.4);
    border-right-color: rgba(160, 130, 70, 0.4);
    border-top-color: rgba(160, 130, 70, 0.4);
    border-bottom-color: rgba(160, 130, 70, 0.4);
}

.ps-route-battle {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.ps-route-battle-hero-hud {
    position: absolute;
    left: 18px;
    top: 58%;
    width: 160px;
    padding: 8px 10px;
    background-color: rgb(8, 10, 14);
    color: rgb(235, 225, 200);
    font-size: 13px;
    white-space: normal;
}

.ps-route-battle-enemy-hud {
    position: absolute;
    right: 18px;
    top: 58%;
    width: 180px;
    padding: 8px 10px;
    background-color: rgb(14, 8, 10);
    color: rgb(245, 210, 200);
    font-size: 13px;
    white-space: normal;
}

.ps-route-battle-intent {
    position: absolute;
    right: 18px;
    top: 18%;
    min-width: 160px;
    padding: 6px 10px;
    background-color: rgb(28, 10, 12);
    color: rgb(255, 190, 160);
    font-size: 13px;
}

.ps-route-battle-log {
    position: absolute;
    left: 22%;
    right: 22%;
    top: 52%;
    padding: 6px 10px;
    background-color: rgb(10, 10, 14);
    color: rgb(230, 220, 190);
    font-size: 13px;
    -unity-text-align: middle-center;
}

.ps-route-battle-bottom {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 42%;
    padding: 8px 14px 10px 14px;
    background-color: rgb(3, 3, 5);
    border-top-width: 1px;
    border-top-color: rgb(180, 140, 70);
    flex-direction: column;
}

.ps-route-battle-consumables {
    flex-direction: row;
    align-items: center;
    height: 40px;
    margin-bottom: 6px;
    background-color: rgb(5, 5, 7);
    padding-left: 6px;
    padding-right: 6px;
}

.ps-route-battle-cons-cap {
    margin-right: 8px;
    color: rgb(210, 190, 140);
    font-size: 12px;
}

.ps-route-battle-cons,
.ps-route-battle .ps-button.ps-route-battle-cons {
    min-width: 72px;
    height: 34px;
    margin-right: 6px;
    background-color: rgb(7, 7, 9);
    background-image: none;
    color: rgb(238, 228, 202);
    border-left-color: rgb(160, 130, 70);
    border-right-color: rgb(160, 130, 70);
    border-top-color: rgb(160, 130, 70);
    border-bottom-color: rgb(160, 130, 70);
}

.ps-route-battle-hand {
    flex-grow: 1;
    flex-direction: row;
    align-items: flex-end;
    justify-content: center;
    background-color: rgb(3, 3, 5);
}

.ps-route-battle-card,
.ps-route-battle .ps-button.ps-route-battle-card {
    width: 132px;
    height: 168px;
    margin-left: 4px;
    margin-right: 4px;
    white-space: normal;
    font-size: 11px;
    -unity-text-align: upper-center;
    background-color: rgb(6, 6, 8);
    background-image: none;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(196, 160, 90);
    border-right-color: rgb(196, 160, 90);
    border-top-color: rgb(196, 160, 90);
    border-bottom-color: rgb(196, 160, 90);
    color: rgb(238, 228, 202);
}

.ps-route-battle-rail {
    flex-direction: row;
    align-items: center;
    height: 44px;
    margin-top: 4px;
    padding-left: 8px;
    padding-right: 8px;
    background-color: rgb(4, 4, 6);
}

.ps-route-battle-energy {
    flex-grow: 1;
    color: rgb(235, 210, 150);
    font-size: 14px;
    background-color: rgb(4, 4, 6);
}

.ps-route-battle-skill,
.ps-route-battle .ps-button.ps-route-battle-skill,
.ps-route-battle-end,
.ps-route-battle .ps-button.ps-route-battle-end {
    min-width: 140px;
    height: 38px;
    background-color: rgb(8, 8, 10);
    background-image: none;
    color: rgb(238, 228, 202);
    border-left-color: rgb(196, 160, 90);
    border-right-color: rgb(196, 160, 90);
    border-top-color: rgb(196, 160, 90);
    border-bottom-color: rgb(196, 160, 90);
}

.ps-route-battle-skill:disabled,
.ps-route-battle .ps-button.ps-route-battle-skill:disabled {
    color: rgba(180, 170, 150, 0.45);
    border-left-color: rgba(120, 100, 70, 0.45);
    border-right-color: rgba(120, 100, 70, 0.45);
    border-top-color: rgba(120, 100, 70, 0.45);
    border-bottom-color: rgba(120, 100, 70, 0.45);
}


.ps-xmap-hint-guide {
    position: absolute;
    left: 14px;
    bottom: 14px;
    width: 260px;
    padding: 8px 10px;
    background-color: rgba(8, 8, 12, 0.55);
    border-left-width: 2px;
    border-left-color: rgba(200, 160, 70, 0.65);
}

.ps-xmap-hint-guide-label {
    font-size: 11px;
    color: rgba(230, 215, 180, 0.9);
    white-space: normal;
}

.ps-route-reward {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(4, 4, 8, 0.35);
}

.ps-route-reward-panel {
    width: 420px;
    padding: 18px 20px;
    background-color: rgba(12, 11, 16, 0.92);
    border-left-width: 3px;
    border-left-color: rgb(212, 168, 72);
    flex-direction: column;
}

.ps-route-reward-choice {
    margin-top: 8px;
    min-height: 56px;
    white-space: normal;
}

/* --- Large analog axis instrument (clipped into bottom-right) --- */
.ps-axis-instrument {
    position: absolute;
    right: -110px;
    bottom: -130px;
    width: 320px;
    height: 320px;
    overflow: visible;
}

/* Visible NW sector only 窶・keeps dialogue / choices from hitting the dial frame. */
.ps-axis-instrument-hit {
    position: absolute;
    left: 8px;
    top: 8px;
    width: 170px;
    height: 170px;
    background-color: rgba(0, 0, 0, 0);
}

.ps-axis-instrument-dim {
    opacity: 0.55;
}

.ps-axis-instrument-preview-focus {
    opacity: 1;
}

.ps-axis-instrument-danger .ps-axis-instrument-body {
    border-left-color: rgb(210, 90, 70);
    border-right-color: rgb(210, 90, 70);
    border-top-color: rgb(210, 90, 70);
    border-bottom-color: rgb(210, 90, 70);
}

.ps-axis-instrument-body {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    border-top-left-radius: 160px;
    border-top-right-radius: 160px;
    border-bottom-left-radius: 160px;
    border-bottom-right-radius: 160px;
    background-color: rgb(28, 24, 20);
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-color: rgb(160, 130, 70);
    border-right-color: rgb(160, 130, 70);
    border-top-color: rgb(160, 130, 70);
    border-bottom-color: rgb(160, 130, 70);
    overflow: hidden;
}

.ps-axis-ring {
    position: absolute;
    left: 18px;
    right: 18px;
    top: 18px;
    bottom: 18px;
    border-top-left-radius: 140px;
    border-top-right-radius: 140px;
    border-bottom-left-radius: 140px;
    border-bottom-right-radius: 140px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(210, 180, 110, 0.35);
    border-right-color: rgba(210, 180, 110, 0.35);
    border-top-color: rgba(210, 180, 110, 0.35);
    border-bottom-color: rgba(210, 180, 110, 0.35);
}

.ps-axis-ring-mid {
    left: 42px;
    right: 42px;
    top: 42px;
    bottom: 42px;
    border-left-color: rgba(180, 90, 70, 0.4);
    border-right-color: rgba(180, 90, 70, 0.4);
    border-top-color: rgba(180, 90, 70, 0.4);
    border-bottom-color: rgba(180, 90, 70, 0.4);
}

.ps-axis-ring-inner {
    left: 68px;
    right: 68px;
    top: 68px;
    bottom: 68px;
    border-left-color: rgba(120, 90, 170, 0.45);
    border-right-color: rgba(120, 90, 170, 0.45);
    border-top-color: rgba(120, 90, 170, 0.45);
    border-bottom-color: rgba(120, 90, 170, 0.45);
}

.ps-axis-marks {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.ps-axis-tick {
    position: absolute;
    left: 50%;
    top: 12px;
    width: 2px;
    height: 14px;
    margin-left: -1px;
    background-color: rgba(210, 185, 130, 0.55);
    transform-origin: 50% 148px;
}

.ps-axis-stamp {
    position: absolute;
    width: 28px;
    height: 28px;
    align-items: center;
    justify-content: center;
}

.ps-axis-stamp-alert { left: 36px; top: 48px; }
.ps-axis-stamp-collapse { right: 40px; top: 52px; }
.ps-axis-stamp-corruption { left: 50%; bottom: 54px; margin-left: -14px; }

.ps-axis-stamp-glyph {
    font-size: 16px;
    color: rgba(230, 210, 160, 0.85);
    -unity-text-align: middle-center;
}

.ps-axis-needle,
.ps-axis-ghost {
    position: absolute;
    left: 50%;
    bottom: 50%;
    width: 3px;
    height: 118px;
    margin-left: -1.5px;
    transform-origin: 50% 100%;
    background-color: rgb(220, 80, 50);
}

.ps-axis-needle-collapse { width: 2px; height: 104px; background-color: rgb(210, 150, 55); }
.ps-axis-needle-corruption { width: 2px; height: 90px; background-color: rgb(140, 90, 190); }

.ps-axis-ghost { opacity: 0.4; }
.ps-axis-ghost.ps-axis-needle-alert { background-color: rgba(255, 140, 100, 0.7); }
.ps-axis-ghost.ps-axis-needle-collapse { background-color: rgba(255, 200, 100, 0.65); }
.ps-axis-ghost.ps-axis-needle-corruption { background-color: rgba(190, 150, 255, 0.65); }

.ps-axis-glow {
    position: absolute;
    width: 48px;
    height: 48px;
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
    border-bottom-left-radius: 24px;
    border-bottom-right-radius: 24px;
    opacity: 0;
}

.ps-axis-glow-alert { left: 28px; top: 40px; background-color: rgba(220, 80, 50, 0.35); }
.ps-axis-glow-collapse { right: 32px; top: 44px; background-color: rgba(210, 150, 55, 0.35); }
.ps-axis-glow-corruption { left: 50%; bottom: 46px; margin-left: -24px; background-color: rgba(140, 90, 190, 0.35); }

.ps-axis-glow-danger {
    background-color: rgba(255, 90, 60, 0.55);
}

.ps-axis-crack {
    position: absolute;
    background-color: rgba(40, 30, 24, 0.85);
    opacity: 0;
}
.ps-axis-crack-a { left: 70px; top: 90px; width: 2px; height: 70px; rotate: 18deg; }
.ps-axis-crack-b { right: 80px; bottom: 100px; width: 2px; height: 60px; rotate: -24deg; }

.ps-axis-noise {
    position: absolute;
    left: 24px;
    right: 24px;
    top: 24px;
    bottom: 24px;
    border-top-left-radius: 130px;
    border-top-right-radius: 130px;
    border-bottom-left-radius: 130px;
    border-bottom-right-radius: 130px;
    background-color: rgba(255, 220, 160, 0.04);
    opacity: 0;
}

.ps-axis-instrument-tip {
    position: absolute;
    left: -200px;
    top: 10px;
    width: 190px;
    padding: 10px 12px;
    background-color: rgba(12, 11, 14, 0.92);
    border-left-width: 2px;
    border-left-color: rgb(180, 145, 75);
    /* Tip must never expand the instrument hit box. */
}

.ps-axis-instrument-tip-body {
    font-size: 11px;
    color: rgba(230, 215, 180, 0.95);
    white-space: normal;
}

/* Soft context HUD 窶・not a heavy black panel */
.ps-xmap-route .ps-xmap-mini {
    background-color: rgba(10, 10, 12, 0.28);
    border-left-width: 0;
    padding: 6px 8px;
    min-width: 100px;
    max-width: 200px;
}

.ps-xmap-route .ps-xmap-mini-name {
    font-size: 13px;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.75);
}

.ps-xmap-route .ps-xmap-axis-meter {
    display: none;
}

/* Bottom dialogue gradient layer */
.ps-route-dialogue {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.ps-route-dialogue-veil {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 34%;
    background-color: rgba(4, 3, 6, 0.72);
}

.ps-route-dialogue-panel {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 30%;
    padding: 18px 28px 20px 28px;
    flex-direction: column;
    background-color: rgba(6, 5, 8, 0.55);
}

.ps-route-dialogue-speaker {
    font-size: 14px;
    color: rgb(220, 185, 110);
    margin-bottom: 6px;
    -unity-font-definition: resource("Fonts/KleeOne-SemiBold");
}

.ps-route-dialogue-body {
    font-size: 15px;
    color: rgb(235, 225, 200);
    white-space: normal;
    margin-bottom: 12px;
    flex-shrink: 0;
}

.ps-route-dialogue-choices {
    flex-direction: column;
    flex-grow: 1;
}

.ps-route-choice-row {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 6px;
    padding: 4px 2px;
    background-color: rgba(0, 0, 0, 0);
}

.ps-route-choice-mark {
    width: 22px;
    font-size: 15px;
    color: rgb(230, 190, 100);
}

.ps-route-choice-text {
    flex-grow: 1;
    font-size: 15px;
    color: rgba(220, 210, 185, 0.88);
    white-space: normal;
}

.ps-route-choice-hot .ps-route-choice-text {
    color: rgb(255, 240, 200);
    border-bottom-width: 1px;
    border-bottom-color: rgba(220, 180, 90, 0.7);
}

.ps-route-bubble {
    position: absolute;
    left: 18%;
    right: 30%;
    bottom: 38%;
    padding: 10px 14px;
    background-color: rgba(12, 11, 16, 0.82);
    border-left-width: 2px;
    border-left-color: rgb(200, 160, 80);
}

.ps-route-bubble-text {
    font-size: 14px;
    color: rgb(240, 230, 200);
    white-space: normal;
}

/* ===== Expedition shell: board first, fixed hero HUD, dossier right, hand below ===== */
.ps-gboard { background-color: rgb(15, 14, 19); }
.ps-gboard-top { left: 14px; right: 14px; top: 10px; height: 78px; min-height: 78px; justify-content: center; background-color: rgba(12, 13, 20, 0.97); border-left-width: 1px; border-left-color: rgba(194, 157, 81, 0.72); border-right-color: rgba(194, 157, 81, 0.38); border-top-color: rgba(194, 157, 81, 0.38); border-bottom-color: rgba(194, 157, 81, 0.5); }
.ps-gboard-top .ps-rite-brand { position: absolute; left: 50%; margin-left: -145px; width: 290px; justify-content: center; }
.ps-gboard-top .ps-rite-brand-mark, .ps-gboard-top-sub { display: none; }
.ps-gboard-top .ps-rite-top-title { align-items: center; }
.ps-gboard-top .ps-rite-top-name { font-size: 23px; color: rgb(231, 207, 144); letter-spacing: 5px; }
.ps-gboard-top .ps-rite-top-eyebrow { font-size: 10px; letter-spacing: 2px; color: rgba(194, 169, 112, 0.78); }
.ps-gboard-phase { position: absolute; left: 50%; bottom: 8px; margin-left: -160px; width: 320px; color: rgba(210, 190, 144, 0.8); font-size: 10px; -unity-text-align: middle-center; }
.ps-gboard-ink { position: absolute; right: 238px; top: 14px; margin-left: 0; color: rgb(134, 192, 220); }
.ps-gboard-doom { position: absolute; right: 72px; top: 13px; min-width: 150px; padding: 7px 10px; background-color: rgba(56, 23, 34, 0.64); border-left-color: rgb(220, 116, 116); }
.ps-gboard-top-finish { position: absolute; right: 14px; bottom: 10px; margin-left: 0; }

.ps-gboard-hero { position: absolute; left: 26px; top: 17px; width: 350px; min-height: 58px; margin-top: 0; padding: 0; background-color: rgba(0, 0, 0, 0); border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; }
.ps-gboard-portrait { width: 58px; height: 58px; margin-right: 10px; border-left-color: rgba(223, 184, 103, 0.66); border-right-color: rgba(223, 184, 103, 0.45); border-top-color: rgba(223, 184, 103, 0.45); border-bottom-color: rgba(223, 184, 103, 0.45); }
.ps-gboard-hero-name { display: none; }
.ps-gboard-hp-label { font-size: 17px; color: rgb(240, 205, 181); letter-spacing: 1px; margin-bottom: 5px; }
.ps-gboard-hp-track { height: 7px; max-width: 236px; border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; }
.ps-gboard-hp-fill { background-color: rgb(187, 82, 82); }

.ps-gboard-stage { left: 24px; right: 408px; top: 100px; bottom: 142px; padding: 0; background-color: rgba(14, 14, 21, 0.96); border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgba(203, 165, 87, 0.6); border-right-color: rgba(203, 165, 87, 0.35); border-top-color: rgba(203, 165, 87, 0.35); border-bottom-color: rgba(203, 165, 87, 0.6); }
.ps-gboard-viewport { background-color: rgba(9, 10, 16, 0.95); }
.ps-gboard-grid { padding: 8px; background-color: rgba(28, 28, 40, 0.42); border-left-color: rgba(209, 176, 99, 0.5); border-right-color: rgba(209, 176, 99, 0.5); border-top-color: rgba(209, 176, 99, 0.5); border-bottom-color: rgba(209, 176, 99, 0.5); }

.ps-gboard-dock { left: auto; right: 24px; top: 100px; bottom: 142px; width: 360px; padding: 0; background-color: rgba(0, 0, 0, 0); border-right-width: 0; }
.ps-gboard-panel { padding: 18px 17px; background-color: rgba(14, 14, 21, 0.96); border-left-color: rgb(198, 160, 83); }
.ps-gboard-panel-title { font-size: 23px; }
.ps-gboard-panel-body { font-size: 13px; }

.ps-gboard-combat-stage { right: 24px; top: 100px; width: 360px; min-width: 360px; bottom: 142px; padding: 22px 24px 18px; justify-content: flex-start; background-color: rgba(17, 14, 23, 0.98); border-left-color: rgb(215, 126, 119); }
.ps-gboard-combat-portrait { width: 100%; height: 250px; margin-bottom: 8px; }
.ps-gboard-combat-title { align-self: stretch; font-size: 24px; margin-bottom: 5px; }
.ps-gboard-combat-hp { align-self: stretch; padding: 9px 0; font-size: 16px; border-top-width: 1px; border-bottom-width: 1px; border-top-color: rgba(210, 154, 116, 0.28); border-bottom-color: rgba(210, 154, 116, 0.28); }
.ps-gboard-combat-intent { align-self: stretch; }
.ps-gboard-in-combat .ps-gboard-dock { display: none; }
.ps-gboard-zoom { right: 390px; top: 110px; background-color: rgba(12, 12, 18, 0.88); }

.ps-battle-hand.ps-gboard-hand-fan { left: 50%; right: auto; bottom: 54px; width: 720px; height: 62px; margin-left: -360px; }
.ps-battle-hand.ps-gboard-hand-fan.ps-gboard-hand-open { height: 344px; }
.ps-gboard-en-rail { left: 50%; right: auto; bottom: 7px; width: 720px; margin-left: -360px; min-height: 38px; background-color: rgba(10, 10, 15, 0.96); }
.ps-gboard-resolve { min-height: 64px; background-color: rgba(28, 16, 38, 0.98); }

/* Cell faces are a terrain layer. Actors are deliberately rendered above it. */
.ps-gboard-cell { position: relative; overflow: hidden; background-color: rgb(31, 29, 34); border-left-color: rgba(126, 105, 72, 0.72); border-right-color: rgba(73, 62, 48, 0.9); border-top-color: rgba(151, 127, 83, 0.7); border-bottom-color: rgba(47, 40, 35, 0.95); }
.ps-gboard-cell-face { position: absolute; left: 4px; right: 4px; top: 4px; bottom: 4px; background-color: rgba(72, 62, 51, 0.42); border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgba(179, 149, 92, 0.12); border-right-color: rgba(0, 0, 0, 0.28); border-top-color: rgba(190, 160, 100, 0.1); border-bottom-color: rgba(0, 0, 0, 0.32); }
.ps-gboard-cell-sigil { position: absolute; left: 0; right: 0; top: 3px; color: rgba(235, 212, 160, 0.28); font-size: 28px; -unity-text-align: middle-center; }
.ps-gboard-cell-mark { position: absolute; left: 0; right: 0; top: 0; bottom: 0; color: rgb(241, 221, 177); font-size: 13px; -unity-text-align: middle-center; }
.ps-gboard-cell.ps-gboard-blocked { background-color: rgb(13, 13, 17); border-color: rgba(49, 43, 43, 0.78); }
.ps-gboard-cell.ps-gboard-blocked .ps-gboard-cell-face { background-color: rgba(4, 4, 6, 0.9); border-color: rgba(59, 48, 46, 0.38); }
.ps-gboard-cell.ps-gboard-void { visibility: hidden; }
.ps-gboard-cell.ps-gboard-start .ps-gboard-cell-face { background-color: rgba(38, 91, 106, 0.62); }
.ps-gboard-cell.ps-gboard-goal .ps-gboard-cell-face, .ps-gboard-cell.ps-gboard-next .ps-gboard-cell-face { background-color: rgba(55, 104, 82, 0.58); }
.ps-gboard-cell.ps-gboard-lamp .ps-gboard-cell-face { background-color: rgba(128, 88, 28, 0.66); }
.ps-gboard-cell.ps-gboard-fog .ps-gboard-cell-face { background-color: rgba(55, 75, 111, 0.62); }
.ps-gboard-cell.ps-gboard-seal .ps-gboard-cell-face { background-color: rgba(98, 43, 73, 0.68); }
.ps-gboard-cell.ps-gboard-event .ps-gboard-cell-face { background-color: rgba(50, 66, 117, 0.62); }
.ps-gboard-cell.ps-gboard-return .ps-gboard-cell-face { background-color: rgba(110, 82, 35, 0.6); }
.ps-gboard-cell.ps-gboard-enemy { background-color: rgb(31, 29, 34); }
.ps-gboard-cell.ps-gboard-enemy .ps-gboard-cell-face { background-color: rgba(72, 62, 51, 0.42); }
.ps-gboard-cell.ps-gboard-path { border-color: rgb(88, 219, 225); }
.ps-gboard-cell.ps-gboard-preview { border-color: rgba(138, 181, 238, 0.9); }
.ps-gboard-cell.ps-gboard-piece .ps-gboard-cell-face { background-color: rgba(167, 125, 42, 0.72); }

.ps-gboard-actors { position: absolute; overflow: visible; }
.ps-gboard-actor { position: absolute; align-items: center; justify-content: center; }
.ps-gboard-enemy-actor { background-color: rgba(83, 31, 66, 0.92); border-left-width: 2px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgb(235, 116, 161); border-right-color: rgba(235, 116, 161, 0.58); border-top-color: rgba(235, 116, 161, 0.58); border-bottom-color: rgba(235, 116, 161, 0.58); }
.ps-gboard-actor-glyph { color: rgb(255, 213, 219); font-size: 25px; -unity-text-align: middle-center; }

/* Product panel art is native portrait ratio: keep it intact instead of stretching it. */
.ps-gboard-dock { bottom: auto; height: 600px; }
.ps-gboard-combat-stage { bottom: auto; height: 600px; }

/* PopDark raster chrome supplies the silhouette; USS owns readable text and states. */
.ps-gboard-action { min-height: 96px; margin-bottom: 9px; padding: 12px 30px; color: rgb(255, 229, 197); font-size: 13px; letter-spacing: 1.2px; -unity-text-align: middle-center; background-color: rgba(0, 0, 0, 0); border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; }
.ps-gboard-action:hover { color: rgb(255, 248, 225); }
.ps-gboard-action:active { color: rgb(255, 188, 207); }
.ps-gboard-action:disabled { opacity: 0.42; }
.ps-gboard-top-finish.ps-gboard-action { min-height: 34px; width: 88px; margin-bottom: 0; padding: 0 8px; font-size: 10px; }
.ps-gboard-skill.ps-gboard-action, .ps-gboard-endturn.ps-gboard-action { min-height: 40px; margin-bottom: 0; padding: 0 16px; font-size: 11px; }
.ps-gboard-dir { width: 58px; height: 46px; margin-right: 7px; margin-bottom: 7px; padding: 0; color: rgb(211, 244, 250); font-size: 19px; background-color: rgba(0, 0, 0, 0); border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; }
.ps-gboard-dir:hover, .ps-gboard-dir-hot { color: rgb(255, 226, 243); }

/* Quiet hierarchy pass: chrome is reserved for cards and decisive actions,
   while ordinary expedition information is carried by space and thin rules. */
.ps-gboard-top { background-image: none; background-color: rgba(9, 10, 16, 0.88); border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 1px; border-bottom-color: rgba(193, 165, 101, 0.42); }
.ps-gboard-stage { right: 392px; background-color: rgba(8, 10, 16, 0.58); border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; }
.ps-gboard-grid { background-color: rgba(16, 18, 27, 0.48); border-left-color: rgba(193, 165, 101, 0.30); border-right-color: rgba(193, 165, 101, 0.30); border-top-color: rgba(193, 165, 101, 0.30); border-bottom-color: rgba(193, 165, 101, 0.30); }
.ps-gboard-dock { width: 332px; height: auto; bottom: 142px; }
.ps-gboard-panel { background-image: none; background-color: rgba(0, 0, 0, 0); border-left-width: 2px; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; border-left-color: rgba(213, 176, 101, 0.66); padding: 18px 4px 18px 16px; }
.ps-gboard-panel-title { font-size: 25px; margin-bottom: 13px; }
.ps-gboard-panel-status { padding-bottom: 10px; border-bottom-width: 1px; border-bottom-color: rgba(164, 143, 107, 0.22); }
.ps-gboard-panel-body { color: rgba(211, 204, 191, 0.84); }
.ps-gboard-combat-stage { width: 332px; min-width: 332px; height: auto; bottom: 142px; background-image: none; background-color: rgba(8, 8, 14, 0.60); border-left-width: 2px; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; border-left-color: rgba(229, 123, 135, 0.78); padding: 0 4px 0 16px; }
.ps-gboard-combat-portrait { width: 100%; height: 252px; margin-bottom: 12px; }
.ps-gboard-combat-title { font-size: 24px; }
.ps-gboard-combat-hp { padding: 9px 0; }
.ps-gboard-action { min-height: 34px; margin-bottom: 6px; padding: 5px 3px; color: rgba(226, 218, 203, 0.86); font-size: 12px; letter-spacing: 0.8px; -unity-text-align: middle-left; background-image: none; background-color: rgba(255, 255, 255, 0); border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 1px; border-bottom-color: rgba(152, 129, 100, 0.30); }
.ps-gboard-action:hover { color: rgb(255, 218, 145); background-color: rgba(255, 206, 130, 0.06); border-bottom-color: rgba(255, 206, 130, 0.72); }
.ps-gboard-top-finish.ps-gboard-action { min-height: 28px; width: auto; margin-bottom: 0; padding: 0 5px; font-size: 10px; }
.ps-gboard-skill.ps-gboard-action, .ps-gboard-endturn.ps-gboard-action { min-height: 34px; padding: 0 10px; -unity-text-align: middle-center; }

/* Makai expedition pass: vivid playfulness comes from the field and accents,
   not from boxing every information group. */
.ps-gboard { background-color: rgb(8, 8, 25); }
.ps-gboard-top { background-color: rgba(13, 12, 39, 0.78); border-bottom-width: 2px; border-bottom-color: rgb(226, 84, 159); }
.ps-gboard-top .ps-rite-top-name { color: rgb(255, 215, 120); text-shadow: 0 0 8px rgba(255, 72, 182, 0.60); }
.ps-gboard-phase { color: rgb(255, 123, 196); }
.ps-gboard-ink { color: rgb(124, 237, 255); }
.ps-gboard-doom { background-color: rgba(106, 28, 82, 0.70); border-left-color: rgb(255, 105, 180); color: rgb(255, 185, 220); }
.ps-gboard-stage { background-color: rgba(10, 10, 34, 0.18); }
.ps-gboard-viewport { background-color: rgba(8, 10, 31, 0.16); }
.ps-gboard-grid { padding: 8px; background-color: rgba(18, 11, 48, 0.44); border-left-color: rgba(95, 238, 255, 0.70); border-right-color: rgba(255, 84, 180, 0.64); border-top-color: rgba(255, 201, 111, 0.68); border-bottom-color: rgba(120, 96, 255, 0.66); }
.ps-gboard-cell { background-color: rgba(31, 22, 75, 0.48); border-left-color: rgba(195, 154, 255, 0.65); border-right-color: rgba(67, 41, 116, 0.92); border-top-color: rgba(224, 181, 255, 0.56); border-bottom-color: rgba(35, 18, 71, 0.95); }
.ps-gboard-cell-face { background-color: rgba(116, 82, 168, 0.26); border-left-color: rgba(209, 183, 255, 0.18); border-top-color: rgba(255, 214, 139, 0.16); }
.ps-gboard-cell-sigil { color: rgba(255, 226, 149, 0.50); }
.ps-gboard-cell-mark { color: rgb(255, 238, 207); }
.ps-gboard-cell.ps-gboard-void { visibility: visible; background-color: rgba(3, 4, 16, 0.88); border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; }
.ps-gboard-cell.ps-gboard-void .ps-gboard-cell-face, .ps-gboard-cell.ps-gboard-void .ps-gboard-cell-mark, .ps-gboard-cell.ps-gboard-void .ps-gboard-cell-sigil { display: none; }
.ps-gboard-cell.ps-gboard-blocked { background-color: rgba(15, 10, 39, 0.86); border-color: rgba(104, 72, 150, 0.54); }
.ps-gboard-cell.ps-gboard-start .ps-gboard-cell-face { background-color: rgba(52, 169, 212, 0.60); }
.ps-gboard-cell.ps-gboard-lamp .ps-gboard-cell-face { background-color: rgba(240, 157, 46, 0.66); }
.ps-gboard-cell.ps-gboard-event .ps-gboard-cell-face { background-color: rgba(131, 79, 232, 0.70); }
.ps-gboard-cell.ps-gboard-next .ps-gboard-cell-face { background-color: rgba(52, 212, 191, 0.66); }
.ps-gboard-cell.ps-gboard-enemy .ps-gboard-cell-face { background-color: rgba(110, 35, 116, 0.62); }
.ps-gboard-cell.ps-gboard-path { border-color: rgb(71, 245, 255); background-color: rgba(28, 132, 192, 0.58); }
.ps-gboard-cell.ps-gboard-preview { border-color: rgb(255, 151, 224); background-color: rgba(158, 69, 186, 0.48); }
.ps-gboard-cell.ps-gboard-piece .ps-gboard-cell-face { background-color: rgba(32, 201, 222, 0.56); }
.ps-gboard-enemy-actor { background-color: rgba(161, 45, 137, 0.92); border-left-color: rgb(255, 134, 210); border-right-color: rgba(104, 245, 255, 0.66); border-top-color: rgba(255, 211, 123, 0.72); border-bottom-color: rgba(104, 245, 255, 0.66); }
.ps-gboard-player-actor { overflow: hidden; background-color: rgba(28, 19, 90, 0.88); border-left-color: rgb(255, 218, 128); border-right-color: rgb(72, 242, 255); border-top-color: rgb(255, 117, 193); border-bottom-color: rgb(72, 242, 255); }
.ps-gboard-player-portrait { width: 100%; height: 100%; }
.ps-gboard-dock { top: 128px; }
.ps-gboard-panel { border-left-color: rgb(87, 240, 255); background-color: rgba(11, 10, 42, 0.48); }
.ps-gboard-panel-type { color: rgb(255, 206, 108); }
.ps-gboard-panel-title { color: rgb(255, 228, 155); text-shadow: 0 0 9px rgba(255, 74, 181, 0.46); }
.ps-gboard-panel-status { color: rgb(255, 156, 211); border-bottom-color: rgba(255, 110, 194, 0.44); }
.ps-gboard-panel-hint { color: rgba(178, 230, 255, 0.78); }
.ps-gboard-combat-stage { top: 128px; border-left-color: rgb(255, 100, 179); background-color: rgba(19, 8, 47, 0.54); }
.ps-gboard-combat-hp { border-top-color: rgba(255, 103, 185, 0.50); border-bottom-color: rgba(104, 237, 255, 0.35); color: rgb(255, 182, 211); }
.ps-gboard-combat-intent { color: rgb(255, 215, 126); }
.ps-gboard-en-rail { background-color: rgba(13, 10, 45, 0.86); border-left-color: rgb(80, 240, 255); border-top-width: 1px; border-top-color: rgba(255, 79, 182, 0.76); }

/* The shared card deck keeps its existing art; only its stage composition is
   changed.  A readable closed fan becomes the visual footer of exploration. */
.ps-battle-hand.ps-gboard-hand-fan { width: 820px; height: 112px; margin-left: -410px; bottom: 52px; }
.ps-battle-hand.ps-gboard-hand-fan.ps-gboard-hand-open { height: 356px; }
.ps-battle-hand.ps-gboard-hand-fan .ps-battle-card:hover { translate: 0 -34px; }
.ps-gboard-selected { right: 366px; top: 176px; }

/* Exploration-map pass: same playful magic palette, with open reading columns
   instead of a heavy box around every secondary section. */
.ps-xmap-top { background-color: rgba(13, 12, 39, 0.80); border-left-color: rgb(92, 241, 255); border-right-color: rgba(255, 98, 188, 0.72); border-top-color: rgba(255, 211, 123, 0.62); border-bottom-color: rgb(226, 84, 159); }
.ps-xmap-panel { background-color: rgba(11, 10, 42, 0.52); border-left-color: rgb(87, 240, 255); border-right-width: 0; border-top-width: 0; border-bottom-width: 0; }
.ps-xmap-panel-eye { color: rgba(132, 235, 255, 0.76); }
.ps-xmap-panel-type { color: rgb(255, 206, 108); }
.ps-xmap-panel-title { color: rgb(255, 228, 155); text-shadow: 0 0 9px rgba(255, 74, 181, 0.46); }
.ps-xmap-panel-status { color: rgb(255, 156, 211); }
.ps-xmap-panel-rule { background-color: rgba(255, 110, 194, 0.44); }
.ps-xmap-panel-body { color: rgba(225, 218, 239, 0.88); }
.ps-xmap-panel-hint { color: rgba(178, 230, 255, 0.78); border-top-color: rgba(104, 237, 255, 0.28); }
.ps-xmap-compass { background-color: rgba(11, 10, 42, 0.35); border-left-color: rgba(255, 198, 111, 0.50); border-right-width: 0; border-top-width: 0; border-bottom-width: 0; }

/* Dedicated raster silhouettes: these are not generic stretched buttons.  They
   are fixed HUD composition pieces, so text and status can sit in their open
   centres while the illustrated linework defines the screen edge. */
.ps-gboard-top { left: 14px; right: 14px; top: 12px; height: 138px; min-height: 138px; padding: 0 34px; background-color: rgba(0, 0, 0, 0); border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; }
.ps-gboard-top .ps-rite-tick { display: none; }
.ps-gboard-top .ps-rite-brand { top: 36px; }
.ps-gboard-top .ps-rite-top-name { font-size: 25px; }
.ps-gboard-phase { bottom: 27px; }
.ps-gboard-ink { top: 52px; right: 248px; }
.ps-gboard-doom { top: 48px; right: 72px; background-color: rgba(62, 18, 71, 0.72); border-left-width: 0; }
.ps-gboard-top-finish.ps-gboard-action { right: 26px; bottom: 38px; }
.ps-gboard-hero { left: 38px; top: 40px; }
.ps-gboard-stage, .ps-gboard-dock, .ps-gboard-combat-stage { top: 160px; }
.ps-gboard-panel { border-left-color: rgb(255, 100, 179); }
.ps-gboard-en-rail { left: 34px; right: auto; bottom: 28px; width: 560px; min-height: 78px; height: 78px; margin-left: 0; padding: 0 88px; background-color: rgba(0, 0, 0, 0); border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; }
.ps-gboard-en-label { margin-right: 0; color: rgb(255, 224, 150); text-shadow: 0 0 6px rgba(255, 70, 181, 0.65); }
.ps-gboard-combat-rail { margin-left: auto; }
.ps-battle-hand.ps-gboard-hand-fan { width: 900px; margin-left: -450px; bottom: 126px; height: 116px; }
.ps-gboard-stage { right: 540px; }
.ps-gboard-dock { right: 34px; width: 470px; }
.ps-gboard-panel { padding: 58px 44px 42px 48px; background-color: rgba(8, 8, 28, 0.18); border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; }
.ps-battle-hand.ps-gboard-hand-fan { width: 900px; margin-left: -450px; bottom: 110px; height: 116px; overflow: visible; }
.ps-battle-hand.ps-gboard-hand-fan.ps-gboard-hand-open { height: 344px; bottom: 54px; }
.ps-gboard-panel { background-image: none; background-color: rgba(7, 8, 27, 0.10); padding: 94px 40px 42px 42px; border-left-width: 2px; border-left-color: rgb(255, 104, 183); border-right-width: 0; border-top-width: 0; border-bottom-width: 0; overflow: visible; }
.ps-gboard-panel-ornament { position: absolute; left: -16px; right: -12px; top: -2px; height: 128px; }
.ps-gboard-panel-type { margin-top: 18px; }
.ps-gboard-portrait { width: 104px; height: 104px; margin-right: 42px; rotate: 45deg; overflow: hidden; border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgb(255, 111, 184); border-right-color: rgb(91, 239, 255); border-top-color: rgb(255, 216, 129); border-bottom-color: rgb(255, 111, 184); }
.ps-gboard-portrait-image { rotate: -45deg; scale: 1.42 1.42 1; }
.ps-gboard-hero { width: 430px; }
.ps-gboard-en-label { color: rgb(255, 224, 150); text-shadow: 0 0 6px rgba(255, 70, 181, 0.65); }

/* Final expedition geometry: the information rail is a narrow, tall reading
   column at the right edge, while EN stays a compact independent rail. */
.ps-gboard-stage { right: 500px; }
.ps-gboard-dock { right: 34px; top: 172px; bottom: auto; width: 350px; height: 760px; }
.ps-gboard-panel { padding: 94px 26px 42px 28px; }
.ps-gboard-panel-ornament { left: -10px; right: -10px; height: 104px; }
.ps-gboard-en-rail { left: 34px; right: auto; bottom: 24px; width: 400px; min-height: 56px; height: 56px; padding: 0 60px; }
.ps-gboard-en-label { font-size: 15px; }

/* Progressive expedition HUD.  The idle state belongs to the dungeon; each
   information group is summoned by the interaction that makes it relevant. */
.ps-gboard-idle .ps-gboard-dock {
    opacity: 0;
    width: 20px;
    overflow: hidden;
    transition-property: opacity;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}
.ps-gboard-idle.ps-gboard-inspecting .ps-gboard-dock {
    opacity: 1;
    width: 350px;
    overflow: visible;
}
.ps-gboard-idle .ps-gboard-stage {
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}
.ps-gboard-idle .ps-gboard-top {
    height: 16px;
    min-height: 16px;
    opacity: 0;
    overflow: hidden;
}
.ps-gboard-idle.ps-gboard-header-hover .ps-gboard-top {
    height: 138px;
    min-height: 138px;
    opacity: 1;
    overflow: visible;
}
.ps-gboard-idle .ps-gboard-hero {
    opacity: 0;
}
.ps-gboard-idle.ps-gboard-header-hover .ps-gboard-hero {
    opacity: 1;
}
.ps-gboard-idle .ps-gboard-en-rail {
    display: none;
}
.ps-gboard-idle .ps-gboard-phase,
.ps-gboard-idle .ps-gboard-ink,
.ps-gboard-idle .ps-gboard-doom,
.ps-gboard-idle .ps-gboard-top-finish,
.ps-gboard-idle .ps-gboard-hero-meta {
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.14s;
}
.ps-gboard-idle.ps-gboard-header-hover .ps-gboard-phase,
.ps-gboard-idle.ps-gboard-header-hover .ps-gboard-ink,
.ps-gboard-idle.ps-gboard-header-hover .ps-gboard-doom,
.ps-gboard-idle.ps-gboard-header-hover .ps-gboard-top-finish,
.ps-gboard-idle.ps-gboard-header-hover .ps-gboard-hero-meta {
    opacity: 1;
}

/* Cards keep a compact lower fan. Hover lifts only the card under the cursor;
   the rest of the hand never becomes a wall over the board. */
.ps-gboard .ps-gboard-fan-card.ps-gboard-fan-focus {
    opacity: 0.72;
}
.ps-gboard-hover-preview {
    opacity: 1;
}

/* Exploration composition: a stable top HUD above one uninterrupted map.
   The right dossier is reserved for battle; planning information overlays the
   map through the selected-card host instead of taking permanent width. */
.ps-gboard-stage {
    left: 24px;
    right: 24px;
    top: 160px;
    bottom: 0;
}
.ps-gboard-dock {
    display: none;
}
.ps-gboard-top {
    height: 138px;
    min-height: 138px;
    opacity: 1;
    overflow: visible;
    background-color: rgba(3, 3, 12, 0.94);
}
.ps-gboard-hero {
    opacity: 1;
}
.ps-gboard-en-rail {
    display: none;
}
.ps-gboard-planning .ps-gboard-en-rail,
.ps-gboard-in-combat .ps-gboard-en-rail {
    display: flex;
}

/* Exploration keeps the complete banner visible. These explicit idle
   overrides replace the earlier hover-only header experiment. */
.ps-gboard-idle .ps-gboard-top,
.ps-gboard-idle.ps-gboard-header-hover .ps-gboard-top {
    height: 138px;
    min-height: 138px;
    opacity: 1;
    overflow: visible;
}
.ps-gboard-idle .ps-gboard-hero,
.ps-gboard-idle.ps-gboard-header-hover .ps-gboard-hero,
.ps-gboard-idle .ps-gboard-phase,
.ps-gboard-idle .ps-gboard-ink,
.ps-gboard-idle .ps-gboard-doom,
.ps-gboard-idle .ps-gboard-top-finish,
.ps-gboard-idle .ps-gboard-hero-meta {
    opacity: 1;
}

/* EN is persistent exploration information, using the same dark backing as
   the banner so it remains legible over a bright dungeon floor. */
.ps-gboard-en-rail,
.ps-gboard-idle .ps-gboard-en-rail {
    display: flex;
    background-color: rgba(3, 3, 12, 0.94);
}

/* Next-area and return decisions are blocking route states. They are attached
   directly to the screen root because the exploration dossier is intentionally
   hidden; keeping these controls inside that dossier made the run stop with no
   visible way to continue. */
.ps-gboard > .ps-gboard-gate {
    position: absolute;
    left: 0;
    right: 0;
    top: 138px;
    bottom: 0;
    margin-top: 0;
    padding-top: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(2, 2, 12, 0.74);
    border-top-width: 1px;
    border-top-color: rgba(255, 103, 190, 0.42);
}
.ps-gboard-gate-dialog {
    width: 500px;
    padding: 28px 34px 26px 34px;
    background-color: rgba(8, 7, 30, 0.98);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(255, 99, 183);
    border-right-color: rgb(82, 231, 255);
    border-top-color: rgb(255, 199, 117);
    border-bottom-color: rgba(176, 78, 226, 0.92);
}
.ps-gboard-gate-eyebrow {
    margin-bottom: 5px;
    color: rgb(92, 226, 255);
    font-size: 10px;
    letter-spacing: 2px;
}
.ps-gboard-gate-title {
    margin-bottom: 12px;
    color: rgb(255, 225, 158);
    font-size: 28px;
    -unity-font-definition: resource("Fonts/KleeOne-SemiBold");
}
.ps-gboard-gate-body {
    margin-bottom: 20px;
    color: rgba(231, 218, 225, 0.88);
    font-size: 13px;
    white-space: normal;
}
.ps-gboard-gate-choices {
    flex-direction: column;
}
.ps-gboard-gate-choices > .ps-gboard-action {
    width: 100%;
    min-height: 46px;
    margin-bottom: 8px;
    padding-left: 15px;
    padding-right: 15px;
    color: rgb(255, 228, 199);
    background-color: rgba(82, 27, 84, 0.74);
    border-left-width: 2px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(255, 104, 182);
    border-right-color: rgba(85, 224, 255, 0.62);
    border-top-color: rgba(255, 196, 116, 0.40);
    border-bottom-color: rgba(85, 224, 255, 0.40);
    -unity-text-align: middle-center;
}
.ps-gboard-gate-choices > .ps-gboard-action:hover {
    color: rgb(255, 249, 224);
    background-color: rgba(141, 40, 115, 0.92);
    border-top-color: rgb(255, 205, 124);
    border-bottom-color: rgb(84, 231, 255);
}

/* Combat stays in the expedition scene. The enemy is deliberately centred,
   with its vitality and intent readable before the player touches a card. */
.ps-gboard-in-combat .ps-gboard-combat-stage {
    position: absolute;
    left: 50%;
    right: auto;
    top: 178px;
    bottom: auto;
    width: 430px;
    min-width: 430px;
    height: 420px;
    margin-left: -215px;
    padding: 14px 28px 18px;
    justify-content: flex-start;
    align-items: stretch;
    background-color: rgba(7, 5, 25, 0.88);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(255, 104, 177, 0.92);
    border-right-color: rgba(88, 235, 255, 0.82);
    border-top-color: rgba(255, 161, 210, 0.78);
    border-bottom-color: rgba(159, 102, 255, 0.75);
}
.ps-gboard-in-combat .ps-gboard-combat-portrait {
    align-self: center;
    width: 270px;
    height: 236px;
    margin-bottom: 2px;
}
.ps-gboard-in-combat .ps-gboard-combat-title {
    align-self: center;
    font-size: 25px;
    color: rgb(255, 224, 166);
}
.ps-gboard-in-combat .ps-gboard-combat-hp {
    align-self: stretch;
    padding: 5px 0 3px;
    font-size: 18px;
    color: rgb(255, 222, 222);
    border-width: 0;
}
.ps-gboard-combat-hp-track {
    align-self: stretch;
    height: 12px;
    margin-bottom: 12px;
    background-color: rgba(19, 7, 21, 0.96);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 169, 201, 0.72);
    border-right-color: rgba(255, 169, 201, 0.72);
    border-top-color: rgba(255, 169, 201, 0.72);
    border-bottom-color: rgba(255, 169, 201, 0.72);
}
.ps-gboard-combat-hp-fill {
    height: 100%;
    background-color: rgb(225, 69, 109);
    border-right-width: 2px;
    border-right-color: rgb(255, 225, 178);
}
.ps-gboard-in-combat .ps-gboard-combat-intent {
    align-self: stretch;
    min-height: 50px;
    padding: 12px 14px;
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(255, 233, 170);
    background-color: rgba(75, 14, 37, 0.88);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(255, 107, 153);
    border-right-color: rgb(255, 107, 153);
    border-top-color: rgba(255, 204, 115, 0.86);
    border-bottom-color: rgba(255, 204, 115, 0.86);
}

/* Events pause the route in-place. They are an overlay over the same map,
   never a screen transition that can strand the running path. */
.ps-gboard-event-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 138px;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(2, 1, 12, 0.48);
}
.ps-gboard-event-popup {
    width: 470px;
    padding: 26px 30px 24px;
    background-color: rgba(14, 7, 39, 0.97);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(255, 115, 181);
    border-right-color: rgb(85, 234, 255);
    border-top-color: rgb(255, 192, 221);
    border-bottom-color: rgb(175, 103, 255);
}
.ps-gboard-event-eyebrow { font-size: 12px; color: rgb(112, 237, 255); -unity-font-style: bold; }
.ps-gboard-event-title { margin-top: 6px; font-size: 30px; color: rgb(255, 223, 163); }
.ps-gboard-event-body { margin-top: 14px; margin-bottom: 20px; font-size: 16px; white-space: normal; color: rgb(230, 219, 249); }
.ps-gboard-event-choices { flex-direction: column; }
.ps-gboard-event-choice { width: 100%; margin-top: 7px; min-height: 38px; }

/* Battle composition: three independent vertical bands.
   Header (0-160), enemy/readout (200-540), hand (from 560 down).  The dice
   sit beside the enemy as a compact roll callout instead of forming a bar
   across the hand. */
.ps-gboard-in-combat .ps-gboard-combat-stage {
    top: 204px;
    height: 330px;
    padding: 10px 24px 14px;
}
.ps-gboard-in-combat .ps-gboard-combat-portrait {
    width: 210px;
    height: 178px;
    margin-bottom: 0;
}
.ps-gboard-in-combat .ps-gboard-combat-title {
    font-size: 22px;
    margin-top: 0;
    margin-bottom: 0;
}
.ps-gboard-in-combat .ps-gboard-combat-hp {
    padding: 2px 0;
    font-size: 16px;
}
.ps-gboard-combat-hp-track {
    height: 9px;
    margin-bottom: 7px;
}
.ps-gboard-in-combat .ps-gboard-combat-intent {
    min-height: 38px;
    padding: 7px 10px;
    font-size: 16px;
}
.ps-gboard-in-combat .ps-gboard-resolve {
    position: absolute;
    left: 50%;
    right: auto;
    top: 286px;
    width: 230px;
    min-height: 102px;
    margin-left: 238px;
    padding: 10px 12px;
    flex-direction: column;
    align-items: stretch;
    background-color: rgba(16, 8, 38, 0.94);
    border-left-width: 2px;
    border-left-color: rgb(109, 239, 255);
    border-top-color: rgba(255, 126, 194, 0.85);
}
.ps-gboard-in-combat .ps-gboard-resolve-head {
    width: auto;
    margin-right: 0;
    flex-direction: row;
    justify-content: space-between;
}
.ps-gboard-in-combat .ps-gboard-resolve-formula { font-size: 11px; }
.ps-gboard-in-combat .ps-gboard-resolve-result { margin-top: 0; font-size: 11px; }
.ps-gboard-in-combat .ps-gboard-resolve-dice { margin-top: 8px; }
.ps-gboard-in-combat .ps-battle-hand.ps-gboard-hand-fan {
    bottom: 46px;
    height: 330px;
}

/* Route drawing controls float over the lower-right corner of the map. */
.ps-gboard-route-palette {
    position: absolute;
    right: 38px;
    bottom: 42px;
    flex-direction: column;
    align-items: center;
    padding: 8px;
    background-color: rgba(10, 8, 35, 0.72);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(105, 240, 255, 0.62);
    border-right-color: rgba(255, 94, 185, 0.62);
    border-top-color: rgba(255, 215, 128, 0.42);
    border-bottom-color: rgba(255, 94, 185, 0.42);
}

/* Final battle layout. The enemy owns the centre, while readable combat
   information uses the otherwise empty left and right gutters. */
.ps-gboard-in-combat .ps-gboard-combat-stage {
    left: 24px;
    right: 24px;
    top: 218px;
    bottom: auto;
    width: auto;
    min-width: 0;
    height: 400px;
    margin-left: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}
.ps-gboard-in-combat .ps-gboard-combat-portrait {
    position: absolute;
    left: 50%;
    top: 34px;
    width: 400px;
    height: 300px;
    margin-left: -200px;
    margin-bottom: 0;
    background-color: rgba(5, 3, 20, 0.72);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(255, 102, 177, 0.82);
    border-right-color: rgba(87, 235, 255, 0.76);
    border-top-color: rgba(255, 201, 139, 0.64);
    border-bottom-color: rgba(164, 101, 255, 0.72);
}
.ps-gboard-in-combat .ps-gboard-combat-title {
    position: absolute;
    left: 50%;
    top: -4px;
    width: 400px;
    margin-left: -200px;
    margin-top: 0;
    margin-bottom: 0;
    font-size: 28px;
    -unity-text-align: middle-center;
    color: rgb(255, 224, 163);
}
.ps-gboard-in-combat .ps-gboard-combat-hp {
    position: absolute;
    left: 58px;
    top: 92px;
    width: 330px;
    height: 76px;
    padding: 14px 18px 30px;
    margin: 0;
    font-size: 21px;
    -unity-font-style: bold;
    color: rgb(255, 220, 225);
    background-color: rgba(10, 5, 30, 0.91);
    border-left-width: 3px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(255, 91, 144);
    border-right-color: rgba(255, 142, 185, 0.54);
    border-top-color: rgba(255, 207, 151, 0.58);
    border-bottom-color: rgba(100, 231, 255, 0.46);
}
.ps-gboard-in-combat .ps-gboard-combat-hp-track {
    position: absolute;
    left: 76px;
    top: 142px;
    width: 294px;
    height: 12px;
    margin-bottom: 0;
}
.ps-gboard-in-combat .ps-gboard-combat-intent {
    position: absolute;
    right: 58px;
    top: 92px;
    width: 330px;
    min-height: 104px;
    padding: 14px 18px;
    margin: 0;
    font-size: 19px;
    white-space: normal;
    -unity-text-align: middle-left;
    color: rgb(255, 232, 166);
    background-color: rgba(49, 8, 34, 0.92);
    border-left-width: 3px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(255, 98, 156);
    border-right-color: rgba(255, 158, 200, 0.58);
    border-top-color: rgba(255, 207, 121, 0.76);
    border-bottom-color: rgba(102, 233, 255, 0.46);
}
.ps-gboard-in-combat .ps-gboard-resolve {
    left: auto;
    right: 82px;
    top: 418px;
    width: 282px;
    min-height: 94px;
    margin-left: 0;
}
.ps-gboard-in-combat .ps-battle-hand.ps-gboard-hand-fan {
    bottom: -20px;
    height: 324px;
}
.ps-gboard-in-combat .ps-gboard-en-rail {
    left: 34px;
    right: auto;
    bottom: 24px;
    width: 240px;
    min-height: 58px;
    height: 58px;
    padding: 0 58px;
}
.ps-gboard-in-combat .ps-gboard-combat-rail {
    position: absolute;
    left: auto;
    right: 34px;
    bottom: 24px;
    width: 360px;
    height: 58px;
    padding: 8px 10px;
    margin-left: 0;
    justify-content: flex-end;
    background-color: rgba(3, 3, 14, 0.94);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(83, 234, 255);
    border-right-color: rgb(255, 91, 167);
    border-top-color: rgba(255, 207, 135, 0.64);
    border-bottom-color: rgba(163, 97, 255, 0.68);
}
.ps-gboard-in-combat .ps-gboard-skill {
    min-width: 158px;
    height: 40px;
    margin-left: 0;
    margin-right: 8px;
    font-size: 14px;
}
.ps-gboard-in-combat .ps-gboard-endturn {
    min-width: 158px;
    height: 40px;
    margin-left: 0;
    font-size: 14px;
    color: rgb(255, 225, 172);
    background-color: rgba(91, 18, 51, 0.92);
    border-left-color: rgb(255, 104, 160);
    border-right-color: rgb(255, 104, 160);
}
.ps-gboard-route-icon.ps-gboard-action {
    width: 54px;
    min-width: 54px;
    height: 54px;
    min-height: 54px;
    margin: 0 0 6px 0;
    padding: 0;
    color: rgb(255, 232, 167);
    font-size: 27px;
    -unity-text-align: middle-center;
    background-color: rgba(32, 22, 70, 0.88);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(164, 110, 255, 0.72);
    border-right-color: rgba(164, 110, 255, 0.72);
    border-top-color: rgba(255, 199, 111, 0.62);
    border-bottom-color: rgba(255, 94, 185, 0.72);
}
.ps-gboard-route-icon.ps-gboard-action:hover { background-color: rgba(91, 47, 133, 0.96); color: white; }
.ps-gboard-route-start.ps-gboard-action { color: rgb(91, 246, 255); border-top-color: rgb(91, 246, 255); }
.ps-gboard-route-cancel.ps-gboard-action { margin-bottom: 0; color: rgb(255, 137, 191); }

/* Product battle composition: a single enemy focal point, dedicated side
   dossiers, and a deliberately quiet lower card fan. */
.ps-gboard-in-combat .ps-gboard-combat-stage {
    top: 194px;
    height: 392px;
}
.ps-gboard-in-combat .ps-gboard-enemy-focus {
    position: absolute;
    left: 50%;
    top: 0;
    width: 400px;
    height: 354px;
    margin-left: -200px;
    align-items: center;
}
.ps-gboard-in-combat .ps-gboard-enemy-eyebrow {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    font-size: 10px;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    color: rgb(112, 236, 255);
}
.ps-gboard-in-combat .ps-gboard-enemy-focus .ps-gboard-combat-portrait {
    position: absolute;
    left: 0;
    top: 26px;
    width: 400px;
    height: 286px;
    margin: 0;
}
.ps-gboard-in-combat .ps-gboard-enemy-focus .ps-gboard-combat-title {
    position: absolute;
    left: 0;
    top: 314px;
    width: 400px;
    margin: 0;
    font-size: 27px;
    -unity-text-align: middle-center;
    color: rgb(255, 226, 158);
    text-shadow: 0 2px 5px rgba(0, 0, 0, 0.96);
}
.ps-gboard-in-combat .ps-gboard-combat-vitals,
.ps-gboard-in-combat .ps-gboard-combat-intent-panel {
    position: absolute;
    top: 105px;
    width: 300px;
    min-height: 114px;
    padding: 13px 16px 14px;
    background-color: rgba(9, 5, 30, 0.91);
    border-left-width: 2px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
}
.ps-gboard-in-combat .ps-gboard-combat-vitals {
    left: 48px;
    border-left-color: rgb(95, 233, 255);
    border-right-color: rgba(95, 233, 255, 0.48);
    border-top-color: rgba(255, 207, 132, 0.52);
    border-bottom-color: rgba(255, 98, 174, 0.56);
}
.ps-gboard-in-combat .ps-gboard-combat-intent-panel {
    right: 48px;
    background-color: rgba(54, 8, 36, 0.92);
    border-left-color: rgb(255, 96, 153);
    border-right-color: rgba(255, 156, 198, 0.52);
    border-top-color: rgba(255, 208, 122, 0.72);
    border-bottom-color: rgba(102, 234, 255, 0.46);
}
.ps-gboard-in-combat .ps-gboard-combat-caption {
    margin-bottom: 5px;
    font-size: 10px;
    letter-spacing: 1.8px;
    color: rgba(194, 226, 255, 0.82);
}
.ps-gboard-in-combat .ps-gboard-combat-vitals .ps-gboard-combat-hp {
    position: relative;
    left: auto;
    top: auto;
    width: auto;
    height: auto;
    min-height: 0;
    padding: 0;
    margin: 0 0 8px;
    font-size: 23px;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}
.ps-gboard-in-combat .ps-gboard-combat-vitals .ps-gboard-combat-hp-track {
    position: relative;
    left: auto;
    top: auto;
    width: 100%;
    height: 10px;
    margin-bottom: 7px;
}
.ps-gboard-in-combat .ps-gboard-combat-intent-panel .ps-gboard-combat-intent {
    position: relative;
    right: auto;
    top: auto;
    width: auto;
    min-height: 0;
    padding: 0;
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    font-size: 19px;
    color: rgb(255, 231, 170);
}
.ps-gboard-in-combat .ps-gboard-combat-intent-hint {
    margin-top: 7px;
    padding-top: 6px;
    font-size: 11px;
    white-space: normal;
    color: rgb(255, 185, 207);
    border-top-width: 1px;
    border-top-color: rgba(255, 195, 130, 0.35);
}
.ps-gboard-in-combat .ps-gboard-combat-statuses {
    flex-direction: row;
    flex-wrap: wrap;
}
.ps-gboard-in-combat .ps-gboard-combat-status-chip {
    margin-right: 5px;
    padding: 2px 6px;
    font-size: 10px;
    color: rgb(255, 223, 164);
    background-color: rgba(102, 48, 151, 0.72);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 190, 114, 0.72);
    border-right-color: rgba(255, 190, 114, 0.72);
    border-top-color: rgba(255, 190, 114, 0.72);
    border-bottom-color: rgba(255, 190, 114, 0.72);
}
.ps-gboard-in-combat .ps-battle-hand.ps-gboard-hand-fan {
    bottom: -20px;
    height: 304px;
}
.ps-gboard-in-combat .ps-battle-hand.ps-gboard-hand-fan .ps-gboard-fan-card {
    scale: 0.91 0.91 1;
    opacity: 0.94;
    transition-property: translate, scale, opacity;
    transition-duration: 0.14s;
}
.ps-gboard-in-combat .ps-battle-hand.ps-gboard-hand-fan .ps-gboard-fan-card:hover {
    translate: 0 -52px;
    scale: 1 1 1;
    opacity: 1;
}
.ps-gboard-in-combat .ps-gboard-viewport {
    opacity: 0.52;
}
.ps-gboard-in-combat .ps-gboard-resolve {
    padding: 10px 14px;
    background-color: rgba(12, 7, 35, 0.96);
    border-left-width: 2px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(112, 236, 255);
    border-right-color: rgba(112, 236, 255, 0.48);
    border-top-color: rgba(255, 207, 125, 0.72);
    border-bottom-color: rgba(255, 103, 184, 0.70);
}
.ps-gboard-in-combat .ps-gboard-resolve-formula {
    font-size: 10px;
    color: rgb(165, 231, 255);
}
.ps-gboard-in-combat .ps-gboard-resolve-result {
    font-size: 12px;
    color: rgb(255, 222, 156);
    -unity-font-style: bold;
}
.ps-gboard-in-combat .ps-gboard-die {
    width: 36px;
    height: 36px;
    font-size: 20px;
    background-color: rgba(99, 46, 126, 0.96);
    border-left-color: rgb(255, 202, 127);
    border-right-color: rgb(255, 202, 127);
    border-top-color: rgb(255, 202, 127);
