}
.ps-gboard-in-combat .ps-gboard-combat-rail {
    padding: 7px 8px;
    background-color: rgba(4, 3, 18, 0.96);
}
.ps-gboard-in-combat .ps-gboard-skill.ps-gboard-action,
.ps-gboard-in-combat .ps-gboard-endturn.ps-gboard-action {
    min-height: 42px;
    height: 42px;
    margin-bottom: 0;
    padding: 0 12px;
    -unity-text-align: middle-center;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
}
.ps-gboard-in-combat .ps-gboard-skill.ps-gboard-action {
    color: rgb(153, 241, 255);
    background-color: rgba(13, 61, 88, 0.88);
    border-left-color: rgb(98, 235, 255);
    border-right-color: rgb(98, 235, 255);
    border-top-color: rgba(194, 246, 255, 0.78);
    border-bottom-color: rgba(104, 173, 255, 0.74);
}
.ps-gboard-in-combat .ps-gboard-endturn.ps-gboard-action {
    color: rgb(255, 228, 171);
    background-color: rgba(99, 18, 53, 0.94);
    border-left-color: rgb(255, 111, 170);
    border-right-color: rgb(255, 111, 170);
    border-top-color: rgba(255, 214, 132, 0.84);
    border-bottom-color: rgba(255, 118, 186, 0.74);
}
.ps-gboard-in-combat .ps-gboard-skill.ps-gboard-action:hover,
.ps-gboard-in-combat .ps-gboard-endturn.ps-gboard-action:hover {
    color: white;
    opacity: 1;
}
.ps-gboard-in-combat .ps-gboard-skill.ps-gboard-action:disabled,
.ps-gboard-in-combat .ps-gboard-endturn.ps-gboard-action:disabled {
    opacity: 0.34;
}
.ps-gboard-in-combat .ps-gboard-fan-card .ps-battle-card-name,
.ps-gboard-in-combat .ps-gboard-fan-card .ps-battle-card-text {
    text-shadow: 0 2px 3px rgba(0, 0, 0, 0.96);
}
.ps-gboard-combat-hp-fill {
    transition-property: width;
    transition-duration: 0.22s;
    transition-timing-function: ease-out;
}
.ps-gboard-in-combat .ps-gboard-enemy-focus {
    transition-property: scale, opacity;
    transition-duration: 0.11s;
}
.ps-gboard-in-combat .ps-gboard-enemy-focus.ps-gboard-enemy-hit {
    scale: 0.96 0.96 1;
    opacity: 0.72;
}
.ps-gboard.ps-gboard-player-hit .ps-gboard-top {
    background-color: rgba(107, 12, 38, 0.96);
}

/* ===== Compact expedition HUD / final three-lane battle composition =====
   The banner is always present but no longer consumes the enemy's vertical
   space. Enemy data reads as one dossier, while card detail and dice share a
   fixed player-context lane on the right. */
.ps-gboard-top,
.ps-gboard-idle .ps-gboard-top,
.ps-gboard-idle.ps-gboard-header-hover .ps-gboard-top {
    left: 12px;
    right: 12px;
    top: 4px;
    height: 92px;
    min-height: 92px;
    padding: 0 22px;
    opacity: 1;
    overflow: visible;
    background-color: rgba(2, 2, 13, 0.95);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}
.ps-gboard-top .ps-rite-tick,
.ps-gboard-top .ps-rite-brand-mark,
.ps-gboard-top .ps-rite-top-eyebrow,
.ps-gboard-top .ps-gboard-top-sub {
    display: none;
}
.ps-gboard-top .ps-rite-brand {
    position: absolute;
    left: 50%;
    top: 20px;
    width: 250px;
    height: 38px;
    margin-left: -125px;
    justify-content: center;
}
.ps-gboard-top .ps-rite-top-title {
    align-items: center;
    justify-content: center;
}
.ps-gboard-top .ps-rite-top-name {
    font-size: 20px;
    letter-spacing: 4px;
    color: rgb(255, 220, 139);
    text-shadow: 0 1px 5px rgba(255, 80, 184, 0.62);
}
.ps-gboard-phase {
    position: absolute;
    left: 50%;
    bottom: 13px;
    width: 160px;
    margin-left: -80px;
    font-size: 9px;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    color: rgb(255, 112, 186);
}
.ps-gboard-ink {
    position: absolute;
    right: 222px;
    top: 34px;
    max-width: 300px;
    margin-left: 0;
    font-size: 10px;
    letter-spacing: 1px;
    -unity-text-align: middle-right;
    color: rgb(111, 231, 255);
}
.ps-gboard-doom {
    position: absolute;
    right: 82px;
    top: 25px;
    min-width: 112px;
    height: 36px;
    margin-left: 0;
    padding: 6px 10px;
    font-size: 17px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(255, 226, 152);
    background-color: rgba(68, 13, 66, 0.82);
    border-left-width: 2px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(255, 91, 173);
    border-right-color: rgb(79, 229, 255);
    border-top-color: rgba(255, 208, 126, 0.72);
    border-bottom-color: rgba(168, 93, 255, 0.72);
}
.ps-gboard-top-finish.ps-gboard-action {
    right: 18px;
    bottom: 12px;
    width: 52px;
    min-width: 52px;
    min-height: 24px;
    height: 24px;
    padding: 0 4px;
    font-size: 9px;
}
.ps-gboard-hero,
.ps-gboard-idle .ps-gboard-hero,
.ps-gboard-idle.ps-gboard-header-hover .ps-gboard-hero {
    left: 28px;
    top: 12px;
    width: 312px;
    min-height: 70px;
    opacity: 1;
}
.ps-gboard-portrait {
    width: 70px;
    height: 70px;
    margin-right: 18px;
    background-color: rgba(3, 3, 14, 0.94);
    border-left-color: rgb(255, 103, 177);
    border-right-color: rgb(74, 230, 255);
    border-top-color: rgb(255, 211, 128);
    border-bottom-color: rgba(165, 93, 255, 0.90);
}
.ps-gboard-hp-label {
    margin-bottom: 4px;
    font-size: 14px;
    color: rgb(255, 224, 198);
}
.ps-gboard-hp-track {
    width: 210px;
    height: 6px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}
.ps-gboard-stage,
.ps-gboard-dock,
.ps-gboard-combat-stage {
    top: 100px;
}
.ps-gboard-stage {
    left: 24px;
    right: 24px;
    bottom: 0;
}
.ps-gboard > .ps-gboard-gate,
.ps-gboard-event-overlay {
    top: 96px;
}

/* Combat stage: left enemy dossier, unobstructed centre art, right context. */
.ps-gboard-in-combat .ps-gboard-combat-stage {
    left: 24px;
    right: 24px;
    top: 102px;
    bottom: 0;
    width: auto;
    min-width: 0;
    height: auto;
    margin-left: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}
.ps-gboard-in-combat .ps-gboard-enemy-focus {
    position: absolute;
    left: 50%;
    top: 10px;
    width: 480px;
    height: 424px;
    margin-left: -240px;
    align-items: center;
}
.ps-gboard-in-combat .ps-gboard-enemy-eyebrow {
    top: 0;
    font-size: 9px;
    letter-spacing: 2.4px;
    color: rgba(103, 233, 255, 0.76);
}
.ps-gboard-in-combat .ps-gboard-enemy-focus .ps-gboard-combat-portrait {
    position: absolute;
    left: 0;
    top: 17px;
    width: 480px;
    height: 398px;
    margin: 0;
    background-color: rgba(3, 2, 17, 0.34);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 104, 177, 0.34);
    border-right-color: rgba(87, 235, 255, 0.32);
    border-top-color: rgba(255, 201, 139, 0.28);
    border-bottom-color: rgba(164, 101, 255, 0.28);
}
.ps-gboard-in-combat .ps-gboard-combat-vitals {
    position: absolute;
    left: 50%;
    right: auto;
    top: 438px;
    width: 480px;
    height: 86px;
    min-height: 86px;
    margin-left: -240px;
    padding: 0;
    background-color: rgba(7, 4, 28, 0.94);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 2px;
    border-left-color: rgba(86, 231, 255, 0.68);
    border-right-color: rgba(255, 99, 179, 0.68);
    border-top-color: rgba(255, 211, 134, 0.72);
    border-bottom-color: rgb(156, 94, 255);
}
.ps-gboard-in-combat .ps-gboard-combat-vitals > .ps-gboard-combat-caption {
    display: none;
}
.ps-gboard-in-combat .ps-gboard-combat-vitals .ps-gboard-combat-title {
    position: absolute;
    left: 14px;
    top: 6px;
    width: 220px;
    height: 24px;
    margin: 0;
    font-size: 19px;
    -unity-text-align: middle-left;
    color: rgb(255, 225, 158);
}
.ps-gboard-in-combat .ps-gboard-combat-vitals .ps-gboard-combat-hp {
    position: absolute;
    left: 14px;
    top: 34px;
    width: 94px;
    height: 19px;
    margin: 0;
    padding: 0;
    font-size: 12px;
    -unity-text-align: middle-left;
    color: rgb(255, 187, 205);
}
.ps-gboard-in-combat .ps-gboard-combat-vitals .ps-gboard-combat-hp-track {
    position: absolute;
    left: 108px;
    right: 14px;
    top: 40px;
    width: auto;
    height: 8px;
    margin: 0;
}
.ps-gboard-in-combat .ps-gboard-combat-shield {
    position: absolute;
    left: 14px;
    top: 58px;
    width: 94px;
    height: 18px;
    margin: 0;
    padding: 0;
    font-size: 12px;
    -unity-text-align: middle-left;
    color: rgb(139, 235, 255);
}
.ps-gboard-in-combat .ps-gboard-combat-shield-track {
    position: absolute;
    left: 108px;
    right: 14px;
    top: 64px;
    width: auto;
    height: 7px;
    overflow: hidden;
    background-color: rgba(11, 20, 42, 0.92);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(78, 223, 255, 0.46);
    border-right-color: rgba(78, 223, 255, 0.46);
    border-top-color: rgba(78, 223, 255, 0.46);
    border-bottom-color: rgba(78, 223, 255, 0.46);
}
.ps-gboard-in-combat .ps-gboard-combat-shield-fill {
    height: 100%;
    background-color: rgb(50, 185, 235);
    border-right-width: 1px;
    border-right-color: rgb(206, 250, 255);
}
.ps-gboard-in-combat .ps-gboard-combat-statuses {
    position: absolute;
    right: 14px;
    top: 6px;
    height: 24px;
    margin: 0;
}
.ps-gboard-in-combat .ps-gboard-combat-intent-panel {
    position: absolute;
    left: 50%;
    right: auto;
    top: 130px;
    width: 220px;
    min-height: 158px;
    margin-left: -470px;
    padding: 14px 16px;
    background-color: rgba(29, 5, 38, 0.94);
    border-left-width: 2px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(255, 91, 161);
    border-right-color: rgba(82, 226, 255, 0.68);
    border-top-color: rgba(255, 211, 134, 0.72);
    border-bottom-color: rgba(156, 94, 255, 0.78);
}
.ps-gboard-in-combat .ps-gboard-combat-intent-panel .ps-gboard-combat-caption {
    margin-bottom: 9px;
    padding-bottom: 7px;
    font-size: 10px;
    letter-spacing: 1.6px;
    color: rgb(255, 159, 196);
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 99, 176, 0.42);
}
.ps-gboard-in-combat .ps-gboard-combat-intent-panel .ps-gboard-combat-intent {
    position: relative;
    left: auto;
    right: auto;
    top: auto;
    width: auto;
    min-height: 0;
    margin: 0;
    padding: 0;
    font-size: 17px;
    white-space: normal;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}
.ps-gboard-in-combat .ps-gboard-combat-intent-panel .ps-gboard-combat-intent-hint {
    margin-top: 10px;
    padding-top: 8px;
    font-size: 10px;
    white-space: normal;
    color: rgba(255, 198, 213, 0.72);
    border-top-width: 1px;
    border-top-color: rgba(255, 211, 134, 0.34);
}

/* Right context lane. The selected card and the roll result never coexist. */
.ps-gboard-in-combat .ps-gboard-combat-action-view {
    position: absolute;
    right: 28px;
    top: 58px;
    width: 278px;
    height: 356px;
    padding: 13px 15px 15px;
    align-items: center;
    background-color: rgba(7, 4, 28, 0.92);
    border-left-width: 1px;
    border-right-width: 2px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 101, 179, 0.62);
    border-right-color: rgb(78, 230, 255);
    border-top-color: rgba(255, 211, 134, 0.62);
    border-bottom-color: rgba(156, 94, 255, 0.72);
}
.ps-gboard-in-combat .ps-gboard-action-view-caption {
    align-self: stretch;
    margin-bottom: 6px;
    padding-bottom: 7px;
    font-size: 10px;
    letter-spacing: 2px;
    color: rgb(109, 233, 255);
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 102, 181, 0.42);
}
.ps-gboard-in-combat .ps-gboard-combat-card-preview {
    flex-grow: 1;
    width: 100%;
    min-height: 0;
    align-items: center;
    justify-content: center;
}
.ps-gboard-in-combat .ps-gboard-card-view-card {
    position: relative;
    left: auto;
    right: auto;
    top: auto;
    bottom: auto;
    width: 190px;
    min-width: 190px;
    max-width: 190px;
    height: 267px;
    min-height: 267px;
    max-height: 267px;
    margin: 0;
    translate: 0 0;
    scale: 1 1 1;
    rotate: 0deg;
}
.ps-gboard-in-combat .ps-gboard-card-view-card:hover {
    translate: 0 0;
    scale: 1 1 1;
}
.ps-gboard-in-combat .ps-gboard-card-view-empty {
    width: 100%;
    font-size: 12px;
    letter-spacing: 1px;
    white-space: normal;
    -unity-text-align: middle-center;
    color: rgba(189, 174, 211, 0.68);
}
.ps-gboard-in-combat .ps-gboard-combat-action-view .ps-gboard-resolve {
    position: relative;
    left: auto;
    right: auto;
    top: auto;
    width: 100%;
    min-height: 214px;
    margin: 18px 0 0;
    padding: 18px 16px;
    flex-direction: column;
    align-items: stretch;
    justify-content: center;
}
.ps-gboard-in-combat .ps-gboard-combat-action-view .ps-gboard-resolve-head {
    width: 100%;
    margin-right: 0;
    flex-direction: column;
}
.ps-gboard-in-combat .ps-gboard-combat-action-view .ps-gboard-resolve-formula {
    font-size: 11px;
    white-space: normal;
}
.ps-gboard-in-combat .ps-gboard-combat-action-view .ps-gboard-resolve-result {
    margin-top: 7px;
    font-size: 16px;
}
.ps-gboard-in-combat .ps-gboard-combat-action-view .ps-gboard-resolve-dice {
    margin-top: 16px;
}

/* The hand lives below the focal art. Hover is a small confirmation lift;
   detail is read in the right lane instead of enlarging over the enemy. */
.ps-gboard-in-combat .ps-battle-hand.ps-gboard-hand-fan .ps-gboard-fan-card {
    scale: 0.86 0.86 1;
    opacity: 0.92;
    transition-property: translate, scale, opacity;
    transition-duration: 0.14s;
}
.ps-gboard-in-combat .ps-battle-hand.ps-gboard-hand-fan .ps-gboard-fan-card:hover {
    translate: 0 -16px;
    scale: 0.90 0.90 1;
    opacity: 1;
}
.ps-gboard-in-combat .ps-gboard-viewport {
    opacity: 0.46;
}
.ps-gboard-in-combat .ps-gboard-en-rail {
    left: 34px;
    bottom: 18px;
    width: 220px;
    min-height: 46px;
    height: 46px;
    padding: 0 50px;
}
.ps-gboard-in-combat .ps-gboard-combat-rail {
    right: 34px;
    bottom: 18px;
    width: 330px;
    height: 48px;
    padding: 5px 7px;
}
.ps-gboard-in-combat .ps-gboard-skill.ps-gboard-action,
.ps-gboard-in-combat .ps-gboard-endturn.ps-gboard-action {
    min-height: 36px;
    height: 36px;
    font-size: 12px;
}

/* Exploration uses the same side-reading rule as combat. Browsing a card
   replaces the right preview instead of spawning a duplicate above the fan. */
.ps-gboard .ps-gboard-side-preview,
.ps-gboard .ps-gboard-side-preview:hover {
    translate: 0 0;
    scale: 1 1 1;
}
.ps-gboard .ps-gboard-fan-card.ps-gboard-fan-selected {
    translate: 0 0;
    scale: 1 1 1;
    opacity: 1;
}

/* ===== Full-board HUD: no top banner =====
   The dungeon is the screen. Persistent player vitals become one ornamental
   lower-left crest, while route facts live in compact upper-right chips. */
.ps-gboard-stage {
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}
.ps-gboard > .ps-gboard-gate,
.ps-gboard-event-overlay {
    top: 0;
}
.ps-gboard-in-combat .ps-gboard-combat-stage {
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.ps-gboard-player-hud {
    position: absolute;
    left: 10px;
    bottom: 7px;
    width: 343px;
    height: 86%;
    background-color: rgba(0, 0, 0, 0);
    transition-property: scale, opacity;
    transition-duration: 0.16s;
}
.ps-gboard-player-hud-ornament-clip {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 343px;
    height: auto;
    overflow: visible;
}
.ps-gboard-player-hud-ornament {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 343px;
    height: auto;
    -unity-background-scale-mode: scale-to-fit;
}
.ps-gboard.ps-gboard-player-hit .ps-gboard-player-hud {
    scale: 0.97 0.97 1;
    opacity: 0.72;
}
.ps-gboard-player-hud .ps-gboard-hero,
.ps-gboard-idle .ps-gboard-player-hud .ps-gboard-hero,
.ps-gboard-idle.ps-gboard-header-hover .ps-gboard-player-hud .ps-gboard-hero {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: auto;
    min-height: 0;
    margin: 0;
    padding: 0;
    opacity: 1;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}
.ps-gboard-player-hud .ps-gboard-hero-row {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: auto;
}
.ps-gboard-player-hud .ps-gboard-portrait {
    position: absolute;
    left: 31px;
    bottom: 23px;
    width: 112px;
    height: 112px;
    margin: 0;
    overflow: hidden;
    rotate: 45deg;
    background-color: rgba(3, 2, 18, 0.90);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}
.ps-gboard-player-hud .ps-gboard-portrait-image {
    position: absolute;
    left: -8px;
    top: -8px;
    width: 128px;
    height: 128px;
    rotate: -45deg;
    scale: 1.16 1.16 1;
}
.ps-gboard-player-hud .ps-gboard-portrait-blank {
    width: 100%;
    height: 100%;
    background-color: rgba(6, 4, 24, 0.82);
}
.ps-gboard-player-hud .ps-gboard-hero-meta {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: auto;
    min-width: 0;
}
.ps-gboard-player-hud .ps-gboard-hero-name {
    display: none;
}
.ps-gboard-player-hud .ps-gboard-hp-label,
.ps-gboard-player-hud .ps-gboard-shield-label {
    position: absolute;
    top: auto;
    bottom: 148px;
    margin: 0;
    padding: 0;
    font-size: 8px;
    letter-spacing: 0;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    background-color: rgba(4, 3, 22, 0.88);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.96);
}
.ps-gboard-player-hud .ps-gboard-hp-label {
    left: 67px;
    width: 43px;
    height: 25px;
    color: rgb(255, 164, 200);
    border-bottom-width: 1px;
    border-bottom-color: rgb(255, 72, 145);
}
.ps-gboard-player-hud .ps-gboard-shield-label {
    left: 115px;
