    -unity-font-definition: resource("Fonts/NotoSerifJP-VF");
}

.ps-hub-misprint__briefing-mark {
    width: 20px;
    height: 20px;
    min-width: 20px;
    margin-right: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.ps-hub-misprint__briefing-mark--objective { background-image: resource("Art/UI/ObsidianMisprint/hub-icon-expedition-v1"); }
.ps-hub-misprint__briefing-mark--recommend { background-image: resource("Art/UI/ObsidianMisprint/hub-icon-role-v1"); }
.ps-hub-misprint__briefing-mark--notice { background-image: resource("Art/UI/ObsidianMisprint/hub-icon-guide-v1"); }
.ps-hub-misprint__briefing-mark--progress { background-image: resource("Art/UI/ObsidianMisprint/hub-icon-compendium-v1"); }

.ps-hub-misprint__briefing-copy { flex-grow: 1; min-width: 0; flex-direction: column; }
.ps-hub-misprint__briefing-title { color: rgb(231, 204, 163); font-size: 12px; -unity-font-definition: resource("Fonts/NotoSerifJP-VF"); -unity-font-style: bold; }
.ps-hub-misprint__briefing-body { color: rgba(219, 194, 156, 0.7); font-size: 9px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.ps-hub-misprint__briefing-tail {
    width: 22px;
    height: 22px;
    min-width: 22px;
    margin-left: 8px;
    background-image: resource("Art/UI/ObsidianMisprint/hub-icon-registration-arrow-v1");
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0.72;
}

.ps-hub-misprint__mission {
    position: absolute;
    left: 620px;
    right: 18px;
    bottom: 58px;
    height: 190px;
    flex-direction: row;
    align-items: stretch;
    padding: 22px 22px 19px 29px;
    background-image: resource("Art/UI/ObsidianMisprint/hub-mission-briefing-paper-v1");
    -unity-background-scale-mode: stretch-to-fill;
}

.ps-hub-misprint__mission-copy {
    width: 52%;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
    padding: 2px 18px 3px 0;
    overflow: hidden;
}

.ps-hub-misprint__mission-heading-row {
    height: 34px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.ps-hub-misprint__mission-heading {
    color: rgb(27, 24, 20);
    font-size: 28px;
    -unity-font-definition: resource("Fonts/KleeOne-SemiBold");
}

.ps-hub-misprint__mission-folio {
    color: rgba(134, 43, 33, 0.8);
    font-size: 8px;
    white-space: nowrap;
    overflow: hidden;
