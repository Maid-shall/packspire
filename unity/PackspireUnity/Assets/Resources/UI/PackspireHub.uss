}

.ps-hub-misprint__mission-title {
    margin-top: 3px;
    color: rgb(26, 23, 19);
    font-size: 20px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-font-definition: resource("Fonts/NotoSerifJP-VF");
}

.ps-hub-misprint__mission-meta-row {
    height: 38px;
    flex-direction: row;
    align-items: center;
    margin-top: 9px;
}

.ps-hub-misprint__mission-meta-item {
    flex-grow: 1;
    min-width: 0;
    flex-direction: column;
    padding: 0 9px 0 0;
    margin-right: 9px;
    border-right-width: 1px;
    border-right-color: rgba(141, 44, 34, 0.32);
}

.ps-hub-misprint__mission-meta-item--last {
    margin-right: 0;
    border-right-width: 0;
}

.ps-hub-misprint__mission-meta-key {
    color: rgba(137, 39, 31, 0.78);
    font-size: 8px;
}

.ps-hub-misprint__mission-meta-value {
    color: rgba(41, 33, 25, 0.86);
    font-size: 10px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.ps-hub-misprint__mission-action {
    flex-grow: 1;
    min-width: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin: 6px 0 6px 0;
    padding: 10px 10px 10px 68px;
    background-color: rgba(0, 0, 0, 0);
    background-image: resource("Art/UI/ObsidianMisprint/hub-expedition-command-v1");
    -unity-background-scale-mode: stretch-to-fill;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    overflow: hidden;
}

.ps-hub-misprint__mission-action:hover {
    translate: 2px 0;
}

.ps-hub-misprint__mission-action-label {
    color: rgb(139, 37, 29);
    font-size: 27px;
    -unity-font-definition: resource("Fonts/KleeOne-SemiBold");
    white-space: nowrap;
}

.ps-hub-misprint__heading-wordmark {
    color: rgba(0, 0, 0, 0);
    font-size: 0;
}

.ps-hub-misprint__indexes {
    position: absolute;
    right: 20px;
    bottom: 10px;
    width: 290px;
    height: 44px;
    flex-direction: row;
}

.ps-hub-misprint__index {
    width: 50%;
    height: 44px;
    min-height: 44px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-left: 5px;
    padding: 6px 28px 6px 10px;
    background-image: resource("Art/UI/ObsidianMisprint/hub-decor-index-ticket-v1");
    -unity-background-scale-mode: stretch-to-fill;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.ps-hub-misprint__index:hover { translate: 0 -1px; }
.ps-hub-misprint__index-title { color: rgb(38, 31, 24); font-size: 13px; -unity-font-definition: resource("Fonts/NotoSerifJP-VF"); }
.ps-hub-misprint__index-value { color: rgb(137, 40, 31); font-size: 16px; }

.ps-hub-misprint__modal {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.ps-hub-misprint__modal.is-open { display: flex; }

.ps-hub-misprint__modal-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.78);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.ps-hub-misprint__modal-panel {
    width: 920px;
    height: 560px;
    flex-direction: column;
    padding: 18px;
    background-color: rgb(11, 12, 12);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(199, 158, 97);
    border-right-color: rgb(199, 158, 97);
    border-top-color: rgb(199, 158, 97);
    border-bottom-color: rgb(199, 158, 97);
}

.ps-hub-misprint__modal-header {
    height: 52px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-bottom-width: 1px;
    border-bottom-color: rgba(205, 166, 103, 0.52);
}

.ps-hub-misprint__modal-title { color: rgb(229, 201, 157); font-size: 25px; -unity-font-definition: resource("Fonts/NotoSerifJP-VF"); }
.ps-hub-misprint__modal-close { width: 100px; height: 34px; background-color: rgba(0, 0, 0, 0); border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgb(190, 149, 91); border-right-color: rgb(190, 149, 91); border-top-color: rgb(190, 149, 91); border-bottom-color: rgb(190, 149, 91); color: rgb(223, 195, 151); }

.ps-hub-misprint__modal-body { flex-grow: 1; min-height: 0; flex-direction: row; margin-top: 12px; }
.ps-hub-misprint__modal-categories { width: 150px; flex-shrink: 0; flex-direction: column; padding-right: 10px; }
.ps-hub-street-guide-cat { height: 42px; margin-bottom: 4px; background-color: rgba(0, 0, 0, 0); border-left-width: 3px; border-right-width: 0; border-top-width: 0; border-bottom-width: 1px; border-left-color: rgba(194, 151, 91, 0.24); border-bottom-color: rgba(194, 151, 91, 0.26); color: rgb(211, 184, 143); }
.ps-hub-street-guide-cat.ps-selected { border-left-color: rgb(196, 50, 38); background-color: rgba(164, 44, 34, 0.18); color: rgb(239, 208, 163); }
.ps-hub-misprint__modal-list { width: 370px; flex-shrink: 0; margin-right: 12px; background-color: rgba(0, 0, 0, 0); }
.ps-hub-misprint__modal-detail { flex-grow: 1; min-width: 0; padding: 16px; border-left-width: 1px; border-left-color: rgba(201, 160, 98, 0.44); }

.ps-hub-chrome {
    width: 100%;
    min-height: 66px;
    margin-bottom: 5px;
    padding: 8px;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 2px;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 1px;
    border-left-color: rgba(196, 153, 91, 0.22);
    border-bottom-color: rgba(196, 153, 91, 0.26);
}

.ps-hub-chrome:hover,
.ps-hub-chrome.ps-selected { background-color: rgba(156, 42, 32, 0.16); border-left-color: rgb(194, 52, 40); }
.ps-hub-chrome-frame,
.ps-hub-chrome-face { flex-grow: 1; min-width: 0; flex-direction: row; align-items: center; }
.ps-hub-chrome-glow { display: none; }
.ps-hub-chrome-emblem { width: 44px; height: 44px; min-width: 44px; align-items: center; justify-content: center; margin-right: 8px; }
.ps-hub-chrome-emblem-text { color: rgb(64, 186, 191); font-size: 11px; }
.ps-hub-chrome-copy { flex-grow: 1; min-width: 0; flex-direction: column; }
.ps-hub-chrome-title { color: rgb(228, 201, 158); font-size: 16px; }
.ps-hub-chrome-sub { color: rgba(211, 184, 143, 0.66); font-size: 10px; }
.ps-hub-chrome-primary,
.ps-hub-chrome-secondary { min-height: 42px; margin-top: 12px; border-left-color: rgb(190, 49, 38); }
