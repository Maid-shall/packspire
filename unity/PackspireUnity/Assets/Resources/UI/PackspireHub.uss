    background-image: resource("Art/UI/ObsidianMisprint/hub-icon-wax-seal-v1");
    -unity-background-scale-mode: scale-to-fit;
}

.ps-hub-misprint__currency-value {
    color: rgb(229, 194, 140);
    font-size: 24px;
    -unity-font-definition: resource("Fonts/NotoSerifJP-VF");
}

.ps-hub-misprint__upper-grid {
    height: 192px;
    flex-shrink: 0;
    flex-direction: row;
    margin-top: 8px;
}

.ps-hub-misprint__studies {
    width: 30%;
    flex-shrink: 0;
    flex-direction: row;
    border-right-width: 1px;
    border-right-color: rgba(211, 172, 108, 0.34);
    padding-right: 6px;
}

.ps-hub-misprint__study {
    width: 50%;
    height: 100%;
    align-items: center;
    justify-content: flex-end;
    overflow: hidden;
    opacity: 0.72;
}

.ps-hub-misprint__study .ps-hub-misprint__study-image,
.ps-hub-misprint__study .ps-hub-misprint__study-image.ps-portrait-display-image {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.ps-hub-misprint__equipment-record {
    flex-grow: 1;
    min-width: 0;
    flex-direction: column;
    margin-left: 10px;
}

.ps-hub-misprint__equipment-row {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
    margin-top: 5px;
}

.ps-hub-misprint__equipment-cell {
    width: 33.333%;
    height: 100%;
    min-height: 0;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    margin: 0;
    padding: 3px 5px 2px 5px;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 1px;
    border-top-width: 0;
    border-bottom-width: 0;
    border-right-color: rgba(211, 172, 108, 0.28);
}

.ps-hub-misprint__equipment-cell--last { border-right-width: 0; }

.ps-hub-misprint__equipment-art {
    flex-grow: 1;
    width: 100%;
    min-height: 0;
    margin: 0;
    -unity-background-scale-mode: scale-to-fit;
    overflow: hidden;
}

.ps-hub-misprint__equipment-art--loadout { background-image: resource("Art/UI/ObsidianMisprint/hub-parcel-v1"); }
.ps-hub-misprint__equipment-art--heirloom { background-image: resource("Art/UI/ObsidianMisprint/hub-order-slip-v1"); }
.ps-hub-misprint__equipment-art--heirloom.has-art { background-image: none; }

.ps-hub-misprint__equipment-image,
.ps-hub-misprint__equipment-image.ps-portrait-display-image {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.ps-hub-misprint__equipment-copy {
    height: 45px;
    flex-shrink: 0;
    width: 100%;
    min-width: 0;
    flex-direction: column;
    justify-content: flex-start;
}

.ps-hub-misprint__equipment-meta {
    color: rgb(75, 190, 194);
    font-size: 7px;
}

.ps-hub-misprint__equipment-name {
    color: rgb(221, 194, 151);
    font-size: 10px;
    -unity-font-definition: resource("Fonts/NotoSerifJP-VF");
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.ps-hub-misprint__equipment-detail {
    color: rgba(219, 194, 156, 0.64);
    font-size: 7px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.ps-hub-misprint__lower-grid {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
    margin-top: 8px;
    border-top-width: 1px;
    border-top-color: rgba(211, 172, 108, 0.46);
    padding-top: 6px;
}

.ps-hub-misprint__briefing-module { flex-grow: 1; min-width: 0; flex-direction: column; }

.ps-hub-misprint__briefing-heading {
    height: 24px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 0 8px;
}

.ps-hub-misprint__briefing-heading-meta { color: rgba(67, 191, 196, 0.78); font-size: 8px; }

.ps-hub-misprint__briefing-host {
    height: 136px;
    min-height: 136px;
    flex-shrink: 0;
    flex-direction: column;
    margin-top: 2px;
    padding: 4px 18px 4px 8px;
    background-image: resource("Art/UI/ObsidianMisprint/hub-objective-lines-v1");
    -unity-background-scale-mode: stretch-to-fill;
}

.ps-hub-misprint__briefing-item {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
    align-items: center;
    margin: 0;
    padding: 3px 8px 3px 5px;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    overflow: hidden;
}

.ps-hub-misprint__briefing-item:hover {
    translate: 2px 0;
    background-color: rgba(170, 48, 37, 0.12);
}

.ps-hub-misprint__briefing-index {
    width: 24px;
    min-width: 24px;
    margin-right: 5px;
    color: rgba(198, 55, 43, 0.9);
