    background-image: resource("Art/UI/ObsidianMisprint/hub-decor-cyan-offset-v1");
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0.58;
}

.ps-hub-misprint__character-host {
    position: absolute;
    left: 34px;
    right: -34px;
    top: -26px;
    bottom: -54px;
    align-items: center;
    justify-content: flex-end;
    overflow: visible;
}

.ps-hub-misprint__character-portrait,
.ps-hub-misprint__character-portrait.ps-portrait-display-image {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
