    -unity-font-definition: resource("Fonts/NotoSerifJP-VF");
}

.ps-hub-misprint__identity-code { color: rgb(70, 190, 194); font-size: 9px; }

.ps-hub-misprint__dossier {
    position: absolute;
    left: 704px;
    right: 16px;
    top: 16px;
    height: 450px;
    flex-direction: column;
}

.ps-hub-misprint__dossier-top {
    height: 36px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-bottom-width: 1px;
    border-bottom-color: rgba(211, 172, 108, 0.52);
}

.ps-hub-misprint__section-title,
.ps-hub-misprint__module-title {
    color: rgb(217, 184, 133);
    font-size: 12px;
    -unity-font-definition: resource("Fonts/NotoSerifJP-VF");
}

.ps-hub-misprint__currency {
    flex-direction: row;
    align-items: center;
