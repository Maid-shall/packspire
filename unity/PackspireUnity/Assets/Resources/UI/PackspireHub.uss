.ps-hub-misprint {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    overflow: hidden;
    background-color: rgb(8, 9, 9);
    color: rgb(224, 199, 158);
    -unity-font-definition: resource("Fonts/KleeOne-SemiBold");
}

.ps-hub-misprint__background {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: resource("Art/UI/ObsidianMisprint/hub-misprint-background-v1");
    -unity-background-scale-mode: scale-and-crop;
}

.ps-hub-misprint__edge-shade {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(2, 4, 5, 0.16);
}

.ps-hub-misprint__nav {
    position: absolute;
    left: 8px;
    top: 14px;
    bottom: 14px;
    width: 272px;
    flex-direction: column;
    padding-right: 4px;
}

.ps-hub-misprint__nav-diagonal-rule {
    position: absolute;
    left: 260px;
    top: 0;
    width: 721px;
    height: 1px;
    background-color: rgba(218, 179, 116, 0.62);
    rotate: 93.2deg;
    transform-origin: 0% 50%;
}

.ps-hub-misprint__masthead {
    height: 58px;
    flex-shrink: 0;
    justify-content: flex-start;
    border-bottom-width: 1px;
    border-bottom-color: rgba(218, 179, 116, 0.42);
}

.ps-hub-misprint__brand {
    margin: 0;
    padding: 0;
    color: rgb(232, 200, 151);
    font-size: 18px;
    -unity-font-definition: resource("Fonts/NotoSerifJP-VF");
}

.ps-hub-misprint__brand-copy {
    margin-top: 2px;
    color: rgba(218, 192, 151, 0.74);
    font-size: 10px;
}

.ps-hub-misprint__nav-scroll {
    flex-grow: 1;
    min-height: 0;
    margin-top: 0;
    background-color: rgba(0, 0, 0, 0);
}

.ps-hub-misprint__nav-list {
    flex-direction: column;
}

.ps-hub-misprint__nav-row {
    position: relative;
    width: 252px;
    height: 82px;
    min-height: 82px;
    flex-shrink: 0;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    margin: 0;
    padding: 7px 18px 6px 9px;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(194, 157, 98, 0.28);
    color: rgb(226, 204, 169);
    overflow: visible;
}

.ps-hub-misprint__nav-row--1 { width: 248px; }
.ps-hub-misprint__nav-row--2 { width: 244px; }
.ps-hub-misprint__nav-row--3 { width: 240px; }
.ps-hub-misprint__nav-row--4 { width: 236px; }

.ps-hub-misprint__nav-row.is-reel-current {
    height: 116px;
    min-height: 116px;
    padding: 10px 22px 8px 9px;
    background-image: resource("Art/UI/ObsidianMisprint/hub-nav-selected-paper-v1");
    -unity-background-scale-mode: stretch-to-fill;
    border-bottom-width: 0;
    color: rgb(17, 16, 14);
}

.ps-hub-misprint__nav-row:hover {
    background-color: rgba(201, 166, 105, 0.07);
}

.ps-hub-misprint__nav-row.is-reel-current:hover {
    background-color: rgba(0, 0, 0, 0);
}

.ps-hub-misprint__nav-row.is-locked {
    opacity: 0.36;
}

.ps-hub-misprint__nav-icon {
    width: 12px;
    height: 12px;
    min-width: 12px;
    min-height: 12px;
    margin-right: 6px;
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0.88;
}

.ps-hub-misprint__nav-icon--gate { background-image: resource("Art/UI/ObsidianMisprint/hub-icon-expedition-v1"); }
.ps-hub-misprint__nav-icon--forge { background-image: resource("Art/UI/ObsidianMisprint/hub-icon-loadout-v1"); }
.ps-hub-misprint__nav-icon--vault { background-image: resource("Art/UI/ObsidianMisprint/hub-icon-vault-v1"); }
.ps-hub-misprint__nav-icon--heirloom { background-image: resource("Art/UI/ObsidianMisprint/hub-icon-heirloom-v1"); }
.ps-hub-misprint__nav-icon--guild { background-image: resource("Art/UI/ObsidianMisprint/hub-icon-role-v1"); }
.ps-hub-misprint__nav-icon--codex { background-image: resource("Art/UI/ObsidianMisprint/hub-icon-compendium-v1"); }

.ps-hub-misprint__nav-copy {
    width: 100%;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
}

.ps-hub-misprint__nav-subline {
    height: 15px;
    min-height: 15px;
    flex-direction: row;
    align-items: center;
    margin-top: -1px;
}

.ps-hub-misprint__nav-title {
    margin: 0;
    padding: 0;
    height: 42px;
    color: rgba(0, 0, 0, 0);
    font-size: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(232, 208, 171);
    white-space: nowrap;
}

.ps-hub-misprint__nav-title--forge {
    width: 112px;
    background-image: resource("Art/UI/ObsidianMisprint/hub-nav-wordmark-forge-v1");
}

.ps-hub-misprint__nav-title--vault {
    width: 119px;
    background-image: resource("Art/UI/ObsidianMisprint/hub-nav-wordmark-vault-v1");
}

.ps-hub-misprint__nav-title--heirloom {
    width: 80px;
    background-image: resource("Art/UI/ObsidianMisprint/hub-nav-wordmark-heirloom-v1");
}

.ps-hub-misprint__nav-title--guild {
    width: 81px;
    background-image: resource("Art/UI/ObsidianMisprint/hub-nav-wordmark-guild-v1");
}

.ps-hub-misprint__nav-title--codex {
    width: 79px;
    background-image: resource("Art/UI/ObsidianMisprint/hub-nav-wordmark-codex-v1");
}

.ps-hub-misprint__nav-meta {
    margin: 0;
    padding: 0;
    color: rgba(209, 177, 123, 0.76);
    font-size: 8px;
    white-space: nowrap;
}

.ps-hub-misprint__nav-row.is-reel-current .ps-hub-misprint__nav-title,
.ps-hub-misprint__nav-row.is-reel-current .ps-hub-misprint__nav-meta {
    color: rgb(18, 16, 13);
}

.ps-hub-misprint__nav-row.is-reel-current .ps-hub-misprint__nav-title {
    height: 58px;
    -unity-background-image-tint-color: rgb(18, 16, 13);
}

.ps-hub-misprint__nav-row.is-reel-current .ps-hub-misprint__nav-title--forge { width: 154px; }
.ps-hub-misprint__nav-row.is-reel-current .ps-hub-misprint__nav-title--vault { width: 165px; }
.ps-hub-misprint__nav-row.is-reel-current .ps-hub-misprint__nav-title--heirloom { width: 111px; }
.ps-hub-misprint__nav-row.is-reel-current .ps-hub-misprint__nav-title--guild { width: 112px; }
.ps-hub-misprint__nav-row.is-reel-current .ps-hub-misprint__nav-title--codex { width: 110px; }

.ps-hub-misprint__nav-registration {
    display: none;
    position: absolute;
    right: -12px;
    top: 41px;
    width: 34px;
    height: 34px;
    background-image: resource("Art/UI/ObsidianMisprint/hub-icon-registration-arrow-v1");
    -unity-background-scale-mode: scale-to-fit;
}

.ps-hub-misprint__nav-row.is-reel-current .ps-hub-misprint__nav-registration {
    display: flex;
}

.ps-hub-misprint__guide {
    width: 216px;
    height: 60px;
    min-height: 60px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
    padding: 6px 10px;
    background-color: rgba(8, 10, 10, 0.86);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgba(204, 165, 105, 0.48);
    border-bottom-color: rgba(204, 165, 105, 0.48);
}

.ps-hub-misprint__guide:hover {
    background-color: rgba(62, 48, 32, 0.52);
    border-top-color: rgb(220, 180, 112);
    border-bottom-color: rgb(220, 180, 112);
}

.ps-hub-misprint__guide-icon {
    width: 40px;
    height: 40px;
    margin-right: 10px;
    background-image: resource("Art/UI/ObsidianMisprint/hub-icon-guide-v1");
    -unity-background-scale-mode: scale-to-fit;
}

.ps-hub-misprint__guide-copy { min-width: 0; flex-direction: column; overflow: hidden; }
.ps-hub-misprint__guide-title { color: rgb(226, 204, 169); font-size: 18px; }
.ps-hub-misprint__guide-meta { color: rgba(201, 166, 110, 0.76); font-size: 9px; }

.ps-hub-misprint__heading-wordmark {
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    -unity-background-scale-mode: scale-to-fit;
    overflow: hidden;
}

.ps-hub-misprint__heading-wordmark--guide {
    width: 82px;
    height: 22px;
    background-image: resource("Art/UI/ObsidianMisprint/hub-heading-guide-v1");
    -unity-background-image-tint-color: rgb(226, 204, 169);
}

.ps-hub-misprint__heading-wordmark--equipment {
    width: 60px;
    height: 16px;
    background-image: resource("Art/UI/ObsidianMisprint/hub-heading-equipment-record-v1");
    -unity-background-image-tint-color: rgb(217, 184, 133);
}

.ps-hub-misprint__heading-wordmark--record {
    width: 84px;
    height: 18px;
    background-image: resource("Art/UI/ObsidianMisprint/hub-heading-current-record-v1");
    -unity-background-image-tint-color: rgb(217, 184, 133);
}

.ps-hub-misprint__heading-wordmark--mission {
    width: 112px;
    height: 24px;
    background-image: resource("Art/UI/ObsidianMisprint/hub-heading-mission-v1");
    -unity-background-image-tint-color: rgb(36, 29, 22);
}

.ps-hub-misprint__heading-wordmark--action {
    width: 162px;
    height: 26px;
    background-image: resource("Art/UI/ObsidianMisprint/hub-heading-expedition-open-v1");
    -unity-background-image-tint-color: rgb(139, 37, 29);
}

.ps-hub-misprint__character-stage {
    position: absolute;
    left: 232px;
    top: 0;
    bottom: 0;
    width: 472px;
    overflow: visible;
}

.ps-hub-misprint__destination-block {
    position: absolute;
    left: 62px;
