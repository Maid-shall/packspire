<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="packing-background" class="ps-rite-scene-bg" picking-mode="Ignore" />
    <ui:VisualElement class="ps-rite-scene-shade" picking-mode="Ignore" />
    <ui:Button name="packing-back" text="← 戻る" class="ps-packing-back" />
    <ui:VisualElement name="packing-top" class="ps-rite-top">
        <ui:VisualElement class="ps-rite-top-title">
            <ui:Label text="PACKSPIRE / PACKING" class="ps-rite-top-eyebrow" picking-mode="Ignore" />
            <ui:Label text="荷造り" class="ps-rite-top-name" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement class="ps-rite-top-actions">
            <ui:Button name="packing-loadouts" text="術式を切替" class="ps-packing-action" />
            <ui:Button name="packing-formula-edit" text="盤の構成" class="ps-packing-action" />
            <ui:Button name="packing-save" text="荷造りを保存" class="ps-packing-action ps-packing-confirm" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="packing-body" class="ps-rite-body">
        <ui:VisualElement name="packing-left" class="ps-rite-left">
            <ui:VisualElement class="ps-packing-inventory-heading">
                <ui:Label text="所持品一覧" class="ps-rite-panel-title" />
                <ui:Label name="packing-inventory-count" class="ps-rite-meta" />
            </ui:VisualElement>
            <ui:VisualElement class="ps-packing-search-row ps-packing-preserve-selection">
                <ui:TextField name="packing-search" label="検索" class="ps-packing-search" />
                <ui:Toggle name="packing-unplaced" label="未配置のみ" class="ps-packing-unplaced" />
                <ui:Button name="packing-sort" text="名前順" class="ps-packing-action ps-packing-sort" />
            </ui:VisualElement>
            <ui:VisualElement name="packing-filter-host" class="ps-rite-filters ps-packing-preserve-selection">
                <ui:Button name="packing-filter-all" text="全部" class="ps-packing-action ps-rite-filter" />
                <ui:Button name="packing-filter-weapon" text="武器" class="ps-packing-action ps-rite-filter" />
                <ui:Button name="packing-filter-armor" text="防具" class="ps-packing-action ps-rite-filter" />
                <ui:Button name="packing-filter-rune" text="ルーン" class="ps-packing-action ps-rite-filter" />
                <ui:Button name="packing-filter-supply" text="道具" class="ps-packing-action ps-rite-filter" />
            </ui:VisualElement>
            <ui:ScrollView name="packing-equip-scroll" class="ps-rite-equip-scroll" mode="Vertical" vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden">
                <ui:VisualElement name="packing-equip-grid" class="ps-rite-equip-grid" />
            </ui:ScrollView>
            <ui:Label text="装備を盤へドラッグ ／ 空白をクリックで選択解除" class="ps-packing-inventory-help" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement class="ps-packing-workspace">
            <ui:VisualElement class="ps-packing-workspace-heading">
                <ui:Label name="packing-loadout-name" class="ps-rite-panel-title" />
                <ui:Label name="packing-board-size" class="ps-rite-board-heading-size" />
            </ui:VisualElement>
            <ui:Label name="packing-formula-summary" class="ps-packing-formula-summary" />
            <ui:VisualElement class="ps-packing-upper">
                <ui:VisualElement name="packing-center" class="ps-rite-center">
                    <ui:ScrollView name="packing-board-scroll" class="ps-packing-board-scroll" mode="VerticalAndHorizontal" horizontal-scroller-visibility="Auto" vertical-scroller-visibility="Auto">
                        <ui:VisualElement name="packing-kiln" class="ps-rite-kiln">
                            <ui:VisualElement name="packing-board-host" class="ps-rite-circle" />
                        </ui:VisualElement>
                    </ui:ScrollView>
                    <ui:VisualElement name="packing-kiln-rail" class="ps-packing-board-tools ps-packing-preserve-selection">
                        <ui:Button name="packing-zoom-out" text="−" class="ps-packing-action ps-packing-zoom" />
                        <ui:Label name="packing-zoom-value" text="100%" class="ps-packing-zoom-value" />
                        <ui:Button name="packing-zoom-in" text="＋" class="ps-packing-action ps-packing-zoom" />
                        <ui:Button name="packing-fit" text="全体表示" class="ps-packing-action" />
                        <ui:Button name="packing-context-toggle" text="選択情報を畳む" class="ps-packing-action" />
                    </ui:VisualElement>
                    <ui:Label text="宝石＝盤の属性 ／ 菱形＝装備の属性 ／ 水色の境界＝選択中" class="ps-packing-board-legend" picking-mode="Ignore" />
                    <ui:Label name="packing-drag-preview" class="ps-packing-drag-preview" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="packing-right-shell" class="ps-rite-right-shell ps-packing-preserve-selection">
                    <ui:Label text="選択中の装備" class="ps-packing-context-heading" />
                    <ui:Label name="packing-selected-name" text="装備を選択" class="ps-rite-detail-name" />
                    <ui:Label name="packing-selected-status" class="ps-rite-meta" />
                    <ui:Label name="packing-selected-description" class="ps-packing-selected-description" />
                    <ui:VisualElement class="ps-packing-shape-row">
                        <ui:VisualElement name="packing-selected-shape" />
                        <ui:Label name="packing-selected-rotation" class="ps-rite-meta" />
                    </ui:VisualElement>
                    <ui:VisualElement class="ps-packing-selection-actions">
                        <ui:Button name="packing-rotate" text="回転" class="ps-packing-action" />
                        <ui:Button name="packing-remove" text="盤から外す" class="ps-packing-action" />
                    </ui:VisualElement>
                    <ui:Label text="関連効果・LINK" class="ps-packing-context-heading" />
                    <ui:ScrollView name="packing-right-scroll" class="ps-rite-right ps-packing-effects-scroll" mode="Vertical" vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="ps-packing-results ps-packing-preserve-selection">
                <ui:VisualElement class="ps-packing-results-heading">
                    <ui:Label text="配置結果 — 編成全体" class="ps-rite-panel-title" />
                    <ui:Button name="packing-cards" text="装備由来の札を見る" class="ps-packing-action" />
                </ui:VisualElement>
                <ui:VisualElement class="ps-packing-result-columns">
                    <ui:VisualElement class="ps-packing-result-group">
                        <ui:Label name="packing-link-summary" text="LINK・札変化" class="ps-packing-result-title" />
                        <ui:ScrollView name="packing-links-scroll" class="ps-packing-effects-scroll" mode="Vertical" vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden" />
                    </ui:VisualElement>
                    <ui:VisualElement class="ps-packing-result-group ps-packing-color-group">
                        <ui:Label name="packing-color-summary" text="色一致・配達印" class="ps-packing-result-title" />
                        <ui:ScrollView name="packing-colors-scroll" class="ps-packing-effects-scroll" mode="Vertical" vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="packing-loadout-overlay" class="ps-packing-loadout-overlay ps-packing-preserve-selection">
        <ui:VisualElement class="ps-packing-loadout-panel">
            <ui:VisualElement class="ps-rite-template-head">
                <ui:Label text="術式テンプレート" class="ps-rite-panel-title" />
                <ui:Button name="packing-loadout-add" text="新規追加" class="ps-packing-action" />
                <ui:Button name="packing-loadout-close" text="閉じる" class="ps-packing-action" />
            </ui:VisualElement>
            <ui:ScrollView name="packing-loadout-scroll" mode="Vertical" vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
