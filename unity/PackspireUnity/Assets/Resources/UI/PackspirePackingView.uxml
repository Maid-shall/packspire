<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="packing-background" class="ps-rite-scene-bg" picking-mode="Ignore" />
    <ui:VisualElement class="ps-rite-scene-shade" picking-mode="Ignore" />
    <ui:VisualElement class="ps-packing-mark" picking-mode="Ignore" />
    <ui:VisualElement class="ps-packing-register" picking-mode="Ignore" />
    <ui:VisualElement class="ps-packing-proof-slash" picking-mode="Ignore" />
    <ui:VisualElement name="packing-top" class="ps-rite-top">
        <ui:VisualElement class="ps-rite-brand">
            <ui:VisualElement class="ps-rite-brand-mark" picking-mode="Ignore" />
            <ui:VisualElement class="ps-rite-top-title">
                <ui:Label text="PACKSPIRE / PACKING / LOADOUT" class="ps-rite-top-eyebrow" picking-mode="Ignore" />
                <ui:Label text="荷造り" class="ps-rite-top-name" picking-mode="Ignore" />
                <ui:Label text="装備を配置し、遠征の効果とリンクを確認します。" class="ps-rite-top-sub" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="packing-top-actions" class="ps-rite-top-actions" />
    </ui:VisualElement>
    <ui:VisualElement name="packing-body" class="ps-rite-body">
        <ui:VisualElement name="packing-left" class="ps-rite-left">
            <ui:VisualElement class="ps-rite-left-header">
                <ui:VisualElement class="ps-rite-panel-head">
                    <ui:Label text="01" class="ps-rite-panel-index" picking-mode="Ignore" />
                    <ui:Label text="所持品一覧" class="ps-rite-panel-title" picking-mode="Ignore" />
                    <ui:VisualElement class="ps-rite-panel-rule" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="packing-filter-host" />
            </ui:VisualElement>
            <ui:ScrollView name="packing-equip-scroll" class="ps-rite-equip-scroll" mode="Vertical" vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden">
                <ui:VisualElement name="packing-equip-grid" class="ps-rite-equip-grid" />
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:VisualElement name="packing-center" class="ps-rite-center">
            <ui:VisualElement class="ps-rite-board-heading">
                <ui:Label text="収納盤" class="ps-rite-board-heading-title" picking-mode="Ignore" />
                <ui:Label name="packing-board-size" text="6 × 4" class="ps-rite-board-heading-size" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="ps-rite-kiln-row">
                <ui:VisualElement name="packing-kiln" class="ps-rite-kiln"><ui:VisualElement name="packing-board-host" class="ps-rite-circle" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="packing-kiln-rail" class="ps-rite-kiln-rail" />
        </ui:VisualElement>
        <ui:VisualElement name="packing-right-shell" class="ps-rite-right-shell">
            <ui:VisualElement class="ps-packing-tabs">
                <ui:Button name="packing-effects-tab" text="配達員・効果" class="ps-packing-tab" />
                <ui:Button name="packing-formulas-tab" text="術式" class="ps-packing-tab" />
            </ui:VisualElement>
            <ui:VisualElement class="ps-packing-courier">
                <ui:VisualElement name="packing-courier-art" class="ps-packing-courier-art" picking-mode="Ignore" />
                <ui:VisualElement class="ps-packing-courier-copy">
                    <ui:Label name="packing-courier-name" class="ps-packing-courier-name" />
                    <ui:Label name="packing-courier-role" class="ps-rite-meta" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:ScrollView name="packing-right-scroll" class="ps-rite-right" mode="Vertical" vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden" />
            <ui:Button name="packing-save" text="荷造りを保存" class="ps-rite-save" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
