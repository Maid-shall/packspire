    border-bottom-color: rgba(255, 98, 174, 0.56);
}
.ps-gboard-in-combat .ps-gboard-combat-intent-panel {
    right: 48px;
    background-color: rgba(54, 8, 36, 0.92);
    border-left-color: rgb(255, 96, 153);
    border-right-color: rgba(255, 156, 198, 0.52);
    border-top-color: rgba(255, 208, 122, 0.72);
    border-bottom-color: rgba(102, 234, 255, 0.46);
}
.ps-gboard-in-combat .ps-gboard-combat-caption {
    margin-bottom: 5px;
    font-size: 10px;
    letter-spacing: 1.8px;
    color: rgba(194, 226, 255, 0.82);
}
.ps-gboard-in-combat .ps-gboard-combat-vitals .ps-gboard-combat-hp {
    position: relative;
    left: auto;
    top: auto;
    width: auto;
    height: auto;
    min-height: 0;
    padding: 0;
    margin: 0 0 8px;
    font-size: 23px;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}
.ps-gboard-in-combat .ps-gboard-combat-vitals .ps-gboard-combat-hp-track {
    position: relative;
    left: auto;
    top: auto;
    width: 100%;
    height: 10px;
    margin-bottom: 7px;
}
.ps-gboard-in-combat .ps-gboard-combat-intent-panel .ps-gboard-combat-intent {
    position: relative;
    right: auto;
    top: auto;
    width: auto;
    min-height: 0;
    padding: 0;
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    font-size: 19px;
    color: rgb(255, 231, 170);
}
.ps-gboard-in-combat .ps-gboard-combat-intent-hint {
    margin-top: 7px;
    padding-top: 6px;
    font-size: 11px;
    white-space: normal;
    color: rgb(255, 185, 207);
    border-top-width: 1px;
    border-top-color: rgba(255, 195, 130, 0.35);
}
.ps-gboard-in-combat .ps-gboard-combat-statuses {
    flex-direction: row;
    flex-wrap: wrap;
}
.ps-gboard-in-combat .ps-gboard-combat-status-chip {
    margin-right: 5px;
    padding: 2px 6px;
    font-size: 10px;
    color: rgb(255, 223, 164);
    background-color: rgba(102, 48, 151, 0.72);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 190, 114, 0.72);
    border-right-color: rgba(255, 190, 114, 0.72);
    border-top-color: rgba(255, 190, 114, 0.72);
    border-bottom-color: rgba(255, 190, 114, 0.72);
}
.ps-gboard-in-combat .ps-battle-hand.ps-gboard-hand-fan {
    bottom: -20px;
    height: 304px;
}
.ps-gboard-in-combat .ps-battle-hand.ps-gboard-hand-fan .ps-gboard-fan-card {
    scale: 0.91 0.91 1;
    opacity: 0.94;
    transition-property: translate, scale, opacity;
    transition-duration: 0.14s;
}
.ps-gboard-in-combat .ps-battle-hand.ps-gboard-hand-fan .ps-gboard-fan-card:hover {
    translate: 0 -52px;
    scale: 1 1 1;
    opacity: 1;
}
.ps-gboard-in-combat .ps-gboard-viewport {
    opacity: 0.52;
}
.ps-gboard-in-combat .ps-gboard-resolve {
    padding: 10px 14px;
    background-color: rgba(12, 7, 35, 0.96);
    border-left-width: 2px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(112, 236, 255);
    border-right-color: rgba(112, 236, 255, 0.48);
    border-top-color: rgba(255, 207, 125, 0.72);
    border-bottom-color: rgba(255, 103, 184, 0.70);
}
.ps-gboard-in-combat .ps-gboard-resolve-formula {
    font-size: 10px;
    color: rgb(165, 231, 255);
}
.ps-gboard-in-combat .ps-gboard-resolve-result {
    font-size: 12px;
    color: rgb(255, 222, 156);
    -unity-font-style: bold;
}
.ps-gboard-in-combat .ps-gboard-die {
    width: 36px;
    height: 36px;
    font-size: 20px;
    background-color: rgba(99, 46, 126, 0.96);
    border-left-color: rgb(255, 202, 127);
    border-right-color: rgb(255, 202, 127);
    border-top-color: rgb(255, 202, 127);
    border-bottom-color: rgb(255, 202, 127);
}
.ps-gboard-in-combat .ps-gboard-die-mod {
    font-size: 17px;
    color: rgb(255, 217, 157);
}
.ps-gboard-in-combat .ps-gboard-combat-rail {
    padding: 7px 8px;
    background-color: rgba(4, 3, 18, 0.96);
}
.ps-gboard-in-combat .ps-gboard-skill.ps-gboard-action,
.ps-gboard-in-combat .ps-gboard-endturn.ps-gboard-action {
    min-height: 42px;
    height: 42px;
    margin-bottom: 0;
    padding: 0 12px;
    -unity-text-align: middle-center;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
}
.ps-gboard-in-combat .ps-gboard-skill.ps-gboard-action {
    color: rgb(153, 241, 255);
    background-color: rgba(13, 61, 88, 0.88);
    border-left-color: rgb(98, 235, 255);
    border-right-color: rgb(98, 235, 255);
    border-top-color: rgba(194, 246, 255, 0.78);
    border-bottom-color: rgba(104, 173, 255, 0.74);
}
.ps-gboard-in-combat .ps-gboard-endturn.ps-gboard-action {
    color: rgb(255, 228, 171);
    background-color: rgba(99, 18, 53, 0.94);
    border-left-color: rgb(255, 111, 170);
    border-right-color: rgb(255, 111, 170);
    border-top-color: rgba(255, 214, 132, 0.84);
    border-bottom-color: rgba(255, 118, 186, 0.74);
}
.ps-gboard-in-combat .ps-gboard-skill.ps-gboard-action:hover,
.ps-gboard-in-combat .ps-gboard-endturn.ps-gboard-action:hover {
    color: white;
    opacity: 1;
}
.ps-gboard-in-combat .ps-gboard-skill.ps-gboard-action:disabled,
.ps-gboard-in-combat .ps-gboard-endturn.ps-gboard-action:disabled {
    opacity: 0.34;
}
.ps-gboard-in-combat .ps-gboard-fan-card .ps-battle-card-name,
.ps-gboard-in-combat .ps-gboard-fan-card .ps-battle-card-text {
    text-shadow: 0 2px 3px rgba(0, 0, 0, 0.96);
}
.ps-gboard-combat-hp-fill {
    transition-property: width;
    transition-duration: 0.22s;
    transition-timing-function: ease-out;
}
.ps-gboard-in-combat .ps-gboard-enemy-focus {
    transition-property: scale, opacity;
    transition-duration: 0.11s;
}
.ps-gboard-in-combat .ps-gboard-enemy-focus.ps-gboard-enemy-hit {
    scale: 0.96 0.96 1;
    opacity: 0.72;
}
.ps-gboard.ps-gboard-player-hit .ps-gboard-top {
    background-color: rgba(107, 12, 38, 0.96);
}

/* ===== Compact expedition HUD / final three-lane battle composition =====
   The banner is always present but no longer consumes the enemy's vertical
   space. Enemy data reads as one dossier, while card detail and dice share a
   fixed player-context lane on the right. */
.ps-gboard-top,
.ps-gboard-idle .ps-gboard-top,
.ps-gboard-idle.ps-gboard-header-hover .ps-gboard-top {
    left: 12px;
    right: 12px;
    top: 4px;
    height: 92px;
    min-height: 92px;
    padding: 0 22px;
    opacity: 1;
    overflow: visible;
    background-color: rgba(2, 2, 13, 0.95);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}
.ps-gboard-top .ps-rite-tick,
.ps-gboard-top .ps-rite-brand-mark,
.ps-gboard-top .ps-rite-top-eyebrow,
.ps-gboard-top .ps-gboard-top-sub {
    display: none;
}
.ps-gboard-top .ps-rite-brand {
    position: absolute;
    left: 50%;
    top: 20px;
    width: 250px;
    height: 38px;
    margin-left: -125px;
    justify-content: center;
}
.ps-gboard-top .ps-rite-top-title {
    align-items: center;
    justify-content: center;
}
.ps-gboard-top .ps-rite-top-name {
    font-size: 20px;
    letter-spacing: 4px;
    color: rgb(255, 220, 139);
    text-shadow: 0 1px 5px rgba(255, 80, 184, 0.62);
}
.ps-gboard-phase {
    position: absolute;
    left: 50%;
    bottom: 13px;
    width: 160px;
    margin-left: -80px;
    font-size: 9px;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    color: rgb(255, 112, 186);
}
.ps-gboard-ink {
    position: absolute;
    right: 222px;
    top: 34px;
    max-width: 300px;
    margin-left: 0;
    font-size: 10px;
    letter-spacing: 1px;
    -unity-text-align: middle-right;
    color: rgb(111, 231, 255);
}
.ps-gboard-doom {
    position: absolute;
    right: 82px;
    top: 25px;
    min-width: 112px;
    height: 36px;
    margin-left: 0;
    padding: 6px 10px;
    font-size: 17px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(255, 226, 152);
    background-color: rgba(68, 13, 66, 0.82);
    border-left-width: 2px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(255, 91, 173);
    border-right-color: rgb(79, 229, 255);
    border-top-color: rgba(255, 208, 126, 0.72);
    border-bottom-color: rgba(168, 93, 255, 0.72);
}
.ps-gboard-top-finish.ps-gboard-action {
    right: 18px;
    bottom: 12px;
    width: 52px;
    min-width: 52px;
    min-height: 24px;
    height: 24px;
    padding: 0 4px;
    font-size: 9px;
}
.ps-gboard-hero,
.ps-gboard-idle .ps-gboard-hero,
.ps-gboard-idle.ps-gboard-header-hover .ps-gboard-hero {
    left: 28px;
    top: 12px;
    width: 312px;
    min-height: 70px;
    opacity: 1;
}
.ps-gboard-portrait {
    width: 70px;
    height: 70px;
    margin-right: 18px;
    background-color: rgba(3, 3, 14, 0.94);
    border-left-color: rgb(255, 103, 177);
    border-right-color: rgb(74, 230, 255);
    border-top-color: rgb(255, 211, 128);
    border-bottom-color: rgba(165, 93, 255, 0.90);
}
.ps-gboard-hp-label {
    margin-bottom: 4px;
    font-size: 14px;
    color: rgb(255, 224, 198);
}
.ps-gboard-hp-track {
    width: 210px;
    height: 6px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}
.ps-gboard-stage,
.ps-gboard-dock,
.ps-gboard-combat-stage {
    top: 100px;
}
.ps-gboard-stage {
    left: 24px;
    right: 24px;
    bottom: 0;
}
.ps-gboard > .ps-gboard-gate,
.ps-gboard-event-overlay {
    top: 96px;
}

/* Combat stage: left enemy dossier, unobstructed centre art, right context. */
