.ps-gboard-in-combat .ps-gboard-combat-intent-panel {
    position: absolute;
    left: 50%;
    right: auto;
    top: 130px;
    width: 220px;
    min-height: 158px;
    margin-left: -470px;
    padding: 14px 16px;
    background-color: rgba(29, 5, 38, 0.94);
    border-left-width: 2px;
