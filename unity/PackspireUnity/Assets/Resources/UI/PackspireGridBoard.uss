/* PACKSPIRE grid expedition/combat presentation layer.
   Loaded immediately after PackspireRoute.uss; cascade order is intentional.
   Keep board-only overrides here and legacy route/map styles in PackspireRoute.uss. */

/* ===== Expedition shell: board first, fixed hero HUD, dossier right, hand below ===== */
.ps-gboard { background-color: rgb(15, 14, 19); }
.ps-gboard-top { left: 14px; right: 14px; top: 10px; height: 78px; min-height: 78px; justify-content: center; background-color: rgba(12, 13, 20, 0.97); border-left-width: 1px; border-left-color: rgba(194, 157, 81, 0.72); border-right-color: rgba(194, 157, 81, 0.38); border-top-color: rgba(194, 157, 81, 0.38); border-bottom-color: rgba(194, 157, 81, 0.5); }
.ps-gboard-top .ps-rite-brand { position: absolute; left: 50%; margin-left: -145px; width: 290px; justify-content: center; }
.ps-gboard-top .ps-rite-brand-mark, .ps-gboard-top-sub { display: none; }
.ps-gboard-top .ps-rite-top-title { align-items: center; }
.ps-gboard-top .ps-rite-top-name { font-size: 23px; color: rgb(231, 207, 144); letter-spacing: 5px; }
.ps-gboard-top .ps-rite-top-eyebrow { font-size: 10px; letter-spacing: 2px; color: rgba(194, 169, 112, 0.78); }
.ps-gboard-phase { position: absolute; left: 50%; bottom: 8px; margin-left: -160px; width: 320px; color: rgba(210, 190, 144, 0.8); font-size: 10px; -unity-text-align: middle-center; }
.ps-gboard-ink { position: absolute; right: 238px; top: 14px; margin-left: 0; color: rgb(134, 192, 220); }
.ps-gboard-doom { position: absolute; right: 72px; top: 13px; min-width: 150px; padding: 7px 10px; background-color: rgba(56, 23, 34, 0.64); border-left-color: rgb(220, 116, 116); }
.ps-gboard-top-finish { position: absolute; right: 14px; bottom: 10px; margin-left: 0; }

.ps-gboard-hero { position: absolute; left: 26px; top: 17px; width: 350px; min-height: 58px; margin-top: 0; padding: 0; background-color: rgba(0, 0, 0, 0); border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; }
.ps-gboard-portrait { width: 58px; height: 58px; margin-right: 10px; border-left-color: rgba(223, 184, 103, 0.66); border-right-color: rgba(223, 184, 103, 0.45); border-top-color: rgba(223, 184, 103, 0.45); border-bottom-color: rgba(223, 184, 103, 0.45); }
.ps-gboard-hero-name { display: none; }
.ps-gboard-hp-label { font-size: 17px; color: rgb(240, 205, 181); letter-spacing: 1px; margin-bottom: 5px; }
.ps-gboard-hp-track { height: 7px; max-width: 236px; border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; }
.ps-gboard-hp-fill { background-color: rgb(187, 82, 82); }

.ps-gboard-stage { left: 24px; right: 408px; top: 100px; bottom: 142px; padding: 0; background-color: rgba(14, 14, 21, 0.96); border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgba(203, 165, 87, 0.6); border-right-color: rgba(203, 165, 87, 0.35); border-top-color: rgba(203, 165, 87, 0.35); border-bottom-color: rgba(203, 165, 87, 0.6); }
.ps-gboard-viewport { background-color: rgba(9, 10, 16, 0.95); }
.ps-gboard-grid { padding: 8px; background-color: rgba(28, 28, 40, 0.42); border-left-color: rgba(209, 176, 99, 0.5); border-right-color: rgba(209, 176, 99, 0.5); border-top-color: rgba(209, 176, 99, 0.5); border-bottom-color: rgba(209, 176, 99, 0.5); }

.ps-gboard-dock { left: auto; right: 24px; top: 100px; bottom: 142px; width: 360px; padding: 0; background-color: rgba(0, 0, 0, 0); border-right-width: 0; }
.ps-gboard-panel { padding: 18px 17px; background-color: rgba(14, 14, 21, 0.96); border-left-color: rgb(198, 160, 83); }
.ps-gboard-panel-title { font-size: 23px; }
.ps-gboard-panel-body { font-size: 13px; }

.ps-gboard-combat-stage { right: 24px; top: 100px; width: 360px; min-width: 360px; bottom: 142px; padding: 22px 24px 18px; justify-content: flex-start; background-color: rgba(17, 14, 23, 0.98); border-left-color: rgb(215, 126, 119); }
.ps-gboard-combat-portrait { width: 100%; height: 250px; margin-bottom: 8px; }
.ps-gboard-combat-title { align-self: stretch; font-size: 24px; margin-bottom: 5px; }
.ps-gboard-combat-hp { align-self: stretch; padding: 9px 0; font-size: 16px; border-top-width: 1px; border-bottom-width: 1px; border-top-color: rgba(210, 154, 116, 0.28); border-bottom-color: rgba(210, 154, 116, 0.28); }
.ps-gboard-combat-intent { align-self: stretch; }
.ps-gboard-in-combat .ps-gboard-dock { display: none; }
.ps-gboard-zoom { right: 390px; top: 110px; background-color: rgba(12, 12, 18, 0.88); }

.ps-battle-hand.ps-gboard-hand-fan { left: 50%; right: auto; bottom: 54px; width: 720px; height: 62px; margin-left: -360px; }
.ps-battle-hand.ps-gboard-hand-fan.ps-gboard-hand-open { height: 344px; }
.ps-gboard-en-rail { left: 50%; right: auto; bottom: 7px; width: 720px; margin-left: -360px; min-height: 38px; background-color: rgba(10, 10, 15, 0.96); }
.ps-gboard-resolve { min-height: 64px; background-color: rgba(28, 16, 38, 0.98); }

/* Cell faces are a terrain layer. Actors are deliberately rendered above it. */
.ps-gboard-cell { position: relative; overflow: hidden; background-color: rgb(31, 29, 34); border-left-color: rgba(126, 105, 72, 0.72); border-right-color: rgba(73, 62, 48, 0.9); border-top-color: rgba(151, 127, 83, 0.7); border-bottom-color: rgba(47, 40, 35, 0.95); }
.ps-gboard-cell-face { position: absolute; left: 4px; right: 4px; top: 4px; bottom: 4px; background-color: rgba(72, 62, 51, 0.42); border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgba(179, 149, 92, 0.12); border-right-color: rgba(0, 0, 0, 0.28); border-top-color: rgba(190, 160, 100, 0.1); border-bottom-color: rgba(0, 0, 0, 0.32); }
.ps-gboard-cell-sigil { position: absolute; left: 0; right: 0; top: 3px; color: rgba(235, 212, 160, 0.28); font-size: 28px; -unity-text-align: middle-center; }
.ps-gboard-cell-mark { position: absolute; left: 0; right: 0; top: 0; bottom: 0; color: rgb(241, 221, 177); font-size: 13px; -unity-text-align: middle-center; }
.ps-gboard-cell.ps-gboard-blocked { background-color: rgb(13, 13, 17); border-color: rgba(49, 43, 43, 0.78); }
.ps-gboard-cell.ps-gboard-blocked .ps-gboard-cell-face { background-color: rgba(4, 4, 6, 0.9); border-color: rgba(59, 48, 46, 0.38); }
.ps-gboard-cell.ps-gboard-void { visibility: hidden; }
.ps-gboard-cell.ps-gboard-start .ps-gboard-cell-face { background-color: rgba(38, 91, 106, 0.62); }
.ps-gboard-cell.ps-gboard-goal .ps-gboard-cell-face, .ps-gboard-cell.ps-gboard-next .ps-gboard-cell-face { background-color: rgba(55, 104, 82, 0.58); }
.ps-gboard-cell.ps-gboard-lamp .ps-gboard-cell-face { background-color: rgba(128, 88, 28, 0.66); }
.ps-gboard-cell.ps-gboard-fog .ps-gboard-cell-face { background-color: rgba(55, 75, 111, 0.62); }
.ps-gboard-cell.ps-gboard-seal .ps-gboard-cell-face { background-color: rgba(98, 43, 73, 0.68); }
.ps-gboard-cell.ps-gboard-event .ps-gboard-cell-face { background-color: rgba(50, 66, 117, 0.62); }
.ps-gboard-cell.ps-gboard-return .ps-gboard-cell-face { background-color: rgba(110, 82, 35, 0.6); }
.ps-gboard-cell.ps-gboard-enemy { background-color: rgb(31, 29, 34); }
.ps-gboard-cell.ps-gboard-enemy .ps-gboard-cell-face { background-color: rgba(72, 62, 51, 0.42); }
.ps-gboard-cell.ps-gboard-path { border-color: rgb(88, 219, 225); }
.ps-gboard-cell.ps-gboard-preview { border-color: rgba(138, 181, 238, 0.9); }
.ps-gboard-cell.ps-gboard-piece .ps-gboard-cell-face { background-color: rgba(167, 125, 42, 0.72); }

.ps-gboard-actors { position: absolute; overflow: visible; }
.ps-gboard-actor { position: absolute; align-items: center; justify-content: center; }
.ps-gboard-enemy-actor { background-color: rgba(83, 31, 66, 0.92); border-left-width: 2px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgb(235, 116, 161); border-right-color: rgba(235, 116, 161, 0.58); border-top-color: rgba(235, 116, 161, 0.58); border-bottom-color: rgba(235, 116, 161, 0.58); }
.ps-gboard-actor-glyph { color: rgb(255, 213, 219); font-size: 25px; -unity-text-align: middle-center; }

/* Product panel art is native portrait ratio: keep it intact instead of stretching it. */
.ps-gboard-dock { bottom: auto; height: 600px; }
.ps-gboard-combat-stage { bottom: auto; height: 600px; }

/* PopDark raster chrome supplies the silhouette; USS owns readable text and states. */
.ps-gboard-action { min-height: 96px; margin-bottom: 9px; padding: 12px 30px; color: rgb(255, 229, 197); font-size: 13px; letter-spacing: 1.2px; -unity-text-align: middle-center; background-color: rgba(0, 0, 0, 0); border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; }
.ps-gboard-action:hover { color: rgb(255, 248, 225); }
.ps-gboard-action:active { color: rgb(255, 188, 207); }
.ps-gboard-action:disabled { opacity: 0.42; }
.ps-gboard-top-finish.ps-gboard-action { min-height: 34px; width: 88px; margin-bottom: 0; padding: 0 8px; font-size: 10px; }
.ps-gboard-skill.ps-gboard-action, .ps-gboard-endturn.ps-gboard-action { min-height: 40px; margin-bottom: 0; padding: 0 16px; font-size: 11px; }
.ps-gboard-dir { width: 58px; height: 46px; margin-right: 7px; margin-bottom: 7px; padding: 0; color: rgb(211, 244, 250); font-size: 19px; background-color: rgba(0, 0, 0, 0); border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; }
.ps-gboard-dir:hover, .ps-gboard-dir-hot { color: rgb(255, 226, 243); }

/* Quiet hierarchy pass: chrome is reserved for cards and decisive actions,
   while ordinary expedition information is carried by space and thin rules. */
.ps-gboard-top { background-image: none; background-color: rgba(9, 10, 16, 0.88); border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 1px; border-bottom-color: rgba(193, 165, 101, 0.42); }
.ps-gboard-stage { right: 392px; background-color: rgba(8, 10, 16, 0.58); border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; }
.ps-gboard-grid { background-color: rgba(16, 18, 27, 0.48); border-left-color: rgba(193, 165, 101, 0.30); border-right-color: rgba(193, 165, 101, 0.30); border-top-color: rgba(193, 165, 101, 0.30); border-bottom-color: rgba(193, 165, 101, 0.30); }
.ps-gboard-dock { width: 332px; height: auto; bottom: 142px; }
.ps-gboard-panel { background-image: none; background-color: rgba(0, 0, 0, 0); border-left-width: 2px; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; border-left-color: rgba(213, 176, 101, 0.66); padding: 18px 4px 18px 16px; }
.ps-gboard-panel-title { font-size: 25px; margin-bottom: 13px; }
.ps-gboard-panel-status { padding-bottom: 10px; border-bottom-width: 1px; border-bottom-color: rgba(164, 143, 107, 0.22); }
.ps-gboard-panel-body { color: rgba(211, 204, 191, 0.84); }
.ps-gboard-combat-stage { width: 332px; min-width: 332px; height: auto; bottom: 142px; background-image: none; background-color: rgba(8, 8, 14, 0.60); border-left-width: 2px; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; border-left-color: rgba(229, 123, 135, 0.78); padding: 0 4px 0 16px; }
.ps-gboard-combat-portrait { width: 100%; height: 252px; margin-bottom: 12px; }
.ps-gboard-combat-title { font-size: 24px; }
.ps-gboard-combat-hp { padding: 9px 0; }
.ps-gboard-action { min-height: 34px; margin-bottom: 6px; padding: 5px 3px; color: rgba(226, 218, 203, 0.86); font-size: 12px; letter-spacing: 0.8px; -unity-text-align: middle-left; background-image: none; background-color: rgba(255, 255, 255, 0); border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 1px; border-bottom-color: rgba(152, 129, 100, 0.30); }
.ps-gboard-action:hover { color: rgb(255, 218, 145); background-color: rgba(255, 206, 130, 0.06); border-bottom-color: rgba(255, 206, 130, 0.72); }
.ps-gboard-top-finish.ps-gboard-action { min-height: 28px; width: auto; margin-bottom: 0; padding: 0 5px; font-size: 10px; }
.ps-gboard-skill.ps-gboard-action, .ps-gboard-endturn.ps-gboard-action { min-height: 34px; padding: 0 10px; -unity-text-align: middle-center; }

/* Makai expedition pass: vivid playfulness comes from the field and accents,
   not from boxing every information group. */
.ps-gboard { background-color: rgb(8, 8, 25); }
.ps-gboard-top { background-color: rgba(13, 12, 39, 0.78); border-bottom-width: 2px; border-bottom-color: rgb(226, 84, 159); }
.ps-gboard-top .ps-rite-top-name { color: rgb(255, 215, 120); text-shadow: 0 0 8px rgba(255, 72, 182, 0.60); }
.ps-gboard-phase { color: rgb(255, 123, 196); }
.ps-gboard-ink { color: rgb(124, 237, 255); }
.ps-gboard-doom { background-color: rgba(106, 28, 82, 0.70); border-left-color: rgb(255, 105, 180); color: rgb(255, 185, 220); }
.ps-gboard-stage { background-color: rgba(10, 10, 34, 0.18); }
.ps-gboard-viewport { background-color: rgba(8, 10, 31, 0.16); }
.ps-gboard-grid { padding: 8px; background-color: rgba(18, 11, 48, 0.44); border-left-color: rgba(95, 238, 255, 0.70); border-right-color: rgba(255, 84, 180, 0.64); border-top-color: rgba(255, 201, 111, 0.68); border-bottom-color: rgba(120, 96, 255, 0.66); }
.ps-gboard-cell { background-color: rgba(31, 22, 75, 0.48); border-left-color: rgba(195, 154, 255, 0.65); border-right-color: rgba(67, 41, 116, 0.92); border-top-color: rgba(224, 181, 255, 0.56); border-bottom-color: rgba(35, 18, 71, 0.95); }
.ps-gboard-cell-face { background-color: rgba(116, 82, 168, 0.26); border-left-color: rgba(209, 183, 255, 0.18); border-top-color: rgba(255, 214, 139, 0.16); }
.ps-gboard-cell-sigil { color: rgba(255, 226, 149, 0.50); }
.ps-gboard-cell-mark { color: rgb(255, 238, 207); }
.ps-gboard-cell.ps-gboard-void { visibility: visible; background-color: rgba(3, 4, 16, 0.88); border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; }
.ps-gboard-cell.ps-gboard-void .ps-gboard-cell-face, .ps-gboard-cell.ps-gboard-void .ps-gboard-cell-mark, .ps-gboard-cell.ps-gboard-void .ps-gboard-cell-sigil { display: none; }
.ps-gboard-cell.ps-gboard-blocked { background-color: rgba(15, 10, 39, 0.86); border-color: rgba(104, 72, 150, 0.54); }
.ps-gboard-cell.ps-gboard-start .ps-gboard-cell-face { background-color: rgba(52, 169, 212, 0.60); }
.ps-gboard-cell.ps-gboard-lamp .ps-gboard-cell-face { background-color: rgba(240, 157, 46, 0.66); }
.ps-gboard-cell.ps-gboard-event .ps-gboard-cell-face { background-color: rgba(131, 79, 232, 0.70); }
.ps-gboard-cell.ps-gboard-next .ps-gboard-cell-face { background-color: rgba(52, 212, 191, 0.66); }
.ps-gboard-cell.ps-gboard-enemy .ps-gboard-cell-face { background-color: rgba(110, 35, 116, 0.62); }
.ps-gboard-cell.ps-gboard-path { border-color: rgb(71, 245, 255); background-color: rgba(28, 132, 192, 0.58); }
.ps-gboard-cell.ps-gboard-preview { border-color: rgb(255, 151, 224); background-color: rgba(158, 69, 186, 0.48); }
.ps-gboard-cell.ps-gboard-piece .ps-gboard-cell-face { background-color: rgba(32, 201, 222, 0.56); }
.ps-gboard-enemy-actor { background-color: rgba(161, 45, 137, 0.92); border-left-color: rgb(255, 134, 210); border-right-color: rgba(104, 245, 255, 0.66); border-top-color: rgba(255, 211, 123, 0.72); border-bottom-color: rgba(104, 245, 255, 0.66); }
.ps-gboard-player-actor { overflow: hidden; background-color: rgba(28, 19, 90, 0.88); border-left-color: rgb(255, 218, 128); border-right-color: rgb(72, 242, 255); border-top-color: rgb(255, 117, 193); border-bottom-color: rgb(72, 242, 255); }
.ps-gboard-player-portrait { width: 100%; height: 100%; }
.ps-gboard-dock { top: 128px; }
.ps-gboard-panel { border-left-color: rgb(87, 240, 255); background-color: rgba(11, 10, 42, 0.48); }
.ps-gboard-panel-type { color: rgb(255, 206, 108); }
.ps-gboard-panel-title { color: rgb(255, 228, 155); text-shadow: 0 0 9px rgba(255, 74, 181, 0.46); }
.ps-gboard-panel-status { color: rgb(255, 156, 211); border-bottom-color: rgba(255, 110, 194, 0.44); }
.ps-gboard-panel-hint { color: rgba(178, 230, 255, 0.78); }
.ps-gboard-combat-stage { top: 128px; border-left-color: rgb(255, 100, 179); background-color: rgba(19, 8, 47, 0.54); }
.ps-gboard-combat-hp { border-top-color: rgba(255, 103, 185, 0.50); border-bottom-color: rgba(104, 237, 255, 0.35); color: rgb(255, 182, 211); }
.ps-gboard-combat-intent { color: rgb(255, 215, 126); }
.ps-gboard-en-rail { background-color: rgba(13, 10, 45, 0.86); border-left-color: rgb(80, 240, 255); border-top-width: 1px; border-top-color: rgba(255, 79, 182, 0.76); }

/* The shared card deck keeps its existing art; only its stage composition is
   changed.  A readable closed fan becomes the visual footer of exploration. */
.ps-battle-hand.ps-gboard-hand-fan { width: 820px; height: 112px; margin-left: -410px; bottom: 52px; }
.ps-battle-hand.ps-gboard-hand-fan.ps-gboard-hand-open { height: 356px; }
.ps-battle-hand.ps-gboard-hand-fan .ps-battle-card:hover { translate: 0 -34px; }
.ps-gboard-selected { right: 366px; top: 176px; }

/* Exploration-map pass: same playful magic palette, with open reading columns
   instead of a heavy box around every secondary section. */
.ps-xmap-top { background-color: rgba(13, 12, 39, 0.80); border-left-color: rgb(92, 241, 255); border-right-color: rgba(255, 98, 188, 0.72); border-top-color: rgba(255, 211, 123, 0.62); border-bottom-color: rgb(226, 84, 159); }
.ps-xmap-panel { background-color: rgba(11, 10, 42, 0.52); border-left-color: rgb(87, 240, 255); border-right-width: 0; border-top-width: 0; border-bottom-width: 0; }
.ps-xmap-panel-eye { color: rgba(132, 235, 255, 0.76); }
.ps-xmap-panel-type { color: rgb(255, 206, 108); }
.ps-xmap-panel-title { color: rgb(255, 228, 155); text-shadow: 0 0 9px rgba(255, 74, 181, 0.46); }
.ps-xmap-panel-status { color: rgb(255, 156, 211); }
.ps-xmap-panel-rule { background-color: rgba(255, 110, 194, 0.44); }
.ps-xmap-panel-body { color: rgba(225, 218, 239, 0.88); }
.ps-xmap-panel-hint { color: rgba(178, 230, 255, 0.78); border-top-color: rgba(104, 237, 255, 0.28); }
.ps-xmap-compass { background-color: rgba(11, 10, 42, 0.35); border-left-color: rgba(255, 198, 111, 0.50); border-right-width: 0; border-top-width: 0; border-bottom-width: 0; }

/* Dedicated raster silhouettes: these are not generic stretched buttons.  They
   are fixed HUD composition pieces, so text and status can sit in their open
   centres while the illustrated linework defines the screen edge. */
.ps-gboard-top { left: 14px; right: 14px; top: 12px; height: 138px; min-height: 138px; padding: 0 34px; background-color: rgba(0, 0, 0, 0); border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; }
.ps-gboard-top .ps-rite-tick { display: none; }
.ps-gboard-top .ps-rite-brand { top: 36px; }
.ps-gboard-top .ps-rite-top-name { font-size: 25px; }
.ps-gboard-phase { bottom: 27px; }
.ps-gboard-ink { top: 52px; right: 248px; }
.ps-gboard-doom { top: 48px; right: 72px; background-color: rgba(62, 18, 71, 0.72); border-left-width: 0; }
.ps-gboard-top-finish.ps-gboard-action { right: 26px; bottom: 38px; }
.ps-gboard-hero { left: 38px; top: 40px; }
.ps-gboard-stage, .ps-gboard-dock, .ps-gboard-combat-stage { top: 160px; }
.ps-gboard-panel { border-left-color: rgb(255, 100, 179); }
.ps-gboard-en-rail { left: 34px; right: auto; bottom: 28px; width: 560px; min-height: 78px; height: 78px; margin-left: 0; padding: 0 88px; background-color: rgba(0, 0, 0, 0); border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; }
.ps-gboard-en-label { margin-right: 0; color: rgb(255, 224, 150); text-shadow: 0 0 6px rgba(255, 70, 181, 0.65); }
.ps-gboard-combat-rail { margin-left: auto; }
.ps-battle-hand.ps-gboard-hand-fan { width: 900px; margin-left: -450px; bottom: 126px; height: 116px; }
.ps-gboard-stage { right: 540px; }
.ps-gboard-dock { right: 34px; width: 470px; }
.ps-gboard-panel { padding: 58px 44px 42px 48px; background-color: rgba(8, 8, 28, 0.18); border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; }
.ps-battle-hand.ps-gboard-hand-fan { width: 900px; margin-left: -450px; bottom: 110px; height: 116px; overflow: visible; }
.ps-battle-hand.ps-gboard-hand-fan.ps-gboard-hand-open { height: 344px; bottom: 54px; }
.ps-gboard-panel { background-image: none; background-color: rgba(7, 8, 27, 0.10); padding: 94px 40px 42px 42px; border-left-width: 2px; border-left-color: rgb(255, 104, 183); border-right-width: 0; border-top-width: 0; border-bottom-width: 0; overflow: visible; }
.ps-gboard-panel-ornament { position: absolute; left: -16px; right: -12px; top: -2px; height: 128px; }
.ps-gboard-panel-type { margin-top: 18px; }
.ps-gboard-portrait { width: 104px; height: 104px; margin-right: 42px; rotate: 45deg; overflow: hidden; border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgb(255, 111, 184); border-right-color: rgb(91, 239, 255); border-top-color: rgb(255, 216, 129); border-bottom-color: rgb(255, 111, 184); }
.ps-gboard-portrait-image { rotate: -45deg; scale: 1.42 1.42 1; }
.ps-gboard-hero { width: 430px; }
.ps-gboard-en-label { color: rgb(255, 224, 150); text-shadow: 0 0 6px rgba(255, 70, 181, 0.65); }

/* Final expedition geometry: the information rail is a narrow, tall reading
   column at the right edge, while EN stays a compact independent rail. */
.ps-gboard-stage { right: 500px; }
.ps-gboard-dock { right: 34px; top: 172px; bottom: auto; width: 350px; height: 760px; }
.ps-gboard-panel { padding: 94px 26px 42px 28px; }
.ps-gboard-panel-ornament { left: -10px; right: -10px; height: 104px; }
.ps-gboard-en-rail { left: 34px; right: auto; bottom: 24px; width: 400px; min-height: 56px; height: 56px; padding: 0 60px; }
.ps-gboard-en-label { font-size: 15px; }

/* Progressive expedition HUD.  The idle state belongs to the dungeon; each
   information group is summoned by the interaction that makes it relevant. */
.ps-gboard-idle .ps-gboard-dock {
    opacity: 0;
    width: 20px;
    overflow: hidden;
    transition-property: opacity;
    transition-duration: 0.16s;
    transition-timing-function: ease-out;
}
.ps-gboard-idle.ps-gboard-inspecting .ps-gboard-dock {
    opacity: 1;
    width: 350px;
    overflow: visible;
}
.ps-gboard-idle .ps-gboard-stage {
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}
.ps-gboard-idle .ps-gboard-top {
    height: 16px;
    min-height: 16px;
    opacity: 0;
    overflow: hidden;
}
.ps-gboard-idle.ps-gboard-header-hover .ps-gboard-top {
    height: 138px;
    min-height: 138px;
    opacity: 1;
    overflow: visible;
}
.ps-gboard-idle .ps-gboard-hero {
    opacity: 0;
}
.ps-gboard-idle.ps-gboard-header-hover .ps-gboard-hero {
    opacity: 1;
}
.ps-gboard-idle .ps-gboard-en-rail {
    display: none;
}
.ps-gboard-idle .ps-gboard-phase,
.ps-gboard-idle .ps-gboard-ink,
.ps-gboard-idle .ps-gboard-doom,
.ps-gboard-idle .ps-gboard-top-finish,
.ps-gboard-idle .ps-gboard-hero-meta {
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.14s;
}
.ps-gboard-idle.ps-gboard-header-hover .ps-gboard-phase,
.ps-gboard-idle.ps-gboard-header-hover .ps-gboard-ink,
.ps-gboard-idle.ps-gboard-header-hover .ps-gboard-doom,
.ps-gboard-idle.ps-gboard-header-hover .ps-gboard-top-finish,
.ps-gboard-idle.ps-gboard-header-hover .ps-gboard-hero-meta {
    opacity: 1;
}

/* Cards keep a compact lower fan. Hover lifts only the card under the cursor;
   the rest of the hand never becomes a wall over the board. */
.ps-gboard .ps-gboard-fan-card.ps-gboard-fan-focus {
    opacity: 0.72;
}
.ps-gboard-hover-preview {
    opacity: 1;
}

/* Exploration composition: a stable top HUD above one uninterrupted map.
   The right dossier is reserved for battle; planning information overlays the
   map through the selected-card host instead of taking permanent width. */
.ps-gboard-stage {
    left: 24px;
    right: 24px;
    top: 160px;
    bottom: 0;
}
.ps-gboard-dock {
    display: none;
}
.ps-gboard-top {
    height: 138px;
    min-height: 138px;
    opacity: 1;
    overflow: visible;
    background-color: rgba(3, 3, 12, 0.94);
}
.ps-gboard-hero {
    opacity: 1;
}
.ps-gboard-en-rail {
    display: none;
}
.ps-gboard-planning .ps-gboard-en-rail,
.ps-gboard-in-combat .ps-gboard-en-rail {
    display: flex;
}

/* Exploration keeps the complete banner visible. These explicit idle
   overrides replace the earlier hover-only header experiment. */
.ps-gboard-idle .ps-gboard-top,
.ps-gboard-idle.ps-gboard-header-hover .ps-gboard-top {
    height: 138px;
    min-height: 138px;
    opacity: 1;
    overflow: visible;
}
.ps-gboard-idle .ps-gboard-hero,
.ps-gboard-idle.ps-gboard-header-hover .ps-gboard-hero,
.ps-gboard-idle .ps-gboard-phase,
.ps-gboard-idle .ps-gboard-ink,
.ps-gboard-idle .ps-gboard-doom,
.ps-gboard-idle .ps-gboard-top-finish,
.ps-gboard-idle .ps-gboard-hero-meta {
    opacity: 1;
}

/* EN is persistent exploration information, using the same dark backing as
   the banner so it remains legible over a bright dungeon floor. */
.ps-gboard-en-rail,
.ps-gboard-idle .ps-gboard-en-rail {
    display: flex;
    background-color: rgba(3, 3, 12, 0.94);
}

/* Next-area and return decisions are blocking route states. They are attached
   directly to the screen root because the exploration dossier is intentionally
   hidden; keeping these controls inside that dossier made the run stop with no
   visible way to continue. */
.ps-gboard > .ps-gboard-gate {
    position: absolute;
    left: 0;
    right: 0;
    top: 138px;
    bottom: 0;
    margin-top: 0;
    padding-top: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(2, 2, 12, 0.74);
    border-top-width: 1px;
    border-top-color: rgba(255, 103, 190, 0.42);
}
.ps-gboard-gate-dialog {
    width: 500px;
    padding: 28px 34px 26px 34px;
    background-color: rgba(8, 7, 30, 0.98);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(255, 99, 183);
    border-right-color: rgb(82, 231, 255);
    border-top-color: rgb(255, 199, 117);
    border-bottom-color: rgba(176, 78, 226, 0.92);
}
.ps-gboard-gate-eyebrow {
    margin-bottom: 5px;
    color: rgb(92, 226, 255);
    font-size: 10px;
    letter-spacing: 2px;
}
.ps-gboard-gate-title {
    margin-bottom: 12px;
    color: rgb(255, 225, 158);
    font-size: 28px;
    -unity-font-definition: resource("Fonts/KleeOne-SemiBold");
}
.ps-gboard-gate-body {
    margin-bottom: 20px;
    color: rgba(231, 218, 225, 0.88);
    font-size: 13px;
    white-space: normal;
}
.ps-gboard-gate-choices {
    flex-direction: column;
}
.ps-gboard-gate-choices > .ps-gboard-action {
    width: 100%;
    min-height: 46px;
    margin-bottom: 8px;
    padding-left: 15px;
    padding-right: 15px;
    color: rgb(255, 228, 199);
    background-color: rgba(82, 27, 84, 0.74);
    border-left-width: 2px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(255, 104, 182);
    border-right-color: rgba(85, 224, 255, 0.62);
    border-top-color: rgba(255, 196, 116, 0.40);
    border-bottom-color: rgba(85, 224, 255, 0.40);
    -unity-text-align: middle-center;
}
.ps-gboard-gate-choices > .ps-gboard-action:hover {
    color: rgb(255, 249, 224);
    background-color: rgba(141, 40, 115, 0.92);
    border-top-color: rgb(255, 205, 124);
    border-bottom-color: rgb(84, 231, 255);
}

/* Combat stays in the expedition scene. The enemy is deliberately centred,
   with its vitality and intent readable before the player touches a card. */
.ps-gboard-in-combat .ps-gboard-combat-stage {
    position: absolute;
    left: 50%;
    right: auto;
    top: 178px;
    bottom: auto;
    width: 430px;
    min-width: 430px;
    height: 420px;
    margin-left: -215px;
    padding: 14px 28px 18px;
    justify-content: flex-start;
    align-items: stretch;
    background-color: rgba(7, 5, 25, 0.88);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(255, 104, 177, 0.92);
    border-right-color: rgba(88, 235, 255, 0.82);
    border-top-color: rgba(255, 161, 210, 0.78);
    border-bottom-color: rgba(159, 102, 255, 0.75);
}
.ps-gboard-in-combat .ps-gboard-combat-portrait {
    align-self: center;
    width: 270px;
    height: 236px;
    margin-bottom: 2px;
}
.ps-gboard-in-combat .ps-gboard-combat-title {
    align-self: center;
    font-size: 25px;
    color: rgb(255, 224, 166);
}
.ps-gboard-in-combat .ps-gboard-combat-hp {
    align-self: stretch;
    padding: 5px 0 3px;
    font-size: 18px;
    color: rgb(255, 222, 222);
    border-width: 0;
}
.ps-gboard-combat-hp-track {
    align-self: stretch;
    height: 12px;
    margin-bottom: 12px;
    background-color: rgba(19, 7, 21, 0.96);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 169, 201, 0.72);
    border-right-color: rgba(255, 169, 201, 0.72);
    border-top-color: rgba(255, 169, 201, 0.72);
    border-bottom-color: rgba(255, 169, 201, 0.72);
}
.ps-gboard-combat-hp-fill {
    height: 100%;
    background-color: rgb(225, 69, 109);
    border-right-width: 2px;
    border-right-color: rgb(255, 225, 178);
}
.ps-gboard-in-combat .ps-gboard-combat-intent {
    align-self: stretch;
    min-height: 50px;
    padding: 12px 14px;
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(255, 233, 170);
    background-color: rgba(75, 14, 37, 0.88);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(255, 107, 153);
    border-right-color: rgb(255, 107, 153);
    border-top-color: rgba(255, 204, 115, 0.86);
    border-bottom-color: rgba(255, 204, 115, 0.86);
}

/* Events pause the route in-place. They are an overlay over the same map,
   never a screen transition that can strand the running path. */
.ps-gboard-event-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 138px;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(2, 1, 12, 0.48);
}
.ps-gboard-event-popup {
    width: 470px;
    padding: 26px 30px 24px;
    background-color: rgba(14, 7, 39, 0.97);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(255, 115, 181);
    border-right-color: rgb(85, 234, 255);
    border-top-color: rgb(255, 192, 221);
    border-bottom-color: rgb(175, 103, 255);
}
.ps-gboard-event-eyebrow { font-size: 12px; color: rgb(112, 237, 255); -unity-font-style: bold; }
.ps-gboard-event-title { margin-top: 6px; font-size: 30px; color: rgb(255, 223, 163); }
.ps-gboard-event-body { margin-top: 14px; margin-bottom: 20px; font-size: 16px; white-space: normal; color: rgb(230, 219, 249); }
.ps-gboard-event-choices { flex-direction: column; }
.ps-gboard-event-choice { width: 100%; margin-top: 7px; min-height: 38px; }

/* Battle composition: three independent vertical bands.
   Header (0-160), enemy/readout (200-540), hand (from 560 down).  The dice
   sit beside the enemy as a compact roll callout instead of forming a bar
   across the hand. */
.ps-gboard-in-combat .ps-gboard-combat-stage {
    top: 204px;
    height: 330px;
    padding: 10px 24px 14px;
}
.ps-gboard-in-combat .ps-gboard-combat-portrait {
    width: 210px;
    height: 178px;
    margin-bottom: 0;
}
.ps-gboard-in-combat .ps-gboard-combat-title {
    font-size: 22px;
    margin-top: 0;
    margin-bottom: 0;
}
.ps-gboard-in-combat .ps-gboard-combat-hp {
    padding: 2px 0;
    font-size: 16px;
}
.ps-gboard-combat-hp-track {
    height: 9px;
    margin-bottom: 7px;
}
.ps-gboard-in-combat .ps-gboard-combat-intent {
    min-height: 38px;
    padding: 7px 10px;
    font-size: 16px;
}
.ps-gboard-in-combat .ps-gboard-resolve {
    position: absolute;
    left: 50%;
    right: auto;
    top: 286px;
    width: 230px;
    min-height: 102px;
    margin-left: 238px;
    padding: 10px 12px;
    flex-direction: column;
    align-items: stretch;
    background-color: rgba(16, 8, 38, 0.94);
    border-left-width: 2px;
    border-left-color: rgb(109, 239, 255);
    border-top-color: rgba(255, 126, 194, 0.85);
}
.ps-gboard-in-combat .ps-gboard-resolve-head {
    width: auto;
    margin-right: 0;
    flex-direction: row;
    justify-content: space-between;
}
.ps-gboard-in-combat .ps-gboard-resolve-formula { font-size: 11px; }
.ps-gboard-in-combat .ps-gboard-resolve-result { margin-top: 0; font-size: 11px; }
.ps-gboard-in-combat .ps-gboard-resolve-dice { margin-top: 8px; }
.ps-gboard-in-combat .ps-battle-hand.ps-gboard-hand-fan {
    bottom: 46px;
    height: 330px;
}

/* Route drawing controls float over the lower-right corner of the map. */
.ps-gboard-route-palette {
    position: absolute;
    right: 38px;
    bottom: 42px;
    flex-direction: column;
    align-items: center;
    padding: 8px;
    background-color: rgba(10, 8, 35, 0.72);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(105, 240, 255, 0.62);
    border-right-color: rgba(255, 94, 185, 0.62);
    border-top-color: rgba(255, 215, 128, 0.42);
    border-bottom-color: rgba(255, 94, 185, 0.42);
}

/* Final battle layout. The enemy owns the centre, while readable combat
   information uses the otherwise empty left and right gutters. */
.ps-gboard-in-combat .ps-gboard-combat-stage {
    left: 24px;
    right: 24px;
    top: 218px;
    bottom: auto;
    width: auto;
    min-width: 0;
    height: 400px;
    margin-left: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}
.ps-gboard-in-combat .ps-gboard-combat-portrait {
    position: absolute;
    left: 50%;
    top: 34px;
    width: 400px;
    height: 300px;
    margin-left: -200px;
    margin-bottom: 0;
    background-color: rgba(5, 3, 20, 0.72);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(255, 102, 177, 0.82);
    border-right-color: rgba(87, 235, 255, 0.76);
    border-top-color: rgba(255, 201, 139, 0.64);
    border-bottom-color: rgba(164, 101, 255, 0.72);
}
.ps-gboard-in-combat .ps-gboard-combat-title {
    position: absolute;
    left: 50%;
    top: -4px;
    width: 400px;
    margin-left: -200px;
    margin-top: 0;
    margin-bottom: 0;
    font-size: 28px;
    -unity-text-align: middle-center;
    color: rgb(255, 224, 163);
}
.ps-gboard-in-combat .ps-gboard-combat-hp {
    position: absolute;
    left: 58px;
    top: 92px;
    width: 330px;
    height: 76px;
    padding: 14px 18px 30px;
    margin: 0;
    font-size: 21px;
    -unity-font-style: bold;
    color: rgb(255, 220, 225);
    background-color: rgba(10, 5, 30, 0.91);
    border-left-width: 3px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(255, 91, 144);
    border-right-color: rgba(255, 142, 185, 0.54);
    border-top-color: rgba(255, 207, 151, 0.58);
    border-bottom-color: rgba(100, 231, 255, 0.46);
}
.ps-gboard-in-combat .ps-gboard-combat-hp-track {
    position: absolute;
    left: 76px;
    top: 142px;
    width: 294px;
    height: 12px;
    margin-bottom: 0;
}
.ps-gboard-in-combat .ps-gboard-combat-intent {
    position: absolute;
    right: 58px;
    top: 92px;
    width: 330px;
    min-height: 104px;
    padding: 14px 18px;
    margin: 0;
    font-size: 19px;
    white-space: normal;
    -unity-text-align: middle-left;
    color: rgb(255, 232, 166);
    background-color: rgba(49, 8, 34, 0.92);
    border-left-width: 3px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(255, 98, 156);
    border-right-color: rgba(255, 158, 200, 0.58);
    border-top-color: rgba(255, 207, 121, 0.76);
    border-bottom-color: rgba(102, 233, 255, 0.46);
}
.ps-gboard-in-combat .ps-gboard-resolve {
    left: auto;
    right: 82px;
    top: 418px;
    width: 282px;
    min-height: 94px;
    margin-left: 0;
}
.ps-gboard-in-combat .ps-battle-hand.ps-gboard-hand-fan {
    bottom: -20px;
    height: 324px;
}
.ps-gboard-in-combat .ps-gboard-en-rail {
    left: 34px;
    right: auto;
    bottom: 24px;
    width: 240px;
    min-height: 58px;
    height: 58px;
    padding: 0 58px;
}
.ps-gboard-in-combat .ps-gboard-combat-rail {
    position: absolute;
    left: auto;
    right: 34px;
    bottom: 24px;
    width: 360px;
    height: 58px;
    padding: 8px 10px;
    margin-left: 0;
    justify-content: flex-end;
    background-color: rgba(3, 3, 14, 0.94);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(83, 234, 255);
    border-right-color: rgb(255, 91, 167);
    border-top-color: rgba(255, 207, 135, 0.64);
    border-bottom-color: rgba(163, 97, 255, 0.68);
}
.ps-gboard-in-combat .ps-gboard-skill {
    min-width: 158px;
    height: 40px;
    margin-left: 0;
    margin-right: 8px;
    font-size: 14px;
}
.ps-gboard-in-combat .ps-gboard-endturn {
    min-width: 158px;
    height: 40px;
    margin-left: 0;
    font-size: 14px;
    color: rgb(255, 225, 172);
    background-color: rgba(91, 18, 51, 0.92);
    border-left-color: rgb(255, 104, 160);
    border-right-color: rgb(255, 104, 160);
}
.ps-gboard-route-icon.ps-gboard-action {
    width: 54px;
    min-width: 54px;
    height: 54px;
    min-height: 54px;
    margin: 0 0 6px 0;
    padding: 0;
    color: rgb(255, 232, 167);
    font-size: 27px;
    -unity-text-align: middle-center;
    background-color: rgba(32, 22, 70, 0.88);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(164, 110, 255, 0.72);
    border-right-color: rgba(164, 110, 255, 0.72);
    border-top-color: rgba(255, 199, 111, 0.62);
    border-bottom-color: rgba(255, 94, 185, 0.72);
}
.ps-gboard-route-icon.ps-gboard-action:hover { background-color: rgba(91, 47, 133, 0.96); color: white; }
.ps-gboard-route-start.ps-gboard-action { color: rgb(91, 246, 255); border-top-color: rgb(91, 246, 255); }
.ps-gboard-route-cancel.ps-gboard-action { margin-bottom: 0; color: rgb(255, 137, 191); }

/* Product battle composition: a single enemy focal point, dedicated side
   dossiers, and a deliberately quiet lower card fan. */
.ps-gboard-in-combat .ps-gboard-combat-stage {
    top: 194px;
    height: 392px;
}
.ps-gboard-in-combat .ps-gboard-enemy-focus {
    position: absolute;
    left: 50%;
    top: 0;
    width: 400px;
    height: 354px;
    margin-left: -200px;
    align-items: center;
}
.ps-gboard-in-combat .ps-gboard-enemy-eyebrow {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    font-size: 10px;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    color: rgb(112, 236, 255);
}
.ps-gboard-in-combat .ps-gboard-enemy-focus .ps-gboard-combat-portrait {
    position: absolute;
    left: 0;
    top: 26px;
    width: 400px;
    height: 286px;
    margin: 0;
}
.ps-gboard-in-combat .ps-gboard-enemy-focus .ps-gboard-combat-title {
    position: absolute;
    left: 0;
    top: 314px;
    width: 400px;
    margin: 0;
    font-size: 27px;
    -unity-text-align: middle-center;
    color: rgb(255, 226, 158);
    text-shadow: 0 2px 5px rgba(0, 0, 0, 0.96);
}
.ps-gboard-in-combat .ps-gboard-combat-vitals,
.ps-gboard-in-combat .ps-gboard-combat-intent-panel {
    position: absolute;
    top: 105px;
    width: 300px;
    min-height: 114px;
    padding: 13px 16px 14px;
    background-color: rgba(9, 5, 30, 0.91);
    border-left-width: 2px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
}
.ps-gboard-in-combat .ps-gboard-combat-vitals {
    left: 48px;
