    right: 2px;
    bottom: 2px;
    width: 53px;
    height: 53px;
    min-width: 53px;
    min-height: 53px;
    padding: 0;
    color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    background-image: resource("Art/UI/PopDark/VaultCodexV3/round-next");
    -unity-background-scale-mode: scale-to-fit;
}

/* The card remains clickable for the central enlarged view; only movement is
 * suppressed so browsing the record does not make the card jitter. */
.ps-vault-final .ps-vault-card-modal-face:hover {
    rotate: 0deg;
    translate: 0 0;
    scale: 1 1 1;
}


/* ===== Consolidated from PackspireVaultV6.uss ===== */
/*
 * PACKSPIRE Vault V6
 * Exact presentation pass for the approved vault reference.
 * This sheet intentionally overrides V5 without changing the underlying
 * data flow or interaction model.
 */

.ps-vault-final {
    overflow: hidden;
    border-radius: 28px;
    background-color: rgb(2, 5, 18);
}

/* The approved layout has a compact title block, not a full-width flourish. */
.ps-vault-final .ps-mgmt-header {
    height: 54px;
    min-height: 54px;
    max-height: 54px;
    margin: 0 0 6px 0;
    padding: 0 0 4px 0;
    border-width: 0;
    background-image: none;
    background-color: rgba(0, 0, 0, 0);
}

.ps-vault-final .ps-management-brand {
    width: 290px;
    height: 50px;
    padding-left: 2px;
}

.ps-vault-final .ps-management-brand-crest {
    width: 44px;
    height: 44px;
    margin-right: 8px;
}

/* Inventory tabs: one compact illustrated family, with no loose ornaments. */
.ps-vault-final .ps-vault-v7-category-bar {
    height: 49px;
    min-height: 49px;
    max-height: 49px;
    padding: 0 2px;
}

.ps-vault-final .ps-vault-v7-category {
    width: 19.2%;
    min-width: 19.2%;
    max-width: 19.2%;
