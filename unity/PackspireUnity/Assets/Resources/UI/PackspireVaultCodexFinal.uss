}

.ps-vault-final .ps-vault-inventory-header {
    height: 96px;
    min-height: 96px;
    max-height: 96px;
}

/* Every item owns a complete illustrated cell. Selection swaps the cell art;
 * it never adds a floating marker behind the equipment. */
.ps-vault-final .ps-vault-grid {
    padding: 4px 3px 2px 3px;
}

.ps-vault-final .ps-vault-grid-card {
    width: 24%;
