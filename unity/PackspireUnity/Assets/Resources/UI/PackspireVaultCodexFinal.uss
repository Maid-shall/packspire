/* ===== Obsidian misprint compendium ===== */
.ps-codex-v8 .ps-layer-background {
    background-image: resource("Art/UI/ObsidianMisprintShared/misprint-background-archive-v1");
    -unity-background-scale-mode: scale-and-crop;
}
.ps-codex-v8 .ps-mgmt-bg { display: none; }
.ps-codex-v8 .ps-mgmt-shade { background-color: rgba(2, 3, 3, 0.12); }
.ps-codex-v8 .ps-mgmt-header {
    height: 64px;
    min-height: 64px;
    padding-right: 64px;
    background-image: resource("Art/UI/ObsidianMisprintShared/misprint-decor-long-rule-v1");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.ps-codex-v8 .ps-codex-category-tab {
    height: 48px;
    min-height: 48px;
    background-image: resource("Art/UI/ObsidianMisprintShared/misprint-surface-index-tab-v1");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    color: rgb(226, 202, 163);
}
.ps-codex-v8 .ps-codex-category-tab.ps-selected { background-image: resource("Art/UI/ObsidianMisprintShared/misprint-surface-selection-v1"); color: rgb(25, 21, 17); }
#compendium-tab-items-icon { background-image: resource("Art/UI/ObsidianMisprintShared/misprint-icon-packing-v1"); }
#compendium-tab-roles-icon { background-image: resource("Art/UI/ObsidianMisprintShared/misprint-icon-status-v1"); }
#compendium-tab-enemies-icon { background-image: resource("Art/UI/ObsidianMisprintShared/misprint-icon-battle-v1"); }

.ps-codex-v8 .ps-codex-index-surface,
.ps-codex-v8 .ps-codex-record-surface { background-color: rgba(1, 3, 3, 0.64); }
.ps-codex-v8 .ps-codex-v9-index-entry {
    min-height: 62px;
    margin-bottom: 6px;
    background-image: resource("Art/UI/ObsidianMisprintShared/misprint-surface-list-v1");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}
.ps-codex-v8 .ps-codex-v9-index-entry.ps-codex-v9-current { background-image: resource("Art/UI/ObsidianMisprintShared/misprint-surface-selected-row-v1"); }
.ps-codex-v8 .ps-codex-v9-index-accent { display: none; }
.ps-codex-v8 .ps-codex-v9-index-name { color: rgb(229, 204, 165); font-size: 17px; }

.ps-codex-v8 .ps-codex-record-header,
.ps-codex-v8 .ps-codex-card-heading,
.ps-codex-v8 .ps-codex-shape-heading {
    background-image: resource("Art/UI/ObsidianMisprintShared/misprint-surface-section-b-v1");
    -unity-background-scale-mode: stretch-to-fill;
}
.ps-codex-v8 .ps-codex-item-name { color: rgb(235, 207, 165); font-size: 30px; }
.ps-codex-v8 .ps-codex-item-description { color: rgba(226, 205, 174, 0.80); font-size: 12px; }
.ps-codex-v8 .ps-codex-item-hero { border-bottom-width: 1px; border-bottom-color: rgb(55, 180, 186); }

.ps-codex-v8 .ps-codex-link-host {
    background-image: resource("Art/UI/ObsidianMisprintShared/misprint-surface-confirm-v1");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0, 0, 0, 0);
}
.ps-codex-v8 .ps-codex-acquisition-panel {
    background-image: resource("Art/UI/ObsidianMisprintShared/misprint-surface-dossier-v1");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0, 0, 0, 0);
}
.ps-codex-v8 .ps-codex-acquisition-heading,
.ps-codex-v8 .ps-codex-acquisition-key { color: rgb(126, 36, 29); }
.ps-codex-v8 .ps-codex-acquisition-value { color: rgb(41, 34, 27); }
.ps-codex-v8 .ps-codex-archive-footer {
    background-image: resource("Art/UI/ObsidianMisprintShared/misprint-surface-order-ticket-v1");
    -unity-background-scale-mode: stretch-to-fill;
}
.ps-codex-v8 .ps-codex-item-next-page {
    background-image: resource("Art/UI/ObsidianMisprintShared/misprint-icon-map-v1");
    -unity-background-scale-mode: scale-to-fit;
}
/* End Obsidian misprint compendium overrides. */
