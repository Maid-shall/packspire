/* Codex rows do not inherit the old management reel plates.  Selection is a
   quiet surface/edge change so the index stays readable beside the record. */


/* Archive II is a separate, full-height reading surface.  None of the old
   illustrated flavor-page dimensions or ornamental panel assets apply here. */


/* V8 owns the complete record viewport.  Older archive compatibility sheets
   constrain this ScrollView to 48/52%, so these selectors deliberately come
   last and restore a single full-height record surface. */
.ps-management-v3.ps-codex-v8 .ps-codex-record-column,
.ps-management-v3.ps-codex-v8 .ps-codex-record-surface {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 0;
    flex-grow: 1;
    flex-shrink: 1;
}

.ps-management-v3.ps-codex-v8 .ps-codex-record-surface,
.ps-management-v3.ps-codex-v8 .ps-codex-record-scroll {
    background-image: none;
}

.ps-management-v3.ps-codex-v8 .ps-codex-record-column .ps-codex-record-scroll {
    width: 100%;
    height: 100%;
    min-height: 100%;
    max-height: 100%;
    margin: 0;
    padding: 0;
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.ps-management-v3.ps-codex-v8 .ps-codex-record-scroll .unity-scroll-view__content-and-vertical-scroll-container,
.ps-management-v3.ps-codex-v8 .ps-codex-record-scroll .unity-scroll-view__content-viewport,
.ps-management-v3.ps-codex-v8 .ps-codex-record-scroll .unity-scroll-view__content-container {
    width: 100%;
    height: 100%;
    min-height: 100%;
    flex-grow: 1;
    flex-shrink: 1;
}

.ps-management-v3.ps-codex-v8 .ps-codex-record-scroll.ps-codex-page-two {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: auto;
    height: auto;
    min-height: 0;
    max-height: 100%;
    margin: 0;
    padding: 0;
    background-image: none;
    background-color: rgba(3, 4, 18, 0.84);
}

.ps-codex-v8 .ps-management-detail-corner {
    display: none;
}

/* A domain reload can retain previously constructed rows for one repaint.
   Hide the old ornamental reel children as a fail-safe; new codex rows no
   longer create them at all. */


/* Equipment archive page I reserves the upper half for the specimen hero. */
.ps-management-v3.ps-codex-v8 .ps-codex-item-v5-lower {
    position: absolute;
    left: 0;
    top: 49%;
    right: 0;
    bottom: 0;
    width: 100%;
    height: auto;
    min-height: 0;
    padding: 10px 64px 12px 7px;
    flex-direction: row;
    align-items: stretch;
}

.ps-management-v3.ps-codex-v8 .ps-codex-item-v5-card-panel {
    width: 39%;
    min-width: 39%;
    height: 100%;
    min-height: 0;
    margin: 0 16px 0 0;
    padding: 8px 13px 10px 13px;
    flex-shrink: 0;
    background-image: none;
    background-color: rgba(4, 3, 20, 0.72);
    border-left-width: 1px;
    border-left-color: rgba(241, 71, 142, 0.42);
    border-bottom-width: 1px;
    border-bottom-color: rgba(64, 212, 228, 0.38);
}

.ps-management-v3.ps-codex-v8 .ps-codex-item-v5-card-stage {
    min-height: 0;
    flex-grow: 1;
}

.ps-management-v3.ps-codex-v8 .ps-codex-item-v6-side {
    min-width: 0;
    height: 100%;
    min-height: 0;
    flex-grow: 1;
    flex-direction: column;
}





.ps-management-v3.ps-codex-v8 .ps-codex-item-v6-note-panel {
    min-width: 0;
    min-height: 74px;
    margin-top: 10px;
    padding: 10px 16px 10px 18px;
    flex-grow: 1;
    background-color: rgba(7, 4, 24, 0.82);
    border-left-width: 2px;
    border-left-color: rgba(203, 132, 67, 0.92);
    border-bottom-width: 1px;
    border-bottom-color: rgba(65, 211, 228, 0.42);
}

.ps-management-v3.ps-codex-v8 .ps-codex-item-v6-note-title {
    height: 22px;
    min-height: 22px;
    color: rgb(255, 219, 161);
    font-size: 13px;
    -unity-font-style: bold;
}

.ps-management-v3.ps-codex-v8 .ps-codex-item-v6-note-panel .ps-codex-item-v5-note {
    margin: 0;
    padding: 4px 0 0 0;
    white-space: normal;
    border-top-width: 0;
}


/* ===== Consolidated from PackspireVaultV5.uss ===== */
/*
 * PACKSPIRE Vault V5
 * Final vault-only composition based on the approved flat-canvas mock-up.
 * V3 supplies the illustrated controls; these rules deliberately load after
 * the generic V4 treatment so the dedicated parts remain visible.
 */

.ps-vault-final {
    overflow: hidden;
    border-radius: 28px;
    background-color: rgb(2, 5, 18);
}

.ps-vault-final .ps-mgmt-bg {
    opacity: 0.025;
}

.ps-vault-final .ps-mgmt-shade {
    background-color: rgba(1, 3, 15, 0.94);
}

.ps-vault-final .ps-layer-content {
    padding: 10px 17px 13px 17px;
}

.ps-vault-final .ps-mgmt-header {
    height: 55px;
    min-height: 55px;
    max-height: 55px;
    margin: 0 0 7px 0;
    padding: 0 0 5px 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: resource("Art/UI/PopDark/VaultCodexV3/header-flourish");
    -unity-background-scale-mode: stretch-to-fill;
