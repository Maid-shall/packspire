/* PACKSPIRE Vault + Codex canonical presentation.
   Consolidated in cascade order after the Vault V17 and Codex V8 layouts were approved.
   Edit this file only; the numbered compatibility sheets are no longer loaded. */

/* ===== Consolidated from PackspireVaultCodexV2.uss ===== */
/* PACKSPIRE Vault / Codex V2
 * The two approved compact navy mockups are the sole visual reference.
 * This sheet intentionally loads last and neutralizes the older ornate pass.
 */

.ps-vault-final {
    background-color: rgba(3, 6, 20, 0.98);
    border-radius: 25px;
    overflow: hidden;
}

.ps-vault-final .ps-mgmt-bg {
    opacity: 0.13;
}

.ps-vault-final .ps-mgmt-shade {
    background-color: rgba(2, 5, 17, 0.82);
}

.ps-vault-final .ps-layer-content {
    padding: 12px 16px 12px 16px;
}

.ps-vault-final .ps-mgmt-header {
    height: 54px;
    min-height: 54px;
    padding: 0;
    margin: 0 0 5px 0;
    background-color: rgba(3, 6, 20, 0);
    border-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(128, 55, 71, 0.34);
}

.ps-vault-final .ps-management-brand {
    height: 50px;
    padding: 0;
    margin: 0;
}

.ps-vault-final .ps-management-brand-crest {
    width: 42px;
    height: 42px;
    margin-right: 8px;
}

.ps-vault-final .ps-mgmt-body {
    flex-grow: 1;
    min-height: 0;
    padding: 0;
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
}

/* --------------------------------------------------------------------- */
/* Vault                                                                 */
/* --------------------------------------------------------------------- */

.ps-vault-final .ps-vault-v9-main-row {
    flex-direction: row;
    align-items: stretch;
}

.ps-vault-final .ps-vault-inventory-column {
    width: 48%;
    min-width: 48%;
    max-width: 48%;
    height: 100%;
    padding: 0 13px 0 0;
    margin: 0;
    border-width: 0;
    border-right-width: 1px;
    border-right-color: rgba(115, 78, 69, 0.66);
    background-color: rgba(3, 5, 18, 0.55);
}

.ps-vault-final .ps-vault-inventory-header {
    height: 111px;
    min-height: 111px;
    padding: 5px 0 0 0;
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.ps-vault-final .ps-vault-v7-category-bar {
    height: 48px;
    min-height: 48px;
    padding: 0;
    margin: 2px 0 0 0;
    flex-direction: row;
    align-items: stretch;
    border-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(126, 85, 74, 0.48);
}

.ps-vault-final .ps-vault-v7-category {
    flex-grow: 1;
    flex-basis: 0;
    height: 46px;
    min-width: 0;
    padding: 3px 5px;
    margin: 0 2px 0 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    color: rgb(207, 190, 165);
    background-color: rgba(8, 10, 27, 0.94);
    background-image: resource("Art/UI/PopDark/VaultCodexV2/category-tab-normal-v2");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 58;
    -unity-slice-right: 58;
    -unity-slice-top: 38;
    -unity-slice-bottom: 38;
    border-width: 0;
    border-radius: 7px;
}

.ps-vault-final .ps-vault-v7-category.ps-selected {
    color: rgb(255, 224, 183);
    background-color: rgba(74, 17, 48, 0.96);
    background-image: resource("Art/UI/PopDark/VaultCodexV2/category-tab-selected-v2");
}

.ps-vault-final .ps-vault-v7-category-icon {
    width: 21px;
    height: 21px;
    margin: 0 5px 0 0;
}

.ps-vault-final .ps-vault-v7-category-label {
    font-size: 11px;
    -unity-font-style: bold;
    color: #ead9b6;
    white-space: nowrap;
}

.ps-vault-final .ps-vault-v7-category-glow,
.ps-vault-final .ps-vault-v7-context {
    display: none;
}

.ps-vault-final .ps-vault-inventory-surface {
    flex-grow: 1;
    min-height: 0;
    padding: 6px 0 0 0;
    margin: 0;
    background-color: rgba(2, 4, 15, 0.3);
    border-width: 0;
}

.ps-vault-final .ps-vault-grid-scroll {
    flex-grow: 1;
    min-height: 0;
    padding: 0;
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.ps-vault-final .ps-vault-grid-scroll > .unity-scroll-view__content-viewport {
    padding: 0;
    margin: 0;
}

.ps-vault-final .ps-vault-grid {
    width: 100%;
    padding: 0 3px 5px 3px;
    margin: 0;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    justify-content: flex-start;
}

.ps-vault-final .ps-vault-grid-card {
    position: relative;
    width: 23.2%;
    height: 136px;
    min-width: 0;
    min-height: 136px;
    max-height: 136px;
    padding: 8px 7px 7px 7px;
    margin: 0 1.8% 7px 0;
    align-items: center;
    justify-content: flex-end;
    background-color: rgba(6, 8, 23, 0.96);
    background-image: resource("Art/UI/PopDark/VaultCodexV2/item-cell-normal-v2");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 48;
    -unity-slice-right: 48;
    -unity-slice-top: 48;
    -unity-slice-bottom: 48;
    border-width: 0;
    border-radius: 9px;
    overflow: visible;
}

.ps-vault-final .ps-vault-grid-card.ps-selected {
    background-color: rgba(37, 8, 37, 0.98);
    background-image: resource("Art/UI/PopDark/VaultCodexV2/item-cell-selected-v2");
    -unity-slice-left: 70;
    -unity-slice-right: 48;
    -unity-slice-top: 48;
    -unity-slice-bottom: 48;
}

.ps-vault-final .ps-management-selection-corners {
    display: none;
}

.ps-vault-final .ps-vault-grid-art {
    position: absolute;
    left: 11px;
    right: 11px;
    top: 11px;
    height: 91px;
    background-color: rgba(4, 5, 14, 0.86);
    border-width: 0;
    border-radius: 6px;
    overflow: hidden;
}

.ps-vault-final .ps-vault-grid-image {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.ps-vault-final .ps-vault-grid-name {
    height: 24px;
    max-height: 24px;
    margin: 0;
    padding: 2px 2px 0 2px;
    font-size: 10px;
    color: rgb(225, 207, 176);
    -unity-text-align: middle-center;
    white-space: normal;
}

.ps-vault-final .ps-vault-grid-badges {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    height: 20px;
    flex-direction: row;
}

.ps-vault-final .ps-vault-grid-badge {
    width: 17px;
    height: 17px;
    margin: 0 2px 0 0;
    padding: 0;
    align-items: center;
    justify-content: center;
    border-radius: 3px;
    background-color: rgb(218, 78, 100);
}

.ps-vault-final .ps-vault-badge-heirloom {
    background-color: rgb(242, 205, 114);
}

.ps-vault-final .ps-vault-grid-badge Label {
    font-size: 8px;
    color: rgb(23, 13, 23);
    -unity-font-style: bold;
}

.ps-vault-final .ps-vault-grid-lock {
    display: none;
    position: absolute;
    right: 2px;
    bottom: 1px;
    width: 20px;
    height: 20px;
    border-radius: 10px;
    background-color: rgba(11, 10, 24, 0.94);
}

.ps-vault-final .ps-vault-grid-card.ps-vault-protected .ps-vault-grid-lock {
    display: flex;
}

.ps-vault-final .ps-vault-grid-lock-icon {
    width: 16px;
    height: 16px;
}

.ps-vault-final .ps-vault-v7-footer {
    height: 37px;
    min-height: 37px;
    padding: 4px 3px 0 3px;
    margin: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgba(2, 4, 14, 0.94);
    border-width: 0;
    border-top-width: 1px;
    border-top-color: rgba(121, 75, 65, 0.72);
}

.ps-vault-final .ps-vault-v7-rarity-filter {
    width: 210px;
    height: 29px;
    min-height: 29px;
    padding: 0 5px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(3, 6, 17, 0.98);
    border-width: 1px;
    border-color: rgba(126, 87, 74, 0.72);
    border-radius: 6px;
}

.ps-vault-final .ps-vault-v8-sort-label {
    width: 47px;
    font-size: 9px;
    color: rgba(197, 181, 158, 0.75);
}

.ps-vault-final .ps-vault-v8-sort {
    flex-grow: 1;
    height: 27px;
    min-height: 27px;
    padding: 0 5px;
    color: rgb(230, 211, 181);
    background-color: rgba(2, 4, 14, 0.98);
    border-width: 0;
    font-size: 10px;
}

.ps-vault-final .ps-vault-v8-sort .unity-base-popup-field__input {
    height: 27px;
    min-height: 27px;
    padding: 0 4px;
    background-color: rgba(2, 4, 14, 0.98);
    border-width: 0;
}

.ps-vault-final .ps-vault-v7-count {
    font-size: 9px;
    color: rgba(208, 194, 169, 0.78);
}

.ps-vault-final .ps-vault-v9-record-column {
    width: 52%;
    min-width: 52%;
    max-width: 52%;
    height: 100%;
    padding: 0 0 0 14px;
    margin: 0;
    background-color: rgba(3, 6, 20, 0.34);
    border-width: 0;
}

.ps-vault-final .ps-vault-v9-divider {
    display: none;
}

.ps-vault-final .ps-vault-v9-hero {
    display: flex;
    height: 54%;
    min-height: 54%;
    max-height: 54%;
    padding: 0;
    margin: 0;
    flex-direction: row;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.ps-vault-final .ps-vault-v9-hero-art {
    display: none;
}

.ps-vault-final .ps-vault-v9-identity {
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
}

.ps-vault-final .ps-vault-v11-equipment-hero {
    position: relative;
    width: 100%;
    height: 100%;
    padding: 13px 15px 7px 15px;
    flex-direction: row;
    background-color: rgba(0, 0, 0, 0);
}

.ps-vault-final .ps-vault-v11-showcase {
    position: absolute;
    left: 0;
    top: 0;
    width: 61%;
    height: 100%;
    padding: 3px 9px 5px 3px;
    margin: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
}

.ps-vault-final .ps-vault-v11-art-column {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.ps-vault-final .ps-vault-v11-art-frame {
    width: 100%;
    height: 88%;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 50%;
}

.ps-vault-final .ps-vault-v11-item-art {
    width: 92%;
    height: 92%;
    -unity-background-scale-mode: scale-to-fit;
}

.ps-vault-final .ps-vault-v11-durability {
    position: absolute;
    left: 9px;
    bottom: 3px;
    height: 20px;
    margin: 0;
    padding: 0;
    font-size: 10px;
    color: rgb(116, 205, 210);
}

.ps-vault-final .ps-vault-v11-meta,
.ps-vault-final .ps-vault-v9-name-row,
.ps-vault-final .ps-vault-v9-description,
.ps-vault-final .ps-vault-v9-shape {
    position: absolute;
    left: 62%;
    right: 5px;
}

.ps-vault-final .ps-vault-v11-meta {
    top: 16px;
    height: 18px;
    margin: 0;
    font-size: 9px;
    color: rgba(201, 180, 161, 0.72);
}

.ps-vault-final .ps-vault-v9-name-row {
    top: 36px;
    height: 42px;
    margin: 0;
    flex-direction: row;
    align-items: flex-start;
}

.ps-vault-final .ps-vault-v9-item-name {
    font-size: 25px;
    color: rgb(255, 221, 161);
    -unity-font-style: bold;
    white-space: normal;
}

.ps-vault-final .ps-vault-v9-inuse {
    height: 18px;
    margin: 6px 0 0 7px;
    padding: 2px 5px;
    border-radius: 4px;
    background-color: rgba(98, 55, 25, 0.78);
}

.ps-vault-final .ps-vault-v9-description {
    top: 82px;
    height: 46px;
    margin: 0;
    padding: 0 0 6px 0;
    font-size: 10px;
    color: rgb(205, 190, 174);
    white-space: normal;
    border-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(129, 78, 70, 0.56);
}

.ps-vault-final .ps-vault-v9-shape {
    top: 137px;
    height: 112px;
    padding: 0;
    margin: 0;
    flex-direction: column;
    align-items: flex-start;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.ps-vault-final .ps-vault-v9-shape-title {
    height: 20px;
    margin: 0 0 5px 0;
    padding: 0;
    font-size: 11px;
    color: rgb(213, 190, 158);
    -unity-font-style: bold;
}

.ps-vault-final .ps-vault-v9-shape-grid {
    width: 70px;
    height: 70px;
    padding: 0;
}

.ps-vault-final .ps-vault-v9-shape-row {
    height: 23px;
    flex-direction: row;
}

.ps-vault-final .ps-vault-v9-shape-cell {
    width: 22px;
    height: 22px;
    margin: 0 2px 2px 0;
    background-color: rgba(18, 20, 35, 0.92);
    border-width: 1px;
    border-color: rgba(116, 100, 100, 0.76);
    border-radius: 2px;
}

.ps-vault-final .ps-vault-v9-shape-cell.ps-filled {
    background-color: rgb(216, 159, 145);
    border-color: rgb(246, 197, 165);
}

.ps-vault-final .ps-vault-v9-detail {
    height: 46%;
    min-height: 46%;
    max-height: 46%;
    padding: 0;
    margin: 0;
    overflow: hidden;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-top-width: 1px;
    border-top-color: rgba(127, 83, 69, 0.72);
}

.ps-vault-final .ps-vault-v9-detail > .unity-scroll-view__content-viewport,
.ps-vault-final .ps-vault-v9-detail > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    height: 100%;
    min-height: 100%;
    padding: 0;
}

.ps-vault-final .ps-vault-v9-lower {
    position: relative;
    width: 100%;
    height: 100%;
    padding: 7px 0 0 0;
    margin: 0;
    flex-direction: row;
    background-color: rgba(0, 0, 0, 0);
}

.ps-vault-final .ps-vault-v9-card-panel {
    width: 39%;
    height: 100%;
    min-height: 0;
    padding: 0 8px 0 3px;
    margin: 0;
    align-items: center;
    background-color: rgba(4, 6, 19, 0.72);
    border-width: 0;
    border-right-width: 1px;
    border-right-color: rgba(103, 76, 68, 0.62);
}

.ps-vault-final .ps-vault-v9-lower-header {
    width: 100%;
    height: 31px;
    min-height: 31px;
    padding: 0 2px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.ps-vault-final .ps-vault-v9-lower-title {
    font-size: 10px;
    color: rgb(219, 198, 167);
}

.ps-vault-final .ps-vault-v9-flip {
    width: 83px;
    height: 24px;
    min-height: 24px;
    padding: 0 8px;
    font-size: 9px;
    color: rgb(243, 205, 185);
    background-color: rgba(48, 11, 37, 0.98);
    background-image: resource("Art/UI/PopDark/VaultCodexV2/category-tab-selected-v2");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 58;
    -unity-slice-right: 58;
    -unity-slice-top: 38;
    -unity-slice-bottom: 38;
    border-width: 0;
    border-radius: 12px;
}

.ps-vault-final .ps-vault-v9-card-open {
    width: 130px;
    height: 183px;
    min-height: 183px;
    max-height: 183px;
    margin: 0;
    transform-origin: center;
}

.ps-vault-final .ps-vault-v9-effect-panel {
    position: relative;
    width: 61%;
    height: 100%;
    min-height: 0;
    padding: 0 4px 38px 10px;
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
}

.ps-vault-final .ps-vault-v9-effect {
    height: 47%;
    min-height: 0;
    padding: 8px 13px 6px 13px;
    margin: 0 0 5px 0;
    background-color: rgba(7, 8, 24, 0.92);
    background-image: resource("Art/UI/PopDark/VaultCodexV2/effect-panel-v2");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 64;
    -unity-slice-right: 64;
    -unity-slice-top: 64;
    -unity-slice-bottom: 64;
    border-width: 0;
    border-radius: 8px;
}

.ps-vault-final .ps-vault-v9-effect-eyebrow {
    height: 15px;
    font-size: 8px;
    color: rgb(231, 93, 117);
    -unity-font-style: bold;
}

.ps-vault-final .ps-vault-v9-effect-name {
    height: 21px;
    font-size: 14px;
    color: rgb(244, 210, 167);
    -unity-font-style: bold;
}

.ps-vault-final .ps-vault-v9-effect-body {
    flex-grow: 1;
    min-height: 0;
    font-size: 9px;
    color: rgb(207, 195, 179);
    white-space: normal;
}

.ps-vault-final .ps-vault-v9-actions {
    position: absolute;
    right: 6px;
    bottom: 1px;
    width: 45px;
    height: 45px;
}

.ps-vault-final .ps-vault-v9-lock-action {
    width: 45px;
    height: 45px;
    min-width: 45px;
    min-height: 45px;
    padding: 0;
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: resource("Art/UI/PopDark/VaultCodexV2/round-lock-v2");
    -unity-background-scale-mode: scale-to-fit;
    border-width: 0;
    border-radius: 23px;
}

.ps-vault-final .ps-vault-v9-lock-action.ps-locked {
    -unity-background-image-tint-color: rgb(255, 111, 138);
}

.ps-vault-final .ps-vault-v11-page-arrow {
    position: absolute;
    right: 3px;
    bottom: 3px;
    width: 45px;
    height: 45px;
    min-width: 45px;
    min-height: 45px;
    padding: 0;
    margin: 0;
    font-size: 0;
    color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    background-image: resource("Art/UI/PopDark/VaultCodexV2/round-next-v2");
    -unity-background-scale-mode: scale-to-fit;
    border-width: 0;
    border-radius: 23px;
}

/* Keep all detail pages inside the product shell; page content owns paging. */
.ps-vault-final .unity-scroller,
.ps-vault-final .ps-vault-v9-detail .unity-scroller {
    display: none;
}


/* ===== Consolidated from PackspireVaultCodexV3.uss ===== */
/*
 * PACKSPIRE Vault / Codex V3
 * Approved compact mockups are the layout and component reference.
 * Every visible control below is skinned with a dedicated bitmap component.
 */

.ps-vault-final {
    background-color: rgb(2, 5, 18);
    border-radius: 28px;
    overflow: hidden;
}

.ps-vault-final .ps-mgmt-bg {
    opacity: 0.08;
}

.ps-vault-final .ps-mgmt-shade {
    background-color: rgba(1, 3, 14, 0.88);
}

.ps-vault-final .ps-layer-content {
    padding: 12px 18px 13px 18px;
}

.ps-vault-final .ps-mgmt-header {
    height: 54px;
    min-height: 54px;
    margin: 0 0 6px 0;
    padding: 0 0 4px 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: resource("Art/UI/PopDark/VaultCodexV3/header-flourish");
    -unity-background-scale-mode: stretch-to-fill;
}

.ps-vault-final .ps-management-brand {
    height: 49px;
    padding: 0;
}

.ps-vault-final .ps-management-brand-crest {
    width: 42px;
    height: 42px;
    margin-right: 7px;
}

.ps-vault-final .ps-mgmt-body {
    flex-grow: 1;
    min-height: 0;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.ps-vault-final .ps-mgmt-column-boundary,
.ps-vault-final .ps-vault-v9-divider {
    display: none;
}

/* ------------------------------------------------------------------ */
/* Shared illustrated controls                                        */
/* ------------------------------------------------------------------ */

.ps-vault-final Button {
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.ps-vault-final .ps-vault-v7-category {
    background-image: resource("Art/UI/PopDark/VaultCodexV3/category-tab-normal");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 30;
    -unity-slice-right: 30;
    -unity-slice-top: 20;
    -unity-slice-bottom: 20;
}

.ps-vault-final .ps-vault-v7-category.ps-selected {
    background-image: resource("Art/UI/PopDark/VaultCodexV3/category-tab-selected");
}

.ps-vault-final .ps-vault-v7-category:hover {
    -unity-background-image-tint-color: rgb(255, 230, 238);
}

.ps-vault-final .ps-vault-v9-flip {
    min-width: 112px;
    height: 30px;
    padding: 0 16px;
    color: rgb(246, 217, 170);
