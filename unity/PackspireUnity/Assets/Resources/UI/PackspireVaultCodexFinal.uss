/*
 * Inventory tile final guard
 * --------------------------
 * ManagementV3 still contains the pre-V17 square-thumbnail layout with a
 * stronger two-class selector.  Keep this at EOF and match that specificity
 * so a vault item is always one complete authored cell: frame, contained art,
 * title and rarity marker.
 */

.ps-vault-final.ps-vault-final.ps-management-v3 .ps-vault-grid {
    width: 100%;
    min-height: 100%;
    padding: 7px 7px 10px 7px;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    justify-content: flex-start;
}

.ps-vault-final.ps-vault-final.ps-management-v3 .ps-vault-grid-card,
.ps-vault-final.ps-vault-final.ps-management-v3 .ps-vault-grid-card:hover,
.ps-vault-final.ps-vault-final.ps-management-v3 .ps-vault-grid-card:active,
.ps-vault-final.ps-vault-final.ps-management-v3 .ps-vault-grid-card:focus,
.ps-vault-final.ps-vault-final.ps-management-v3 .ps-vault-grid-card.ps-selected {
    position: relative;
    width: 23%;
    min-width: 23%;
    max-width: 23%;
    height: 146px;
    min-height: 146px;
    max-height: 146px;
    flex-basis: 23%;
    flex-grow: 0;
    flex-shrink: 0;
    margin: 0 1% 9px 1%;
    padding: 0;
    align-items: center;
    justify-content: flex-start;
    overflow: visible;
    border-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    background-image: resource("Art/UI/PopDark/VaultCodexV4/item-cell-normal");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.ps-vault-final.ps-vault-final.ps-management-v3 .ps-vault-grid-card.ps-selected,
.ps-vault-final.ps-vault-final.ps-management-v3 .ps-vault-grid-card.ps-selected:hover,
.ps-vault-final.ps-vault-final.ps-management-v3 .ps-vault-grid-card.ps-selected:active,
.ps-vault-final.ps-vault-final.ps-management-v3 .ps-vault-grid-card.ps-selected:focus {
    background-image: resource("Art/UI/PopDark/VaultCodexV4/item-cell-selected");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.ps-vault-final.ps-vault-final.ps-management-v3 .ps-vault-grid-card:hover {
    -unity-background-image-tint-color: rgb(255, 233, 240);
}

.ps-vault-final.ps-vault-final.ps-management-v3 .ps-vault-grid-art {
    position: absolute;
    left: 15px;
    right: 15px;
    top: 13px;
    width: auto;
    height: 98px;
    min-width: 0;
    min-height: 98px;
    max-width: none;
    max-height: 98px;
    margin: 0;
    padding: 0;
    overflow: hidden;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
}

.ps-vault-final.ps-vault-final.ps-management-v3 .ps-vault-grid-image {
    position: relative;
    left: auto;
    right: auto;
    top: auto;
    bottom: auto;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    margin: 0;
    padding: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.ps-vault-final.ps-vault-final.ps-management-v3 .ps-vault-grid-name {
    position: absolute;
    left: 15px;
    right: 15px;
    bottom: 17px;
    width: auto;
    height: 18px;
    min-height: 18px;
    max-height: 18px;
    margin: 0;
    padding: 0;
    color: rgb(238, 219, 187);
    font-size: 11px;
    white-space: nowrap;
    -unity-text-align: middle-center;
}

.ps-vault-final.ps-vault-final.ps-management-v3 .ps-vault-grid-rarity {
    display: flex;
    position: absolute;
    left: 50%;
    bottom: 6px;
    width: 12px;
    height: 10px;
    margin-left: -6px;
    padding: 0;
    color: rgb(101, 216, 243);
    font-size: 6px;
    -unity-text-align: middle-center;
}

.ps-vault-final.ps-vault-final.ps-management-v3 .ps-vault-grid-rarity-heirloom {
    color: rgb(251, 210, 93);
}

.ps-vault-final.ps-vault-final.ps-management-v3 .ps-vault-grid-badges {
    position: absolute;
    left: 2px;
    top: 2px;
    right: auto;
    bottom: auto;
    width: auto;
    height: 18px;
    margin: 0;
    padding: 0;
    flex-direction: row;
}

.ps-vault-final.ps-vault-final.ps-management-v3 .ps-vault-grid-lock {
    position: absolute;
    display: none;
    right: 2px;
    top: 2px;
    width: 18px;
    height: 18px;
    margin: 0;
    padding: 0;
}

.ps-vault-final.ps-vault-final.ps-management-v3 .ps-vault-grid-card.ps-vault-protected .ps-vault-grid-lock {
    display: flex;
}

/*
 * Equipment hero final guard
 * --------------------------
 * The hero is a real two-column composition.  Keeping the identity copy and
 * occupancy grid in their own column prevents the old absolute offsets from
 * colliding at narrow panel widths.
 */

.ps-vault-final.ps-vault-final.ps-management-v3 .ps-vault-v11-equipment-hero {
    padding: 5px 10px 4px 8px;
}

.ps-vault-final.ps-vault-final.ps-management-v3 .ps-vault-v11-showcase {
    width: 100%;
    height: 100%;
    min-height: 0;
    flex-grow: 1;
    flex-direction: row;
    align-items: stretch;
}

.ps-vault-final.ps-vault-final.ps-management-v3 .ps-vault-v11-art-column {
    position: relative;
    left: auto;
    right: auto;
    top: auto;
    bottom: auto;
    width: 58%;
    min-width: 58%;
    max-width: 58%;
    height: 100%;
    margin: 0 12px 0 0;
}

.ps-vault-final.ps-vault-final.ps-management-v3 .ps-vault-v11-art-frame {
    width: 100%;
    height: auto;
    min-height: 0;
    max-height: none;
    flex-grow: 1;
    margin: 0;
    padding: 25px;
    overflow: hidden;
    background-color: rgba(0, 0, 0, 0);
    background-image: resource("Art/UI/PopDark/VaultCodexV3/magic-circle");
    -unity-background-scale-mode: scale-to-fit;
    border-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-radius: 0;
}

.ps-vault-final.ps-vault-final.ps-management-v3 .ps-vault-v11-item-art {
    border-radius: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.ps-vault-final.ps-vault-final.ps-management-v3 .ps-vault-v17-info-column {
    position: relative;
    width: auto;
    min-width: 0;
    height: 100%;
    min-height: 0;
    flex-grow: 1;
    padding: 8px 2px 3px 0;
    overflow: hidden;
}

.ps-vault-final.ps-vault-final.ps-management-v3 .ps-vault-v17-info-column .ps-vault-v11-meta,
.ps-vault-final.ps-vault-final.ps-management-v3 .ps-vault-v17-info-column .ps-vault-v9-name-row,
.ps-vault-final.ps-vault-final.ps-management-v3 .ps-vault-v17-info-column .ps-vault-v9-description,
.ps-vault-final.ps-vault-final.ps-management-v3 .ps-vault-v17-info-column .ps-vault-v9-shape {
    position: relative;
    left: auto;
    right: auto;
    top: auto;
    bottom: auto;
}

.ps-vault-final.ps-vault-final.ps-management-v3 .ps-vault-v17-info-column .ps-vault-v11-meta {
    width: 100%;
    height: 17px;
    min-height: 17px;
    margin: 0;
    font-size: 9px;
}

.ps-vault-final.ps-vault-final.ps-management-v3 .ps-vault-v17-info-column .ps-vault-v9-name-row {
    width: 100%;
    height: 40px;
    min-height: 40px;
    margin: 0;
    padding: 0;
}

.ps-vault-final.ps-vault-final.ps-management-v3 .ps-vault-v17-info-column .ps-vault-v9-description {
    width: 100%;
    height: 34px;
    min-height: 34px;
    margin: 0 0 3px 0;
    font-size: 9px;
}

.ps-vault-final.ps-vault-final.ps-management-v3 .ps-vault-v9-shape {
    width: 100%;
    min-width: 0;
    max-width: none;
    height: auto;
    min-height: 0;
    max-height: none;
    flex-grow: 1;
    margin: 0;
    padding: 1px 0 0 0;
    align-items: center;
    justify-content: flex-start;
    overflow: hidden;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 1px;
    border-bottom-width: 0;
    border-top-color: rgba(204, 124, 72, 0.52);
}

.ps-vault-final.ps-vault-final.ps-management-v3 .ps-vault-v9-shape-title {
    width: 100%;
    height: 19px;
    min-height: 19px;
    margin: 0;
    font-size: 10px;
    -unity-text-align: middle-center;
}

.ps-vault-final.ps-vault-final.ps-management-v3 .ps-vault-v9-shape-grid {
    width: 82px;
    min-width: 82px;
    max-width: 82px;
    height: 82px;
    min-height: 82px;
    max-height: 82px;
    margin: 0 auto;
    padding: 2px;
}

.ps-vault-final.ps-vault-final.ps-management-v3 .ps-vault-v9-shape-row {
    width: 76px;
    height: 25px;
    min-height: 25px;
}

.ps-vault-final.ps-vault-final.ps-management-v3 .ps-vault-v9-shape-cell {
    width: 23px;
    min-width: 23px;
    height: 23px;
    min-height: 23px;
    margin: 1px;
}

/* The face selector has its own mirrored background layer, so only the pink
 * selected half changes sides; labels stay readable. */

.ps-vault-final.ps-vault-final.ps-management-v3 .ps-vault-v9-flip {
    position: relative;
    width: 112px;
    min-width: 112px;
    height: 26px;
    min-height: 26px;
    padding: 0;
    flex-direction: row;
    overflow: hidden;
    background-image: none;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.ps-vault-final.ps-vault-final.ps-management-v3 .ps-vault-v9-flip-bg {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: resource("Art/UI/PopDark/VaultCodexV3/battle-explore-toggle");
    -unity-background-scale-mode: stretch-to-fill;
}

.ps-vault-final.ps-vault-final.ps-management-v3 .ps-vault-v9-flip-label {
    position: relative;
    width: 50%;
    height: 100%;
    color: rgb(177, 158, 160);
    font-size: 9px;
    -unity-text-align: middle-center;
}

.ps-vault-final.ps-vault-final.ps-management-v3 .ps-vault-v9-flip-label.ps-selected {
    color: rgb(255, 228, 195);
    -unity-font-style: bold;
}

/* Lock and page navigation are separate controls.  They share the footer but
 * never occupy the same absolute slot. */

.ps-vault-final.ps-vault-final.ps-management-v3 .ps-vault-v9-actions {
    position: absolute;
    left: auto;
    right: 58px;
    top: auto;
    bottom: 1px;
    width: 50px;
    min-width: 50px;
    height: 50px;
    min-height: 50px;
    margin: 0;
    padding: 0;
}

.ps-vault-final.ps-vault-final.ps-management-v3 .ps-vault-v9-actions .ps-vault-v9-lock-action {
    position: relative;
    left: auto;
    right: auto;
    top: auto;
    bottom: auto;
    width: 48px;
    min-width: 48px;
    height: 48px;
    min-height: 48px;
    margin: 0;
}

.ps-vault-final.ps-vault-final.ps-management-v3 .ps-vault-v16-next-item {
    position: absolute;
    left: auto;
    right: 2px;
    top: auto;
    bottom: 1px;
    width: 48px;
    min-width: 48px;
    height: 48px;
    min-height: 48px;
    margin: 0;
    padding: 0;
}

