/* ===== Consolidated from PackspireVaultCodexV4.uss ===== */
/*
 * PACKSPIRE Vault / Codex V4
 * Restrained component pass based on the approved compact references.
 * Ornament is reserved for selection and primary round actions.
 */

.ps-vault-final,
.ps-codex-v8 {
    background-color: rgb(2, 4, 15);
    border-radius: 26px;
    overflow: hidden;
}

.ps-vault-final .ps-mgmt-bg,
.ps-codex-v8 .ps-mgmt-bg {
    opacity: 0.055;
}

.ps-vault-final .ps-mgmt-shade,
.ps-codex-v8 .ps-mgmt-shade {
    background-color: rgba(1, 3, 13, 0.91);
}

.ps-vault-final .ps-layer-content,
.ps-codex-v8 .ps-layer-content {
    padding: 11px 17px 13px 17px;
}

.ps-vault-final .ps-mgmt-header,
.ps-codex-v8 .ps-mgmt-header {
    height: 52px;
    min-height: 52px;
    margin: 0 0 7px 0;
    padding: 0 0 4px 0;
    border-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(132, 74, 61, 0.48);
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
}

.ps-vault-final .ps-management-brand,
.ps-codex-v8 .ps-management-brand {
    height: 47px;
    padding: 0;
}

.ps-vault-final .ps-management-brand-crest,
.ps-codex-v8 .ps-management-brand-crest {
    width: 40px;
    height: 40px;
    margin-right: 7px;
}

.ps-vault-final .ps-mgmt-body,
.ps-codex-v8 .ps-mgmt-body {
    flex-grow: 1;
    min-height: 0;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.ps-vault-final .ps-mgmt-column-boundary,
.ps-codex-v8 .ps-mgmt-column-boundary,
.ps-vault-final .ps-vault-v9-divider,
.ps-codex-v8 .ps-management-detail-corner,
.ps-vault-final .ps-management-selection-corners,
.ps-codex-v8 .ps-management-selection-corners {
    display: none;
}

.ps-vault-final Button,
.ps-codex-v8 Button {
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

/* Shared compact tabs */

.ps-vault-final .ps-vault-v7-category {
    background-image: resource("Art/UI/PopDark/VaultCodexV4/category-tab-normal");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 34;
    -unity-slice-right: 34;
    -unity-slice-top: 19;
    -unity-slice-bottom: 19;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.ps-vault-final .ps-vault-v7-category.ps-selected {
    background-image: resource("Art/UI/PopDark/VaultCodexV4/category-tab-selected");
}

.ps-vault-final .ps-vault-v7-category:hover {
    -unity-background-image-tint-color: rgb(255, 246, 246);
}

.ps-vault-final .ps-vault-v9-flip {
    min-width: 92px;
    height: 25px;
    padding: 0 12px;
    color: rgb(236, 206, 170);
    font-size: 9px;
    border-width: 1px;
    border-color: rgba(177, 73, 105, 0.72);
    border-radius: 13px;
    background-image: none;
    background-color: rgba(34, 8, 28, 0.92);
}

