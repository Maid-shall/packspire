    -unity-background-scale-mode: scale-to-fit;
}


/* ===== Consolidated from PackspireVaultV7.uss ===== */
/*
 * PACKSPIRE Vault V7
 * Whole-image composition pass.
 *
 * Nothing in this sheet uses 9-slicing. Authored UI parts retain their
 * original proportions and text is placed only inside their safe areas.
 */

.ps-vault-final {
    overflow: hidden;
    border-radius: 28px;
    background-color: rgb(2, 5, 18);
}

.ps-vault-final .ps-layer-content {
    padding: 9px 17px 13px 17px;
}

.ps-vault-final .ps-mgmt-header {
    height: 55px;
    min-height: 55px;
    max-height: 55px;
    margin: 0 0 7px 0;
    padding: 0;
    border-width: 0;
    background-image: none;
    background-color: rgba(0, 0, 0, 0);
}

.ps-vault-final .ps-management-brand {
    width: 290px;
    height: 51px;
    padding: 0;
}

.ps-vault-final .ps-management-brand-crest {
    width: 43px;
    height: 43px;
    margin-right: 8px;
}

.ps-vault-final .ps-mgmt-body,
.ps-vault-final .ps-vault-v9-main-row {
    width: 100%;
    min-width: 0;
    min-height: 0;
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: row;
    flex-wrap: nowrap;
    margin: 0;
    padding: 0;
    overflow: hidden;
    border-width: 0;
}

/* Inventory ----------------------------------------------------------- */

