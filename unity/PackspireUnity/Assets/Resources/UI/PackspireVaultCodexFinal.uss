/* Compendium: approved archive layout -------------------------------- */

.ps-codex-v8 {
    flex-grow: 1;
}

.ps-codex-v8 .ps-codex-index-column {
    width: 36%;
    min-width: 36%;
    max-width: 36%;
    padding-right: 13px;
}

.ps-codex-v8 .ps-codex-record-column {
    position: relative;
    width: 64%;
    min-width: 64%;
    max-width: 64%;
    padding-left: 15px;
}

.ps-codex-v8 .ps-codex-index-header {
    height: 58px;
    min-height: 58px;
    margin-bottom: 6px;
    flex-direction: row;
    justify-content: space-between;
}

.ps-codex-v8 .ps-codex-category-tab {
    position: relative;
    width: 32.5%;
    min-width: 32.5%;
