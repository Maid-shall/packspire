<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="faction-background" class="ps-layer-background" picking-mode="Ignore">
        <ui:VisualElement class="ps-faction-shade" picking-mode="Ignore" />
    </ui:VisualElement>
    <ui:VisualElement class="ps-faction-register-mark" picking-mode="Ignore" />
    <ui:VisualElement class="ps-faction-ledger-spine" picking-mode="Ignore" />
    <ui:VisualElement class="ps-layer-content ps-faction-layout">
        <ui:VisualElement name="faction-header" class="ps-faction-header">
            <ui:VisualElement class="ps-faction-header-copy">
                <ui:Label text="FACTION / ALLEGIANCE" class="ps-faction-header-eyebrow" picking-mode="Ignore" />
                <ui:Label text="配達組合契約" class="ps-faction-header-title" picking-mode="Ignore" />
                <ui:Label text="所属と貢献記録を照合し、各組合との関係を確認する。" class="ps-faction-header-note" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="ps-faction-body">
            <ui:VisualElement class="ps-faction-top-row">
                <ui:VisualElement class="ps-faction-emissary-column">
                    <ui:VisualElement name="faction-emissary-study-front" class="ps-faction-emissary-study ps-faction-emissary-study-front" picking-mode="Ignore" />
                    <ui:VisualElement name="faction-emissary-study-back" class="ps-faction-emissary-study ps-faction-emissary-study-back" picking-mode="Ignore" />
                    <ui:VisualElement name="faction-emissary-host" class="ps-faction-emissary-host" />
                    <ui:VisualElement class="ps-faction-emissary-caption">
                        <ui:Label text="EMISSARY" class="ps-faction-emissary-eyebrow" picking-mode="Ignore" />
                        <ui:Label name="faction-emissary-name" class="ps-faction-emissary-name" picking-mode="Ignore" />
                        <ui:Label name="faction-emissary-title" class="ps-faction-emissary-title" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="faction-graph-column" class="ps-faction-col-graph">
                    <ui:VisualElement class="ps-faction-registry-heading">
                        <ui:Label text="組合一覧" class="ps-faction-registry-title" picking-mode="Ignore" />
                        <ui:Label text="FACTION REGISTRY" class="ps-faction-registry-eyebrow" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="faction-graph-host" class="ps-faction-graph-host">
                        <ui:VisualElement name="faction-graph-nodes" class="ps-faction-graph-nodes" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="ps-faction-col-detail">
                <ui:VisualElement name="faction-detail-surface" class="ps-faction-detail-surface">
                    <ui:VisualElement name="faction-detail-header" class="ps-faction-detail-header" />
                    <ui:ScrollView name="faction-detail-scroll" class="ps-faction-detail-scroll" mode="Vertical" vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
