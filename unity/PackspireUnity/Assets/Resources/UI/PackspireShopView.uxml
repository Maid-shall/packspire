<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="shop-background" class="ps-layer-background" picking-mode="Ignore">
        <ui:VisualElement class="ps-shop-shade" picking-mode="Ignore" />
    </ui:VisualElement>
    <ui:VisualElement class="ps-layer-content">
        <ui:VisualElement name="shop-header" class="ps-shop-header">
            <ui:VisualElement class="ps-shop-header-copy">
                <ui:Label text="NIGHT MARKET / SHOP" class="ps-shop-header-eyebrow" picking-mode="Ignore" />
                <ui:Label text="悪魔商店" class="ps-shop-header-title" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="ps-shop-gold-plaque">
                <ui:Label name="shop-header-gold" class="ps-shop-header-gold" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="shop-dev-hint" text="DEVプレビュー" class="ps-shop-dev-hint" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement class="ps-shop-body">
            <ui:VisualElement name="shop-merchant-column" class="ps-shop-col-merchant">
                <ui:VisualElement name="shop-merchant-scene" class="ps-shop-merchant-scene">
                    <ui:VisualElement name="shop-merchant-backdrop" class="ps-shop-merchant-backdrop-layer" picking-mode="Ignore" />
                    <ui:VisualElement class="ps-shop-merchant-character-viewport" picking-mode="Ignore">
                        <ui:Image name="shop-merchant-character" class="ps-shop-merchant-character-image" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="ps-shop-merchant-dialogue-layer" picking-mode="Ignore">
                        <ui:Label name="shop-merchant-dialogue" class="ps-shop-merchant-dialogue" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="shop-list-column" class="ps-shop-col-list">
                <ui:VisualElement name="shop-filter-host" class="ps-shop-filter-host" />
                <ui:VisualElement class="ps-shop-stock-heading">
                    <ui:Label text="本日の品" class="ps-shop-stock-heading-text" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:ScrollView name="shop-product-scroll" class="ps-shop-product-scroll" mode="Vertical" vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden">
                    <ui:VisualElement name="shop-product-grid" class="ps-shop-product-grid" />
                </ui:ScrollView>
            </ui:VisualElement>
            <ui:VisualElement name="shop-detail-column" class="ps-shop-col-detail">
                <ui:VisualElement name="shop-detail-host" class="ps-shop-detail-host">
                    <ui:ScrollView name="shop-detail-scroll" class="ps-shop-detail-scroll" mode="Vertical" vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="shop-transaction-column" class="ps-shop-col-transaction">
                <ui:Label text="PURCHASE INVOICE" class="ps-shop-transaction-heading" picking-mode="Ignore" />
                <ui:VisualElement class="ps-shop-merchant-transaction-layer">
                    <ui:Label name="shop-selected-name" class="ps-shop-tx-name" picking-mode="Ignore" />
                    <ui:Label name="shop-gold" class="ps-shop-tx-gold" picking-mode="Ignore" />
                    <ui:Label name="shop-total" class="ps-shop-tx-total" picking-mode="Ignore" />
                    <ui:Label name="shop-purchase-reason" class="ps-shop-tx-reason" picking-mode="Ignore" />
                    <ui:VisualElement class="ps-shop-tx-actions">
                        <ui:Button name="shop-buy" text="購入する" class="ps-shop-buy-btn" />
                        <ui:Button name="shop-leave" text="地図へ戻る" class="ps-shop-leave-btn" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
