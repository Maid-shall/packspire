  - id: ash_forge
    name: "\u7070\u71B1\u306E\u92F3\u9020\u5751"
    description: "\u6575\u306E\u5BC6\u5EA6\u3068\u653B\u6483\u6027\u304C\u9AD8\u3044\u9AD8\u6E29\u5751\u9053\u3002"
