  events:
  - id: memory_rift
    eyebrow: ANOMALY  /  RITE
    title: "\u8A18\u61B6\u306E\u63FA\u3089\u304E"
    body: "\u7A7A\u9593\u306E\u5965\u3067\u3001\u7D2B\u306E\u6B8B\u5149\u304C\u3086\u3063\u304F\u308A\u3068\u8108\u52D5\u3057\u3066\u3044\u308B\u3002\u89E6\u308C\u308C\u3070\u4F55\u304B\u304C\u5909\u308F\u308B\u3002\u305D\u306E\u4EE3\u511F\u307E\u3067\u306F\u3001\u307E\u3060\u8A18\u3055\u308C\u3066\u3044\u306A\u3044\u3002"
    minimumDoomTier: 0
    weight: 1
    choices:
    - id: offer
      label: "\u4EE3\u511F\u3092\u652F\u6255\u3046"
      resultText: "\u4EE3\u511F\u3092\u6255\u3044\u300124G\u3092\u5F97\u305F"
      effects:
      - effect: 1
        amount: -6
      - effect: 2
        amount: 24
      reactionContributions:
      - reactionId: sacrifice
        amount: 3
        scope: 2
        stackRule: 0
        perLevel: 0
    - id: repair
      label: "\u6B8B\u97FF\u3092\u4FEE\u5FA9\u3059\u308B"
      resultText: "\u6B8B\u97FF\u304C\u88C5\u5099\u3092\u4FEE\u5FA9\u3057\u305F"
      effects:
      - effect: 3
        amount: 6
      reactionContributions:
      - reactionId: artifice
        amount: 2
        scope: 2
        stackRule: 0
        perLevel: 0
    - id: leave
      label: "\u7ACB\u3061\u53BB\u308B"
      resultText: "\u9ED2\u3044\u9744\u3092\u632F\u308A\u6255\u3044\u3001\u63A2\u7D22\u3078\u623B\u3063\u305F"
      effects: []
      reactionContributions:
      - reactionId: observation
        amount: 1
        scope: 3
        stackRule: 0
        perLevel: 0
    artwork: {fileID: 0}
  - id: wayfinder_shrine
    eyebrow: WAYFINDER  /  TRACE
    title: 導標の祭壇
    body: 青い針が未知の区画を指して震えている。針を読むか、砕いて路銀に変えるか。
    minimumDoomTier: 0
    weight: 1
    choices:
    - id: read
      label: 導標を読み解く
      resultText: 塔の構造を読み、観測の反応を得た
      effects: []
      reactionContributions:
      - reactionId: observation
        amount: 3
        scope: 2
        stackRule: 0
        perLevel: 0
    - id: break
      label: 導標を砕く
      resultText: 砕けた結晶を18Gに換えた
      effects:
      - effect: 2
        amount: 18
      reactionContributions:
      - reactionId: commerce
        amount: 1
        scope: 2
        stackRule: 0
        perLevel: 0
    - id: leave
      label: 触れずに進む
      resultText: 針の震えを記憶し、探索へ戻った
      effects: []
      reactionContributions:
      - reactionId: observation
        amount: 1
        scope: 3
        stackRule: 0
        perLevel: 0
    artwork: {fileID: 0}
  - id: field_workbench
    eyebrow: WORKBENCH  /  LOADOUT
    title: 放棄された荷造り卓
    body: 折れた工具と、まだ熱を残す修復炉がある。装備を直す余地も、部材を売る余地もある。
    minimumDoomTier: 0
    weight: 1
    choices:
    - id: repair
      label: 装備を修復する
      resultText: 全装備の耐久を8まで修復した
      effects:
      - effect: 3
        amount: 8
      reactionContributions:
      - reactionId: artifice
        amount: 2
        scope: 2
        stackRule: 0
        perLevel: 0
    - id: salvage
      label: 部材を回収する
      resultText: 不要な部材を20Gに換えた
      effects:
      - effect: 2
        amount: 20
      reactionContributions:
      - reactionId: commerce
        amount: 2
        scope: 2
        stackRule: 0
        perLevel: 0
    - id: study
      label: 構造を記録する
      resultText: 工巧の反応を遠征記録へ刻んだ
      effects: []
      reactionContributions:
      - reactionId: artifice
        amount: 3
        scope: 2
        stackRule: 0
        perLevel: 0
    artwork: {fileID: 0}
  - id: spore_nursery
    eyebrow: SPORE  /  GROWTH
    title: 眠る胞子苗床
    body: 淡い胞子が傷と金属の双方へ根を伸ばす。育てれば癒やすが、何を養分にするかは選ばなければならない。
    minimumDoomTier: 0
    weight: 1
    choices:
    - id: rest
      label: 胞子に身を預ける
      resultText: HPを10回復した
      effects:
      - effect: 1
        amount: 10
      reactionContributions:
      - reactionId: spore
        amount: 3
        scope: 2
        stackRule: 0
        perLevel: 0
    - id: repair
      label: 装備を培養する
      resultText: 全装備の耐久を7まで修復した
      effects:
      - effect: 3
        amount: 7
      reactionContributions:
      - reactionId: artifice
        amount: 2
        scope: 2
        stackRule: 0
        perLevel: 0
    - id: harvest
      label: 胞子を採取する
      resultText: 胞子を16Gに換えた
      effects:
      - effect: 2
        amount: 16
      reactionContributions:
      - reactionId: spore
        amount: 1
        scope: 2
        stackRule: 0
        perLevel: 0
      - reactionId: commerce
        amount: 1
        scope: 2
        stackRule: 0
        perLevel: 0
    artwork: {fileID: 0}
  - id: black_ledger
    eyebrow: PACT  /  PRICE
    title: 黒鐘の台帳
    body: 台帳には、まだ支払っていない代価と、まだ受け取っていない報酬が同じ墨で記されている。
    minimumDoomTier: 1
    weight: 2
    choices:
    - id: offer
      label: 血で署名する
      resultText: HPを8失い、36Gと代償の反応を得た
      effects:
      - effect: 1
        amount: -8
      - effect: 2
        amount: 36
      reactionContributions:
      - reactionId: sacrifice
        amount: 3
        scope: 2
        stackRule: 0
        perLevel: 0
    - id: repair
      label: 古い契約を修復する
      resultText: 装備の耐久を9まで修復した
      effects:
      - effect: 3
        amount: 9
      reactionContributions:
      - reactionId: artifice
        amount: 2
        scope: 2
        stackRule: 0
        perLevel: 0
    - id: leave
      label: 台帳を閉じる
      resultText: 契約を拒み、最深部へ進んだ
      effects: []
      reactionContributions:
      - reactionId: observation
        amount: 1
        scope: 3
        stackRule: 0
        perLevel: 0
    artwork: {fileID: 0}
